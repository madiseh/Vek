@namespace Vek.Components.Components.DataGrid
@typeparam TItem

@{
    var sortedItems = GetSortedItems();
    var totalPages = GetTotalPages(sortedItems.Count);
    _currentPage = Math.Clamp(_currentPage, 1, totalPages);
    var pageItems = sortedItems
        .Skip((_currentPage - 1) * EffectivePageSize)
        .Take(EffectivePageSize)
        .ToList();
}

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<div class="vek-data-grid @Class">
    @{ var pagerContext = CreatePagerContext(sortedItems.Count, totalPages); }
    @if (FilterMode == VekDataGridFilterMode.Simple && _columns.Any(column => column.Filterable))
    {
        <div class="filter-panel" aria-label="Filters">
            @foreach (var column in _columns.Where(column => column.Filterable))
            {
                @RenderFilterControl(column)
            }
            <button type="button" @onclick="() => ClearFilterAsync()">Clear filters</button>
        </div>
    }
    <div class="table-scroll-container">
        <table>
            <thead>
                <tr>
                    @foreach (var column in _columns)
                    {
                        var sortPriority = GetSortPriority(column);
                        <th scope="col" aria-sort="@GetAriaSort(column)">
                            @if (column.IsSelectionColumn)
                            {
                                @if (SelectionMode == VekDataGridSelectionMode.Multiple)
                                {
                                    <input type="checkbox" aria-label="Select all visible rows"
                                           checked="@AreAllVisibleItemsSelected()"
                                           @onchange="args => ToggleAllVisibleItemsAsync(args.Value is true)" />
                                }
                            }
                            else
                            {
                                <button type="button"
                                        class="sort-button"
                                        disabled="@(SortMode == VekDataGridSortMode.None || !column.Sortable)"
                                        aria-label="Sort by @column.Title"
                                        @onclick="args => SortBy(column, args)">
                                    @column.Title
                                    @if (sortPriority.HasValue)
                                    {
                                        <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(column)</span>
                                    }
                                </button>
                            }
                            @if (FilterMode == VekDataGridFilterMode.ColumnMenu && column.Filterable)
                            {
                                @RenderFilterControl(column)
                            }
                        </th>
                    }
                </tr>
                @if (FilterMode == VekDataGridFilterMode.ColumnRow)
                {
                    <tr class="filter-row">
                        @foreach (var column in _columns)
                        {
                            <th scope="col">@if (column.Filterable) { @RenderFilterControl(column) }</th>
                        }
                    </tr>
                }
            </thead>
            <tbody>
                @if (pageItems.Count == 0)
                {
                    <tr>
                        <td class="empty-state" colspan="@Math.Max(_columns.Count, 1)">No items to display.</td>
                    </tr>
                }
                else if (EffectiveGroups.Count > 0)
                {
                    @RenderGroupRows(BuildGroupNodes(pageItems, 0, string.Empty))
                }
                else
                {
                    @foreach (var item in pageItems)
                    {
                        <tr class="@(IsItemSelected(item) ? "is-selected" : null)"
                            aria-selected="@IsItemSelected(item)"
                            @onclick="() => SelectRowAsync(item)">
                            @foreach (var column in _columns)
                            {
                                <td>
                                    @if (IsEditing(item, column) && column.EditTemplate is not null)
                                    {
                                        <CascadingValue Value="_editContext">
                                            @column.EditTemplate(GetEditContext(item, column)!)
                                        </CascadingValue>
                                    }
                                    else
                                    {
                                        @column.CellTemplate(item)
                                        @if (EditMode == VekDataGridEditMode.Cell && column.Editable && column.EditTemplate is not null)
                                        {
                                            <button type="button" class="edit-cell-button" aria-label="Edit @column.Title"
                                                    @onclick:stopPropagation="true" @onclick="() => StartEditAsync(item, column)">Edit</button>
                                        }
                                        @if ((EditMode is VekDataGridEditMode.Row or VekDataGridEditMode.Form)
                                            && CanEditRow && ReferenceEquals(column, _columns.FirstOrDefault()))
                                        {
                                            <button type="button" class="edit-row-button" aria-label="Edit row @GetEditLabel(item)"
                                                    @onclick:stopPropagation="true" @onclick="() => StartEditAsync(item)">Edit</button>
                                        }
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
            @if (Aggregates.Any(aggregate => aggregate.Scope is VekDataGridAggregateScope.Footer or VekDataGridAggregateScope.Both))
            {
                var footerContext = CreateFooterContext();
                <tfoot>
                    <tr class="aggregate-footer">
                        <td colspan="@Math.Max(_columns.Count, 1)">
                            @if (FooterTemplate is not null)
                            {
                                @FooterTemplate(footerContext)
                            }
                            @foreach (var aggregate in footerContext.Aggregates)
                            {
                                @RenderAggregate(aggregate, footerContext.Items)
                            }
                        </td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    @if (PagerContent is null)
    {
        <nav class="pager" aria-label="Table pagination">
            <label>Rows per page
                <select aria-label="Rows per page" value="@EffectivePageSize" @onchange="SetPageSizeAsync">
                    @foreach (var option in PageSizeOptions.Where(option => option > 0).Append(EffectivePageSize).Distinct().Order())
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>
            <button type="button" aria-label="Previous page" @onclick="() => SetCurrentPageAsync(_currentPage - 1)" disabled="@(_currentPage <= 1)">Previous</button>
            <span>Page @_currentPage of @totalPages</span>
            <button type="button" aria-label="Next page" @onclick="() => SetCurrentPageAsync(_currentPage + 1)" disabled="@(_currentPage >= totalPages)">Next</button>
        </nav>
    }
    else
    {
        @PagerContent(pagerContext)
    }
</div>

@code {
    private RenderFragment RenderFilterControl(IVekDataGridColumn<TItem> column) => builder =>
    {
        if (column.FilterTemplate is not null)
        {
            builder.AddContent(0, column.FilterTemplate(new VekDataGridFilterContext(
                GetFilterValue(column.Key),
                value => _ = ApplyTextFilter(column, value),
                () => _ = ClearColumnFilter(column))));
            return;
        }

        var sequence = 0;
        if (FilterMode == VekDataGridFilterMode.ColumnMenu)
        {
            builder.OpenElement(sequence++, "details");
            builder.OpenElement(sequence++, "summary");
            builder.AddContent(sequence++, "Filter");
            builder.CloseElement();
        }
        builder.OpenElement(sequence++, "label");
        builder.AddContent(sequence++, column.Title);
        builder.OpenElement(sequence++, "input");
        builder.AddAttribute(sequence++, "aria-label", $"Filter {column.Title}");
        builder.AddAttribute(sequence++, "value", GetFilterValue(column.Key) ?? string.Empty);
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            args => ApplyTextFilter(column, args.Value?.ToString())));
        builder.CloseElement();
        builder.CloseElement();
        if (FilterMode == VekDataGridFilterMode.ColumnMenu) builder.CloseElement();
    };
}
