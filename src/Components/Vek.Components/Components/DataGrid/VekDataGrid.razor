@namespace Vek.Components.Components.DataGrid
@typeparam TItem

@{
    var sortedItems = ServerData is null ? GetSortedItems() : _serverItems.ToList();
    var totalItemCount = ServerData is null ? sortedItems.Count : _serverTotalItems;
    var totalPages = GetTotalPages(totalItemCount);
    _currentPage = Math.Clamp(_currentPage, 1, totalPages);
    var pageItems = ServerData is null
        ? sortedItems.Skip((_currentPage - 1) * EffectivePageSize).Take(EffectivePageSize).ToList()
        : sortedItems;
}

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

<div class="vek-data-grid @GetGridClass()" style="@GetGridStyle()">
    @{ var pagerContext = CreatePagerContext(totalItemCount, totalPages); }
    @if (ToolbarTemplate is not null)
    {
        <div class="grid-toolbar">@ToolbarTemplate</div>
    }
    @if (ColumnResizeMode == VekDataGridColumnResizeMode.Container)
    {
        <label class="container-resize-control">Grid width
            <input type="range" aria-label="Resize grid" min="320" max="1440" step="16"
                   value="@(CurrentContainerWidth ?? 900)" @oninput="ResizeContainerAsync" />
        </label>
    }
    @if (ShowColumnPanel)
    {
        <div class="column-toolbar">
            <button type="button" aria-label="Manage columns" aria-expanded="@_columnPanelOpen" @onclick="ToggleColumnPanel">Columns</button>
        </div>
        @if (_columnPanelOpen)
        {
            <section class="column-panel" aria-label="Column options">
                <label class="column-search-label">Search columns
                    <input type="search" aria-label="Search columns" value="@_columnSearch"
                           @oninput="args => _columnSearch = args.Value?.ToString() ?? string.Empty" />
                </label>
                @foreach (var column in SearchableColumns)
                {
                    var columnIndex = _columns.IndexOf(column);
                    <div class="column-option @GetColumnDragClass(column.Key)" draggable="@(CanReorderInPanel ? "true" : "false")"
                         @ondragstart="() => BeginColumnDrag(column.Key)"
                         @ondragenter="() => SetColumnDropTarget(column.Key)"
                         @ondragover:preventDefault="true"
                         @ondrop="() => DropColumnAsync(column.Key, false)"
                         @ondragend="EndColumnDrag">
                        <label>
                            <input type="checkbox" aria-label="Show @column.Title column" checked="@column.Visible"
                                   @onchange="args => SetColumnVisibilityAsync(column.Key, args.Value is true)" />
                            <span class="column-title">@column.Title</span>
                        </label>
                        @if (CanReorderInPanel)
                        {
                            <span class="column-move-controls" aria-label="Reorder @column.Title column">
                                <button type="button" aria-label="Move @column.Title column up" disabled="@(columnIndex <= 0)"
                                        @onclick="() => MoveColumnInPanelAsync(column.Key, -1)">↑</button>
                                <button type="button" aria-label="Move @column.Title column down" disabled="@(columnIndex >= _columns.Count - 1)"
                                        @onclick="() => MoveColumnInPanelAsync(column.Key, 1)">↓</button>
                            </span>
                        }
                    </div>
                }
            </section>
        }
    }
    @if (FilterMode == VekDataGridFilterMode.Simple && VisibleColumns.Any(column => column.Filterable))
    {
        <div class="filter-panel" aria-label="Filters">
            @foreach (var column in VisibleColumns.Where(column => column.Filterable))
            {
                @RenderFilterControl(column)
            }
            <button type="button" @onclick="() => ClearFilterAsync()">Clear filters</button>
        </div>
    }
    <div class="table-scroll-container @(Responsive ? "is-responsive" : null) @(FixedHeader ? "has-fixed-header" : null)"
         data-responsive="@(Responsive ? "true" : "false")">
        <table @attributes="AdditionalAttributes" aria-label="@AriaLabel">
            <thead class="@(FixedHeader ? "is-sticky" : null) @(ColumnGroups.Count > 0 ? "has-column-groups" : null)">
                @if (ColumnGroups.Count > 0)
                {
                    <tr class="column-group-row">
                        @foreach (var segment in GetColumnGroupSegments())
                        {
                            <th scope="@(segment.Title is null ? "col" : "colgroup")" colspan="@segment.Span">@segment.Title</th>
                        }
                    </tr>
                }
                @HeaderTemplate
                <tr>
                    @foreach (var column in VisibleColumns)
                    {
                        var sortPriority = GetSortPriority(column);
                        <th scope="col" data-column-key="@column.Key" draggable="@(CanReorderInHeader ? "true" : "false")"
                            class="@GetHeaderClass(column.Key)" aria-sort="@GetAriaSort(column)"
                            style="@GetColumnWidthStyle(column) @HeaderStyle?.Invoke(column.Key)"
                            tabindex="@(CanReorderInHeader ? 0 : null)"
                            aria-description="@(CanReorderInHeader ? "Use the left and right arrow keys to move this column." : null)"
                            @ondragstart="() => BeginColumnDrag(column.Key)"
                            @ondragenter="() => SetColumnDropTarget(column.Key)"
                            @ondragover:preventDefault="true"
                            @ondrop="() => DropColumnAsync(column.Key, true)"
                            @onkeydown="args => MoveColumnFromHeaderByKeyAsync(column.Key, args)"
                            @ondragend="EndColumnDrag">
                            @if (column.IsHierarchyColumn)
                            {
                                <button type="button" aria-label="Toggle all row details"
                                        aria-expanded="@(AreAllRowsExpanded() ? "true" : "false")"
                                        @onclick="ToggleAllRowDetailsAsync">@(AreAllRowsExpanded() ? "−" : "+")</button>
                            }
                            else if (column.IsSelectionColumn)
                            {
                                @if (SelectionMode == VekDataGridSelectionMode.Multiple)
                                {
                                    <input type="checkbox" aria-label="Select all visible rows"
                                           checked="@AreAllVisibleItemsSelected()"
                                           @onchange="args => ToggleAllVisibleItemsAsync(args.Value is true)" />
                                }
                            }
                            else
                            {
                                <button type="button"
                                        class="sort-button"
                                        disabled="@(SortMode == VekDataGridSortMode.None || !column.Sortable)"
                                        aria-label="Sort by @column.Title"
                                        @onclick="args => SortBy(column, args)">
                                    @column.Title
                                    @if (sortPriority.HasValue)
                                    {
                                        <span class="sort-indicator" aria-hidden="true">@GetSortIndicator(column)</span>
                                    }
                                </button>
                            }
                            @if (FilterMode == VekDataGridFilterMode.ColumnMenu && column.Filterable)
                            {
                                @RenderFilterControl(column)
                            }
                            @if (ColumnResizeMode == VekDataGridColumnResizeMode.Column)
                            {
                                <input type="range" class="column-width-control" aria-label="Resize @column.Title column"
                                       min="@Math.Max(column.MinWidth, 32)" max="@Math.Max(column.MaxWidth, Math.Max(column.MinWidth, 32))"
                                       step="8" value="@GetColumnWidthValue(column)"
                                       @oninput="args => ResizeColumnFromInputAsync(column.Key, args)" />
                            }
                        </th>
                    }
                </tr>
                @if (FilterMode == VekDataGridFilterMode.ColumnRow)
                {
                    <tr class="filter-row">
                        @foreach (var column in VisibleColumns)
                        {
                            <th scope="col">@if (column.Filterable) { @RenderFilterControl(column) }</th>
                        }
                    </tr>
                }
            </thead>
            <tbody>
                @if (ServerData is not null && _serverLoading)
                {
                    <tr><td class="loading-state" role="status" colspan="@VisibleColumnCount">@(LoadingContent is null ? "Loading items..." : null) @LoadingContent</td></tr>
                }
                else if (ServerData is not null && _serverError is not null)
                {
                    <tr><td class="error-state" colspan="@VisibleColumnCount">
                        @if (ErrorContent is null) { @_serverError.Message }
                        else { @ErrorContent(_serverError) }
                    </td></tr>
                }
                else if (VirtualizeRows)
                {
                    @if (ServerVirtualData is null)
                    {
                        <Virtualize TItem="TItem" Items="sortedItems" ItemSize="VirtualItemSize"
                                    OverscanCount="VirtualOverscanCount" MaxItemCount="VirtualMaxItemCount"
                                    SpacerElement="tr" Context="virtualItem" @ref="_virtualizer">
                            <ChildContent Context="virtualItem">@VirtualizedRowTemplate(virtualItem)</ChildContent>
                            <Placeholder Context="placeholder">
                                <tr style="height: @(VirtualItemSize)px"><td class="loading-state" role="status" colspan="@VisibleColumnCount">@(LoadingContent is null ? "Loading rows…" : null) @LoadingContent</td></tr>
                            </Placeholder>
                            <EmptyContent>
                                <tr><td class="empty-state" role="status" colspan="@VisibleColumnCount">@(EmptyContent is null ? "No items to display." : null) @EmptyContent</td></tr>
                            </EmptyContent>
                        </Virtualize>
                    }
                    else
                    {
                        <Virtualize TItem="TItem" ItemsProvider="LoadVirtualItemsAsync" ItemSize="VirtualItemSize"
                                    OverscanCount="VirtualOverscanCount" MaxItemCount="VirtualMaxItemCount"
                                    SpacerElement="tr" Context="virtualItem" @ref="_virtualizer">
                            <ChildContent Context="virtualItem">@VirtualizedRowTemplate(virtualItem)</ChildContent>
                            <Placeholder Context="placeholder">
                                <tr style="height: @(VirtualItemSize)px"><td class="loading-state" role="status" colspan="@VisibleColumnCount">@(LoadingContent is null ? "Loading rows…" : null) @LoadingContent</td></tr>
                            </Placeholder>
                            <EmptyContent>
                                <tr><td class="empty-state" role="status" colspan="@VisibleColumnCount">@(EmptyContent is null ? "No items to display." : null) @EmptyContent</td></tr>
                            </EmptyContent>
                        </Virtualize>
                    }
                }
                else if (pageItems.Count == 0)
                {
                    <tr>
                        <td class="empty-state" role="status" colspan="@VisibleColumnCount">
                            @if (EmptyContent is null) { @("No items to display.") }
                            else { @EmptyContent }
                        </td>
                    </tr>
                }
                else if (EffectiveGroups.Count > 0)
                {
                    @RenderGroupRows(BuildGroupNodes(pageItems, 0, string.Empty))
                }
                else
                {
                    @foreach (var item in pageItems)
                    {
                        @VirtualizedRowTemplate(item)
                    }
                }
            </tbody>
            @if (FooterTemplate is not null || Aggregates.Any(aggregate => aggregate.Scope is VekDataGridAggregateScope.Footer or VekDataGridAggregateScope.Both))
            {
                var footerContext = CreateFooterContext();
                <tfoot>
                    <tr class="aggregate-footer @FooterClass?.Invoke()" style="@FooterStyle?.Invoke()">
                        <td colspan="@VisibleColumnCount">
                            @if (FooterTemplate is not null)
                            {
                                @FooterTemplate(footerContext)
                            }
                            @foreach (var aggregate in footerContext.Aggregates)
                            {
                                @RenderAggregate(aggregate, footerContext.Items)
                            }
                        </td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>

    @if (!VirtualizeRows && PagerContent is null)
    {
        <nav class="pager" aria-label="Table pagination">
            <label>Rows per page
                <select aria-label="Rows per page" value="@EffectivePageSize" @onchange="SetPageSizeAsync">
                    @foreach (var option in PageSizeOptions.Where(option => option > 0).Append(EffectivePageSize).Distinct().Order())
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>
            <button type="button" aria-label="Previous page" @onclick="() => SetCurrentPageAsync(_currentPage - 1)" disabled="@(_currentPage <= 1)">Previous</button>
            <span>Page @_currentPage of @totalPages</span>
            <button type="button" aria-label="Next page" @onclick="() => SetCurrentPageAsync(_currentPage + 1)" disabled="@(_currentPage >= totalPages)">Next</button>
        </nav>
    }
    else if (!VirtualizeRows)
    {
        @PagerContent?.Invoke(pagerContext)
    }
</div>

@code {
    private RenderFragment RenderFilterControl(IVekDataGridColumn<TItem> column) => builder =>
    {
        if (column.FilterTemplate is not null)
        {
            builder.AddContent(0, column.FilterTemplate(new VekDataGridFilterContext(
                GetFilterValue(column.Key),
                value => _ = ApplyTextFilter(column, value),
                () => _ = ClearColumnFilter(column))));
            return;
        }

        var sequence = 0;
        if (FilterMode == VekDataGridFilterMode.ColumnMenu)
        {
            builder.OpenElement(sequence++, "details");
            builder.OpenElement(sequence++, "summary");
            builder.AddContent(sequence++, "Filter");
            builder.CloseElement();
        }
        builder.OpenElement(sequence++, "label");
        builder.AddContent(sequence++, column.Title);
        builder.OpenElement(sequence++, "input");
        builder.AddAttribute(sequence++, "aria-label", $"Filter {column.Title}");
        builder.AddAttribute(sequence++, "value", GetFilterValue(column.Key) ?? string.Empty);
        builder.AddAttribute(sequence++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this,
            args => ApplyTextFilter(column, args.Value?.ToString())));
        builder.CloseElement();
        builder.CloseElement();
        if (FilterMode == VekDataGridFilterMode.ColumnMenu) builder.CloseElement();
    };
}
