<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Vek.Components</RootNamespace>
    <PackageId>Vek.Blazor.CodeView</PackageId>
    <Version>0.1.0</Version>
    <Authors>AMIN SABAGHI</Authors>
    <Description>Code viewer components for Blazor and .NET 10.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>blazor;components;ui;code-view</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <None Include="../../../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
