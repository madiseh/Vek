<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <!-- Workspaces transitively pins Microsoft.CodeAnalysis.CSharp to the same band as the analyzer
         (VekRoslynShippedVersion in Directory.Build.props); both DLLs ship together in
         analyzers/dotnet/cs and must stay on the same Roslyn band. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vek.Analyzers\Vek.Analyzers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vek.UnitTests" />
  </ItemGroup>
</Project>
