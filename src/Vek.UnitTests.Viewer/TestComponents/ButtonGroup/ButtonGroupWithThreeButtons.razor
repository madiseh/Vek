<VekButtonGroup FullWidth="ButtonGroupFullWidth">
    @if(Button1Displayed)
    {
        <VekButton FullWidth="Button1FullWidth">Button One</VekButton>
    }
    @if(Button2Displayed)
    {
        <VekButton FullWidth="Button2FullWidth">Button Two</VekButton>
    }
    @if(Button3Displayed)
    {
        <VekButton FullWidth="Button3FullWidth">Button Third</VekButton>
    }
</VekButtonGroup>

@code {
    [Parameter]
    public bool ButtonGroupFullWidth { get; set; } = true;

    [Parameter]
    public bool Button1Displayed { get; set; } = true;

    [Parameter]
    public bool Button1FullWidth { get; set; }

    [Parameter]
    public bool Button2Displayed { get; set; } = true;

    [Parameter]
    public bool Button2FullWidth { get; set; }

    [Parameter]
    public bool Button3Displayed { get; set; } = true;

    [Parameter]
    public bool Button3FullWidth { get; set; }
}