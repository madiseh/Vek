<VekText Typo="Typo.h6">Buttons</VekText>

<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Filled">One</VekButton>
<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Filled">Two</VekButton>
<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Filled">Three</VekButton>

<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Text">One</VekButton>
<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Text">Two</VekButton>
<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Text">Three</VekButton>

<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Outlined">One</VekButton>
<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Outlined">Two</VekButton>
<VekButton Disabled="_disabled" Color="Color.Primary" Variant="Variant.Outlined">Three</VekButton>

<VekText Typo="Typo.h6">ButtonGroup</VekText>

<VekButtonGroup Color="Color.Primary" Variant="Variant.Filled" OverrideStyles="_overrideStyles">
    <VekButton Disabled="_disabled">One</VekButton>
    <VekButton Disabled="_disabled">Two</VekButton>
    <VekButton Disabled="_disabled">Three</VekButton>
</VekButtonGroup>

<VekButtonGroup Color="Color.Primary" Variant="Variant.Text" OverrideStyles="_overrideStyles">
    <VekButton Disabled="_disabled">One</VekButton>
    <VekButton Disabled="_disabled">Two</VekButton>
    <VekButton Disabled="_disabled">Three</VekButton>
</VekButtonGroup>

<VekButtonGroup Color="Color.Primary" Variant="Variant.Outlined" OverrideStyles="_overrideStyles">
    <VekButton Disabled="_disabled">One</VekButton>
    <VekButton Disabled="_disabled">Two</VekButton>
    <VekButton Disabled="_disabled">Three</VekButton>
</VekButtonGroup>

<br />
<br />
<VekSwitch Label="Disabled" @bind-Value="_disabled" />
<VekSwitch Label="Override Styles" @bind-Value="_overrideStyles" />

@code {
    private bool _disabled;
    private bool _overrideStyles = true;
}
