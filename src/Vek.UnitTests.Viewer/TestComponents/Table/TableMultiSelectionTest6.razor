<VekText>SelectedItems { @string.Join(", ", _selectedItems) }</VekText>
<VekTable Items="_items" @bind-SelectedItems="_selectedItems" MultiSelection="true">
    <HeaderContent>
        <VekTh>#</VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd>@context</VekTd>
    </RowTemplate>
    <FooterContent>
        <VekTd>F</VekTd>
    </FooterContent>
</VekTable>

@code {
    public static string __description__ = "the selected items (check-box click or row click) should be represented in SelectedItems.";

    private readonly int[] _items = [0, 1, 2];
    private HashSet<int> _selectedItems = [];
}
