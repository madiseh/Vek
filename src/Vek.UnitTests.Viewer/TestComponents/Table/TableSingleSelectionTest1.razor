<VekText>Seleted Item: @(_selectedItem.ToString())</VekText>
<VekTable Items="_items"  @bind-SelectedItems="_selectedItems" @bind-SelectedItem="_selectedItem" Hover="true" MultiSelection="false" EditTrigger="EditTrigger">
    <RowTemplate>
        <VekTd>@context</VekTd>
    </RowTemplate> 
</VekTable>

@code {
    public static string __description__ = "can only select one item";

    private HashSet<int?>? _selectedItems;
    private int? _selectedItem;
    private readonly int?[] _items = [0, 1, 2];

    [Parameter]
    public TableEditTrigger EditTrigger { get; set; }
}
