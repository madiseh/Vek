<VekTable T="int" Items="_items" EditTrigger="EditTrigger" RowEditableFunc="x => x > 5">
    <RowTemplate>
        <VekTd>@context</VekTd>
    </RowTemplate> 
    <RowEditingTemplate>
        <VekTd>
            <VekNumericField T="int" @bind-Value="context" />
        </VekTd>
    </RowEditingTemplate>
</VekTable>

@code {
    public static string __description__ = "The Tr should not allow editing when AllowEditItem returns false.";

    private readonly int[] _items = [5, 10, 20];

    [Parameter]
    public TableEditTrigger EditTrigger { get; set; } = TableEditTrigger.RowClick;
}
