<VekTable T="int" @ref="Table" Items="_items" CurrentPage="_currentPage">
    <RowTemplate>
        <VekTd>@context</VekTd>
    </RowTemplate>
    <PagerContent>
        <VekTablePager />
    </PagerContent>
</VekTable>

<VekButton OnClick="Rerender" Variant="Variant.Outlined">Rerender</VekButton>
<VekButton OnClick="SetPageFromCode" Variant="Variant.Outlined">Set page from code</VekButton>
