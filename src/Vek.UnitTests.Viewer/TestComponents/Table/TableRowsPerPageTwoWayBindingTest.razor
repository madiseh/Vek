<VekPopoverProvider />

<VekPaper>
    <VekTable Items="@_viewModel.Items"
              Dense="true" Hover="true"
              FixedHeader="true"
              SortLabel="Sort By"
              @bind-RowsPerPage="@RowsPerPage">
        <RowTemplate>
            <VekTd DataLabel="Text">@context.Text</VekTd>
        </RowTemplate>
        <PagerContent>
            <VekTablePager />
        </PagerContent>
    </VekTable>
</VekPaper>