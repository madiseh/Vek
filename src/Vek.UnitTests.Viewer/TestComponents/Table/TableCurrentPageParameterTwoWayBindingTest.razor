<VekTable Items="_items" @bind-CurrentPage="_currentPage">
    <HeaderContent>
        <VekTh>Item</VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd DataLabel="Item">@context</VekTd>
    </RowTemplate>
    <PagerContent>
        <VekTablePager PageSizeOptions="[1]"/>
    </PagerContent>
</VekTable>

@code {
    public static string __description__ = "CurrentPage parameter should be two-way bindable.";
    
    private readonly int[] _items = [1, 2, 3];
    private int _currentPage;
}