<VekPopoverProvider />

<div class="popoverparent">
    <p>Some Text</p>
    <VekPopover Open="true">
        <div class="dynamic-content">
            @for (int i = 0; i < _rowAmount; i++)
            {
                var temp = i;
                <VekText>Popover content @temp</VekText>
            }
        </div>
    </VekPopover>
</div>

@code {
    private int _rowAmount;

    public Task AddRow()
    {
        _rowAmount++;
        return InvokeAsync(StateHasChanged);
    }
}