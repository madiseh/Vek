@* MODE SELECTORS *@

<VekStack Row AlignItems="AlignItems.End">
    <VekSelect T="Margin" Label="Margin size" @bind-Value="Margin" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (Margin margin in Enum.GetValues(typeof(Margin)))
        {
            <VekSelectItem Value="@margin">@margin</VekSelectItem>
        }
    </VekSelect>
    <VekSelect T="AlignItems" Label="Align" @bind-Value="Align" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (AlignItems align in Enum.GetValues(typeof(AlignItems)))
        {
            <VekSelectItem Value="@align">@align</VekSelectItem>
        }
    </VekSelect>
</VekStack>

@* INPUT EXAMPLES FOR EACH VARIANT *@

<VekText Typo="Typo.h6" Class="mt-6 mb-2">VekField</VekText>
<VekStack Row AlignItems="@Align">
    <VekField Variant="Variant.Text" Margin="@Margin">Field value</VekField>
    <VekField Variant="Variant.Filled" Margin="@Margin">Field value</VekField>
    <VekField Variant="Variant.Outlined" Margin="@Margin">Field value</VekField>
</VekStack>
<VekStack Row AlignItems="@Align">
