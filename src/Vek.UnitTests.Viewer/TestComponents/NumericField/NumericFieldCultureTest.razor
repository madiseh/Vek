@using System.Globalization

<VekText>@FieldImmediate.ReadText</VekText>
<VekText>@FieldNotImmediate.ReadText</VekText>

<VekNumericField id="immediate" @ref="FieldImmediate" T="double?" @bind-Value="_value" Immediate Label="English Immediate" Format="N2" Culture="_english" />
<VekNumericField id="notImmediate" @ref="FieldNotImmediate" T="double?" @bind-Value="_value2" Label="German" Format="N2" Culture="_german" />

@code {
    private double? _value;
    private double? _value2;
    private readonly CultureInfo _german = CultureInfo.GetCultureInfo("de-DE");
    private readonly CultureInfo _english = CultureInfo.GetCultureInfo("en-US");

    public VekNumericField<double?> FieldImmediate { get; private set; } = null!;

    public VekNumericField<double?> FieldNotImmediate { get; private set; } = null!;
}
