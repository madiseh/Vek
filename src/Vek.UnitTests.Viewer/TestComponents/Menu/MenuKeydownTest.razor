<VekPopoverProvider />

<VekMenu Label="Full Menu Width" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" PopoverClass="menu-popover-class" Disabled="DisableMenu">
    <VekMenuItem Class="test-class" OnClick="@(() => InvokeItem(1))">1</VekMenuItem>
    <VekMenuItem Href="https://www.test.com" OnClick="@(() => InvokeItem(2))">2</VekMenuItem>
    <VekMenuItem Href="https://www.test.com" Target="_blank" OnClick="@(() => InvokeItem(3))">3</VekMenuItem>

    <VekMenu Label="4">
        <ActivatorContent>
            <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => InvokeItem(4))">Button</VekButton>
        </ActivatorContent>
        <ChildContent>
            <VekMenu Label="4.1">
                 <ActivatorContent>
                    <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => InvokeItem(41))">Button</VekButton>
                 </ActivatorContent>
                 <ChildContent>
                    <VekMenuItem Label="4.1.1" OnClick="@(() => InvokeItem(411))" />
                    <VekMenuItem Label="4.1.2" OnClick="@(() => InvokeItem(412))" />
                    <VekMenuItem Label="4.1.3" OnClick="@(() => InvokeItem(413))" />
                </ChildContent>
            </VekMenu>

            <VekMenuItem Label="4.2" OnClick="@(() => InvokeItem(42))" />
        </ChildContent>
    </VekMenu>

    <VekMenuItem OnClick="@(() => InvokeItem(5))" Disabled>5 Disabled</VekMenuItem>
    <VekMenuItem OnClick="@(() => InvokeItem(6))">6</VekMenuItem>
</VekMenu>

@code {
    public static string __description__ = "Access Menu Via Keyboard -> Click Enter -> Select item with arrow keys -> Press Enter";
    [Parameter]
    public bool DisableMenu { get; set; }

    public int? LastInvokedIndex { get; private set; }

    private void InvokeItem(int index)
    {
        LastInvokedIndex = index;
        StateHasChanged();
    }
}
