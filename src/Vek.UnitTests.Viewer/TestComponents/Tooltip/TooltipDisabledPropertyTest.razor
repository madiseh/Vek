<VekPopoverProvider />

<VekTooltip Arrow Disabled="@TooltipDisabled" ShowOnHover="@ShowOnHover" ShowOnFocus="@ShowOnFocus">
    <ChildContent>
        <VekButton Disabled="@ButtonDisabled">My Button</VekButton>
    </ChildContent>
    <TooltipContent>
        <div id="my-tooltip-content">
            <p>Some Text</p>
        </div>
    </TooltipContent>
</VekTooltip>

<VekStack Row>
    <VekSwitch @bind-Value="@ShowOnHover">ShowOnHover: @ShowOnHover</VekSwitch>
    <VekSwitch @bind-Value="@ShowOnFocus">ShowOnFocus: @ShowOnFocus</VekSwitch>
</VekStack>
<VekStack Row>
    <VekSwitch @bind-Value="@TooltipDisabled">Tooltip disabled: @TooltipDisabled</VekSwitch>
    <VekSwitch @bind-Value="@ButtonDisabled">Button disabled: @ButtonDisabled</VekSwitch>
</VekStack>

@code
{
    public static string __description__ = "Test used to validate a disabled tooltip";

    [Parameter]
    public bool TooltipDisabled { get; set; }

    [Parameter]
    public bool ButtonDisabled { get; set; }

    [Parameter]
    public bool ShowOnHover { get; set; } = true; // Default

    [Parameter]
    public bool ShowOnFocus { get; set; } = true; // Default
}
