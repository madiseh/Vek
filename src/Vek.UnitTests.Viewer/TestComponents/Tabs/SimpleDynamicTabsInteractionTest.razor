<VekDynamicTabs CloseIconClass="my-close-icon-class" CloseTab="OnCloseClicked"
                AddIconClass="my-add-icon-class" AddTab="OnAddClicked">
    <VekTabPanel Text="Tab A">
        Content A
    </VekTabPanel>
    <VekTabPanel Text="Tab B">
        Content B
    </VekTabPanel>
    <VekTabPanel Text="Tab C">
        Content C
    </VekTabPanel>
</VekDynamicTabs>

@code {
    public int AddClickCounter { get; private set; }

    public HashSet<VekTabPanel> CloseClicked { get; } = [];

    private void OnAddClicked()
    {
        AddClickCounter++;
    }

    private void OnCloseClicked(VekTabPanel panel)
    {
        CloseClicked.Add(panel);
    }
}
