<VekButton OnClick="AddTab">Add Tab</VekButton>
<VekButton OnClick="RemoveLast">Remove Last</VekButton>

<VekTabs Elevation="1" @ref="Tabs">
    @foreach (var tab in _tabs)
    {
        <VekTabPanel @key="tab" Text="@tab">
            <VekText>@tab</VekText>
        </VekTabPanel>
    }    
</VekTabs>

@code
{
    public static string __description__ = "Adding and removing tabs should work";

    private List<string> _tabs = new List<string>();
    private int i = 0;

    public VekTabs Tabs { get; set; } = null!;

    private async Task AddTab()
    {
        _tabs.Add($"Tab {i++}");
        await InvokeAsync(StateHasChanged);
    }

    private async Task RemoveLast()
    {
        if(_tabs.Any())
        {
            _tabs.RemoveAt(_tabs.Count - 1);
            await InvokeAsync(StateHasChanged);
        }
    }
}
