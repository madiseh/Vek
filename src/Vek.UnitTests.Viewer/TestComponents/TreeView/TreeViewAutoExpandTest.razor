<VekTreeView @ref="_treeView" Hover AutoExpand="@AutoExpand" @bind-SelectedValue="SelectedValue" SelectionMode="@SelectionMode.ToggleSelection">
    <VekTreeViewItem Value='"C:"' Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
        <VekTreeViewItem Value='"config"' CanExpand="@ConfigCanExpand" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <VekTreeViewItem Value='"launch.json"' Icon="@Icons.Custom.FileFormats.FileCode" />
            <VekTreeViewItem Value='"tasks.json"' Icon="@Icons.Custom.FileFormats.FileCode" />
        </VekTreeViewItem>
        <VekTreeViewItem Value='"images"' Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <VekTreeViewItem Value='"logo.png"' Icon="@Icons.Custom.FileFormats.FileImage" />
        </VekTreeViewItem>
    </VekTreeViewItem>
</VekTreeView>

<VekStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <VekButton Class="expand-all" Color="Color.Primary" OnClick="@(() => _treeView.ExpandAllAsync())" Variant="Variant.Filled">Expand All</VekButton>
    <VekButton Class="collapse-all" Color="Color.Dark" OnClick="@(() => _treeView.CollapseAllAsync())" Variant="Variant.Filled">Collapse All</VekButton>
    <VekChipSet T="string" @bind-SelectedValue="SelectedValue" Color="Color.Primary" Variant="Variant.Text" SelectionMode="@SelectionMode.ToggleSelection">
        <VekChip Text="config" />
        <VekChip Text="launch.json" />
        <VekChip Text="tasks.json" />
        <VekChip Text="images" />
        <VekChip Text="logo.png" />
    </VekChipSet>
    <VekSwitch @bind-Value="AutoExpand" Color="Color.Primary">AutoExpand</VekSwitch>
</VekStack>

@code {
    private VekTreeView<string> _treeView = null!;

    [Parameter]
    public string? SelectedValue { get; set; }

    [Parameter]
    public bool AutoExpand { get; set; } = true;

    [Parameter]
    public bool ConfigCanExpand { get; set; } = true;

}