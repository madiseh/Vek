<VekPaper Width="300px" Elevation="0">
    <VekTreeView T="string" Hover SelectionMode="@SelectionMode.ToggleSelection" Color="Color.Tertiary">
        <VekTreeViewItem Class="item-config" Text="config" @bind-Expanded="_configExpanded" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <VekTreeViewItem Class="item-launch" Text="launch.json" @bind-Selected="_launchSelected" Icon="@Icons.Custom.FileFormats.FileCode" />
            <VekTreeViewItem Class="item-tasks" Text="tasks.json" @bind-Selected="_tasksSelected" Icon="@Icons.Custom.FileFormats.FileCode" />
        </VekTreeViewItem>
        <VekTreeViewItem Class="item-images" Text="images" @bind-Expanded="_imagesExpanded" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <VekTreeViewItem Class="item-logo" Text="logo.png" @bind-Selected="_logoSelected" Icon="@Icons.Custom.FileFormats.FileImage" />
        </VekTreeViewItem>
    </VekTreeView>
</VekPaper>

<VekStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <VekSwitch Class="switch-config" @bind-Value="_configExpanded" Color="Color.Tertiary">config</VekSwitch>
    <VekSwitch Class="switch-images" @bind-Value="_imagesExpanded" Color="Color.Tertiary">images</VekSwitch>
    <VekCheckBox Class="checkbox-launch" @bind-Value="_launchSelected" Color="Color.Tertiary">launch.json</VekCheckBox>
    <VekCheckBox Class="checkbox-tasks" @bind-Value="_tasksSelected" Color="Color.Tertiary">tasks.json</VekCheckBox>
    <VekCheckBox Class="checkbox-logo" @bind-Value="_logoSelected" Color="Color.Tertiary">logo.png</VekCheckBox>
</VekStack>

@code {
    private bool _configExpanded;
    private bool _imagesExpanded;
    private bool _launchSelected = true;
    private bool _tasksSelected;
    private bool _logoSelected;
}