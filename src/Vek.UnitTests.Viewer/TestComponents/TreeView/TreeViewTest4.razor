<VekTreeView @ref="_treeView" T="string" @bind-SelectedValue="SelectedValue" SelectionMode="SelectionMode.ToggleSelection">
    <VekTreeViewItem @ref="_item1" Value='"content"' />
    <VekTreeViewItem @ref="_item2" Value='"src"' />
</VekTreeView>

@code {
    private VekTreeView<string> _treeView = null!;
    private VekTreeViewItem<string> _item1 = null!;
    private VekTreeViewItem<string> _item2 = null!;

    public string? SelectedValue { get; set; }

    public Task ClickFirst() => _treeView.OnItemClickAsync(_item1);

    public Task ClickSecond() => _treeView.OnItemClickAsync(_item2);
}