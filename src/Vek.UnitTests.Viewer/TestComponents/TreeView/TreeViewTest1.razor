<VekTreeView T="string" @bind-SelectionMode="SelectionMode" @bind-SelectedValue="SelectedValue">
    <VekTreeViewItem Value='"content"' @bind-Selected="Item1Selected">
        <VekTreeViewItem Value='"logo.png"' />
        <VekTreeViewItem Value='"Vek.svg"' @bind-Selected="SubItemSelected" />
        <VekTreeViewItem Value='"Nuget.png"' />
    </VekTreeViewItem>
    <VekTreeViewItem Value='"src"' @bind-Selected="Item2Selected">
        <VekTreeViewItem Value='"Vek"' />
        <VekTreeViewItem Value='"Vek.Docs"'>
            <VekTreeViewItem Value='"wwwroot"'>
                <VekTreeViewItem Value='"VekAppbarCorner.svg"' />
                <VekTreeViewItem Value='"VekDocs.min.css"' />
            </VekTreeViewItem>
        </VekTreeViewItem>
    </VekTreeViewItem>
</VekTreeView>

@code{

    [Parameter]
    public SelectionMode SelectionMode { get; set; } = SelectionMode.MultiSelection;

    public string? SelectedValue { get; set; }

    public bool SubItemSelected { get; set; }

    public bool Item1Selected { get; set; }

    public bool Item2Selected { get; set; }
}