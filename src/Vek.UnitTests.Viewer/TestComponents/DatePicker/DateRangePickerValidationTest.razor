<VekPopoverProvider />

<VekForm @ref="_form" IsValidChanged="@(HandleFormValidChanged)">
    <VekPaper>
        @($"Status: {_submitStatus ?? "Not yet submitted/validated"}")
    </VekPaper>
    
    <VekDateRangePicker id="dateRangeLabelTest" @ref="@(_picker)" @bind-DateRange="@(_dateRange)" Label="Select Date Range" Required="true" RequiredError="This field is required!">
        <PickerActions>
            <VekButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Clear</VekButton>
            <VekButton OnClick="@(() => _picker.CloseAsync(false))">Cancel</VekButton>
            <VekButton Color="Color.Primary" OnClick="@(() => _picker.CloseAsync())">OK</VekButton>
        </PickerActions>
    </VekDateRangePicker>

    <VekButton Class="mt-2" OnClick="@(() => _form.ValidateAsync())">Validate</VekButton>
</VekForm>

@code {
    public static string __description__ = $"The {nameof(VekDateRangePicker)} should shown an error when clicking validate without any data but this should disappear when a value has been set.";

    private VekForm _form = null!;
    private VekDateRangePicker _picker = null!;
    private string? _submitStatus;
    private DateRange? _dateRange; // = new(DateTime.Now, DateTime.Now.AddDays(2));

    private void HandleFormValidChanged(bool isValid)
    {
        _submitStatus = $"Form is {(isValid ? string.Empty : "in")}valid";
    }
}