<VekPopoverProvider/>

<VekDateRangePicker id="picker" @ref="_picker" Label="With action buttons" @bind-DateRange="DateRange">
    <PickerActions>
        <VekButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync(CloseOnClear))">Clear</VekButton>
    </PickerActions>
</VekDateRangePicker>

@code {
    private VekDateRangePicker _picker = null!;

    [Parameter]
    public DateRange? DateRange { get; set; }

    [Parameter]
    public bool CloseOnClear { get; set; }
}