<VekPopoverProvider />

<VekDatePicker id="picker" @ref="PickerReference" Label="With action buttons" PickerVariant="PickerVariant.Static" @bind-Date="Date">
    <PickerActions>
        <VekButton Class="mr-auto align-self-start" OnClick="@(() => PickerReference.ClearAsync())">Clear</VekButton>
        <VekButton OnClick="@(() => PickerReference.CloseAsync(false))">Cancel</VekButton>
        <VekButton Color="Color.Primary" OnClick="@(() => PickerReference.CloseAsync())">OK</VekButton>
    </PickerActions>
</VekDatePicker>

@code {
    [Parameter]
    public DateTime? Date { get; set; } = DateTime.Today.Subtract(TimeSpan.FromDays(60));

    public VekDatePicker PickerReference { get; set; } = null!;
}