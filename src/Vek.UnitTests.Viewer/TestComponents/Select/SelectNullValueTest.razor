<VekPopoverProvider />

<VekSelect @bind-Value="_value" Label="Select">
    <VekSelectItem T="@(int?)" Value="@(null)">None</VekSelectItem>
    <VekSelectItem T="@(int?)" Value="@(1)">One</VekSelectItem>
    <VekSelectItem T="@(int?)" Value="@(2)">Two</VekSelectItem>
</VekSelect>

@code {
    public static string __description__ =
        "When the select has a null value, the text should be displayed, and the vek-shrink class should be applied.";

    private int? _value;
}
