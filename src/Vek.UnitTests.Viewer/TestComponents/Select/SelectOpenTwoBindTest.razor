<VekPopoverProvider />

<VekSelect T="string" @bind-Value="@_value" @bind-Open="@Open">
    <VekSelectItem Value="@("1")">1</VekSelectItem>
    <VekSelectItem Value="@("2")">2</VekSelectItem>
    <VekSelectItem Value="@("3")">3</VekSelectItem>
</VekSelect>

<VekSwitch id="switch" Color="Color.Primary" @bind-Value="@Open" Label="Open" />

@code {
    public static string __description__ = "Tests Open two-way bind.";

    private string? _value = null;

    public bool Open { get; private set; }
}
