<VekPopoverProvider />

<VekSelect @bind-Value="_value" PopoverClass="select-popover-class" @onfocus="Focused" OnBlur="Blurred">
    <VekSelectItem Value="@("1")"/>
    <VekSelectItem Value="@("2")"/>
    <VekSelectItem Value="@("3")"/>
    <VekSelectItem Value="@("4")" Disabled="true"/>
</VekSelect>

<VekSwitch id="switch" @bind-Value="@_focused" />

@code {
    public static string __description__ = "Click should open the Menu and selecting a value should update the bindable value.";

    private string? _value = null;
    private bool _focused;

    private void Focused()
    {
        _focused = true;
    }

    private void Blurred()
    {
        _focused = false;
    }
}
