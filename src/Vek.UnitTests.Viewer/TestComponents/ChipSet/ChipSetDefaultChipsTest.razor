<VekChipSet @bind-SelectedValue="_selectedValue" @bind-SelectedValues="_selectedValues" SelectionMode="@SelectionMode" CheckMark="_checkMark">
    <VekChip Value="@("Milk")" Default="true" />
    <VekChip Value="@("Eggs")" />
    <VekChip Value="@("Soap")" Default="false" />
    <VekChip Value="@("Corn flakes")" Default="true" />
    <VekChip Value="@("Salad")" />
    <VekChip Value="@("Apples")" />
    <VekChip Value="@("Red wine")" />
</VekChipSet>

<div class="selected-value">
    <VekText>@_selectedValue</VekText>
</div>
<div class="selected-values">
    @if (_selectedValues is { Count: > 0 }) {
        <VekText>@string.Join(", ", _selectedValues.OrderBy(x => x))</VekText>
    }
    else {
        <VekText>Nothing selected</VekText>
    }
</div>

<VekCheckBox @bind-Value="_checkMark">CheckMark</VekCheckBox>

@code
{
    [Parameter]
    public SelectionMode SelectionMode { get; set; } = SelectionMode.ToggleSelection;

    [Parameter]
    public string[]? InitialValues { get; set; }

    private bool _checkMark = false;
    private IReadOnlyCollection<string>? _selectedValues;
    private string? _selectedValue;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _selectedValues = InitialValues;
    }
}