<VekChipSet @bind-SelectedValue="_selectedValue" @bind-SelectedValues="_selectedValues" SelectionMode="SelectionMode.MultiSelection">
    <VekChip Value="@("Milk")" />
    <VekChip Value="@("Eggs")" />
    <VekChip Value="@("Soap")" />
    <VekChip Value="@("Corn flakes")" />
    <VekChip Value="@("Salad")" />
    <VekChip Value="@("Apples")" />
    <VekChip Value="@("Red wine")" />
</VekChipSet>

<div class="selected-value">
    <VekText>@_selectedValue</VekText>
</div>
<div class="selected-values">
    @if (_selectedValues is { Count: > 0 }) {
        <VekText>@string.Join(", ", _selectedValues)</VekText>
    }
    else {
        <VekText>Nothing selected</VekText>
    }
</div>

@code
{
    private string? _selectedValue;
    private IReadOnlyCollection<string>? _selectedValues;

    [Parameter]
    public string[]? InitialValues { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _selectedValues = InitialValues;
    }
}