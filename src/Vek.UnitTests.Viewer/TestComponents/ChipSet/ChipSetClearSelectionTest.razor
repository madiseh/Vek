<VekChipSet @bind-SelectedValues="_selected" SelectionMode="SelectionMode.MultiSelection">
    <VekChip Value="@("Milk")"/>
    <VekChip Value="@("Eggs")"/>
    <VekChip Value="@("Soap")"/>
    <VekChip Value="@("Corn flakes")"/>
    <VekChip Value="@("Salad")"/>
    <VekChip Value="@("Apples")"/>
    <VekChip Value="@("Red wine")"/>
</VekChipSet>

@if (_selected is { Count: > 0 }) {
    <VekText>@string.Join(", ", _selected.OrderBy(x => x))</VekText>
}
else {
    <VekText>Nothing selected.</VekText>
}
<VekButton id="set-null" OnClick="SetNull">Set Null</VekButton>
<VekButton id="set-empty" OnClick="SetEmpty">Set Empty</VekButton>
@code
{
    private IReadOnlyCollection<string>? _selected;

    private void SetNull() => _selected = null;

    private void SetEmpty() => _selected = Array.Empty<string>();
}