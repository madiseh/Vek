<VekRTLProvider RightToLeft=@_rightToLeft>
    <div class="d-flex mb-3">
        <VekButtonGroup Color="Color.Dark" Variant="Variant.Filled">
            <VekTooltip Text="Open 1"><VekButton>1</VekButton></VekTooltip>
            <VekTooltip Text="Open 2"><VekButton>2</VekButton></VekTooltip>
            <VekTooltip Text="Open 3"><VekButton>3</VekButton></VekTooltip>
        </VekButtonGroup>
    </div>

    <div class="d-flex mb-3">
        <VekButtonGroup Color="Color.Dark" Variant="Variant.Filled">
            <VekTooltip Text="Open 1"><VekIconButton Icon="@Icons.Material.Filled.Edit" aria-label="Edit" /></VekTooltip>
            <VekTooltip Text="Open 2"><VekButton>Save</VekButton></VekTooltip>
            <VekTooltip Text="Open 3"><VekIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Delete" /></VekTooltip>
        </VekButtonGroup>
    </div>

    <div class="d-flex mr-3">
        <VekButtonGroup Color="Color.Dark" Variant="Variant.Filled" Vertical="true" Style="margin-right: 4px">
            <VekTooltip Text="Open 1"><VekButton>1</VekButton></VekTooltip>
            <VekTooltip Text="Open 2"><VekButton>2</VekButton></VekTooltip>
            <VekTooltip Text="Open 3"><VekButton>3</VekButton></VekTooltip>
        </VekButtonGroup>
    </div>
</VekRTLProvider>

<VekSwitch @bind-Value="@_rightToLeft" Label="Toggle Right to Left" Color="Color.Primary" />

@code
{
    private bool _rightToLeft;
    public static string __description__ = "The button group rounded corners and dividers should still work when using tooltips.";
}
