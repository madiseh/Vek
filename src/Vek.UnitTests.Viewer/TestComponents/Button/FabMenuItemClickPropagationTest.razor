<VekPaper @onclick="@(() => ContainerClickedCount += 1)">
    <VekFabMenu ClickPropagation="@ClickPropagation">
        <VekFabMenuItem OnClick="@(() => ItemClickedCount += 1)" />
    </VekFabMenu>
</VekPaper>

@code {
    [Parameter]
    public bool ClickPropagation { get; set; }
    public int ItemClickedCount { get; set; }
    public int ContainerClickedCount { get; set; }
}
