<VekList T="string" @bind-SelectedValue="_selectedValue" SelectionMode="@SelectionMode">
    <VekListSubheader>
        Your drink:
        <VekChip Color="Color.Secondary">
            @(_selectedValue ?? "You are dry")
        </VekChip>
    </VekListSubheader>
    <VekListItem Text="Sparkling Water" />
    <VekListItem Text="Teas">
        <NestedList>
            <VekListItem Text="Earl Grey" />
            <VekListItem Text="Matcha" />
            <VekListItem Text="Pu'er" />
        </NestedList>
    </VekListItem>
    <VekListItem Text="Coffees">
        <NestedList>
            <VekListItem Text="Irish Coffee" />
            <VekListItem Text="Double Espresso" />
            <VekListItem Text="Cafe Latte" />
        </NestedList>
    </VekListItem>
</VekList>

@code {
    public static string __description__ = "Clicking the drinks selects them. The child lists are updated accordingly.";
    
    private string? _selectedValue;

    [Parameter]
    public SelectionMode SelectionMode { get; set; } = SelectionMode.SingleSelection;
}