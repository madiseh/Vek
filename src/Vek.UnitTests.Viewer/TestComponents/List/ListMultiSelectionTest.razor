<VekList T="string" @bind-SelectedValues="SelectedValues" SelectionMode="SelectionMode.MultiSelection">
    <VekListSubheader>
        Select your favourite drinks:
    </VekListSubheader>
    <VekListItem Text="Milk" />
    <VekListItem Text="Sparkling Water" Value='"Carbonated H²O"' />
    <VekListItem Text="Teas">
        <NestedList>
            <VekListItem Text="English Tea" Value='"Earl Grey"' />
            <VekListItem Text="Japanese Tea" Value='"Matcha"' />
            <VekListItem Text="Chinese Tea" Value='"Wu Long Cha"' />
        </NestedList>
    </VekListItem>
    <VekListItem Text="Coffees">
        <NestedList>
            <VekListItem Text="Irish Coffee" />
            <VekListItem Text="Double Espresso" />
            <VekListItem Text="Cafe Latte" />
        </NestedList>
    </VekListItem>
    <VekListItem Text="Juices">
        <NestedList>
            <VekListItem Text="Apple Juice" Disabled="true" />
            <VekListItem Text="Orange Juice" Disabled="true" />
        </NestedList>
    </VekListItem>
</VekList>

<p class="selected-values">
    @(string.Join(", ", (SelectedValues ?? Array.Empty<string>()).OrderBy(x => x)))
</p>

@code {
    [Parameter]
    public IReadOnlyCollection<string>? SelectedValues { get; set; }
}
