<VekButton id="change-max-button" OnClick="ChangeMax" Variant="Variant.Filled" Class="mb-4">ChangeMax</VekButton><VekText>Max: @Max</VekText>
<VekAvatarGroup Max="@Max" MaxColor="Color.Primary">
    <VekAvatar Color="Color.Primary">AA</VekAvatar>
    <VekAvatar Color="Color.Secondary">BB</VekAvatar>
    <VekAvatar Color="Color.Tertiary">CC</VekAvatar>
    <VekAvatar Color="Color.Info">DD</VekAvatar>
    <VekAvatar Color="Color.Secondary">FF</VekAvatar>
    <VekAvatar Color="Color.Warning">GG</VekAvatar>
    <VekAvatar Color="Color.Error">HH</VekAvatar>
</VekAvatarGroup>

@code {
    public static string __description__ = "Clicking the button should change the max numbers of avatars.";

    public int Max { get; set; } = 3;

    private void ChangeMax()
    {
        if (Max == 7)
        {
            Max = 0;
        }
        else
        {
            Max++;
        }
    }
}