<VekFileUpload T="IBrowserFile" Disabled="Disabled">
    <CustomContent>
        <VekButton OnClick="@context.OpenFilePickerAsync">
            Upload
        </VekButton>
    </CustomContent>
</VekFileUpload>

@code {
    public static string __description__ = "Tests that file upload respects the disabled state with custom activator content.";

    [Parameter]
    public bool Disabled { get; set; }
}
