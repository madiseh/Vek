@using Vek
@using System.Collections.Generic
@using Vek.Utilities

<VekDataGrid T="Model" Items="@Items" ExpandSingleRow="@ExpandSingleRow" HierarchyVisibilityToggled="@OnHierarchyVisibilityToggled">
    <Columns>
        <HierarchyColumn />
        <PropertyColumn Property="x => x.Name" />
        <PropertyColumn Property="x => x.Age" />
    </Columns>
    <ChildRowContent>
        <VekText>Child content for @context.Item.Name</VekText>
    </ChildRowContent>
</VekDataGrid>

@code {
    public record Model(string Name, int Age);

    [Parameter]
    public bool ExpandSingleRow { get; set; }

    public List<Model> Items = new()
    {
        new Model("John", 25),
        new Model("Jane", 30),
        new Model("Bob", 35)
    };

    public List<DataGridHierarchyVisibilityToggledEventArgs<Model>> ToggledEvents = [];

    private Task OnHierarchyVisibilityToggled(DataGridHierarchyVisibilityToggledEventArgs<Model> args)
    {
        ToggledEvents.Add(args);
        return Task.CompletedTask;
    }
}
