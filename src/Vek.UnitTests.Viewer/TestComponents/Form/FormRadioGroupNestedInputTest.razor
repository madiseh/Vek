@using Vek.Utilities
<VekFormTestable ValidationDelay="0" FieldChanged="OnFieldChanged">
    <VekRadioGroup T="string" @bind-Value="_choice">
        <VekRadio Value="@("A")">Option A</VekRadio>
        <VekRadio Value="@("B")">Option B</VekRadio>
        <VekTextField T="string" @bind-Value="_detail" Required="true" RequiredError="Detail is required" Label="Detail" />
    </VekRadioGroup>
</VekFormTestable>

@code {
    public static string __description__ = "#11540: an input nested inside a VekRadioGroup must register with the surrounding VekForm; individual radios must not.";

    public List<string> FieldChangedFieldTypes { get; } = new();

    private string? _choice;
    private string? _detail;

    private void OnFieldChanged(FormFieldChangedEventArgs args)
        => FieldChangedFieldTypes.Add(args.Field?.GetType().Name ?? "(null)");
}
