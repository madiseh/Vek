<div style="max-width: 400px;">
    <VekCard>
        <VekCardContent>
            <VekForm>

                <VekTextField T="string" Variant="Variant.Outlined" @bind-Value="@_catName" Label="Cat Name"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Info" />

                <VekTextField T="string" Variant="Variant.Outlined" @bind-Value="@_ownerName" Label="Owner Name"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Info" />


                <VekTextField T="int" Variant="Variant.Outlined" @bind-Value="@_catWeight" Label="Weight"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Info" />

                <VekCheckBox @bind-Value="@_evilCheckBox" Label="Evil"></VekCheckBox>

            </VekForm>
        </VekCardContent>
        <VekCardActions>
            <VekButton Variant="Variant.Filled" Color="Color.Primary"  Class="ml-auto">Buy Cat</VekButton>
        </VekCardActions>
    </VekCard>
</div>
@code {

    public static string __description__ = "Based on error report. Clicking the checkbox should not influence the other form fields.";

    private string? _catName;
    private string? _ownerName;
    private int _catWeight;
    private bool _evilCheckBox  = true;
}
