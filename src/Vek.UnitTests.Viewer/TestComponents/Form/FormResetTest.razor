<VekForm @ref="_form" ValidationDelay="0">
    <VekDatePicker Label="Date" Required @bind-Date="@_date" Editable></VekDatePicker>
    <VekTextField Label="Name" T="string" Required Immediate @bind-Value="@_name" />
    <VekNumericField Label="Age" T="int?" Required Immediate @bind-Value="@_age"></VekNumericField>
    <VekDateRangePicker Label="Date Range" @bind-DateRange="@_dateRange" />
</VekForm>
<br><br>
<span>Date: @_date</span>
<span>Name: @_name</span>
<span>Age: @_age</span>
<br><br>
<VekButton Class="reset" OnClick="@ResetFormAsync">Reset</VekButton>

@code {
    public static string __description__ = "Calling Form.Reset() should clear the text field.";

    private int? _age;
    private string? _name;
    private DateTime? _date;
    private DateRange? _dateRange;
    private VekForm _form = null!;

    private async Task ResetFormAsync()
    {
        await _form.ResetAsync();
        StateHasChanged();
    }
}
