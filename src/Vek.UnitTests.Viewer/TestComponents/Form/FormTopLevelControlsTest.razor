<VekFormTestable ValidationDelay="0">
    <VekInput T="string"></VekInput>
    <VekInputString></VekInputString>

    <VekTextField T="string"></VekTextField>

    <VekNumericField T="decimal"></VekNumericField>

    <VekRangeInput T="string"></VekRangeInput>

    <VekRadioGroup T="string">
        <VekRadio Value="@("A")">Option A</VekRadio>
        <VekRadio Value="@("B")">Option B</VekRadio>
    </VekRadioGroup>

    <VekDateRangePicker></VekDateRangePicker>
    <VekDatePicker></VekDatePicker>
    <VekTimePicker></VekTimePicker>

    <VekCheckBox T="bool"></VekCheckBox>
    <VekSwitch T="bool" />
    <VekBooleanInput T="bool"></VekBooleanInput>

    <VekColorPicker></VekColorPicker>
</VekFormTestable>

@code {
    public static string __description__ = "Only the top SubscribeToParentForm fields should be registered inside the form.";
}
