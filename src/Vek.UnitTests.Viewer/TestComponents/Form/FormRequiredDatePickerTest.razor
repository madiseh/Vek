<VekForm @ref="Form" @bind-IsValid="IsValid" ValidationDelay="0">
    <VekTextField T="string" @bind-Value="Name" Required="true" RequiredError="Name is required" />
    <VekDatePicker @bind-Date="Date" Required="true" RequiredError="Date is required" />
</VekForm>

@code {
    public static string __description__ = "#12400: a required VekDatePicker must be checked by VekForm.IsValid — empty is invalid on load, a preset date is valid on load.";

    public VekForm Form { get; set; } = null!;
    public bool IsValid { get; set; }

    [Parameter] public string? Name { get; set; }
    [Parameter] public DateTime? Date { get; set; }
}
