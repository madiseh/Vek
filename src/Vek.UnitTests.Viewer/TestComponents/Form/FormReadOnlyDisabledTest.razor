<div style="max-width: 400px;">
    <VekCard>
        <VekCardContent>
            <VekForm ReadOnly="FormReadOnly" Disabled="FormDisabled">
                <VekTextField T="string" ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekTextField T="string" Mask="@(new DateMask(" yyyy-MM-dd"))" ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekCheckBox T="bool" ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekRadioGroup T="string" ReadOnly="CompReadOnly" Disabled="CompDisabled">
                    <VekRadio Value="@("1")" />
                    <VekRadio Value="@("2")" />
                </VekRadioGroup>
                <VekSelect T="string" ReadOnly="CompReadOnly" Disabled="CompDisabled"></VekSelect>
                <VekSwitch T="bool" ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekColorPicker ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekDatePicker ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekDateRangePicker ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekTimePicker ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekAutocomplete T="string" ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekNumericField T="int" ReadOnly="CompReadOnly" Disabled="CompDisabled" />
                <VekFileUpload T="IBrowserFile" Disabled="CompDisabled">
                    <CustomContent>
                        <VekButton Variant="Variant.Filled"
                                   Color="Color.Primary">
                            Disabled Button
                        </VekButton>
                    </CustomContent>
                </VekFileUpload>
            </VekForm>
        </VekCardContent>
        <VekCardActions>
            <VekCheckBox @bind-Value="FormReadOnly">Form ReadOnly</VekCheckBox>
            <VekCheckBox @bind-Value="CompReadOnly">Comp ReadOnly</VekCheckBox>
            <VekCheckBox @bind-Value="FormDisabled">Form Disabled</VekCheckBox>
            <VekCheckBox @bind-Value="CompDisabled">Comp Disabled</VekCheckBox>
        </VekCardActions>
    </VekCard>
</div>
@code {
    public static string __description__ = "All child form fields should be disabled or readonly if the Form property is changed";
    
    [Parameter]
    public bool FormReadOnly { get; set; }

    [Parameter]
    public bool CompReadOnly { get; set; }

    [Parameter]
    public bool FormDisabled { get; set; }

    [Parameter]
    public bool CompDisabled { get; set; }
}
