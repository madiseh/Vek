<div class="d-flex">
    <VekButton OnClick="OpenDialog" Variant="Variant.Filled" Color="Color.Primary">
        Open dialog
    </VekButton>
</div>

<VekDialog @bind-Visible="_visible">
    <TitleContent>
        <VekText Typo="Typo.h6">
            <VekIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3"/> Edit rating
        </VekText>
    </TitleContent>
    <DialogContent>
        <p>Close and re-open me by clicking out of the dialog. </p>
    </DialogContent>
    <DialogActions>
    </DialogActions>
</VekDialog>

@code { 
    private bool _visible;

    private void OpenDialog() => _visible = true;
}
