@attribute [ViewerHidden]

<VekDialog>
    <DialogContent>
        Dialog Content
        <VekTextField T="string" Immediate TextChanged="@OnTextChangedAsync" />
        <div @onclick="OnClick">
            Click here!
        </div>
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="Cancel">Cancel</VekButton>
        <VekButton Color="Color.Primary" OnClick="Submit">OK</VekButton>
    </DialogActions>
</VekDialog>

@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; } = null!;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private void Submit() => VekDialog.Close(DialogResult.Ok(true));

    private void Cancel() => VekDialog.Cancel();

    private Task OnTextChangedAsync(string text) => OnSearch.InvokeAsync(text);
}
