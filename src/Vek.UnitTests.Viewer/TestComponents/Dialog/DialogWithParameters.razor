<VekDialog>
    <DialogContent>
        <VekInput @bind-Value="TestValue" />
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="OnTest" Variant="Variant.Filled" Color="Color.Primary" Class="mr-auto">Test</VekButton>
        <VekButton OnClick="() => VekDialog.Close()">Close</VekButton>
    </DialogActions>
</VekDialog>

@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; } = null!;

    [Parameter]
    public string? TestValue { get; set; }

    [Parameter]
    public Color ColorTest { get; set; }

    public int ParametersSetCounter { get; private set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        ParametersSetCounter++;
    }

    private void OnTest()
    {
        VekDialog.StateHasChanged();
        StateHasChanged();
    }
}