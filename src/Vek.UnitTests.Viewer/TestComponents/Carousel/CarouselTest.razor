<VekCarousel @bind-SelectedIndex="SelectedIndex" Style="height:200px;" ShowArrows ArrowsPosition="Position.Top" BulletsPosition="Position.Start" ShowBullets AutoCycle="false" AutoCycleTime="TimeSpan.FromMilliseconds(500)" TData="object">
    <VekCarouselItem Class="fake-class-item1" Transition="Transition.Slide">
        <div class="d-flex" style="background-color:#594AE2; height:100%">
            <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Size="@Size.Large" />
        </div>
    </VekCarouselItem>
    <VekCarouselItem Class="fake-class-item2" Transition="Transition.Slide">
        <div class="d-flex" style="background-color:#FF4081; height:100%">
            <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Size="@Size.Large" />
        </div>
    </VekCarouselItem>
    <VekCarouselItem Class="fake-class-item3" Transition="Transition.Slide">
        <div class="d-flex" style="background-color:lightgray; height:100%">
            <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Color="@Color.Primary" Size="@Size.Large" />
        </div>
    </VekCarouselItem>
</VekCarousel>

@code {
    public int SelectedIndex { get; set; }
}