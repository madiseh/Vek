@using Vek.Utilities

<div data-testid="broken">
    <VekColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_broken" />
</div>

<div data-testid="alpha">
    <VekColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_alpha" />
</div>

<div data-testid="lightness">
    <VekColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_lightness" />
</div>

<div data-testid="pseudo">
    <VekColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_pseudo" />
</div>

<div data-testid="async">
    <VekColorPicker PickerVariant="PickerVariant.Static" @bind-Value="_async" />
</div>

@code {
    private const string __description__ = "Regression coverage for https://github.com/madiseh/vek/issues/13037 after the null-value startup path introduced by https://github.com/madiseh/vek/pull/12567 became reachable.";
    private VekColor _broken = "#00000088";
    private VekColor _alpha = "#00000188";
    private VekColor _lightness = "#ff0000ff";
    private VekColor _pseudo = "#ff000088";
    private VekColor _async = "#ff000088";

    protected override async Task OnInitializedAsync()
    {
        _pseudo = new VekColor("#0f0f");
        await Task.Yield();
        _async = new VekColor("#00ff");
    }
}
