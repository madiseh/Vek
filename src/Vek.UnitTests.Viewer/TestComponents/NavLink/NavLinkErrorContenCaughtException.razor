<ErrorBoundary>
    <ChildContent>
        <VekNavMenu Margin="Margin.Dense" Color="Color.Warning">
            <VekNavLink OnClick="HandleClickAsync">
                Clickable Link
            </VekNavLink>
        </VekNavMenu>
    </ChildContent>
    <ErrorContent>
        <VekAlert Severity="Severity.Error">Oh my! We caught an error and handled it!</VekAlert>
    </ErrorContent>
</ErrorBoundary>

@code {
    public async Task HandleClickAsync()
    {
        await Task.Delay(100);
        throw new Exception("Something went wrong...");
    }
}