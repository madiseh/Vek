<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(PrimaryTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableNUnitRunner>true</EnableNUnitRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Vek.UnitTests.Shared" />
    <Using Include="Vek.UnitTests.Shared.Mocks" />
    <Using Include="Vek.UnitTests.Shared.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="JunitXml.TestLogger" Version="8.1.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <!-- Microsoft.CodeAnalysis.Analyzer.Testing is provided transitively by the two packages below
         (CSharp.Analyzer.Testing -> Analyzer.Testing; CSharp.CodeFix.Testing -> CodeFix.Testing ->
         Analyzer.Testing), so it is not referenced directly. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vek.Analyzers.TestComponents\Vek.Analyzers.TestComponents.csproj" />
    <ProjectReference Include="..\Vek.Analyzers\Vek.Analyzers.csproj">
      <!-- Some namespaces are matching with the core, we must use alias -->
      <Aliases>VekAnalyzer</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\Vek.Analyzers.CodeFixes\Vek.Analyzers.CodeFixes.csproj">
      <Aliases>VekAnalyzer</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\Vek.UnitTests.Shared\Vek.UnitTests.Shared.csproj" />
  </ItemGroup>

</Project>
