@namespace Vek
@inherits VekComponentBase
@using Vek.Resources
@inject InternalVekLocalizer Localizer
@inject TimeProvider TimeProvider

<div @attributes="UserAttributes"
     id="@_elementId"
     class="@Classname"
     style="@Style"
     tabindex="0"
     role="region"
     aria-label="@AriaLabel"
     @onkeydown="HandleKeyDownAsync">
    <div class="vek-picker-container @(Orientation == Orientation.Landscape ? "vek-picker-container-landscape" : "")">
        @if (ShowToolbar)
        {
            <VekPickerToolbar Class="vek-picker-datepicker-toolbar"
                              ShowToolbar="@ShowToolbar"
                              Orientation="@Orientation"
                              PickerVariant="@PickerVariant"
                              Color="@Color"
                              @onmousedown:preventDefault="true">
                <VekButton Variant="Variant.Text" Color="Color.Inherit" Class="vek-button-year" OnClick="GoToSelectedYear">
                    @GetFormattedYearString()
                </VekButton>
                <VekButton Variant="Variant.Text" Color="Color.Inherit" Class="vek-button-date" OnClick="OnFormattedDateClick">
                    @GetTitleDateString()
                </VekButton>
            </VekPickerToolbar>
        }
        <div class="vek-picker-content">
            <div class="vek-picker-calendar-content vek-picker-calendar-content-1" @onmousedown:preventDefault="true">
                <div class="vek-picker-calendar-container">
                    @if (_viewMode == CalendarViewMode.Years || _viewMode == CalendarViewMode.Decades)
                    {
                        @if (_viewMode == CalendarViewMode.Decades)
                        {
                            <div class="vek-picker-calendar-header">
                                <button type="button" class="vek-picker-calendar-header-transition" @onclick="OnYearGridClick">@GetDecadeStart()s</button>
                            </div>
                            <div class="vek-picker-year-container" role="grid" aria-label="Choose decade">
                                @foreach (var decade in GetDisplayedYears().Where(y => y % 10 == 0))
                                {
                                    <button type="button" class="vek-picker-year" aria-label="@($"{decade}s")" @onclick="() => SelectYearAsync(decade)" @onclick:stopPropagation="true">@($"{decade}s")</button>
                                }
                            </div>
                        }
                        else
                        {
                            <div id="pickerYears" class="vek-picker-year-container" role="grid" aria-label="Choose year">
                                <button type="button" class="vek-picker-calendar-header-transition" @onclick="OnDecadeClick">@GetDecadeStart()–@(GetDecadeStart() + 9)</button>
                                @foreach (var year in GetDisplayedYears())
                                {
                                    <button type="button" class="vek-picker-year" aria-label="@year" disabled="@(year < GetMinYear() || year > GetMaxYear())" @onclick="() => SelectYearAsync(year)" @onclick:stopPropagation="true">
                                        @VekText.RenderText(GetYearTypo(year), GetYearClasses(year), year.ToString(System.Globalization.CultureInfo.InvariantCulture))
                                    </button>
                                }
                            </div>
                        }
                    }
                    else if (_viewMode == CalendarViewMode.Months)
                    {
                        var calendarYear = GetCalendarYear(GetMonthStart());
                        <div class="vek-picker-calendar-header">
                            <div class="vek-picker-calendar-header-switch">
                                <VekIconButton aria-label="@Localizer[LanguageResource.VekBaseDatePicker_PrevYear, $"({calendarYear - 1})"]" Icon="@PreviousIcon" OnClick="OnPreviousYearClickAsync" Class="vek-flip-x-rtl" />
                                <button type="button" class="vek-picker-slide-transition vek-picker-calendar-header-transition" @onclick="OnDecadeClick" @onclick:stopPropagation="true">
                                    <VekText Typo="Typo.body1" Align="Align.Center">@calendarYear</VekText>
                                </button>
                                <VekIconButton aria-label="@Localizer[LanguageResource.VekBaseDatePicker_NextYear, $"({calendarYear + 1})"]" Icon="@NextIcon" OnClick="OnNextYearClickAsync" Class="vek-flip-x-rtl" />
                            </div>
                        </div>
                        <div class="vek-picker-month-container">
                            @foreach (var month in GetAllMonths())
                            {
                                <button type="button" aria-label="@GetMonthName(month)" disabled="@IsMonthDisabled(month)"
                                        class="vek-picker-month vek-button-root" @onclick="@(async () => await OnMonthSelectedAsync(month))" @onclick:stopPropagation="true">
                                    <VekText Typo="@GetMonthTypo(month)" Class="@GetMonthClasses(month)">@GetAbbreviatedMonthName(month)</VekText>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="vek-picker-calendar-header">
                            <div class="vek-picker-calendar-header-switch">
                                <VekIconButton aria-label="@Localizer[LanguageResource.VekBaseDatePicker_PrevMonth, $"({GetMonthYearTitle(GetMonthStart().AddMonths(-1))})"]"
                                               Class="vek-picker-nav-button-prev vek-flip-x-rtl"
                                               Icon="@PreviousIcon"
                                               OnClick="OnPreviousMonthClickAsync" />
                                <button type="button" class="vek-picker-slide-transition vek-picker-calendar-header-transition vek-button-month" @onclick="OnMonthClick" @onclick:stopPropagation="true">
                                    <VekText Typo="Typo.body1" Align="Align.Center">@GetMonthYearTitle(GetMonthStart())</VekText>
                                </button>
                                <VekIconButton aria-label="@Localizer[LanguageResource.VekBaseDatePicker_NextMonth, $"({GetMonthYearTitle(GetMonthStart().AddMonths(1))})"]"
                                               Class="vek-picker-nav-button-next vek-flip-x-rtl"
                                               Icon="@NextIcon"
                                               OnClick="OnNextMonthClickAsync" />
                            </div>
                            <div class="vek-picker-calendar-header-day">
                                @if (ShowWeekNumbers)
                                {
                                    <div class="vek-picker-calendar-week">
                                        <VekText Typo="Typo.caption" Class="vek-picker-calendar-week-text"></VekText>
                                    </div>
                                }
                                @foreach (var dayName in GetAbbreviatedDayNames())
                                {
                                    <VekText Typo="Typo.caption" Class="vek-day-label">@dayName</VekText>
                                }
                            </div>
                        </div>
                        <div class="vek-picker-calendar-transition vek-picker-slide-transition">
                            <div class="vek-picker-calendar" role="grid" aria-label="@GetMonthName(GetMonthStart())">
                                @for (int week = 0; week < 6; week++)
                                {
                                    int tempWeek = week;
                                    @if (ShowWeekNumbers)
                                    {
                                        <div class="vek-picker-calendar-week">
                                            <VekText class="vek-picker-calendar-week-text" Typo="Typo.caption">@GetWeekNumber(tempWeek)</VekText>
                                        </div>
                                    }
                                    @foreach (var day in GetWeek(tempWeek))
                                    {
                                        var isSelected = IsDateSelected(day);
                                        var isDisabled = IsDayDisabled(day);
                                        <button type="button"
                                                aria-label="@day.ToString("D", GetCulture())"
                                                aria-selected="@(isSelected ? "true" : "false")"
                                                aria-disabled="@(isDisabled ? "true" : null)"
                                                class="@GetDayClasses(day, isSelected, isDisabled)"
                                                @onclick="@(async () => await HandleDayButtonClickAsync(day))"
                                                @onclick:stopPropagation="true"
                                                disabled="@isDisabled">
                                            @if (DayCellTemplate is null)
                                            {
                                                <p class="vek-typography vek-typography-body2 vek-inherit-text">@day.Day</p>
                                            }
                                            else
                                            {
                                                @DayCellTemplate(new DatePickerDayContext(
                                                    day,
                                                    day.Day,
                                                    isDisabled,
                                                    IsAdjacentMonthDay(day)))
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
            @if (ShowTodayButton)
            {
                <div class="vek-calendar-actions pa-2 d-flex justify-end">
                    <VekButton Variant="Variant.Text" Color="@Color" OnClick="GoToTodayAsync">@TodayButtonText</VekButton>
                </div>
            }
        </div>
    </div>
</div>

