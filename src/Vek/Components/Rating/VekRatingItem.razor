@namespace Vek
@inherits VekComponentBase
@using System.Globalization

<span class="@ClassName"
      style="@Style"
      @onpointerover="HandlePointerOverAsync"
      @onpointerout="HandlePointerOutAsync"
      @onclick="HandleClickAsync">
    <input @attributes="UserAttributes"
           class="vek-rating-input"
           type="radio"
           tabindex="-1"
           value="@((PreciseItemValue ?? ItemValue).ToString(CultureInfo.InvariantCulture))"
           name="@Rating?.Name"
           disabled="@Disabled"
           checked="@Checked" />

    @if (ItemTemplate is not null)
    {
        @ItemTemplate(ItemValue)
    }
    else
    {
        <VekIcon Icon="@ItemIcon" Color="@ItemColor" Size="@Size" />
    }
</span>
