@namespace Vek
@inherits VekComponentBase

<div @attributes="UserAttributes" class="@Classname" style="@Style">
    @if (CardHeaderAvatar is not null)
    {
        <div class="vek-card-header-avatar">@CardHeaderAvatar</div>
    }
    @if (CardHeaderContent is not null)
    {
        <div class="vek-card-header-content">@CardHeaderContent</div>
    }
    @if (CardHeaderActions is not null)
    {
        <div class="vek-card-header-actions">@CardHeaderActions</div>
    }
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    @if (ParentCard?.Collapsible == true)
    {
        <VekIconButton Class="vek-card-collapse-toggle"
                       Icon="@Icons.Material.Filled.ExpandMore"
                       aria-label="@(ParentCard.IsExpanded ? "Collapse card" : "Expand card")"
                       aria-expanded="@ParentCard.IsExpanded.ToString().ToLowerInvariant()"
                       OnClick="ParentCard.ToggleExpandedAsync" />
    }
</div>
