@namespace Vek
@inherits VekComponentBase

@if (ParentCard?.Collapsible == true)
{
    <VekCollapse Class="vek-card-content-collapse" Expanded="@ParentCard.IsExpanded">
        <div @attributes="UserAttributes" class="@Classname" style="@Style">
            @ChildContent
        </div>
    </VekCollapse>
}
else
{
    <div @attributes="UserAttributes" class="@Classname" style="@Style">
        @ChildContent
    </div>
}
