@namespace Vek
@using Microsoft.AspNetCore.Components.CompilerServices
@using Vek.Resources
@inject InternalVekLocalizer Localizer
@inherits VekTabs

@Render

@{
#pragma warning disable CS0618 // Type or member is obsolete
}

@code {
    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Header = VekTabsHeader;
        TabPanelHeader = VekTabPanelPanelHeader;
    }

    /// <summary>
    /// Renders the component to the supplied <see cref="BuildRenderTree"/>.
    /// </summary>
    public RenderFragment Render => base.BuildRenderTree;

    private RenderFragment<VekTabPanel> VekTabPanelPanelHeader => context =>
        @<VekRender>
            @if (context.ShowCloseIcon)
            {
                if (!string.IsNullOrEmpty(CloseIconToolTip))
                {
                    <VekTooltip Text="@CloseIconToolTip">
                        <VekIconButton Icon="@CloseTabIcon"
                                       Class="@CloseIconClass"
                                       Style="@CloseIconStyle"
                                       OnClick="() => CloseTab.InvokeAsync(context)"
                                       aria-label="@Localizer[LanguageResource.VekTabs_CloseTab]"/>
                    </VekTooltip>
                }
                else
                {
                    <VekIconButton Icon="@CloseTabIcon"
                                   Class="@CloseIconClass"
                                   Style="@CloseIconStyle"
                                   OnClick="() => CloseTab.InvokeAsync(context)"
                                   aria-label="@Localizer[LanguageResource.VekTabs_CloseTab]" />
                }
            }
        </VekRender>;

    private RenderFragment<VekTabs> VekTabsHeader => _ =>
        @<VekRender>
            @if (!string.IsNullOrEmpty(AddIconToolTip))
            {
                <VekTooltip Text="@AddIconToolTip">
                    <VekIconButton Icon="@AddTabIcon" 
                        Class="@AddIconClass" 
                        Style="@AddIconStyle" 
                        OnClick="@AddTab" 
                        aria-label="@Localizer[LanguageResource.VekTabs_AddTab]" />
                </VekTooltip>
            }
            else
            {
                <VekIconButton 
                    Icon="@AddTabIcon" 
                    Class="@AddIconClass" 
                    Style="@AddIconStyle" 
                    OnClick="@AddTab" 
                    aria-label="@Localizer[LanguageResource.VekTabs_AddTab]" />
            }
        </VekRender>;
}
