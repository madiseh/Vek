@namespace Vek
@using Vek.Resources
@inherits VekComponentBase
@inject InternalVekLocalizer Localizer

<div @attributes="UserAttributes" class="@TabsClassnames" style="@Style">
    <CascadingValue Value="this" IsFixed="true">
        <div class="@TabBarClassnames">
            <div @ref="@_tabsInnerSize" class="vek-tabs-tabbar-inner" style="@MaxHeightStyles" id="@_elementId">
                @if (HeaderPosition == TabHeaderPosition.Before && Header != null)
                {
                    <div class="vek-tabs-header vek-tabs-header-before">
                        @Header(this)
                    </div>
                }
                @if (_showScrollButtons)
                {
                    <CascadingValue Value="false" Name="ParentDisabled" IsFixed="true">
                        <div class="vek-tabs-scroll-button"
                             @ondragover="@(e => _throttleDispatcher.Value.ThrottleAsync(() => { ScrollPrev(); return Task.CompletedTask; }))">
                            <VekIconButton Icon="@_prevIcon" Color="@ScrollIconColor" OnClick="@((e) => ScrollPrev())" Disabled="@_prevButtonDisabled" aria-label="@GetPrevAriaLabel()" />
                        </div>
                    </CascadingValue>
                }
                <div @ref="@_tabsContentSize" class="vek-tabs-tabbar-content" @onwheel="HandleWheel" @onwheel:preventDefault="ScrollMode != TabsScrollMode.None && !_isVerticalTabs && _allTabsSize > _tabBarContentSize">
                    @if (EnableDragAndDrop || AllowTabReorder)
                    {
                        <VekDropContainer @ref="_dropContainer" T="VekTabPanel" Class="@WrapperClassnames" Style="@WrapperScrollStyle" Items="_panels"
                                          ItemsSelector="@((item,dropzone) => true)" ItemDropped="@ItemUpdated"
                                          ItemDisabled="@((item) => Disabled || item.Disabled)" role="tablist"
                                          aria-orientation="@(_isVerticalTabs ? "vertical" : "horizontal")">
                            <ChildContent>
                                <VekDropZone T="VekTabPanel" Identifier="vek-tabs-dropzone" Class="@DropZoneClassnames" AllowReorder="true" />
                                @if (!HideSlider && _isSliderPositionDetermined)
                                {
                                    <div class="@SliderClass" style="@SliderStyle"></div>
                                }
                            </ChildContent>
                            <ItemRenderer>
                                @RenderTabWrapperSection(context)
                            </ItemRenderer>
                        </VekDropContainer>
                    }
                    else
                    {
                        <div class="@WrapperClassnames" style="@WrapperScrollStyle" role="tablist" aria-orientation="@(_isVerticalTabs ? "vertical" : "horizontal")">
                            @foreach (VekTabPanel panel in _panels)
                            {
                                @RenderTabWrapperSection(panel)
                            }
                            @if (!HideSlider && _isSliderPositionDetermined)
                            {
                                <div class="@SliderClass" style="@SliderStyle"></div>
                            }
                        </div>
                    }
                </div>
                @if (_showScrollButtons)
                {
                    <CascadingValue Value="false" Name="ParentDisabled" IsFixed="true">
                        <div class="vek-tabs-scroll-button"
                             @ondragover="@(e => _throttleDispatcher.Value.ThrottleAsync(() => { ScrollNext(); return Task.CompletedTask; }))">
                            <VekIconButton Icon="@_nextIcon" Color="@ScrollIconColor" OnClick="@((e) => ScrollNext())" Disabled="@_nextButtonDisabled" aria-label="@GetNextAriaLabel()" />
                        </div>
                    </CascadingValue>
                }
                @if (HeaderPosition == TabHeaderPosition.After && Header != null)
                {
                    <div class="vek-tabs-header vek-tabs-header-after">
                        @Header(this)
                    </div>
                }
            </div>
        </div>
        @if (PrePanelContent is not null && ActivePanel is not null)
        {
            @PrePanelContent(ActivePanel)
        }
        <div class="@PanelsClassnames">
            @ChildContent
        </div>
    </CascadingValue>
</div>

@code {
    private RenderFragment RenderTabWrapperSection(VekTabPanel panel) =>
        @<text>
            @if (panel.TabContent is null && panel.TabWrapperContent is null)
            {
                <VekTooltip Placement="@GetTooltipPlacement()" Text="@panel.ToolTip" @key="@panel">
                    @RenderTab(panel)
                </VekTooltip>
            }
            else
            {
                <div class="d-inline-block" style="width: fit-content;" @key="@panel">
                    @if (panel.TabWrapperContent is null)
                    {
                        @RenderTab(panel)
                    }
                    else
                    {
                        @panel.TabWrapperContent(RenderTab(panel))
                    }
                </div>
            }
        </text>;

    private RenderFragment RenderTab(VekTabPanel panel) =>
        @<div @ref="panel.PanelRef" class="@GetTabClass(panel)" style="@GetTabStyle(panel)" @onclick="@(e => ActivatePanelClickAsync(panel, e, false))" @onmousedown="panel.OnMouseDown" @oncontextmenu="panel.OnContextMenu" @oncontextmenu:preventDefault="@(panel.OnContextMenu.HasDelegate)"
              aria-controls="@GetTabPanelId(panel)" role="tab" id="@GetTabId(panel)" aria-selected="@(panel == ActivePanel ? "true" : "false")"
              tabindex="@(panel == ActivePanel ? "0" : "-1")" @onkeydown="@(e => HandleTabKeyDownAsync(e, panel))">
            @if (TabPanelHeaderPosition == TabHeaderPosition.Before && TabPanelHeader is not null)
            {
                <div class="vek-tabs-panel-header vek-tabs-panel-header-before">
                    @TabPanelHeader(panel)
                </div>
            }
            @if (panel.HeaderTemplate is not null)
            {
                @panel.HeaderTemplate
            }
            else if (panel.TabContent is not null)
            {
                @panel.TabContent
            }
            else
            {
                @if (panel.IconPosition == TabIconPosition.Start)
                {
                    @RenderPanelIcon(panel)
                }
                @panel.Text
                @if (panel.IconPosition == TabIconPosition.End)
                {
                    @RenderPanelIcon(panel)
                }
            }
            @if (panel.EffectiveBadgeContent is not null || panel.BadgeIcon is not null || panel.BadgeDot)
            {
                <VekBadge Dot="@panel.BadgeDot" Content="@panel.EffectiveBadgeContent" Icon="@panel.BadgeIcon" Max="@panel.BadgeMax" Color="@panel.BadgeColor" Class="vek-tab-badge" />
            }
            @if (TabPanelHeaderPosition == TabHeaderPosition.After && TabPanelHeader is not null)
            {
                <div class="vek-tabs-panel-header vek-tabs-panel-header-after">
                    @TabPanelHeader(panel)
                </div>
            }
            @if (this is not VekDynamicTabs && IsTabCloseable(panel) && ShouldRenderCloseButton(panel))
            {
                @RenderCloseButton(panel)
            }
        </div>;

    private RenderFragment RenderPanelIcon(VekTabPanel panel) =>
        @<text>
            @if (!string.IsNullOrEmpty(panel.Icon))
            {
                <VekIcon Icon="@panel.Icon" Color="@GetPanelIconColor(panel)" Class="@(panel.Text is null ? null : $"vek-tab-icon-text vek-tab-icon-{panel.IconPosition.ToString().ToLowerInvariant()}")" />
            }
        </text>;

    private RenderFragment RenderCloseButton(VekTabPanel panel) =>
        @<span class="vek-tab-close-wrapper" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
            @if (!string.IsNullOrEmpty(GetCloseIconToolTip(panel)))
            {
                <VekTooltip Text="@GetCloseIconToolTip(panel)">
                    <VekIconButton Icon="@GetCloseIcon(panel)"
                                   Class="@GetCloseIconClass(panel)"
                                   Size="Size.Small"
                                   Disabled="@IsPanelDisabled(panel)"
                                   OnClick="@(() => CloseTabAsync(panel))"
                                   aria-label="@Localizer[LanguageResource.VekTabs_CloseTab]" />
                </VekTooltip>
            }
            else
            {
                <VekIconButton Icon="@GetCloseIcon(panel)"
                               Class="@GetCloseIconClass(panel)"
                               Size="Size.Small"
                               Disabled="@IsPanelDisabled(panel)"
                               OnClick="@(() => CloseTabAsync(panel))"
                               aria-label="@Localizer[LanguageResource.VekTabs_CloseTab]" />
            }
        </span>;
}
