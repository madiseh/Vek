@namespace Vek
@using System.Globalization
@inherits VekComponentBase
@typeparam T

<div class="@Classname" style="@Style" @attributes="UserAttributes">
    @if (ChildContent is not null)
    {
        <VekText Typo="Typo.body1">@ChildContent</VekText>
    }
    <div class="vek-slider-container">
        <div class="vek-slider-inner-container">
            <div class="vek-slider-track-background"></div>
            <div class="vek-slider-filled" style="@RangeTrackStyle"></div>
        </div>

        @if (ShouldShowTicks)
        {
            <div class="vek-slider-inner-container">
                <div class="vek-slider-tickmarks">
                    @for (int i = 0; i < _tickMarkCount; i++)
                    {
                        int current = i;
                        <div class="d-flex flex-column relative vek-slider-tickmark" style="@GetTickMarkPositionStyle(current)">
                            <span class="vek-slider-track-tick" />
                            @if ((TickMarkLabels != null && current < TickMarkLabels.Length) || TickMarkLabelFormatter is not null)
                            {
                                <VekText Class="vek-slider-track-tick-label" Typo="Typo.body2">@GetTickMarkLabel(current)</VekText>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <input type="range"
               class="vek-slider-input vek-slider-input-start"
               min="@Min.ToString(null, CultureInfo.InvariantCulture)"
               max="@Max.ToString(null, CultureInfo.InvariantCulture)"
               step="@Step.ToString(null, CultureInfo.InvariantCulture)"
               disabled="@Disabled"
               aria-label="@(AriaLabelStart ?? "Start value")"
               aria-valuenow="@_valueStartState.Value.ToString(null, CultureInfo.InvariantCulture)"
               aria-valuemin="@Min.ToString(null, CultureInfo.InvariantCulture)"
               aria-valuemax="@_valueEndState.Value.ToString(null, CultureInfo.InvariantCulture)"
               style="@GetStartInputZIndexStyle()"
               @bind-value:get="@GetValueStartText"
               @bind-value:set="@SetValueStartTextAsync"
               @bind-value:event="@(Immediate ? "oninput" : "onchange")"
               @onfocus="@(() => _activeThumb = ActiveThumb.Start)" />

        <input type="range"
               class="vek-slider-input vek-slider-input-end"
               min="@Min.ToString(null, CultureInfo.InvariantCulture)"
               max="@Max.ToString(null, CultureInfo.InvariantCulture)"
               step="@Step.ToString(null, CultureInfo.InvariantCulture)"
               disabled="@Disabled"
               aria-label="@(AriaLabelEnd ?? "End value")"
               aria-valuenow="@_valueEndState.Value.ToString(null, CultureInfo.InvariantCulture)"
               aria-valuemin="@_valueStartState.Value.ToString(null, CultureInfo.InvariantCulture)"
               aria-valuemax="@Max.ToString(null, CultureInfo.InvariantCulture)"
               style="@GetEndInputZIndexStyle()"
               @bind-value:get="@GetValueEndText"
               @bind-value:set="@SetValueEndTextAsync"
               @bind-value:event="@(Immediate ? "oninput" : "onchange")"
               @onfocus="@(() => _activeThumb = ActiveThumb.End)" />

        @if (ShouldDisplayValueLabel)
        {
            <div class="vek-slider-value-label vek-slider-value-label-start @ValueLabelDisplayClass" style="@ValueLabelStartPositionStyle">
                @if (ValueLabelContent is null)
                {
                    @FormatValueLabel(_valueStartState.Value)
                }
                else
                {
                    @ValueLabelContent(_valueStartState.Value)
                }
            </div>
            <div class="vek-slider-value-label vek-slider-value-label-end @ValueLabelDisplayClass" style="@ValueLabelEndPositionStyle">
                @if (ValueLabelContent is null)
                {
                    @FormatValueLabel(_valueEndState.Value)
                }
                else
                {
                    @ValueLabelContent(_valueEndState.Value)
                }
            </div>
        }
    </div>
</div>
