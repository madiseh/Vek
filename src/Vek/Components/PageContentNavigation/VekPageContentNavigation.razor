@namespace Vek
@using Microsoft.AspNetCore.Components.Routing
@inherits VekComponentBase

<div class="@GetPanelClass()" @attributes="UserAttributes">
    @if (_sections.Count > 1)
    {
        <VekNavMenu Class="pl-4" aria-label="@ResolvedHeadline()">
            <VekText Typo="Typo.subtitle1" Class="title" GutterBottom="true">
                @ResolvedHeadline()
            </VekText>

            @foreach (var docSection in _sections.OrderBy(x => x.LevelSortingValue))
            {
                <VekNavLink @key="docSection.Id" Match="NavLinkMatch.All" Class="@GetNavLinkClass(docSection)" @onclick="@(e => OnNavLinkClick(docSection.Id))">
                    @docSection.Title
                </VekNavLink>
            }
        </VekNavMenu>
    }
</div>
