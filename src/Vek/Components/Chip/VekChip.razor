@namespace Vek
@using Vek.Resources
@typeparam T
@inherits VekComponentBase
@inject InternalVekLocalizer Localizer

<div class="vek-chip-container"
     id="@_chipContainerId"
     @onkeydown="@HandleKeyDownAsync">
    @{
        OpenElement(__builder);
        RenderContent(__builder);
        __builder.CloseElement();
    }
</div>

@code {
    private void RenderContent(RenderTreeBuilder __builder)
    {
        if (AvatarContent is not null)
        {
            @AvatarContent
        }
        else if (!string.IsNullOrEmpty(Icon) && !ShowCheckMark)
        {
            <VekIcon Disabled="@Disabled" Icon="@Icon" Class="vek-chip-icon" Size="Vek.Size.Small" Color="@GetIconColor()" />
        }
        else if (ShowCheckMark)
        {
            <VekIcon Disabled="@Disabled" Icon="@GetCheckedIcon()" Class="vek-chip-icon" Size="Vek.Size.Small" />
        }
        <span class="vek-chip-content">
            @if (ChildContent is null)
            {
                @if(Text is null) {
                    @($"{Value}")
                }
                else {
                    @Text
                }
            }
            else
            {
                @ChildContent
            }
            @if (IsClosable)
            {
                <VekIconButton Class="vek-chip-close-button"
                               Icon="@GetCloseIcon()"
                               OnClick="OnCloseAsync"
                               Size="Vek.Size.Small"
                               Disabled="@Disabled"
                               aria-label="@Localizer[LanguageResource.VekChip_Close]"
                               tabindex="-1"/>
            }
        </span>
    }
}
