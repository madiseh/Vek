@using Vek.Extensions
@using Vek.Resources
@namespace Vek
@inherits VekComponentBase
@typeparam T

@inject InternalVekLocalizer Localizer

@if (!Column.HiddenState.Value)
{
    <th scope="col" class="@Classname" style="@Stylename" colspan="@Column.HeaderColSpan" @attributes="@UserAttributes">
        @if (Column.filterable && Column.FilterTemplate != null)
        {
            @Column.FilterTemplate(Column.FilterContext)
        }
        else if (Column.filterable)
        {
            <VekStack Row="true">
                @if (fieldType.IsString && !(@operator ?? "").EndsWith("empty"))
                {
                    <VekTextField T="string" Value="@valueString" ValueChanged="@StringValueChangedAsync" FullWidth="true" Placeholder="@Localizer[LanguageResource.VekDataGrid_FilterValue]" Margin="@Margin.Dense" Immediate="true" DebounceInterval="@(!DataGrid.HasServerData ? 0 : 500.0)" />
                }
                else if (fieldType.IsNumber && !(@operator ?? "").EndsWith("empty"))
                {
                    <VekNumericField T="double?" Culture="@Column.Culture" Value="@valueNumber" ValueChanged="@NumberValueChangedAsync" FullWidth="true" Placeholder="@Localizer[LanguageResource.VekDataGrid_FilterValue]" Margin="@Margin.Dense" Immediate="true" DebounceInterval="@(!DataGrid.HasServerData ? 0 : 500.0)" />
                }
                else if (fieldType.IsEnum && @operator == FilterOperator.Enum.IsAnyOf)
                {
                    <VekSelect T="Enum" MultiSelection="true" SelectedValues="@valueEnums" SelectedValuesChanged="@EnumValuesChangedAsync" FullWidth="true" Dense="true" Margin="@Margin.Dense">
                        @foreach (var item in EnumExtensions.GetSafeEnumValues(fieldType.InnerType))
                        {
                            <VekSelectItem T="Enum" Value="@item">@Localizer[item]</VekSelectItem>
                        }
                    </VekSelect>
                }
                else if (fieldType.IsEnum)
                {
                    <VekSelect T="Enum" Value="@valueEnum" ValueChanged="@EnumValueChangedAsync" FullWidth="true" Dense="true" Margin="@Margin.Dense">
                        <VekSelectItem T="Enum" Value="@(null)"></VekSelectItem>
                        @foreach (var item in EnumExtensions.GetSafeEnumValues(fieldType.InnerType))
                        {
                            <VekSelectItem T="Enum" Value="@item">@Localizer[item]</VekSelectItem>
                        }
                    </VekSelect>
                }
                else if (fieldType.IsBoolean)
                {
                    <VekSelect T="bool?" Value="@valueBool" ValueChanged="@BoolValueChangedAsync" FullWidth="true" Dense="true" Margin="@Margin.Dense">
                        <VekSelectItem T="bool?" Value="@(null)"></VekSelectItem>
                        <VekSelectItem T="bool?" Value="@(true)">@Localizer[LanguageResource.VekDataGrid_True]</VekSelectItem>
                        <VekSelectItem T="bool?" Value="@(false)">@Localizer[LanguageResource.VekDataGrid_False]</VekSelectItem>
                    </VekSelect>
                }
                else if (fieldType.IsDateOnly && !(@operator ?? "").EndsWith("empty"))
                {
                    <VekDatePicker Date="@valueDateOnlyForPicker" DateChanged="@DateOnlyValueChangedAsync" Margin="@Margin.Dense" />
                }
                else if (fieldType.IsDateTime && !(@operator ?? "").EndsWith("empty"))
                {
                    <VekGrid Spacing="0">
                        <VekItem xs="7">
                            <VekDatePicker Date="@valueDateTimeForPicker" DateChanged="@DateTimeValueChangedAsync" Margin="@Margin.Dense" />
                        </VekItem>
                        <VekItem xs="5">
                            <VekTimePicker Time="@valueTime" TimeChanged="@TimeValueChangedAsync" Margin="@Margin.Dense" />
                        </VekItem>
                    </VekGrid>
                }
                @if (!Column.ShowFilterIcon.HasValue || Column.ShowFilterIcon.Value)
                {
                    <VekMenu Class="column-filter-menu" Icon="@DataGrid.FilterIconFilled" Size="@Size.Small" Dense="true">
                        @foreach (var o in operators)
                        {
                            if (!string.IsNullOrWhiteSpace(o))
                            {
                                <VekMenuItem Style="@chosenOperatorStyle(o)" OnClick="@(async () => await ChangeOperatorAsync(o))">@Localizer[FilterOperator.GetTranslationKeyByOperatorName(o)]</VekMenuItem>
                            }
                        }
                    </VekMenu>
                    <VekIconButton Class="align-self-center filter-button clear" Icon="@DataGrid.FilterIconClear" Size="@Size.Small" OnClick="@ClearFilterAsync" aria-label="@Localizer[LanguageResource.VekDataGrid_ClearFilter]"></VekIconButton>
                }
            </VekStack>
        }
    </th>
}
