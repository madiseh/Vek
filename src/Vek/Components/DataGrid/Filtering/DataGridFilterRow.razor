@using System.Diagnostics.CodeAnalysis
@using Vek.Utilities
@namespace Vek
@inherits VekComponentBase
@typeparam T

<tr class="@Classname" style="@Stylename" @attributes="@UserAttributes">
    @foreach (var entry in DataGrid.ColumnVirtualizationEntries)
    {
        if (entry.IsSpacer)
        {
            <th class="vek-datagrid-column-virtualizer-spacer" aria-hidden="true" style="@DataGrid.GetColumnSpacerStyle(entry.SpacerWidth)"></th>
        }
        else
        {
            var column = entry.Column!;
            <DataGridFilterCell @key="column" T="T" Column="@column" />
        }
    }
</tr>
