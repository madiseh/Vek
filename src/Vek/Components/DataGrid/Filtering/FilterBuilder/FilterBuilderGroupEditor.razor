@namespace Vek

<section class="vek-filter-builder-group" role="region" aria-label="Filter group">
    <header class="vek-filter-builder-group__header">
        <label>
            Match
            <select class="vek-filter-builder-group__logic-select"
                    value="@Group.LogicalOperator"
                    @onchange="OnLogicalOperatorChangedAsync"
                    aria-label="Group logic">
                <option value="And">all conditions</option>
                <option value="Or">any condition</option>
            </select>
        </label>
        <VekButton Variant="Variant.Text"
                   Size="Size.Small"
                   OnClick="@AddConditionAsync"
                   Disabled="@(Columns.Count == 0)"
                   aria-label="Add condition">
            Add condition
        </VekButton>
        <VekButton Variant="Variant.Text"
                   Size="Size.Small"
                   OnClick="@AddGroupAsync"
                   aria-label="Add group">
            Add group
        </VekButton>
    </header>

    <div class="vek-filter-builder-group__children">
        @for (var index = 0; index < Group.Children.Count; index++)
        {
            var childIndex = index;
            var child = Group.Children[childIndex];
            <div class="vek-filter-builder-group__child">
                @if (child.Group is not null)
                {
                    <FilterBuilderGroupEditor Group="@child.Group" Columns="@Columns" Changed="@Changed" />
                    <VekButton Variant="Variant.Text"
                               Color="Color.Error"
                               Size="Size.Small"
                               Class="vek-filter-builder-group__remove-group"
                               OnClick="@(() => RemoveAsync(childIndex))"
                               aria-label="Remove group">
                        Remove group
                    </VekButton>
                }
                else
                {
                    <div class="vek-filter-builder-condition">
                        <select class="vek-filter-builder-condition__field-select"
                                value="@child.ColumnIndex"
                                @onchange="args => OnColumnChangedAsync(child, args)"
                                aria-label="Filter field">
                            @for (var columnIndex = 0; columnIndex < Columns.Count; columnIndex++)
                            {
                                <option value="@columnIndex">@Columns[columnIndex].Title</option>
                            }
                        </select>
                        <select class="vek-filter-builder-condition__operator-select"
                                value="@child.Operator"
                                @onchange="args => OnOperatorChangedAsync(child, args)"
                                aria-label="Comparison">
                            @foreach (var op in GetOperators(child))
                            {
                                <option value="@op">@op</option>
                            }
                        </select>
                        @if (NeedsValue(child))
                        {
                            <input class="vek-filter-builder-condition__value-input"
                                   value="@child.Value"
                                   @onchange="args => OnValueChangedAsync(child, args)"
                                   @oninput="args => OnValueChangedAsync(child, args)"
                                   aria-label="Filter value"
                                   placeholder="Value" />
                        }
                    </div>
                    <VekButton Variant="Variant.Text"
                               Color="Color.Error"
                               Size="Size.Small"
                               Class="vek-filter-builder-group__remove-condition"
                               OnClick="@(() => RemoveAsync(childIndex))"
                               aria-label="Remove condition">
                        Remove
                    </VekButton>
                }
            </div>
        }
    </div>
</section>

@code {
    /// <summary>
    /// The group being edited.
    /// </summary>
    [Parameter]
    [Category(CategoryTypes.DataGrid.Filtering)]
    public FilterBuilderDraftGroup Group { get; set; } = new();

    /// <summary>
    /// The columns available for filter conditions.
    /// </summary>
    [Parameter]
    [Category(CategoryTypes.DataGrid.Filtering)]
    public IReadOnlyList<FilterBuilderColumnOption> Columns { get; set; } = [];

    /// <summary>
    /// Notifies the owning editor that the filter tree changed.
    /// </summary>
    [Parameter]
    [Category(CategoryTypes.DataGrid.Filtering)]
    public EventCallback Changed { get; set; }

    private Task OnLogicalOperatorChangedAsync(ChangeEventArgs args)
    {
        Group.LogicalOperator = Enum.TryParse<FilterGroupOperator>(args.Value?.ToString(), out var value) ? value : FilterGroupOperator.And;
        return Changed.InvokeAsync();
    }

    private Task AddConditionAsync()
    {
        var firstOp = Columns.Count > 0 ? Columns[0].Operators.FirstOrDefault() : null;
        Group.Children.Add(new FilterBuilderDraftNode
        {
            ColumnIndex = 0,
            Operator = firstOp
        });
        return Changed.InvokeAsync();
    }

    private Task AddGroupAsync()
    {
        var newGroup = new FilterBuilderDraftGroup();
        if (Columns.Count > 0)
        {
            newGroup.Children.Add(new FilterBuilderDraftNode
            {
                ColumnIndex = 0,
                Operator = Columns[0].Operators.FirstOrDefault()
            });
        }
        Group.Children.Add(new FilterBuilderDraftNode { Group = newGroup });
        return Changed.InvokeAsync();
    }

    private Task RemoveAsync(int index)
    {
        if (index >= 0 && index < Group.Children.Count)
        {
            Group.Children.RemoveAt(index);
        }
        return Changed.InvokeAsync();
    }

    private IEnumerable<string> GetOperators(FilterBuilderDraftNode node)
    {
        return node.ColumnIndex >= 0 && node.ColumnIndex < Columns.Count
            ? Columns[node.ColumnIndex].Operators
            : [];
    }

    private static bool NeedsValue(FilterBuilderDraftNode node)
    {
        var op = node.Operator?.ToLowerInvariant() ?? string.Empty;
        return !op.Contains("empty") && !op.Contains("null");
    }

    private Task OnColumnChangedAsync(FilterBuilderDraftNode node, ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var index) && index >= 0 && index < Columns.Count)
        {
            node.ColumnIndex = index;
            node.Operator = Columns[index].Operators.FirstOrDefault();
            node.Value = null;
        }

        return Changed.InvokeAsync();
    }

    private Task OnOperatorChangedAsync(FilterBuilderDraftNode node, ChangeEventArgs args)
    {
        node.Operator = args.Value?.ToString();
        return Changed.InvokeAsync();
    }

    private Task OnValueChangedAsync(FilterBuilderDraftNode node, ChangeEventArgs args)
    {
        node.Value = args.Value?.ToString();
        return Changed.InvokeAsync();
    }
}
