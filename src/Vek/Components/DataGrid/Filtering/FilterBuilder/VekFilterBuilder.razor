@namespace Vek
@typeparam T
@inherits VekComponentBase

@if (_visibleState.Value)
{
    @if (_asDialogState.Value)
    {
        <VekOverlay Visible="true" AutoClose="true" OnClick="@OnCloseAsync" />
        <div class="vek-datagrid-filter-builder-dialog" role="dialog" aria-modal="true" aria-label="@_titleState.Value">
            @RenderContent()
        </div>
    }
    else
    {
        @RenderContent()
    }
}

@code {
    private RenderFragment RenderContent() => __builder =>
    {
        <div class="@Classname" style="@Style" role="region" aria-label="@_titleState.Value" @attributes="UserAttributes" @onkeydown="OnKeyDownAsync">
            <header class="vek-filter-builder__header">
                <h3 class="vek-filter-builder__title">@_titleState.Value</h3>
                <VekIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Class="vek-filter-builder__close-button"
                               aria-label="Close filter builder"
                               OnClick="@OnCloseAsync" />
            </header>

            <div class="vek-filter-builder__body">
                @if (_validationMessage is not null)
                {
                    <div class="vek-filter-builder__validation" role="alert">@_validationMessage</div>
                }
                <FilterBuilderGroupEditor Group="@_rootGroup" Columns="@GetEffectiveColumns()" Changed="@OnChangedAsync" />
            </div>

            <footer class="vek-filter-builder__footer">
                <VekButton Variant="Variant.Text"
                           Size="Size.Small"
                           Class="vek-filter-builder__clear"
                           OnClick="@OnClearAsync">
                    Clear
                </VekButton>
                <VekButton Variant="Variant.Text"
                           Size="Size.Small"
                           Class="vek-filter-builder__cancel"
                           OnClick="@OnCloseAsync">
                    Cancel
                </VekButton>
                <VekButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           Size="Size.Small"
                           Class="vek-filter-builder__apply"
                           OnClick="@OnApplyAsync">
                    Apply
                </VekButton>
            </footer>
        </div>
    };
}
