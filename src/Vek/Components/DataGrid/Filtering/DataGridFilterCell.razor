@using System.Diagnostics.CodeAnalysis
@using Vek.Extensions
@using Vek.Utilities
@namespace Vek
@inherits VekComponentBase
@typeparam T

@if (!Column.HiddenState.Value)
{
    <th scope="col" class="@Classname" style="@Stylename" colspan="@Column.HeaderColSpan" @attributes="@UserAttributes">
        @if (Column.filterable && Column.FilterTemplate != null)
        {
            @Column.FilterTemplate(Column.FilterContext)
        }
        else if (Column.filterable)
        {
            <div class="vek-datagrid-filter-cell-content">
                <VekMenu Class="vek-datagrid-filter-operator-menu" Dense="true" Size="Size.Small" Variant="Variant.Text" Icon="@CurrentOperatorSymbol" aria-label="Filter operator">
                    @foreach (var op in SupportedOperators)
                    {
                        <VekMenuItem Style="@GetChosenOperatorStyle(op)" OnClick="@(() => OnOperatorSelectedAsync(op))">
                            @op.ToDisplayString() (@op.ToSymbol())
                        </VekMenuItem>
                    }
                </VekMenu>

                @if (CurrentOperator is DataGridFilterOperator.IsNull)
                {
                    <span class="vek-datagrid-filter-null-label">(Is Null)</span>
                }
                else if (CurrentOperator is DataGridFilterOperator.IsNotNull)
                {
                    <span class="vek-datagrid-filter-null-label">(Not Null)</span>
                }
                else if (FieldType.IsString)
                {
                    <VekTextField T="string"
                                  Value="@StringValue"
                                  ValueChanged="@OnStringValueChangedAsync"
                                  FullWidth="true"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  DebounceInterval="@DebounceDelay"
                                  Placeholder="Filter..."
                                  Class="vek-datagrid-filter-input"
                                  aria-label="@FilterAriaLabel" />
                }
                else if (FieldType.IsNumber)
                {
                    @if (CurrentOperator is DataGridFilterOperator.Between)
                    {
                        <div class="vek-datagrid-filter-range">
                            <VekNumericField T="double?"
                                             Culture="@Column.Culture"
                                             Value="@RangeFromNumber"
                                             ValueChanged="@OnRangeFromNumberChangedAsync"
                                             Margin="Margin.Dense"
                                             Immediate="true"
                                             DebounceInterval="@DebounceDelay"
                                             Placeholder="From"
                                             Class="vek-datagrid-filter-input"
                                             aria-label="From" />
                            <VekNumericField T="double?"
                                             Culture="@Column.Culture"
                                             Value="@RangeToNumber"
                                             ValueChanged="@OnRangeToNumberChangedAsync"
                                             Margin="Margin.Dense"
                                             Immediate="true"
                                             DebounceInterval="@DebounceDelay"
                                             Placeholder="To"
                                             Class="vek-datagrid-filter-input"
                                             aria-label="To" />
                        </div>
                    }
                    else
                    {
                        <VekNumericField T="double?"
                                         Culture="@Column.Culture"
                                         Value="@NumberValue"
                                         ValueChanged="@OnNumberValueChangedAsync"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         DebounceInterval="@DebounceDelay"
                                         Placeholder="Filter..."
                                         Class="vek-datagrid-filter-input"
                                         aria-label="@FilterAriaLabel" />
                    }
                }
                else if (FieldType.IsBoolean)
                {
                    <VekSelect T="bool?"
                               Value="@BoolValue"
                               ValueChanged="@OnBoolValueChangedAsync"
                               FullWidth="true"
                               Dense="true"
                               Margin="Margin.Dense"
                               Class="vek-datagrid-filter-input"
                               aria-label="@FilterAriaLabel">
                        <VekSelectItem T="bool?" Value="@(null)">(All)</VekSelectItem>
                        <VekSelectItem T="bool?" Value="@(true)">True</VekSelectItem>
                        <VekSelectItem T="bool?" Value="@(false)">False</VekSelectItem>
                    </VekSelect>
                }
                else if (FieldType.IsDateOnly)
                {
                    @if (CurrentOperator is DataGridFilterOperator.Between)
                    {
                        <div class="vek-datagrid-filter-range">
                            <VekDatePicker Date="@RangeFromDate"
                                           DateChanged="@OnRangeFromDateOnlyChangedAsync"
                                           Margin="Margin.Dense"
                                           Placeholder="From"
                                           Class="vek-datagrid-filter-input"
                                           aria-label="From" />
                            <VekDatePicker Date="@RangeToDate"
                                           DateChanged="@OnRangeToDateOnlyChangedAsync"
                                           Margin="Margin.Dense"
                                           Placeholder="To"
                                           Class="vek-datagrid-filter-input"
                                           aria-label="To" />
                        </div>
                    }
                    else
                    {
                        <VekDatePicker Date="@DateOnlyValueForPicker"
                                       DateChanged="@OnDateOnlyValueChangedAsync"
                                       Margin="Margin.Dense"
                                       Placeholder="Filter..."
                                       Class="vek-datagrid-filter-input"
                                       aria-label="@FilterAriaLabel" />
                    }
                }
                else if (FieldType.IsDateTime)
                {
                    @if (CurrentOperator is DataGridFilterOperator.Between)
                    {
                        <div class="vek-datagrid-filter-range">
                            <VekDatePicker Date="@RangeFromDate"
                                           DateChanged="@OnRangeFromDateTimeChangedAsync"
                                           Margin="Margin.Dense"
                                           Placeholder="From"
                                           Class="vek-datagrid-filter-input"
                                           aria-label="From" />
                            <VekDatePicker Date="@RangeToDate"
                                           DateChanged="@OnRangeToDateTimeChangedAsync"
                                           Margin="Margin.Dense"
                                           Placeholder="To"
                                           Class="vek-datagrid-filter-input"
                                           aria-label="To" />
                        </div>
                    }
                    else
                    {
                        <VekDatePicker Date="@DateTimeValueForPicker"
                                       DateChanged="@OnDateTimeValueChangedAsync"
                                       Margin="Margin.Dense"
                                       Placeholder="Filter..."
                                       Class="vek-datagrid-filter-input"
                                       aria-label="@FilterAriaLabel" />
                    }
                }
                else if (FieldType.IsEnum)
                {
                    <VekSelect T="Enum"
                               Value="@EnumValue"
                               ValueChanged="@OnEnumValueChangedAsync"
                               FullWidth="true"
                               Dense="true"
                               Margin="Margin.Dense"
                               Class="vek-datagrid-filter-input"
                               aria-label="@FilterAriaLabel">
                        <VekSelectItem T="Enum" Value="@(null)">(All)</VekSelectItem>
                        @foreach (var item in EnumExtensions.GetSafeEnumValues(FieldType.InnerType))
                        {
                            <VekSelectItem T="Enum" Value="@item">@item</VekSelectItem>
                        }
                    </VekSelect>
                }

                <VekIconButton Class="vek-datagrid-filter-clear-button align-self-center"
                               Icon="@DataGrid.FilterIconClear"
                               Size="Size.Small"
                               OnClick="@ClearFilterAsync"
                               aria-label="Clear filter" />
            </div>
        }
    </th>
}
