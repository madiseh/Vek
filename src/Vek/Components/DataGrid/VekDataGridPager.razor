@namespace Vek
@inherits VekComponentBase
@typeparam T
@using Vek.Resources
@inject InternalVekLocalizer Localizer

<VekToolBar @attributes="UserAttributes" Class="@Classname" Style="@Style">
    <div class="vek-table-pagination-spacer"></div>
    @if (PageSizeSelector)
    {
        <VekText Typo="Typo.body2" Class="vek-table-pagination-caption" id="@_rowsPerPageLabelId">
            @RowsPerPageString
        </VekText>
        <VekSelect T="int" ValueChanged="@SetRowsPerPageAsync" Value="@(DataGrid?.RowsPerPage ?? 0)" Class="vek-table-pagination-select" Underline="false" Dense="true" Disabled="@Disabled" SelectionOnEnter="true" aria-labelledby="@_rowsPerPageLabelId">
            @foreach (int pageSize in PageSizeOptions)
            {
                if (pageSize == int.MaxValue)
                {
                    <VekSelectItem T="int" Value="@pageSize">@AllItemsText</VekSelectItem>
                }
                else 
                {
                    <VekSelectItem T="int" Value="@pageSize">@pageSize.ToString().ToUpper()</VekSelectItem>
                }
            }
        </VekSelect>
    }

    @if (ShowPageNumber)
    {
        <VekText Typo="Typo.body2" Class="vek-table-pagination-caption" translate="no">
            @Info
        </VekText>
    }
    
    @if (ShowNavigation)
    {
        <div class="vek-table-pagination-actions">
            <VekIconButton Class="vek-flip-x-rtl" Icon="@Icons.Material.Filled.FirstPage" Disabled="@BackButtonsDisabled" @onclick="@(() => DataGrid?.NavigateTo(Page.First))" aria-label="@Localizer[LanguageResource.VekDataGridPager_FirstPage]" />
            <VekIconButton Class="vek-flip-x-rtl" Icon="@Icons.Material.Filled.NavigateBefore" Disabled="@BackButtonsDisabled" @onclick="@(() => DataGrid?.NavigateTo(Page.Previous))" aria-label="@Localizer[LanguageResource.VekDataGridPager_PreviousPage]" />
            <VekIconButton Class="vek-flip-x-rtl" Icon="@Icons.Material.Filled.NavigateNext" Disabled="@ForwardButtonsDisabled" @onclick="@(() => DataGrid?.NavigateTo(Page.Next))" aria-label="@Localizer[LanguageResource.VekDataGridPager_NextPage]" />
            <VekIconButton Class="vek-flip-x-rtl" Icon="@Icons.Material.Filled.LastPage" Disabled="@ForwardButtonsDisabled" @onclick="@(() => DataGrid?.NavigateTo(Page.Last))" aria-label="@Localizer[LanguageResource.VekDataGridPager_LastPage]" />
        </div>
    }

</VekToolBar>
