@namespace Vek
@inherits VekComponentBase
@typeparam T

@if (Visible)
{
    <li @attributes="UserAttributes" class="@Classname" style="@Style"
        draggable="@(GetAllowDragDrop() && !GetDisabled() ? "true" : null)"
        @ondragstart="HandleDragStartAsync"
        @ondragend="HandleDragEndAsync"
        @ondragover="HandleDragOver"
        @ondragover:preventDefault="GetAllowDrop()"
        @ondragleave="HandleDragLeave"
        @ondrop="HandleDropAsync"
        @ondrop:preventDefault="GetAllowDrop()">
        <div class="@ContentClassname"
             tabindex="@GetTabIndex()"
             @onclick="OnItemClickedAsync"
             @onclick:stopPropagation="true"
             @ondblclick="OnContentDoubleClickedAsync"
             @ondblclick:stopPropagation="true"
             @onkeydown="OnKeyDownAsync">
            @if (Content != null)
            {
                @Content
            }
            else
            {
                @if (DetermineHasChildren())
                {
                    <VekTreeViewItemToggleButton Disabled="@GetDisabled()" Loading="_loading" Expanded="_expandedState.Value" ExpandedChanged="OnItemExpanded" Visible="@AreChildrenVisible()" ExpandedIcon="@ExpandButtonIcon" ExpandedIconColor="@ExpandButtonIconColor" LoadingIcon="@LoadingIcon" LoadingIconColor="LoadingIconColor"></VekTreeViewItemToggleButton>
                }
                else
                {
                    <div class="vek-treeview-item-arrow" @ondblclick="OnArrowDoubleClick" @ondblclick:stopPropagation="true"></div>
                }

                @if (MultiSelection)
                {
                    <VekCheckBox T="bool?" TriState aria-labelledby="@(BodyContent is null ? _checkboxTextId : null)" Class="vek-treeview-item-checkbox" CheckedIcon="@CheckedIcon" UncheckedIcon="@UncheckedIcon" IndeterminateIcon="@GetIndeterminateIcon()"
                                 @bind-Value:get="GetCheckBoxStateTriState()" @bind-Value:set="@(x => OnCheckboxChangedAsync())" Disabled="@GetDisabled()" ReadOnly="@GetCheckBoxReadOnly()"></VekCheckBox>
                }

                @if (HasIcon)
                {
                    <div class="vek-treeview-item-icon">
                        <VekIcon Disabled="@GetDisabled()" Icon="@GetIcon()" Color="@IconColor" />
                    </div>
                }

                @if (_isEditing)
                {
                    <input class="vek-treeview-item-input"
                           type="text"
                           value="@_editingText"
                           @oninput="OnEditInput"
                           @onkeydown="OnEditKeyDownAsync"
                           @onkeydown:stopPropagation="true"
                           @onblur="OnEditBlurAsync"
                           @onclick:stopPropagation="true"
                           @ondblclick:stopPropagation="true"
                           aria-label="@(GetText() ?? "Rename node")"
                           autofocus />
                }
                else if (BodyContent != null)
                {
                    @BodyContent(this)
                }
                else
                {
                    @if (VekTreeRoot?.HasSearchText == true && GetText() is { } label && label.Contains(VekTreeRoot.GetFilterText(), StringComparison.OrdinalIgnoreCase))
                    {
                        var matchIndex = label.IndexOf(VekTreeRoot.GetFilterText(), StringComparison.OrdinalIgnoreCase);
                        @VekText.RenderText(TextTypo, TextClassname, label[..matchIndex], MultiSelection ? _checkboxTextId : null)<mark class="vek-tree-highlight">@label.Substring(matchIndex, VekTreeRoot.GetFilterText().Length)</mark>@VekText.RenderText(TextTypo, TextClassname, label[(matchIndex + VekTreeRoot.GetFilterText().Length)..])
                    }
                    else
                    {
                        @VekText.RenderText(TextTypo, TextClassname, GetText(), MultiSelection ? _checkboxTextId : null)
                    }

                    @if (!string.IsNullOrEmpty(EndText))
                    {
                        @VekText.RenderText(EndTextTypo, EndTextClass, EndText)
                    }

                    @if (!string.IsNullOrEmpty(EndIcon))
                    {
                        <div class="vek-treeview-item-icon">
                            <VekIcon Disabled="@Disabled" Icon="@EndIcon" Color="@EndIconColor" />
                        </div>
                    }
                }
            }
        </div>
        @if (DetermineHasChildren())
        {
            <VekCollapse Expanded="@_expandedState.Value">
                @if (VekTreeRoot is null)
                {
                    @* An item outside a tree passes its missing root on, so the nested tree does not become a root of its own. *@
                    <CascadingValue Value="@VekTreeRoot" IsFixed="true">
                        @RenderChildTree
                    </CascadingValue>
                }
                else
                {
                    @RenderChildTree
                }
            </VekCollapse>
        }
    </li>
}

@code {
    private void RenderChildTree(RenderTreeBuilder __builder)
    {
        <CascadingValue Value="this" IsFixed="true">
            <VekTreeView Items="@_itemsState.Value" ItemTemplate="VekTreeRoot?.ItemTemplate" Class="vek-treeview-group">
                @ChildContent
            </VekTreeView>
        </CascadingValue>
    }
}
