@using Vek.Resources
@namespace Vek
@inherits VekComponentBase
@inject InternalVekLocalizer Localizer

<div @attributes="UserAttributes" class="vek-treeview-item-arrow" @ondblclick="OnDoubleClick" @ondblclick:stopPropagation="true">
    @if (Visible)
    {
        <VekIconButton Disabled="@Disabled"
                       OnClick="@ToggleAsync"
                       Icon="@(Loading ? LoadingIcon : ExpandedIcon)"
                       Color="@(Loading ? LoadingIconColor : ExpandedIconColor)"
                       Class="@Classname"
                       Style="@Style"
                       aria-label="@(Expanded ? @Localizer[LanguageResource.VekTreeView_CollapseItem] : @Localizer[LanguageResource.VekTreeView_ExpandItem])" />
    }
</div>

