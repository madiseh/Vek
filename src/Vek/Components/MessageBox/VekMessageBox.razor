@namespace Vek
@inherits VekComponentBase

@{
}

<VekDialog @attributes="UserAttributes" Class="@Classname">
    <TitleContent>
        @if (TitleContent is null)
        {
            <VekText Typo="Typo.h6">@Title</VekText>
        }
        else
        {
            @TitleContent
        }
    </TitleContent>
    <DialogContent>
        @if (MessageContent is not null)
        {
            @MessageContent
        }
        else
        {
            @MarkupMessage
            @Message
        }
        @if (Prompt)
        {
            <VekTextField @bind-Value="_promptValue" Label="Response" />
        }
    </DialogContent>
    <DialogActions>
        <div tabindex="-1" class="d-contents">
            @if (IsButtonOrderReversed)
            {
                <VekFocusTrap DefaultFocus="DefaultFocus.FirstChild">
                    @ActionButtonsFragment
                </VekFocusTrap>
            }
            else
            {
                <VekFocusTrap DefaultFocus="DefaultFocus.LastChild">
                    @ActionButtonsFragment
                </VekFocusTrap>
            }
        </div>
    </DialogActions>
</VekDialog>

@code {
    private RenderFragment ActionButtonsFragment =>
    @<text>
        @if (CustomButtons is { Count: > 0 })
        {
            @foreach (var button in CustomButtons)
            {
                <VekButton Class="vek-message-box__custom-button"
                           Variant="@(button.IsDestructive ? Variant.Filled : Variant.Text)"
                           Color="@(button.IsDestructive ? Color.Error : Color.Primary)"
                           StartIcon="@button.StartIcon"
                           OnClick="@(() => OnCustomButtonClicked(button))">
                    @button.Text
                </VekButton>
            }
        }
        else if (IsButtonOrderReversed)
        {
            @YesButtonFragment
            @NoButtonFragment
            @CancelButtonFragment
        }
        else
        {
            @CancelButtonFragment
            @NoButtonFragment
            @YesButtonFragment
        }
    </text>;

    private RenderFragment CancelButtonFragment => 
    @<text>
        @if (CancelButton is not null)
        {
            <CascadingValue Value="@_cancelCallback">
                @CancelButton
            </CascadingValue>
        }
        else if (!string.IsNullOrWhiteSpace(CancelText))
        {
            <VekButton Class="vek-message-box__cancel-button" OnClick="OnCancelClicked">@CancelText</VekButton>
        }
    </text>;

    private RenderFragment NoButtonFragment =>
    @<text>
        @if (NoButton is not null)
        {
            <CascadingValue Value="@_noCallback">
                @NoButton
            </CascadingValue>
        }
        else if (!string.IsNullOrWhiteSpace(NoText))
        {
            <VekButton Class="vek-message-box__no-button" OnClick="OnNoClicked">@NoText</VekButton>
        }
    </text>;

    private RenderFragment YesButtonFragment =>
    @<text>
        @if (YesButton is not null)
        {
            <CascadingValue Value="@_yesCallback">
                @YesButton
            </CascadingValue>
        }
        else if (!string.IsNullOrWhiteSpace(YesText))
        {
            <VekButton Class="vek-message-box__yes-button" Color="Color.Primary" OnClick="OnYesClicked">@YesText</VekButton>
        }
    </text>;
}
