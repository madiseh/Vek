@namespace Vek
@typeparam T
@inherits VekDebouncedInput<T>

<VekInputControl Label="@Label"
                 Variant="@Variant"
                 HelperId="@GetHelperId()"
                 HelperText="@HelperText"
                 HelperTextOnFocus="@HelperTextOnFocus"
                 CounterText="@GetCounterText()"
                 FullWidth="@FullWidth"
                 Class="@Classname"
                 Error="@HasErrors"
                 ErrorId="@ErrorIdState.Value"
                 ErrorText="@GetErrorText()"
                 Disabled="@GetDisabledState()"
                 Margin="@Margin"
                 Required="@Required"
                 ForId="@InputElementId"
                 @onclick="@HandleContainerClickAsync">
    <InputContent>
        <CascadingValue Name="SubscribeToParentForm" Value="false" IsFixed="true">
            @if (_mask == null)
            {
                <VekInput T="string"
                          @ref="InputReference"
                          @attributes="UserAttributes"
                          Label="@Label"
                          InputType="@EffectiveInputType"
                          InputMode="@InputMode"
                          Lines="@Lines"
                          MaxLines="@MaxLines"
                          Sizing="@Sizing"
                          Style="@Style"
                          Variant="@Variant"
                          Typo="@Typo"
                          Value="@ReadText"
                          ValueChanged="@OnInnerValueChangedAsync"
                          Placeholder="@Placeholder"
                          Disabled=@GetDisabledState()
                          Underline="@Underline"
                          ReadOnly="@GetReadOnlyState()"
                          MaxLength="@MaxLength"
                          Adornment="@Adornment"
                          AdornmentText="@AdornmentText"
                          AdornmentIcon="@AdornmentIcon"
                          AdornmentColor="@AdornmentColor"
                          AdornmentAriaLabel="@AdornmentAriaLabel"
                          IconSize="@IconSize"
                          OnAdornmentClick="@OnAdornmentClick"
                          Error="@HasErrors"
                          ErrorId="@ErrorIdState.Value"
                          HelperId="@GetHelperId()"
                          HelperText="@HelperText"
                          Immediate="@EffectiveImmediate"
                          Margin="@Margin"
                          OnBlur="@OnBlurredAsync"
                          OnKeyDown="@InvokeKeyDownAsync"
                          OnKeyUp="@InvokeKeyUpAsync"
                          KeyDownPreventDefault="KeyDownPreventDefault"
                          KeyUpPreventDefault="KeyUpPreventDefault"
                          HideSpinButtons="true"
                          Clearable="@ShowClearButton()"
                          ClearButtonDisplayMode="@ClearButtonDisplayMode"
                          ClearIcon="@ClearIcon"
                          OnClearButtonClick="@OnClearButtonClick"
                          ShowPasswordToggle="@_showPasswordToggleState.Value"
                          PasswordVisible="@_passwordVisibleState.Value"
                          PasswordVisibleChanged="@OnInnerPasswordVisibleChangedAsync"
                          OnPasswordToggleClick="@OnPasswordToggleClick"
                          PasswordHiddenIcon="@PasswordHiddenIcon"
                          PasswordVisibleIcon="@PasswordVisibleIcon"
                          PasswordHiddenAriaLabel="@PasswordHiddenAriaLabel"
                          PasswordVisibleAriaLabel="@PasswordVisibleAriaLabel"
                          Pattern="@Pattern"
                          ShrinkLabel="@ShrinkLabel"
                          InputId="@InputElementId"
                          Required="@Required"/>
            }
            else
            {
                <VekMask @ref="_maskReference"
                         @attributes="UserAttributes"
                         Label="@Label"
                         Mask="@_mask"
                         InputType="@EffectiveInputType"
                         InputMode="@InputMode"
                         Lines="@Lines"
                         Style="@Style"
                         Variant="@Variant"
                         Typo="Typo"
                         Value="@ReadText"
                         ValueChanged="OnMaskedValueChangedAsync"
                         Placeholder="@Placeholder"
                         Disabled=@GetDisabledState()
                         Underline="@Underline"
                         ReadOnly="@GetReadOnlyState()"
                         MaxLength="@MaxLength"
                         Adornment="@Adornment"
                         AdornmentText="@AdornmentText"
                         AdornmentIcon="@AdornmentIcon"
                         AdornmentColor="@AdornmentColor"
                         AdornmentAriaLabel="@AdornmentAriaLabel"
                         IconSize="@IconSize"
                         OnAdornmentClick="@OnAdornmentClick"
                         Error="@HasErrors"
                         ErrorId="@ErrorIdState.Value"
                         HelperId="@HelperId"
                         HelperText="@HelperText"
                         Immediate="@EffectiveImmediate"
                         Margin="@Margin" OnBlur="@OnBlurredAsync"
                         OnKeyDown="@InvokeKeyDownAsync"
                         OnKeyUp="@InvokeKeyUpAsync"
                         Clearable="@ShowClearButton()"
                         ClearButtonDisplayMode="@ClearButtonDisplayMode"
                         ClearIcon="@ClearIcon"
                         OnClearButtonClick="@OnClearButtonClick"
                         ShrinkLabel="@ShrinkLabel"
                         InputId="@InputElementId"
                         Required="@Required"/>
            }
        </CascadingValue>
    </InputContent>
</VekInputControl>
