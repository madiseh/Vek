@namespace Vek
@inherits VekPicker<TimeSpan?>
@inject InternalVekLocalizer Localizer

@Render

@code {
    protected override RenderFragment PickerContent => 
    @<text><VekPickerToolbar Class="@ToolbarClassname" Style="@Style" ShowToolbar="@ShowToolbar" Orientation="@Orientation" PickerVariant="@PickerVariant" Color="@Color">
            <div class="vek-timepicker-hourminute vek-ltr">
                @if (TimeEditMode == TimeEditMode.Normal)
                {
                    <VekButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@HoursButtonClassname" OnClick="@OnHourClickAsync">@GetHourString()</VekButton>
                    <VekText Typo="@Typo.h2" Class="vek-timepicker-separator">:</VekText>
                    <VekButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@MinuteButtonClassname" OnClick="@OnMinutesClick">@GetMinuteString()</VekButton>
                }
                else
                {
                    <VekText Typo="Typo.h2" Class="vek-timepicker-separator">@GetHourString():@GetMinuteString()</VekText>
                }
            </div>
            @if (AmPm)
            {
                <div class="vek-timepicker-ampm">
                    <VekButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@AmButtonClassname" OnClick="OnAmClickedAsync">AM</VekButton>
                    <VekButton Variant="@Variant.Text" Color="@Color.Inherit" Class="@PmButtonClassname" OnClick="OnPmClickedAsync">PM</VekButton>
                </div>
            }
        </VekPickerToolbar>
        <VekPickerContent>
            <div class="vek-picker-time-container">
                <div class="vek-picker-time-clock">
                    <div tabindex="-1" class="vek-picker-time-clock-mask" @ref="ClockElementReference" @oncontextmenu="SuppressContextMenuHandler" @oncontextmenu:preventDefault>
                        <div class="@GetClockPinColor()"></div>
                        <div class="@GetClockPointerColor()" style="height: @GetPointerHeight(); transform: @GetPointerRotation()">
                            <div class="@GetClockPointerThumbColor()"></div>
                        </div>
                        <div class="@HourDialClassname">
                            @if (AmPm)
                            {
                                @*Hours from 1 to 12*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <VekText Class="@GetNumberColor(_i)" Style="@GetTransform(angle, 109, 0, 5)">@_i</VekText>
                                }
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    <div class="vek-picker-stick vek-hour" style="@($"transform: rotateZ({_i * 30}deg);")" data-stick-value="@_i"></div>
                                }
                            }
                            else
                            {
                                @*Hours from 13 to 24 (00)*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <VekText Class="@GetNumberColor((_i + 12) % 24)" Style="@GetTransform(angle, 109, 0, 5)">@(((_i + 12) % 24).ToString("D2"))</VekText>
                                }
                                @*Hours from 1 to 12*@
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    var angle = (6 - _i) * 30;
                                    <VekText Class="@GetNumberColor(_i)" Typo="Typo.body2" Style="@GetTransform(angle, 74, 0, 40)">@(_i.ToString("D2"))</VekText>
                                }
                                for (int i = 1; i <= 12; ++i)
                                {
                                    var _i = i;
                                    <div class="vek-picker-stick" style="@($"transform: rotateZ({_i * 30}deg);")">
                                        <div class="vek-picker-stick-inner vek-hour" data-stick-value="@_i"></div>
                                        <div class="vek-picker-stick-outer vek-hour" data-stick-value="@((_i + 12) % 24)"></div>
                                    </div>
                                }
                            }
                        </div>
                        <div class="@MinuteDialClassname">   
                            @*Minutes from 05 to 60 (00) - step 5*@                     
                            @for (int i = 0; i < 12; ++i)
                            {
                                var _i = i;
                                var angle = (6 - _i) * 30;
                                <VekText Class="@GetNumberColor(_i * 5)" Style="@GetTransform(angle, 109, 0, 5)">@((_i * 5).ToString("D2"))</VekText>
                            }
                            @for (int i = 0; i < 60; ++i)
                            {
                                var _i = i;
                                <div class="vek-picker-stick vek-minute" style="@($"transform: rotateZ({_i * 6}deg);")" data-stick-value="@_i"></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </VekPickerContent></text>;
}
