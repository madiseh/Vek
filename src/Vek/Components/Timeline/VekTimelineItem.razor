@namespace Vek
@inherits VekComponentBase

<div @attributes="UserAttributes" class="@Classnames" style="@Style" @onclick="Select">
    <div class="vek-timeline-item-content">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (ItemContent != null)
        {
            @ItemContent
        }
    </div>
    <div class="vek-timeline-item-divider">
        @if(!HideDot)
        {
            <div class="@DotClassnames">
                <div class="@DotInnerClassnames" style="@DotStyleValue">
                    @if (ItemDot is not null)
                    {
                        @ItemDot
                    }
                    else if (!string.IsNullOrEmpty(Icon))
                    {
                        <VekIcon Icon="@Icon" Class="vek-timeline-item-dot-icon" />
                    }
                </div>
            </div>
        }
    </div>
    @if (ItemOpposite is not null)
    {
        <div class="vek-timeline-item-opposite">
            @ItemOpposite
        </div>
    }
</div>
