@namespace Vek
@inherits VekComponentBase

<aside @onpointerenter="@PointerEnterCallback"
       @onpointerleave="@PointerLeaveCallback"
       @onpointerdown="@OnPointerDownCallback"
       @onpointermove="@OnPointerMoveCallback"
       @onpointerup="@OnPointerUpCallback"
       @onpointercancel="@OnPointerCancelCallback"
       @onkeydown="@OnKeyDownCallback"
       tabindex="@(CloseOnEscapeKey ? "-1" : null)"
       @attributes="UserAttributes"
       class="@Classname"
       style="@Stylename">
    <div @ref="_contentRef" class="vek-drawer-content">
        <CascadingValue Value="this" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </div>
</aside>
<VekOverlay Visible="@OverlayVisible" AutoClose="@OverlayAutoClose" OnClosed="CloseDrawerAsync" OnClick="HandleBackdropClickAsync" Class="@OverlayClass" DarkBackground="true" LockScroll="false" />
