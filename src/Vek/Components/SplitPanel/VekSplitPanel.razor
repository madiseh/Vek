@namespace Vek
@using Vek.Resources
@inherits VekComponentBase;
@inject InternalVekLocalizer Localizer

<div id="@_containerId" style="@Style" class="@Classname" @attributes="@UserAttributes">
    <div class="@ClassnameFirstPanel">
        @FirstPanel
    </div>
    <div class="@ClassnameDivider" 
         tabindex="0" 
         role="separator" 
         aria-label="@Localizer[LanguageResource.VekSplitPanel_ResizePanels]" 
         aria-orientation="@(Horizontal ? "horizontal" : "vertical")"></div>
    <div class="@ClassnameSecondPanel">
        @SecondPanel
    </div>
</div>
