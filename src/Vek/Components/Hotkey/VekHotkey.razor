@namespace Vek
@inherits VekComponentBase

@if (IsScopedContainer)
{
    <div role="@ScopeRole"
         aria-label="@AriaLabel"
         tabindex="@ScopeTabIndex"
         @attributes="UserAttributes"
         id="@EffectiveScopeId"
         class="@Classname"
         style="@Style"
         @onkeydown="OnScopedKeyDownAsync">
        @ChildContent
    </div>
}
else if (_childContentIsVisible)
{
    @ChildContent
}
