@namespace Vek
@inherits VekComponentBase

<div role="group"
     id="@FieldId"
     class="@Classname"
     style="@Style"
     @attributes="UserAttributes"
     @onkeydown="HandleRootKeyDownAsync">
    <VekButton @ref="_primaryButtonRef"
               Class="@PrimaryButtonClassname"
               Color="@_colorState.Value"
               Variant="@_variantState.Value"
               Size="@_sizeState.Value"
               Disabled="@IsPrimaryDisabled"
               Ripple="@Ripple"
               DropShadow="false"
               StartIcon="@StartIcon"
               EndIcon="@EndIcon"
               IconColor="@IconColor"
               IconSize="@IconSize"
               IconClass="@IconClass"
               OnClick="@HandlePrimaryClickAsync"
               aria-label="@AriaLabel">
        @if (MenuItems is not null && ChildContent is not null)
        {
            @ChildContent
        }
        else if (string.IsNullOrEmpty(Text) && ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Text
        }
    </VekButton>
    <VekMenu @ref="_menuRef"
             Class="@MenuClassname"
             PopoverClass="@PopoverClass"
             Icon="@DropDownIcon"
             Color="@_colorState.Value"
             Variant="@_variantState.Value"
             Size="@_sizeState.Value"
             Disabled="@IsDropDownDisabled"
             Ripple="@Ripple"
             DropShadow="false"
             Dense="@Dense"
             AnchorOrigin="@(AnchorOrigin ?? (Vertical ? Origin.BottomLeft : Origin.BottomRight))"
             TransformOrigin="@TransformOrigin"
             MaxHeight="@MaxHeight"
             Open="@_openState.Value"
             OpenChanged="@HandleOpenChangedAsync"
             AriaLabel="@DropDownAriaLabel">
        @if (MenuItems is not null)
        {
            @MenuItems
        }
        else if (!string.IsNullOrEmpty(Text) && ChildContent is not null)
        {
            @ChildContent
        }
    </VekMenu>
</div>
