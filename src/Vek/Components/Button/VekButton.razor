@namespace Vek
@inherits VekBaseButton
@implements IDisposable

@{
    OpenRoot(__builder, Classname, IsLoading);
    RenderLabel(__builder);
    __builder.CloseElement();
}

@code {
    private void RenderLabel(RenderTreeBuilder __builder)
    {
        <span class="vek-button-label">
            <span class="vek-button-content">
                @if (!string.IsNullOrWhiteSpace(StartIcon))
                {
                    <span class="@StartIconClass">
                        <VekIcon Disabled="@Disabled" Icon="@StartIcon" Size="@(IconSize ?? Size)" Color="@IconColor" />
                    </span>
                }
                @ChildContent
                @if (!string.IsNullOrWhiteSpace(EndIcon))
                {
                    <span class="@EndIconClass">
                        <VekIcon Disabled="@Disabled" Icon="@EndIcon" Size="@(IconSize ?? Size)" Color="@IconColor" />
                    </span>
                }
            </span>
            @if (IsLoading)
            {
                <span class="vek-button-loading-indicator" aria-hidden="true">
                    @if (LoadingTemplate is null)
                    {
                        <VekProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else
                    {
                        @LoadingTemplate
                    }
                </span>
            }
        </span>
    }
}
