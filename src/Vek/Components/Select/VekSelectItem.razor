@namespace Vek
@typeparam T
@inherits VekComponentBase

@if (!HideContent)
{
    <VekListItem @attributes="GetUserAttributes()" Value="@ItemId" id="@ItemId" OnClick="this.AsNonRenderingEventHandler(OnClickHandleAsync)" OnClickPreventDefault="true" Icon="@CheckBoxIcon" Disabled="@Disabled" KeyboardEnabled="false" Class="@GetCssClasses()" Style="@Style">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @DisplayString
        }
    </VekListItem>
}
