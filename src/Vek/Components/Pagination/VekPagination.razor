@namespace Vek
@using Vek.Resources
@inherits VekComponentBase
@inject InternalVekLocalizer Localizer

<ul @attributes="UserAttributes" class="@Classname" style="@Style">
    @if (ShowPageSizeSelector)
    {
        <li class="vek-pagination-utility vek-pagination-page-size">
            <label>
                <span>@Localizer[LanguageResource.VekPagination_ItemsPerPage]</span>
                <select class="vek-pagination-native-control" aria-label="@Localizer[LanguageResource.VekPagination_ItemsPerPage]" value="@_pageSizeState.Value" disabled="@Disabled" @onchange="OnPageSizeSelectionChangedAsync">
                    @foreach (var pageSize in EffectivePageSizeOptions)
                    {
                        <option value="@pageSize">@pageSize</option>
                    }
                </select>
            </label>
        </li>
    }
    @if (ShowPageSizeSelector || _totalItemsState.Value > 0)
    {
        <li class="vek-pagination-utility vek-pagination-item-range" aria-live="polite">@ItemRangeText</li>
    }
    @if (ShowDirectPageJump)
    {
        <li class="vek-pagination-utility vek-pagination-page-jump">
            <form class="vek-pagination-page-jump-form" @onsubmit="JumpToPageAsync" @onsubmit:preventDefault="true">
                <label>
                    <span>@Localizer[LanguageResource.VekPagination_GoToPage]</span>
                    <input class="vek-pagination-native-control" type="number" min="1" max="@PageCount" aria-label="@Localizer[LanguageResource.VekPagination_GoToPage]" @bind="_pageJumpValue" @bind:event="oninput" disabled="@Disabled" />
                </label>
                <button class="vek-pagination-jump-button" type="submit" disabled="@Disabled">@Localizer[LanguageResource.VekPagination_Go]</button>
            </form>
        </li>
    }
    @if (ShowFirstButton)
    {
        <li class="@ItemClassname">
            <VekIconButton Icon="@FirstIcon" Size="@Size" Variant="@Variant" Disabled="@(_selectedState.Value == 1 || Disabled)" OnClick="@(() => OnClickControlButtonAsync(Page.First))" aria-label="@Localizer[LanguageResource.VekPagination_FirstPage]"></VekIconButton>
        </li>
    }
    @if (ShowPreviousButton)
    {
        <li class="@ItemClassname">
            <VekIconButton Icon="@BeforeIcon" Size="@Size" Variant="@Variant" Disabled="@(_selectedState.Value == 1 || Disabled)" OnClick="@(() => OnClickControlButtonAsync(Page.Previous))" aria-label="@Localizer[LanguageResource.VekPagination_PreviousPage]"></VekIconButton>
        </li>
    }
    @if (ShowPageButtons)
    {
        foreach (var state in GeneratePagination())
        {
            var currentPage = state;
            if (currentPage == -1)
            {
                <li class="@ItemClassname">
                    <VekText disabled="@Disabled" aria-hidden="true">…</VekText>
                </li>
            }
            else if (currentPage == _selectedState.Value)
            {
                <li class="@SelectedItemClassname">
                    <VekButton Variant="@(Variant == Variant.Outlined ? Variant.Outlined : Variant.Filled)" Size="@Size" Ripple="false" Disabled="@Disabled" Color="@Color" aria-current="page" aria-label="@Localizer[LanguageResource.VekPagination_CurrentPage, $"{currentPage}"]">@currentPage</VekButton>
                </li>
            }
            else
            {
                <li class="@ItemClassname">
                    <VekButton OnClick="@(() => SetSelectedAsync(currentPage))" Variant="@Variant" Size="@Size" Ripple="false" Disabled="@Disabled" aria-label="@Localizer[LanguageResource.VekPagination_PageIndex, $"{currentPage}"]">@currentPage</VekButton>
                </li>
            }
        }
    }
    @if (ShowNextButton)
    {
        <li class="@ItemClassname">
            <VekIconButton Icon="@NextIcon" Variant="@Variant" Size="@Size" Disabled="@(_selectedState.Value == PageCount || Disabled)" OnClick="@(() => OnClickControlButtonAsync(Page.Next))" aria-label="@Localizer[LanguageResource.VekPagination_NextPage]"></VekIconButton>
        </li>
    }
    @if (ShowLastButton)
    {
        <li class="@ItemClassname">
            <VekIconButton Icon="@LastIcon" Variant="@Variant" Size="@Size" Disabled="@(_selectedState.Value == PageCount || Disabled)" OnClick="@(() => OnClickControlButtonAsync(Page.Last))" aria-label="@Localizer[LanguageResource.VekPagination_LastPage]"></VekIconButton>
        </li>
    }
</ul>
