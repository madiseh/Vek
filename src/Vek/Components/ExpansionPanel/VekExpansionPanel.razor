@namespace Vek
@inherits VekComponentBase

<div @attributes="UserAttributes" class="@Classname" style="@Style">
    <div class="@HeaderClassname" @onclick="ToggleExpansionAsync" tabindex="@(Disabled ? null : "0")" @onkeydown="HandleKeyDownAsync">
        <div class="vek-expand-panel-text">
            @if (TitleContent is not null)
            {
                @TitleContent
            }
            else
            {
                @Text
            }
        </div>
        @if (!HideIcon)
        {
            <VekIcon Icon="@Icon" class="@(_expandedState.Value ? "vek-expand-panel-icon vek-transform" : "vek-expand-panel-icon")" />
        }
    </div>
    <VekCollapse Expanded="_expandedState.Value" MaxHeight="@MaxHeight">
        @if (KeepContentAlive || _expandedState.Value)
        {
            <div class="@PanelContentClassname">
                @ChildContent
            </div>
        }
    </VekCollapse>
</div>
