<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;$(PrimaryTargetFramework)</TargetFrameworks>
    <TargetFrameworks Condition=" '$([MSBuild]::VersionGreaterThanOrEquals($(NETCoreSdkVersion), 11.0))' == 'true' Or '$(IncludeNet11)' == 'true' ">$(TargetFrameworks);net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <EnumGenerator_ForceInternal>true</EnumGenerator_ForceInternal>
    <NoWarn Condition="'$(TargetFramework)' == 'net11.0'">$(NoWarn);BL0011;BL0012;BL0016</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Nuget.png</PackageIcon>
    <Company>Vek</Company>
    <Authors>Amin Sabaghi</Authors>
    <Copyright>Copyright 2026 Amin Sabaghi (Vek)</Copyright>
    <PackageTags>Blazor, Vek, Material, Material Design, Components, Blazor Components, Blazor Library, .NET 8, .NET 10, .NET 11, net8.0, net10.0, net11.0</PackageTags>
    <Description>Enterprise-ready Blazor Component Suite based on Material Design principles with an emphasis on ease of use and extensibility. Built for .NET 8.0, .NET 10.0, and .NET 11.0.</Description>
    <PackageProjectUrl>https://vekui.dev</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/madiseh/vek</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
    <TrimMode>link</TrimMode>
    <!-- The trim (IL2xxx) analyzer only matters for consumers who trim the packaged library, so run it only in Release/pack where the package is actually produced; skipping it shaves the local Debug inner loop without losing CI coverage. -->
    <EnableTrimAnalyzer Condition="'$(Configuration)' == 'Release' Or '$(_IsPacking)' == 'true'">true</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>

    <!-- https://github.com/dotnet/runtime/issues/95134 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" Visible="false" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" Visible="false" PackagePath="" />
    <None Include="..\..\content\Nuget.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

  <!--Analyzer Config-->
  <PropertyGroup>
    <VekAllowedAttributePattern>LowerCase</VekAllowedAttributePattern>
    <VekDebugAnalyzer>false</VekDebugAnalyzer>
  </PropertyGroup>

  <!--Is this a rebuild - Dont clean generated files as this breaks rebuild behaviour-->
  <Target Name="ShouldCleanGeneratedFiles" BeforeTargets="BeforeRebuild">
    <PropertyGroup>
      <CleanGeneratedFiles>false</CleanGeneratedFiles>
    </PropertyGroup>
  </Target>

  <Target Name="CleanGeneratedFiles" BeforeTargets="Clean" Condition="'$(CleanGeneratedFiles)' != 'false'">
    <ItemGroup>
      <FilesToClean Include="./TScripts/combined/Vek.js" />
      <FilesToClean Include="./wwwroot/Vek.min.js" />
      <FilesToClean Include="./wwwroot/Vek.min.js.map" />
      <FilesToClean Include="./wwwroot/Vek.min.css" />
      <FilesToClean Include="./wwwroot/Vek.css" />
      <FilesToClean Include="./wwwroot/css/Vek.css" />
    </ItemGroup>
    <Delete Files="@(FilesToClean)" />
  </Target>

  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
    <PackageReference Include="Microsoft.AspNetCore.Components" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NetEscapades.EnumGenerators.Generators" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Vek.Utilities.StringHelpers" Static="True" />
  </ItemGroup>

  <ItemGroup>
    <!-- No scripts are JavaScript any more; this input reruns build.mts when one is added, so its check rejects it. -->
    <JsAssetInputs Include="TScripts/**/*.js;TScripts/**/*.cjs;TScripts/**/*.mjs;TScripts/**/*.jsx" />
    <TsAssetInputs Include="TScripts/**/*.ts" />
    <ScssAssetInputs Include="Styles/**/*.scss" />
    <BuildScriptInputs Include="build.mts" />
    <BuildScriptInputs Include="bunfig.toml" />
    <BuildScriptInputs Include="test-setup.ts" />
    <BuildScriptInputs Include="tsconfig.json" />
    <BuildScriptInputs Include="../.oxlintrc.json" />
    <BuildScriptInputs Include="../tsconfig.json" />
    <WebAssetInputs Include="@(JsAssetInputs);@(TsAssetInputs);@(ScssAssetInputs);@(BuildScriptInputs);@(BunToolchainInputs)" />
    <UpToDateCheckInput Include="@(WebAssetInputs)" />
    <WebAssetOutputs Include="wwwroot/Vek.min.js;wwwroot/Vek.min.js.map;wwwroot/Vek.min.css" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Check if we're the first TFM when building directly (no outer build) -->
    <_IsFirstTfm>false</_IsFirstTfm>
    <_IsFirstTfm Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0'">true</_IsFirstTfm>
  </PropertyGroup>

  <Target Name="BuildWebAssets"
          BeforeTargets="DispatchToInnerBuilds"
          Condition="'$(IsCrossTargetingBuild)' == 'true' AND '$(SkipBunCompile)' != 'true'"
          Inputs="@(WebAssetInputs)"
          Outputs="@(WebAssetOutputs)">

    <Message Importance="High"
             Text="Building Vek web assets (outer build)" />

    <Exec Command="$(BunToolRestore)"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Exec Command="$(BunInstall)"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Exec Command="$(BunWrapper) run build.mts"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="BuildWebAssetsInner"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(IsCrossTargetingBuild)' != 'true'
                AND '$(DesignTimeBuild)' != 'true'
                AND '$(_IsFirstTfm)' == 'true'
                AND '$(SkipBunCompile)' != 'true'"
          Inputs="@(WebAssetInputs)"
          Outputs="@(WebAssetOutputs)">

    <Message Importance="High"
             Text="Building Vek web assets (inner build, TFM: $(TargetFramework))" />

    <Exec Command="$(BunToolRestore)"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Exec Command="$(BunInstall)"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Exec Command="$(BunWrapper) run build.mts"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="RegisterGeneratedAssets"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'$(IsCrossTargetingBuild)' != 'true'
                AND '$(DesignTimeBuild)' != 'true'
                AND '$(SkipBunCompile)' != 'true'">

    <ItemGroup>
      <_NewAssets Include="@(WebAssetOutputs)"
                  Exclude="@(Content)" />
      <Content Include="@(_NewAssets)" />
    </ItemGroup>

  </Target>



  <ItemGroup>
    <ProjectReference Include="..\Analyzers\Vek.Analyzers\Vek.Analyzers.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
    <ProjectReference Include="..\Analyzers\Vek.Analyzers.CodeFixes\Vek.Analyzers.CodeFixes.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" OutputItemType="Analyzer" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!--Add analyzer to build output so it works transitively -->
  <Target Name="_AddAnalyzersToOutput">
    <!--Limit to one copy (Vek is multi targeted) analyzers are .net standard 2.0 -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
      <TfmSpecificPackageFile Include="..\Analyzers\Vek.Analyzers\bin\$(Configuration)\netstandard2.0\$(AssemblyName).Analyzers.dll" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="..\Analyzers\Vek.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\$(AssemblyName).Analyzers.CodeFixes.dll" PackagePath="analyzers/dotnet/cs" />
      <!-- Add compiler visible properties to nuget for analyzers -->
      <TfmSpecificPackageFile Include="..\..\Directory.Build.targets" Pack="true" PackagePath="build\$(PackageId).targets" />
    </ItemGroup>
  </Target>

  <!--Dont Include in build output-->
  <ItemGroup>
    <Content Remove="build.mts" />
    <Content Remove="tsconfig.json" />
    <Content Remove="wwwroot/DoNotRemove.txt" />
    <Content Remove="wwwroot/css/Vek.css" />
    <!--macOS hidden file (causes problems with dotnet pack)-->
    <Content Remove="**/*/.DS_Store" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vek.Docs" />
    <InternalsVisibleTo Include="Vek.UnitTests.Shared" />
    <InternalsVisibleTo Include="Vek.UnitTests" />
    <InternalsVisibleTo Include="Vek.UnitTests.Docs" />
    <InternalsVisibleTo Include="Vek.UnitTests.Viewer" />
    <InternalsVisibleTo Include="Vek.Benchmarks" />
    <!--We need to make internal types to be visible for mocking-->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\LanguageResource.resx">
      <Public>false</Public>
      <AsConstants>true</AsConstants>
    </EmbeddedResource>
  </ItemGroup>

</Project>
