<VekGrid Class="docs-footer">
    <VekItem xs="6" sm="3">
        <VekLogo Style="width:40px;"/>
        <div class="d-flex flex-column mt-4">
            <div class="d-flex align-center my-2">
                <VekIcon Icon="@Icons.Custom.Brands.Vek" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                <VekText Typo="Typo.body1">Vek Blazor</VekText>
            </div>
            <div class="d-flex align-center my-2">
                <VekIcon Icon="@Icons.Material.Rounded.Code" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                <VekText Typo="Typo.body1">Open Source Core Team</VekText>
            </div>
            <div class="d-flex align-center my-2">
                <VekIcon Icon="@Icons.Material.Rounded.VerifiedUser" Size="Size.Small" Color="Color.Inherit" Class="mr-2" />
                <VekText Typo="Typo.body1">MIT License</VekText>
            </div>
        </div>
        <div class="d-flex mt-4">
            <VekIconButton Href="https://twitter.com/Vek" Target="_blank" Edge="Edge.Start" Class="me-2" Color="Color.Inherit" Icon="@Icons.Custom.Brands.Twitter" aria-label="twitter" />
            <VekIconButton Href="https://discord.gg/vek" Target="_blank" Edge="Edge.Start" Class="me-2" Color="Color.Inherit" Icon="@Icons.Custom.Brands.Discord" aria-label="discord"/>
            <VekIconButton Href="https://github.com/madiseh/vek" Target="_blank" Edge="Edge.Start" Class="me-2" Color="Color.Inherit" Icon="@Icons.Custom.Brands.GitHub" aria-label="github"/>
            <VekIconButton Href="https://stackoverflow.com/tags/vek" Target="_blank" Edge="Edge.Start" Class="me-2" Color="Color.Inherit" Icon="@Icons.Custom.Brands.StackOverflow" aria-label="stack overflow"/>
        </div>
    </VekItem>
    <VekItem xs="6" sm="3" Class="d-flex flex-column">
        <VekText Typo="Typo.subtitle2" Class="mb-3">Community</VekText>
        <VekLink Href="/vek/community/getting-help" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Getting Help</VekLink>
        <VekLink Href="/vek/community/reporting-bugs" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Reporting Bugs</VekLink>
        <VekLink Href="/vek/community/contribution" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Contribute</VekLink>
        <VekLink Href="/vek/community/extensions" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Community Extensions</VekLink>
    </VekItem>
    <VekItem xs="6" sm="3" Class="d-flex flex-column">
        <VekText Typo="Typo.subtitle2" Class="mb-3">Project</VekText>
        <VekLink Href="/vek/project/releases" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Releases</VekLink>
        <VekLink Href="/vek/project/roadmap" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Roadmap</VekLink>
        <VekLink Href="/vek/project/sponsor" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Sponsors & Backers</VekLink>
        <VekLink Href="/vek/project/team" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Team & Contributors</VekLink>
        <VekLink Href="/vek/project/how-it-started" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">How it started</VekLink>
    </VekItem>
    <VekItem xs="6" sm="3" Class="d-flex flex-column">
        <VekText Typo="Typo.subtitle2" Class="mb-3">Ecosystem & Resources</VekText>
        <VekLink Href="https://github.com/madiseh/vek" Target="_blank" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">GitHub Repository</VekLink>
        <VekLink Href="https://www.nuget.org/packages/Vek" Target="_blank" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">NuGet Package</VekLink>
        <VekLink Href="/docs/overview" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Components Showcase</VekLink>
        <VekLink Href="/api" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">API Documentation</VekLink>
        <VekLink Href="/vek/cookie-policy" Typo="Typo.body1" Color="Color.Inherit" Underline="Underline.None">Cookie Policy</VekLink>
    </VekItem>
    <VekItem xs="12">
        <VekToolBar Gutters="false" Dense="true">
            <VekText Typo="Typo.body1">@($"Copyright © 2020-{DateTime.Now.Year} Vek")</VekText>
        </VekToolBar>
    </VekItem>
</VekGrid>
