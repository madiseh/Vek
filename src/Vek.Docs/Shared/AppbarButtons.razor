@using Vek.Docs.Enums

<VekMenu Icon="@Icons.Material.Outlined.NotificationsNone"
         Color="Color.Inherit"
         Variant="Variant.Text"
         AriaLabel="Latest Vek releases"
         PopoverClass="docs-layout-menu-shadow docs-release-popover"
         ListClass="docs-release-list"
         AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         MaxHeight="420">
    <VekMenuItem Disabled="true" Class="docs-release-heading">
        <VekText Typo="Typo.subtitle1" Class="font-weight-bold">Latest Vek releases</VekText>
    </VekMenuItem>
    @if (_latestReleases.Length == 0)
    {
        <VekMenuItem Disabled="true" Label="No releases are available right now" />
    }
    else
    {
        @foreach (var release in _latestReleases)
        {
            <VekMenuItem Href="@release.HtmlUrl" Target="_blank" Class="docs-release-item" rel="noopener noreferrer">
                <div class="d-flex flex-column">
                    <VekText Typo="Typo.subtitle1" Class="font-weight-bold">@GetReleaseTitle(release)</VekText>
                    <VekText Typo="Typo.body2" Color="Color.Secondary">Vek Team · @GetReleaseDate(release)</VekText>
                </div>
            </VekMenuItem>
        }
    }
</VekMenu>

<VekTooltip Text="@RtlButtonText">
    <VekIconButton OnClick="@LayoutService.ToggleRightToLeftAsync" Icon="@RtlButtonIcon" Color="Color.Inherit" aria-label="@RtlButtonText" />
</VekTooltip>

<VekTooltip Text="@DarkLightModeButtonText">
    <VekIconButton OnClick="@LayoutService.CycleDarkLightModeAsync" Icon="@DarkLightModeButtonIcon" Color="Color.Inherit" aria-label="@DarkLightModeButtonText" />
</VekTooltip>
