@using System.Runtime.Versioning

<VekMainContent Class="vek-main-content">
    <VekContainer MaxWidth="MaxWidth.Large">
        <div id="docspage" class="docs-page">
            <CascadingValue Value="this" IsFixed>
                @ChildContent
            </CascadingValue>
        </div>
        <div class="docs-navigation-footer">
            <NavigationFooter Section=_section Previous="@_previous" Next="@_next" />
        </div>
    </VekContainer>
    @if (DisplayFooter)
    {
        <VekContainer MaxWidth="MaxWidth.Large" Class="mt-16">
            <Footer />
        </VekContainer>
    }
    else
    {
        // Just show copyright and version
        <VekContainer MaxWidth="MaxWidth.Large">
            <VekToolBar Gutters="false" Dense="true">
                <VekText Typo="Typo.body1">Copyright © 2020-@DateTime.Now.Year Vek</VekText>
                <VekSpacer />
                <VekText Typo="Typo.body1">Powered by .NET @Environment.Version.ToString()</VekText>
            </VekToolBar>
        </VekContainer>
    }
    <VekDrawer Class="docs-page-content-navigation-drawer" @bind-Open="_contentDrawerOpen" Breakpoint="Breakpoint.Lg" Anchor="Anchor.End" ClipMode="DrawerClipMode.Always" Elevation="0" Color="Color.Transparent">
        @if (_displayView)
        {
            <VekText Typo="Typo.subtitle1" Class="title" GutterBottom="true">
                Mode
            </VekText>
            <div class="d-flex px-2 mb-2">
                <NavLink class="mode-links mr-2" href="@($"components/{_componentName}")" Match="NavLinkMatch.All">Overview</NavLink>
                <NavLink class="mode-links ml-2" href="@($"api/{_componentName}")" Match="NavLinkMatch.All">API</NavLink>
            </div>
        }
        <VekPageContentNavigation SectionClassSelector="docs-section-anchor" @ref="_contentNavigation" ActivateFirstSectionAsDefault="true" />
        @if (_renderAds)
        {
            <VekElement HtmlTag="script" async type="text/javascript" src="//cdn.carbonads.com/carbon.js?serve=CESDLK3E&placement=vekcom" id="_carbonads_js" data-consent-category="carbon"></VekElement>
        }
        @if (_adBlockerDetected)
        {
            <VekAlert Severity="Severity.Error" Class="ma-4" Elevation="1">
                <VekText Typo="Typo.subtitle2" GutterBottom="true">Support Vek</VekText>
                <VekText Typo="Typo.body2" Class="ms-n8">
                    It looks like an ad blocker is hiding the ad in this slot.
                    Please consider allowing ads on this site.
                </VekText>
            </VekAlert>
        }
    </VekDrawer>
</VekMainContent>
