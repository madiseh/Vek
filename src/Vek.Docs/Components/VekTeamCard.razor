<VekCard Style="height: 100%" Class="d-flex flex-column">
    <VekCardHeader>
        <CardHeaderAvatar>
            <VekAvatar Style="width: 64px; height: 64px;" Class="vek-elevation-4">
                <VekImage Src="@Member.Avatar" Alt="GitHub Avatar" />
            </VekAvatar>
        </CardHeaderAvatar>

        <CardHeaderContent>
            <VekText Typo="Typo.h6">@Member.Name</VekText>
            <VekText Typo="Typo.body2" Class="vek-text-secondary">@($"@{Member.GitHub}")</VekText>
        </CardHeaderContent>
    </VekCardHeader>

    <VekCardContent Class="py-0 flex-grow-1">
        @if (DisplayTeam || Member.Team == Team.CoreMaintainer || !string.IsNullOrWhiteSpace(Member.From))
        {
            <VekStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                @if (DisplayTeam || Member.Team == Team.CoreMaintainer)
                {
                    <VekChip T="string" Variant="Variant.Text" Size="Size.Small" Color="@(Member.Team == Team.Contribution ? Color.Secondary : Color.Primary)">@Member.Team.ToStringFast(true)</VekChip>
                }

                @if (!string.IsNullOrWhiteSpace(Member.From))
                {
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="0" Class="vek-text-secondary">
                        <VekIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Inherit" Class="me-1" />
                        <VekText Typo="Typo.body2">@Member.From</VekText>
                    </VekStack>
                }
            </VekStack>
        }

        @if (!string.IsNullOrWhiteSpace(Member.Bio))
        {
            <VekText Typo="Typo.body2">@Member.Bio</VekText>
        }
    </VekCardContent>

    <VekCardActions Class="mt-auto flex-wrap">
        <VekChip T="string" Variant="Variant.Outlined" Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Target="_blank" Href="@($"https://github.com/{Member.GitHub}")">
            GitHub
        </VekChip>

        @if (Member.GitHubSponsor)
        {
            <VekChip T="string" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.FavoriteBorder" Color="Color.Secondary" Target="_blank" Href="@($"https://github.com/sponsors/{Member.GitHub}")">
                Sponsor
            </VekChip>
        }

        @if (!string.IsNullOrWhiteSpace(Member.LinkedIn))
        {
            <VekChip T="string" Variant="Variant.Outlined" Icon="@Icons.Custom.Brands.LinkedIn" Color="Color.Primary" Target="_blank" Href="@Member.LinkedIn">
                LinkedIn
            </VekChip>
        }
    </VekCardActions>
</VekCard>

@code {

    [Parameter] public TeamMember Member { get; set; }
    [Parameter] public bool DisplayTeam { get; set; }
}
