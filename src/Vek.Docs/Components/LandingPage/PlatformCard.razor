@namespace Vek.Docs.Components.LandingPage

<VekPaper Class="rounded-lg d-flex pa-6" Elevation="@Elevation">
    <div class="d-flex justify-center align-center">
        <VekIcon Icon="@Icon" Style="width:48px;height:48px;"/>
    </div>
    <div class="d-flex flex-column ml-6">
        <div class="d-flex">
            <VekText Typo="Typo.h6" Color="Color.Default">Vek</VekText>
            <VekText Typo="Typo.h6" Color="@Color">@Name</VekText>
        </div>
        <VekText Typo="Typo.body1">@Description</VekText>
    </div>
</VekPaper>
@code {
    [Parameter] public string Icon { get; set; }
    [Parameter] public string Name { get; set; }
    [Parameter] public Color Color { get; set; }
    [Parameter] public int Elevation { get; set; }
    [Parameter] public string Description { get; set; }
}