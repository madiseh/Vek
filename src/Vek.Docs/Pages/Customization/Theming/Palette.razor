@page "/customization/palette"
<DocsPage>
    <DocsPageHeader Title="Palette" SubTitle="The palette is the colors the theme uses for all the components and main layout.">
    </DocsPageHeader>
    <DocsPageSection>
        <VekText Typo="Typo.h4" Class="py-4">Default Colors</VekText>
        <VekGrid>
            <VekItem xs="12" sm="12" md="4">
                <VekPaper Class="vek-theme-primary">
                    <VekText Align="Align.Center" Class="py-16">Primary</VekText>
                    <div class="d-flex">
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--vek-palette-primary-lighten); color: #fff;">
                            <VekText Align="Align.Center" Class="py-6">Lighten</VekText>
                        </VekPaper>
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--vek-palette-primary-darken); color: #fff;">
                            <VekText Align="Align.Center" Class="py-6">Darken</VekText>
                        </VekPaper>
                    </div>
                </VekPaper>
            </VekItem>
            <VekItem xs="12" sm="12" md="4">
                <VekPaper Class="vek-theme-secondary">
                    <VekText Align="Align.Center" Class="py-16">Secondary</VekText>
                    <div class="d-flex">
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--vek-palette-secondary-lighten); color: #fff;">
                            <VekText Align="Align.Center" Class="py-6">Lighten</VekText>
                        </VekPaper>
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--vek-palette-secondary-darken); color: #fff;">
                            <VekText Align="Align.Center" Class="py-6">Darken</VekText>
                        </VekPaper>
                    </div>
                </VekPaper>
            </VekItem>
            <VekItem xs="12" sm="12" md="4">
                <VekPaper Class="vek-theme-tertiary">
                    <VekText Align="Align.Center" Class="py-16">Tertiary</VekText>
                    <div class="d-flex">
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--vek-palette-tertiary-lighten); color: #fff;">
                            <VekText Align="Align.Center" Class="py-6">Lighten</VekText>
                        </VekPaper>
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--vek-palette-tertiary-darken); color: #fff;">
                            <VekText Align="Align.Center" Class="py-6">Darken</VekText>
                        </VekPaper>
                    </div>
                </VekPaper>
            </VekItem>
            <VekItem xs="12" sm="6" md="3">
                <VekPaper Class="vek-theme-info">
                    <VekText Align="Align.Center" Class="py-16">Info</VekText>
                    <div class="d-flex">
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--vek-palette-info-lighten); color: #fff;">
                            <VekText Align="Align.Center" Class="py-4">Lighten</VekText>
                        </VekPaper>
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--vek-palette-info-darken); color: #fff;">
                            <VekText Align="Align.Center" Class="py-4">Darken</VekText>
                        </VekPaper>
                    </div>
                </VekPaper>
            </VekItem>
            <VekItem xs="12" sm="6" md="3">
                <VekPaper Class="vek-theme-success">
                    <VekText Align="Align.Center" Class="py-16">Success</VekText>
                    <div class="d-flex">
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--vek-palette-success-lighten); color: #fff;">
                            <VekText Align="Align.Center" Class="py-4">Lighten</VekText>
                        </VekPaper>
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--vek-palette-success-darken); color: #fff;">
                            <VekText Align="Align.Center" Class="py-4">Darken</VekText>
                        </VekPaper>
                    </div>
                </VekPaper>
            </VekItem>
            <VekItem xs="12" sm="6" md="3">
                <VekPaper Class="vek-theme-warning">
                    <VekText Align="Align.Center" Class="py-16">Warning</VekText>
                    <div class="d-flex">
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--vek-palette-warning-lighten); color: #fff;">
                            <VekText Align="Align.Center" Class="py-4">Lighten</VekText>
                        </VekPaper>
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--vek-palette-warning-darken); color: #fff;">
                            <VekText Align="Align.Center" Class="py-4">Darken</VekText>
                        </VekPaper>
                    </div>
                </VekPaper>
            </VekItem>
            <VekItem xs="12" sm="6" md="3">
                <VekPaper Class="vek-theme-error">
                    <VekText Align="Align.Center" Class="py-16">Error</VekText>
                    <div class="d-flex">
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--vek-palette-error-lighten); color: #fff;">
                            <VekText Align="Align.Center" Class="py-4">Lighten</VekText>
                        </VekPaper>
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--vek-palette-error-darken); color: #fff;">
                            <VekText Align="Align.Center" Class="py-4">Darken</VekText>
                        </VekPaper>
                    </div>
                </VekPaper>
            </VekItem>
            <VekItem xs="12" sm="12" md="12">
                <VekPaper Class="vek-theme-dark">
                    <VekText Align="Align.Center" Class="py-6">Dark</VekText>
                    <div class="d-flex">
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-bl" Style="background-color: var(--vek-palette-dark-lighten); color: #fff;">
                            <VekText Align="Align.Center" Class="py-3">Lighten</VekText>
                        </VekPaper>
                        <VekPaper Elevation="0" Class="flex-grow-1 rounded-0 rounded-br" Style="background-color: var(--vek-palette-dark-darken); color: #fff;">
                            <VekText Align="Align.Center" Class="py-3">Darken</VekText>
                        </VekPaper>
                    </div>
                </VekPaper>
            </VekItem>
        </VekGrid>
        <VekText Typo="Typo.h4" Class="py-4">Texts</VekText>
        <SectionContent DarkenBackground="true">
            <VekGrid>
                <VekItem xs="12" sm="12" md="4">
                    <VekPaper Class="pa-2">
                        <VekText Align="Align.Center" Class="py-6 vek-text-primary" Style="font-size: 1.5rem;">Text Primary</VekText>
                    </VekPaper>
                </VekItem>
                <VekItem xs="12" sm="12" md="4">
                    <VekPaper Class="pa-2">
                        <VekText Align="Align.Center" Class="py-6 vek-text-secondary" Style="font-size: 1.5rem;">Text Secondary</VekText>
                    </VekPaper>
                </VekItem>
                <VekItem xs="12" sm="12" md="4">
                    <VekPaper Class="pa-2">
                        <VekText Align="Align.Center" Class="py-6 vek-text-disabled" Style="font-size: 1.5rem;">Text Disabled</VekText>
                    </VekPaper>
                </VekItem>
            </VekGrid>
        </SectionContent>
    </DocsPageSection>
</DocsPage>