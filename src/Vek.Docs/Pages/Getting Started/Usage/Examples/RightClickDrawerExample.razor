@namespace Vek.Docs.Examples

<div @oncontextmenu="ClickForDrawer" @oncontextmenu:preventDefault class="d-flex align-center justify-center" style="height: calc(100vh - 64px); background: linear-gradient(90deg, #00C9FF 0%, #92FE9D 100%);">
    <VekDrawer @bind-Open="@drawerOpen" Anchor="@Anchor.Right" Elevation="1" Variant="@DrawerVariant.Temporary" Overlay="false">
        <VekDrawerHeader>
            <VekText Typo="Typo.h6">My Drawer</VekText>
        </VekDrawerHeader>
        <VekCard>
            <VekCardContent>
                <VekButton Color="Color.Primary" Variant="Variant.Outlined">New record</VekButton>
            </VekCardContent>
        </VekCard>
        <VekList T="string">
            <VekListSubheader>List</VekListSubheader>
            <VekListItem Text="Item 1"></VekListItem>
        </VekList>
    </VekDrawer>

    <VekText Class="white-text" Typo="Typo.h6">Right click to somewhere!</VekText>
</div>

@code{
    bool drawerOpen;

    private void ClickForDrawer(MouseEventArgs arg)
    {
        if (drawerOpen == false)
        {
            drawerOpen = true;
        }
        else
        {
            drawerOpen = false;
        }
    }
}
