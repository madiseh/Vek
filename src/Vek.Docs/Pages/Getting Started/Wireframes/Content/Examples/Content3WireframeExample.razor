@namespace Vek.Docs.Wireframes
@layout WireframeContentLayout2
@page "/getting-started/wireframes/content3"

<VekContainer Class="mt-16" MaxWidth="MaxWidth.Medium">
    <VekText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">Checkout</VekText>
    <VekGrid Spacing="12" Class="mt-16">
        <VekItem xs="7">
            <VekText Typo="Typo.h5" GutterBottom="true">Billing address</VekText>
            <VekGrid>
                <VekItem xs="12">
                    <VekTextField T="string" Label="Email" />
                </VekItem>
                <VekItem xs="12">
                    <VekTextField T="string" Label="Mobile number" />
                </VekItem>
                <VekItem xs="12">
                    <VekTextField T="string" Label="Personal number" />
                </VekItem>
                <VekItem xs="6">
                    <VekTextField T="string" Label="First name" />
                </VekItem>
                <VekItem xs="6">
                    <VekTextField T="string" Label="Last name" />
                </VekItem>
                <VekItem xs="12">
                    <VekTextField T="string" Label="Address" />
                </VekItem>
                <VekItem xs="6">
                    <VekTextField T="string" Label="Postal code" />
                </VekItem>
                <VekItem xs="6">
                    <VekTextField T="string" Label="Postal Area" />
                </VekItem>
                <VekItem xs="12" Class="d-flex justify-center">
                    <VekButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" Size="Size.Large" Class="mt-8">Continue to Payment</VekButton>
                </VekItem>
            </VekGrid>
        </VekItem>
        <VekItem xs="5">
            <VekText Typo="Typo.h5" GutterBottom="true">Cart</VekText>
            <VekPaper Class="d-flex flex-column" Style="height:100%;" Outlined="true">
                <VekList T="string">
                    <VekListItem Icon="@Icons.Material.Filled.ContentCut">
                        <div class="d-flex">
                            <VekText>Scissor - Big</VekText>
                            <VekText HtmlTag="span" Class="ml-auto">$5</VekText>
                        </div>
                    </VekListItem>
                    <VekListItem Icon="@Icons.Material.Filled.AirplanemodeActive">
                        <div class="d-flex">
                            <VekText>Model Airplane</VekText>
                            <VekText Class="ml-auto">$20</VekText>
                        </div>
                    </VekListItem>
                    <VekListItem Icon="@Icons.Material.Filled.Create">
                        <div class="d-flex">
                            <VekText>Plastic Glue</VekText>
                            <VekText Class="ml-auto">$12</VekText>
                        </div>
                    </VekListItem>
                    <VekListItem Icon="@Icons.Material.Filled.ColorLens">
                        <div class="d-flex">
                            <VekText>Color set - Modern planes</VekText>
                            <VekText Class="ml-auto">$16</VekText>
                        </div>
                    </VekListItem>
                </VekList>
                <div class="mt-auto">
                    <VekDivider />
                    <div class="d-flex pa-4">
                        <VekText>Total:</VekText>
                        <VekText Class="ml-auto"><b>$53</b></VekText>
                    </div>
                </div>
            </VekPaper>
        </VekItem>
    </VekGrid>
</VekContainer>
