@namespace Vek.Docs.Wireframes
@layout WireframeContentLayout2
@page "/getting-started/wireframes/content2"



<VekContainer Class="mt-16">
    <VekText Typo="Typo.h3" Align="Align.Center" GutterBottom="true">Pricing</VekText>
    <VekText Align="Align.Center">Some long pricing text should go here maybe? who knows what text you would want here, i guess i cant fill it in for you.</VekText>
    <VekGrid Class="mt-8">
        <VekItem xs="12" sm="6" md="4">
            <VekCard Elevation="25" Class="rounded-lg pb-4">
                <VekCardHeader>
                    <CardHeaderContent>
                        <VekText Typo="Typo.h5" Align="Align.Center">Beginner</VekText>
                    </CardHeaderContent>
                </VekCardHeader>
                <VekCardContent>
                    <div class="d-flex justify-center">
                        <VekText Typo="Typo.h3">$5</VekText>
                        <VekText Typo="Typo.h5" Class="ml-1 mt-5" Color="Color.Secondary">/Monthly</VekText>
                    </div>
                    <VekList T="string" Class="mx-auto mt-4" Style="width:300px;">
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            Unlimited something
                        </VekListItem>
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            10 something
                        </VekListItem>
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            No something
                        </VekListItem>
                    </VekList>
                </VekCardContent>
                <VekCardActions Class="d-flex justify-center">
                    <VekButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Style="width:50%;">Start now</VekButton>
                </VekCardActions>
            </VekCard>
        </VekItem>
        <VekItem xs="12" sm="6" md="4">
            <VekCard Elevation="25" Class="rounded-lg pb-4">
                <VekCardHeader>
                    <CardHeaderContent>
                        <VekText Typo="Typo.h5" Align="Align.Center">Starter</VekText>
                    </CardHeaderContent>
                </VekCardHeader>
                <VekCardContent>
                    <div class="d-flex justify-center">
                        <VekText Typo="Typo.h3">$10</VekText>
                        <VekText Typo="Typo.h5" Class="ml-1 mt-5" Color="Color.Secondary">/Monthly</VekText>
                    </div>
                    <VekList T="string" Class="mx-auto mt-4" Style="width:300px;">
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            Unlimited something
                        </VekListItem>
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            10 something
                        </VekListItem>
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            No something
                        </VekListItem>
                    </VekList>
                </VekCardContent>
                <VekCardActions Class="d-flex justify-center">
                    <VekButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Style="width:50%;">Start now</VekButton>
                </VekCardActions>
            </VekCard>
        </VekItem>
        <VekItem xs="12" sm="12" md="4">
            <VekCard Elevation="25" Class="rounded-lg pb-4">
                <VekCardHeader>
                    <CardHeaderContent>
                        <VekText Typo="Typo.h5" Align="Align.Center">Professional</VekText>
                    </CardHeaderContent>
                </VekCardHeader>
                <VekCardContent>
                    <div class="d-flex justify-center">
                        <VekText Typo="Typo.h3">$15</VekText>
                        <VekText Typo="Typo.h5" Class="ml-1 mt-5" Color="Color.Secondary">/Monthly</VekText>
                    </div>
                    <VekList T="string" Class="mx-auto mt-4" Style="width:300px;">
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            Unlimited something
                        </VekListItem>
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            10 something
                        </VekListItem>
                        <VekListItem Icon="@Icons.Material.Filled.LiveHelp">
                            No something
                        </VekListItem>
                    </VekList>
                </VekCardContent>
                <VekCardActions Class="d-flex justify-center">
                    <VekButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Style="width:50%;">Start now</VekButton>
                </VekCardActions>
            </VekCard>
        </VekItem>
    </VekGrid>
</VekContainer>
