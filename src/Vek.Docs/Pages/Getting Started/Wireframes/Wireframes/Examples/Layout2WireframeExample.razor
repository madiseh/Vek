@namespace Vek.Docs.Wireframes
@layout WireframeLayout
@page "/getting-started/wireframes/layout2"

<VekThemeProvider />

<VekLayout>
    <VekAppBar Elevation="1">
        <VekIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        <VekText Typo="Typo.h5" Class="ml-3">Application</VekText>
        <VekSpacer />
        <VekIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
    </VekAppBar>
    <VekDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        @*NavMenu*@
    </VekDrawer>
    <VekMainContent>
        @*Body*@
    </VekMainContent>
</VekLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
} 

