@inherits LayoutComponentBase
@namespace Vek.Docs.Examples

<VekThemeProvider />
<VekPopoverProvider />
<VekDialogProvider />
<VekSnackbarProvider />

<VekLayout>
    <VekAppBar>
        <VekIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        My Application
    </VekAppBar>
    <VekDrawer @bind-Open="@_drawerOpen">
        <MyNavMenu/>
    </VekDrawer>
    <VekMainContent>
        @Body
    </VekMainContent>
</VekLayout>

@code {
    bool _drawerOpen = true;

    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}