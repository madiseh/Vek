@namespace Vek.Docs.Examples
@using System.Globalization;

<VekGrid>
    <VekItem xs="12" sm="6" md="4">
        <VekTextField Label="en-US" Variant="Variant.Outlined" Culture="@en" @bind-Value="date" />
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekTextField Label="de-AT" Variant="Variant.Outlined" Culture="@de" @bind-Value="date"></VekTextField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekTextField Label="zh-CN" Variant="Variant.Outlined" Culture="@cn" @bind-Value="date"></VekTextField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekTextField Label="en-US: dddd, MMM dd" Variant="Variant.Outlined" Culture="@en" Format="dddd, MMM dd" @bind-Value="date" />
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekTextField Label="de-AT: dddd, dd. MM." Variant="Variant.Outlined" Culture="@de" Format="dddd, dd. MM." @bind-Value="date"></VekTextField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekTextField Label="zh-CN: yy年MM月dd日" Variant="Variant.Outlined" Culture="@cn" Format="yyyy年MM月dd日" @bind-Value="date"></VekTextField>
    </VekItem>
</VekGrid>

@code {
    CultureInfo en = @CultureInfo.GetCultureInfo("en-US");
    CultureInfo de = CultureInfo.GetCultureInfo("de-AT");
    CultureInfo cn = CultureInfo.GetCultureInfo("zh-CN");
    DateTime date = DateTime.Now;
}
