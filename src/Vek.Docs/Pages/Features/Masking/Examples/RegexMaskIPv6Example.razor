@namespace Vek.Docs.Examples


<VekGrid Class="justify-space-between" Style="max-width: 800px;">
    <VekItem xs="12" sm="6">
        <VekTextField Mask="@ipv6Mask" Label="IPv6 Address"  HelperText="@ipv6Mask.Mask"
                      @bind-Value="ip"  Variant="@Variant.Text" Clearable />
    </VekItem>
    <VekItem xs="12" sm="6">
        <VekTextField Mask="@ipv6PortMask" Label="IPv6 Address with Port"  HelperText="@ipv6PortMask.Mask"
                      @bind-Value="ipPort"  Variant="@Variant.Text" Clearable />
    </VekItem>
    <VekItem xs="12" sm="6">
        IPv4: <b>@ip</b>
    </VekItem>
    <VekItem xs="12" sm="6">
        IPv4 w/Port: <b>@ipPort</b>
    </VekItem>
</VekGrid>

@code {
    public string ip;
    public string ipPort;
    public IMask ipv6Mask = RegexMask.IPv6();
    public IMask ipv6PortMask = RegexMask.IPv6(true);
}