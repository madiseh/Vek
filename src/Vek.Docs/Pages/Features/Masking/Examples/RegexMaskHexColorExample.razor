@namespace Vek.Docs.Examples


<VekGrid Class="justify-space-between" Style="max-width: 800px;">
    <VekItem xs="12" sm="6">
        <VekTextField Mask="@hexColorMask" Label="Color" HelperText="@hexColorMask.Mask"
                      @bind-Value="hexColor" Variant="@Variant.Text" Clearable />
    </VekItem>
    <VekItem xs="12" sm="6" Class="d-flex align-center">
        Color: <b class="ml-1">@hexColor</b>
        <VekPaper Class="ml-2" Elevation="0" Style="@($"width: 24px; height: 24px; background: {hexColor};")" />
    </VekItem>
</VekGrid>

@code {
    public string hexColor = "#594AE2";
    public IMask hexColorMask = RegexMask.HexColor();
}
