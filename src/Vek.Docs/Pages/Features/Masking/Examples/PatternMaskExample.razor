@namespace Vek.Docs.Examples

<VekGrid Class="justify-space-between" Style="max-width: 400px;">
    <VekItem xs="12">
        <VekTextField Mask="@(new PatternMask("0000 0000 0000 0000"))" Label="Credit Card Number" 
                      @bind-Value="creditCard"  Variant="@Variant.Text" Clearable />
    </VekItem>
    <VekItem xs="4">
        <VekTextField Mask="@(new DateMask("MM/YY", 'Y', 'M'))" Label="Expires" 
                      @bind-Value="expiration"  Variant="@Variant.Text" />
    </VekItem>
    <VekItem xs="4"/>
    <VekItem xs="4">
        <VekTextField Mask="@(new PatternMask("000"))" Label="CVC" 
                      @bind-Value="cvc"  Variant="@Variant.Text" />
    </VekItem>
    <VekItem xs="12">
        Credit Card Number: <b>@creditCard</b><br/>
        Expiration Date: <b>@expiration</b><br/>
        CVC: <b>@cvc</b>
    </VekItem>
</VekGrid>

@code {
    private string creditCard;
    private string expiration;
    private string cvc;
}