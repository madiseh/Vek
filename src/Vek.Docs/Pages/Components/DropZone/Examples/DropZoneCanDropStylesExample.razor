@namespace Vek.Docs.Examples

<VekDropContainer T="DropItem" Items="_items" ApplyDropClassesOnDragStarted="_applyDropClassesOnDragStarted" ItemsSelector="@((item,dropzone) => item.Place == dropzone)" CanDropClass="vek-border-success" NoDropClass="vek-border-error" ItemDropped="ItemUpdated" Class="d-flex flex-column flex-grow-1">
    <ChildContent>
        <div class="d-flex flex-wrap justify-space-between">
            <VekDropZone T="DropItem" Identifier="Fridge" CanDrop="@((item) => false)" Class="rounded-lg border-2 border-solid vek-border-lines-default pa-6 ma-8">
                <VekText Typo="Typo.h6" Class="mb-4">Fridge</VekText>
            </VekDropZone>
            <VekDropZone T="DropItem" Identifier="Dinner" CanDrop="@((item) => item.IsPicked == false && item.IsRotten == false)" Class="rounded-lg border-2 border-solid vek-border-lines-default pa-6 ma-8 flex-grow-1">
                <VekText Typo="Typo.h6" Class="mb-4">Soup</VekText>
            </VekDropZone>
            <VekDropZone T="DropItem" Identifier="Trash" CanDrop="@((item) => item.IsPicked == false && item.IsRotten == true)" Class="rounded-lg border-2 border-dashed vek-border-lines-default pa-6 ma-8 flex-grow-1">
                <VekText Typo="Typo.h6" Class="mb-4">Trash</VekText>
            </VekDropZone>
        </div>
        <VekToolBar>
            <VekCheckBox @bind-Value="_applyDropClassesOnDragStarted" Label="Apply Drop Classes On Drag Started" />
            <VekSpacer/>
            <VekButton OnClick="Reset">Reset</VekButton>
        </VekToolBar>
    </ChildContent>
    <ItemRenderer>
        <VekPaper Height="54px" Width="54px" Class="pa-2" Elevation="0">
            <VekBadge Visible="@(context.IsRotten ? true : false)" Overlap="true" Icon="@Icons.Custom.Uncategorized.Bacteria" Color="Color.Dark">
                <VekIcon Icon="@context.Icon" Color="@context.Color" Size="Size.Large"/>
            </VekBadge>
        </VekPaper>
    </ItemRenderer>
</VekDropContainer>

@code {
    private bool _applyDropClassesOnDragStarted = false;

    private void Reset()
    {
        foreach (var item in _items)
        {
            item.Place = "Fridge";
            item.IsPicked = false;
        }
    }

    private void ItemUpdated(VekItemDropInfo<DropItem> dropItem)
    {
        dropItem.Item.IsPicked = true;
        dropItem.Item.Place = dropItem.DropzoneIdentifier;
    }

    private List<DropItem> _items = new()
        {
            new DropItem() { Icon = @Icons.Custom.Uncategorized.FoodApple, Color = Color.Error, IsRotten = false, Place = "Fridge" },
            new DropItem() { Icon = @Icons.Custom.Uncategorized.Baguette, Color = Color.Warning, IsRotten = false, Place = "Fridge" },
            new DropItem() { Icon = @Icons.Custom.Uncategorized.Sausage, Color = Color.Secondary, IsRotten = true, Place = "Fridge" },
            new DropItem() { Icon = @Icons.Custom.Uncategorized.WaterMelon, Color = Color.Success, IsRotten = false, Place = "Fridge" },
            new DropItem() { Icon = @Icons.Custom.Uncategorized.Fish, Color = Color.Info, IsRotten = true, Place = "Fridge" },
        };

    public class DropItem
    {
        public string Icon { get; init; }
        public Color Color { get; init; }
        public bool IsRotten { get; set; }
        public bool IsPicked { get; set; }
        public string Place { get; set; }
    }
}
