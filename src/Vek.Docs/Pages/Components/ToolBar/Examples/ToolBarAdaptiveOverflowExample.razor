@namespace Vek.Docs.Examples

<VekPaper MaxWidth="240px">
    <VekToolBar AdaptiveOverflow="true">
        <VekToolBarItem Label="Create project" Icon="@Icons.Material.Outlined.Add" CollapsePriority="10" OnOverflowClick="CreateProject">
            <VekIconButton Icon="@Icons.Material.Outlined.Add" Color="Color.Inherit" aria-label="Create project" OnClick="CreateProject" />
        </VekToolBarItem>
        <VekToolBarItem Label="Edit project" Icon="@Icons.Material.Outlined.Edit" CollapsePriority="8" OnOverflowClick="EditProject">
            <VekIconButton Icon="@Icons.Material.Outlined.Edit" Color="Color.Inherit" aria-label="Edit project" OnClick="EditProject" />
        </VekToolBarItem>
        <VekToolBarItem Label="Share project" Icon="@Icons.Material.Outlined.Share" CollapsePriority="6" OnOverflowClick="ShareProject">
            <VekIconButton Icon="@Icons.Material.Outlined.Share" Color="Color.Inherit" aria-label="Share project" OnClick="ShareProject" />
        </VekToolBarItem>
        <VekToolBarItem Label="Move to archive" Icon="@Icons.Material.Outlined.Archive" CollapsePriority="2" OnOverflowClick="ArchiveProject">
            <VekIconButton Icon="@Icons.Material.Outlined.Archive" Color="Color.Inherit" aria-label="Move to archive" OnClick="ArchiveProject" />
        </VekToolBarItem>
        <VekToolBarItem Label="Delete project" Icon="@Icons.Material.Outlined.Delete" CollapsePriority="0" OnOverflowClick="DeleteProject">
            <VekIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Inherit" aria-label="Delete project" OnClick="DeleteProject" />
        </VekToolBarItem>
    </VekToolBar>
</VekPaper>

<VekText Typo="Typo.caption">Last action: @_lastAction</VekText>

@code {
    private string _lastAction = "None";

    private void CreateProject() => _lastAction = "Create project";

    private void EditProject() => _lastAction = "Edit project";

    private void ShareProject() => _lastAction = "Share project";

    private void ArchiveProject() => _lastAction = "Move to archive";

    private void DeleteProject() => _lastAction = "Delete project";
}
