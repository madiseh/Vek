@namespace Vek.Docs.Examples

<VekPaper Width="300px" Elevation="0">
    <VekTreeView Hover ReadOnly="@ReadOnly" @bind-SelectedValue="SelectedValue" SelectionMode="@SelectionMode">
        <VekTreeViewItem Value="@("config")" Expanded Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <VekTreeViewItem Value='"launch.json"' Icon="@Icons.Custom.FileFormats.FileCode" />
            <VekTreeViewItem Value='"tasks.json"' Icon="@Icons.Custom.FileFormats.FileCode" />
        </VekTreeViewItem>
        <VekTreeViewItem Value="@("images")" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <VekTreeViewItem Value="@("logo.png")" Icon="@Icons.Custom.FileFormats.FileImage" />
        </VekTreeViewItem>
    </VekTreeView>
</VekPaper>

<VekStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <VekRadioGroup @bind-Value="SelectionMode">
        <VekRadio Value="SelectionMode.SingleSelection" Color="Color.Primary">SingleSelection</VekRadio>
        <VekRadio Value="SelectionMode.ToggleSelection" Color="Color.Primary">ToggleSelection</VekRadio>
    </VekRadioGroup>
    <VekChipSet T="string" @bind-SelectedValue="SelectedValue" Color="Color.Primary" Variant="Variant.Text">
        <VekChip Text="config"/>
        <VekChip Text="launch.json"/>
        <VekChip Text="tasks.json"/>
        <VekChip Text="images"/>
        <VekChip Text="logo.png"/>
    </VekChipSet>
    <VekSwitch @bind-Value="ReadOnly" Color="Color.Primary">ReadOnly</VekSwitch>    
</VekStack>

@code {
    public string SelectedValue = "tasks.json";
    public bool ReadOnly = false;
    public SelectionMode SelectionMode = SelectionMode.SingleSelection;
}