@namespace Vek.Docs.Examples

<VekPaper Width="300px" Elevation="0">
    <VekTreeView Hover ReadOnly="@ReadOnly" TriState="@TriState" AutoSelectParent="@AutoSelectParent" @bind-SelectedValues="SelectedValues" SelectionMode="SelectionMode.MultiSelection"
                 CheckBoxColor="Color.Info">
          <VekTreeViewItem Value='"bundle.zip"' Expanded Icon="@Icons.Material.Filled.FolderZip">
              <VekTreeViewItem Value='"config"' Expanded Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
                <VekTreeViewItem Value='"launch.json"' Icon="@Icons.Custom.FileFormats.FileCode" />
                <VekTreeViewItem Value='"tasks.json"' Icon="@Icons.Custom.FileFormats.FileCode" />
            </VekTreeViewItem>
              <VekTreeViewItem Value='"images"' Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
                <VekTreeViewItem Value="@("logo.png")" Icon="@Icons.Custom.FileFormats.FileImage" />
            </VekTreeViewItem>
        </VekTreeViewItem>
    </VekTreeView>
</VekPaper>

<VekStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <VekChipSet T="string" @bind-SelectedValues="SelectedValues" SelectionMode="SelectionMode.MultiSelection" Color="Color.Info" Variant="Variant.Text">
        <VekChip Text="bundle.zip"/>
        <VekChip Text="config"/>
        <VekChip Text="launch.json"/>
        <VekChip Text="tasks.json"/>
        <VekChip Text="images"/>
        <VekChip Text="logo.png"/>
    </VekChipSet>
    <VekSwitch @bind-Value="TriState" Color="Color.Info">TriState</VekSwitch>
    <VekSwitch @bind-Value="AutoSelectParent" Color="Color.Info">AutoSelectParent</VekSwitch>
    <VekSwitch @bind-Value="ReadOnly" Color="Color.Info">ReadOnly</VekSwitch>    
</VekStack>

@code {
    public IReadOnlyCollection<string> SelectedValues = ["config", "tasks.json", "launch.json"];
    public bool ReadOnly = false;
    public bool TriState = true;
    public bool AutoSelectParent = true;
}
