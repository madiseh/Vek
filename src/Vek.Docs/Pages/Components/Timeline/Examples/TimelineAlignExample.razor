@namespace Vek.Docs.Examples

<VekSelect T="TimelineAlign" @bind-Value="_timelineAlign" Label="Timeline Align" Dense="true" Variant="Variant.Outlined">
    <VekSelectItem T="TimelineAlign" Value="TimelineAlign.Start">Start</VekSelectItem>
    <VekSelectItem T="TimelineAlign" Value="TimelineAlign.Default">Default</VekSelectItem>
    <VekSelectItem T="TimelineAlign" Value="TimelineAlign.End">End</VekSelectItem>
</VekSelect>

<VekTimeline TimelineAlign="_timelineAlign">
    <VekTimelineItem Color="Color.Dark" Elevation="25">
        <ItemOpposite>
            <VekText Color="Color.Dark" Typo="Typo.h6">Aug 2020</VekText>
        </ItemOpposite>
        <ItemContent>
            <VekPaper Elevation="0" Class="mt-n1">
                <VekText Color="Color.Dark" Typo="Typo.h6" GutterBottom="true">Vek Emerges</VekText>
                <VekText Typo="Typo.body2">A repository pops up on GitHub named Vek.</VekText>
                <VekText Typo="Typo.body2">The development has already started and the most common components can be found already.</VekText>
            </VekPaper>
        </ItemContent>
    </VekTimelineItem>
    <VekTimelineItem Color="Color.Primary" Elevation="25" TimelineAlign="TimelineAlign.End">
        <ItemOpposite>
            <VekText Color="Color.Primary" Typo="Typo.h6">Oct 2020</VekText>
        </ItemOpposite>
        <ItemContent>
            <VekPaper Elevation="0" Class="mt-n1">
                <VekText Color="Color.Primary" Typo="Typo.h6" GutterBottom="true">Vek Unleashed!</VekText>
                <VekText Typo="Typo.body2">The first version is released and uploaded as v1.0.7.</VekText>
            </VekPaper>
        </ItemContent>
    </VekTimelineItem>
    <VekTimelineItem Color="Color.Secondary" Elevation="25">
        <ItemOpposite>
            <VekText Color="Color.Secondary" Typo="Typo.h6" GutterBottom="true">Nov 2020</VekText>
        </ItemOpposite>
        <ItemContent>
            <VekPaper Elevation="0" Class="mt-n1">
                <VekText Color="Color.Secondary" Typo="Typo.h6" GutterBottom="true">First Minor</VekText>
                <VekText Typo="Typo.body2">Vek gets its first minor with version 1.1.0.</VekText>
                <VekText Typo="Typo.body2">TimerPicker, AutoComplete and Charts join the library as well as T versions of our inputs and selects.</VekText>
            </VekPaper>
        </ItemContent>
    </VekTimelineItem>
</VekTimeline>

@code{
    private TimelineAlign _timelineAlign { get; set; } = TimelineAlign.Start;
}