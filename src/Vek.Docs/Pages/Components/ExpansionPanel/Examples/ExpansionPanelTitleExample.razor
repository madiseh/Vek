@namespace Vek.Docs.Examples

<div class="mx-auto"  style="max-width: 400px;">
    <VekExpansionPanels>
        <VekExpansionPanel>
            <TitleContent>
                <div class="d-flex">
                    <VekIcon Icon="@Icons.Material.Filled.Info" class="mr-3"></VekIcon>
                    <VekText>Panel header as <strong>RenderFragment</strong></VekText>
                </div>
            </TitleContent>
            <ChildContent>
                Panel Content
            </ChildContent>
        </VekExpansionPanel>
        <VekExpansionPanel Text="The icon of this panel is hidden" HideIcon="true">
            Panel Content
        </VekExpansionPanel>
        <VekExpansionPanel HideIcon="true">
            <TitleContent>
                <div class="d-flex">
                    <VekText Class="mt-1">Inbox</VekText>
                    <VekBadge Content="3" Color="Color.Primary" Overlap="true" Class="d-flex ml-auto">
                        <VekIcon Icon="@Icons.Material.Filled.Email" Color="Color.Default" />
                    </VekBadge>
                </div>
            </TitleContent>
            <ChildContent>
                Panel Content
            </ChildContent>
        </VekExpansionPanel>
        <VekExpansionPanel @bind-Expanded="@open" HideIcon="true">
            <TitleContent>
                <div class="d-flex">
                    <VekText>Overriding standard icon with own icon</VekText>
                    <VekIcon Icon="@(open ? Icons.Material.Filled.Close : Icons.Material.Filled.Add)" class="ml-auto"></VekIcon>
                </div>
            </TitleContent>
            <ChildContent>
                Panel Content
            </ChildContent>
        </VekExpansionPanel>
    </VekExpansionPanels>
</div>

@code
{
    bool open;
}
