@namespace Vek.Docs.Examples

<VekButton Disabled="@_processing" OnClick="ProcessSomething" Variant="Variant.Filled" Color="Color.Primary">
    @if (_processing)
    {
        <VekProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
        <VekText Class="ms-2">Processing</VekText>
    }
    else
    {
        <VekText>Click me</VekText>
    }
</VekButton>

@code {
    private bool _processing = false;

    async Task ProcessSomething()
    {
        _processing = true;
        await Task.Delay(2000);
        _processing = false;
    }
}