@namespace Vek.Docs.Examples

<VekCheckBox @bind-Value="Label_CheckBox1" Label="Default"></VekCheckBox>
<VekCheckBox @bind-Value="Label_CheckBox2" Label="Primary" Color="Color.Primary"></VekCheckBox>
<VekCheckBox @bind-Value="Label_CheckBox3" Label="Secondary" LabelPlacement="Placement.Start" Color="Color.Secondary"></VekCheckBox>
<VekCheckBox @bind-Value="Label_CheckBox1" Disabled="true" Label="Disabled" LabelPlacement="Placement.Start"></VekCheckBox>

@code {
    public bool Label_CheckBox1 { get; set; } = true;
    public bool Label_CheckBox2 { get; set; } = false;
    public bool Label_CheckBox3 { get; set; } = false;
}