@namespace Vek.Docs.Examples

<div class="d-flex flex-column align-center gap-3">
    <VekTabs>
        <VekTabPanel Text="Item One" />
        <VekTabPanel Text="Item Two" Visible="@_visible" />
        <VekTabPanel Text="Item Three" />
    </VekTabs>

    <VekSwitch @bind-Value="_visible" Label="Tab Two Visible" Color="Color.Primary" />
</div>

@code {
    private bool _visible = true;
}