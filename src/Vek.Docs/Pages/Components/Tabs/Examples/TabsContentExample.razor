@namespace Vek.Docs.Examples

<VekTabs Elevation="1" Rounded="true" TabPanelsClass="pa-6" ActiveTabClass="border-solid border-2 vek-border-primary">
    <VekTabPanel>
        <ChildContent>
            <VekText>Custom tab content only</VekText>
        </ChildContent>
        <TabContent>
            Item One
        </TabContent>
    </VekTabPanel>
    <VekTabPanel>
        <ChildContent>
            <VekText>Both custom tab and wrapper content</VekText>
        </ChildContent>
        <TabWrapperContent>
            <VekTooltip Text="ToolTip Two">
                @context
            </VekTooltip>
        </TabWrapperContent>
        <TabContent>
            <VekText Typo="Typo.h6">Item Two</VekText>
        </TabContent>
    </VekTabPanel>
    <VekTabPanel Text="Item Three">
        <ChildContent>
            <VekText>Custom wrapper content only</VekText>
        </ChildContent>
        <TabWrapperContent>
            <VekTooltip Text="ToolTip Three">
                @context
            </VekTooltip>
        </TabWrapperContent>
    </VekTabPanel>
</VekTabs>
