@namespace Vek.Docs.Examples

<VekBreadcrumbs Items="_items">
    <ItemTemplate Context="item">
        <VekLink Href="@item.Href">@item.Text.ToUpper()</VekLink>
    </ItemTemplate>
</VekBreadcrumbs>

@code {
    private List<BreadcrumbItem> _items =
    [
        new("Home", href: "#"),
        new("Link 1", href: "#"),
        new("Link 2", href: null, disabled: true)
    ];
}