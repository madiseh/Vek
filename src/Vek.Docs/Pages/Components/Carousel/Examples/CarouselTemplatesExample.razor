@namespace Vek.Docs.Examples

<VekCarousel Class="vek-width-full" Style="height:200px;" AutoCycle="false" TData="object">
    <BulletTemplate Context="selected">
        <div Class="vek-button-root vek-icon-button vek-icon-button-color-inherit vek-ripple vek-ripple-icon">
            <span class="vek-icon-button-label">
                <VekIcon Icon="@(selected ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Circle)" Color="@Color.Inherit" />
            </span>
        </div>
    </BulletTemplate>
    <PreviousButtonTemplate>
        <div Class="vek-button-root vek-icon-button vek-icon-button-color-inherit vek-ripple vek-ripple-icon">
            <span class="vek-icon-button-label">
                <VekIcon Class="vek-ripple vek-ripple-icon vek-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipPrevious" Color="@Color.Inherit" />
            </span>
        </div>
    </PreviousButtonTemplate>
    <NextButtonTemplate>
        <div Class="vek-button-root vek-icon-button vek-icon-button-color-inherit vek-ripple vek-ripple-icon">
            <span class="vek-icon-button-label">
                <VekIcon Class="vek-ripple vek-ripple-icon vek-icon-button-size-medium" Icon="@Icons.Material.Filled.SkipNext" Color="@Color.Inherit" />
            </span>
        </div>
    </NextButtonTemplate>
    <ChildContent>
        <VekCarouselItem Color="@Color.Primary">
            <div class="d-flex" style="height:100%">
                <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Size="@Size.Large" />
            </div>
        </VekCarouselItem>
        <VekCarouselItem Color="@Color.Secondary">
            <div class="d-flex" style="height:100%">
                <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Size="@Size.Large" />
            </div>
        </VekCarouselItem>
        <VekCarouselItem>
            <div class="d-flex" style="height:100%">
                <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Color="@Color.Primary" Size="@Size.Large" />
            </div>
        </VekCarouselItem>
    </ChildContent>
</VekCarousel>