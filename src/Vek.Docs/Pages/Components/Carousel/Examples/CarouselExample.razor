@namespace Vek.Docs.Examples

<VekCarousel Class="vek-width-full" Style="height:200px;" ShowArrows="@arrows" ShowBullets="@bullets" EnableSwipeGesture="@enableSwipeGesture" AutoCycle="@autocycle" TData="object">
    <VekCarouselItem Transition="transition" Color="@Color.Primary">
        <div class="d-flex" style="height:100%">
            <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Size="@Size.Large" />
        </div>
    </VekCarouselItem>
    <VekCarouselItem Transition="transition" Color="@Color.Secondary">
        <div class="d-flex" style="height:100%">
            <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Size="@Size.Large" />
        </div>
    </VekCarouselItem>
    <VekCarouselItem Transition="transition">
        <div class="d-flex" style="height:100%">
            <VekIcon Class="mx-auto my-auto" Icon="@Icons.Custom.Brands.Vek" Color="@Color.Primary" Size="@Size.Large" />
        </div>
    </VekCarouselItem>
</VekCarousel>
<VekSelect @bind-Value="transition" Label="Transition" Class="ma-2">
    <VekSelectItem Value="@Transition.Fade">Fade</VekSelectItem>
    <VekSelectItem Value="@Transition.Slide">Slide</VekSelectItem>
    <VekSelectItem Value="@Transition.None">None</VekSelectItem>
</VekSelect>
<VekSwitch @bind-Value="arrows" Color="Color.Primary">Show Arrows</VekSwitch>
<VekSwitch @bind-Value="bullets" Color="Color.Primary">Show Bullets</VekSwitch>
<VekSwitch @bind-Value="enableSwipeGesture" Color="Color.Primary">Enable Swipe Gesture</VekSwitch>
<VekSwitch @bind-Value="autocycle" Color="Color.Primary">Auto Cycle (Default: 5 secs)</VekSwitch>

@code{ 
    private bool arrows = true;
    private bool bullets = true;
    private bool enableSwipeGesture = true;
    private bool autocycle = true;
    private Transition transition = Transition.Slide;
}