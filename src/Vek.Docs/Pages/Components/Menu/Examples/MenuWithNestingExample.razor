@namespace Vek.Docs.Examples

<VekMenu Label="Open nested menu" Dense>
    <VekMenuItem Label="Add reaction" />
    <VekMenuItem Label="Add bookmark" />

    <VekMenu Label="Format">
        <VekMenu Label="Text" StartIcon="@Icons.Material.Filled.FormatBold">
            <VekMenuItem Label="Bold" Icon="@Icons.Material.Filled.FormatBold" />
            <VekMenuItem Label="Italic" Icon="@Icons.Material.Filled.FormatItalic" />
            <VekMenuItem Label="Underline" Icon="@Icons.Material.Filled.FormatUnderlined" />

            <VekMenu Label="Size">
                <VekMenuItem Label="Increase font size" />
                <VekMenuItem Label="Decrease font size" />
            </VekMenu>
        </VekMenu>

        <VekMenu Label="Points">
            <VekMenuItem Label="Bullet" Icon="@Icons.Material.Filled.FormatListBulleted" IconColor="Color.Secondary" />
            <VekMenuItem Label="Number" Icon="@Icons.Material.Filled.FormatListNumbered" IconColor="Color.Secondary" />
        </VekMenu>

        <VekMenu Label="Alignment">
            <VekMenuItem Label="Left" Icon="@Icons.Material.Filled.FormatAlignLeft" IconColor="Color.Tertiary" />
            <VekMenuItem Label="Right" Icon="@Icons.Material.Filled.FormatAlignRight" IconColor="Color.Tertiary" />
        </VekMenu>

        <VekMenuItem Label="Clear formatting" />
        <VekMenuItem Label="Headers and footers" />
    </VekMenu>
</VekMenu>
