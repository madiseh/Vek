@namespace Vek.Docs.Examples

<VekStack Row>
    <VekCard>
        <VekCardContent>
            <VekText Align="Align.Center">ReadOnly Form</VekText>
            <VekForm ReadOnly="ReadOnly" Spacing="2">
                <VekTextField T="string" Label="Text" />
                <VekNumericField T="int" Label="Number" />
                <VekDatePicker Label="Date" />
                <VekSwitch T="bool" Label="Switch" />
                <VekCheckBox T="bool" Label="CheckBox" />
                <VekRadioGroup T="string">
                    <VekRadio Value="@("1")">1</VekRadio>
                    <VekRadio Value="@("2")">2</VekRadio>
                </VekRadioGroup>
                <VekForm ReadOnly="NestedReadOnly" Spacing="2">
                    <VekText Align="Align.Center">Nested Form</VekText>
                    <VekTextField T="string" Label="Nested Text" />
                    <VekNumericField T="int" Label="Nested Number" />
                </VekForm>
            </VekForm>
        </VekCardContent>
        <VekCardActions>
            <VekCheckBox @bind-Value="ReadOnly">ReadOnly</VekCheckBox>
            <VekCheckBox @bind-Value="NestedReadOnly">Nested</VekCheckBox>
        </VekCardActions>
    </VekCard>
    <VekCard>
        <VekCardContent>
            <VekText Align="Align.Center">Disabled Form</VekText>
            <VekForm Disabled="Disabled" Spacing="2">
                <VekTextField T="string" Label="Text" />
                <VekNumericField T="int" Label="Number" />
                <VekDatePicker Label="Date" />
                <VekSwitch T="bool" Label="Switch" />
                <VekCheckBox T="bool" Label="CheckBox" />
                <VekRadioGroup T="string">
                    <VekRadio Value="@("1")">1</VekRadio>
                    <VekRadio Value="@("2")">2</VekRadio>
                </VekRadioGroup>
                <VekForm Disabled="NestedDisabled" Spacing="2">
                    <VekText Align="Align.Center">Nested Form</VekText>
                    <VekTextField T="string" Label="Nested Text" />
                    <VekNumericField T="int" Label="Nested Number" />
                </VekForm>
            </VekForm>
        </VekCardContent>
        <VekCardActions>
            <VekCheckBox @bind-Value="Disabled">Disabled</VekCheckBox>
            <VekCheckBox @bind-Value="NestedDisabled">Nested</VekCheckBox>
        </VekCardActions>
    </VekCard>
</VekStack>

@code {
    bool ReadOnly = true;
    bool NestedReadOnly;
    bool Disabled = true;
    bool NestedDisabled;
}