@using System.ComponentModel.DataAnnotations
@namespace Vek.Docs.Examples

<EditForm Model="@model" OnValidSubmit="OnValidSubmit">
<DataAnnotationsValidator/>
<VekGrid>
    <VekItem xs="12" sm="7">
        <VekCard>
            <VekCardContent>
                <VekTextField Label="First name" HelperText="Max. 8 characters"
                              @bind-Value="model.Username" For="@(() => model.Username)"/>
                <VekTextField Label="Email" Class="mt-3"
                              @bind-Value="model.Email" For="@(() => model.Email)"/>
                <VekTextField Label="Password" HelperText="Choose a strong password" Class="mt-3"
                              @bind-Value="model.Password" For="@(() => model.Password)" InputType="InputType.Password"/>
                <VekTextField Label="Password" HelperText="Repeat the password" Class="mt-3"
                              @bind-Value="model.Password2" For="@(() => model.Password2)" InputType="InputType.Password"/>
            </VekCardContent>
            <VekCardActions>
                <VekButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto">Register</VekButton>
            </VekCardActions>
        </VekCard>
    </VekItem>
    <VekItem xs="12" sm="5">
        <VekPaper Class="pa-4 vek-height-full">
            <VekText Typo="Typo.subtitle2">Validation Summary</VekText>
            @if (success)
            {
                <VekText Color="Color.Success">Success</VekText>
            }
            else
            {
                <VekText Color="@Color.Error">
                    <ValidationSummary />
                </VekText>
            }
        </VekPaper>
    </VekItem>
    <VekItem xs="12">
        <VekText Typo="Typo.body2" Align="Align.Center">
            Fill out the form correctly to see the success message.
        </VekText>
    </VekItem>
</VekGrid>
</EditForm>


@code {
    RegisterAccountForm model = new RegisterAccountForm();
    bool success;

    public class RegisterAccountForm
    {
        [Required]
        [StringLength(8, ErrorMessage = "Name length can't be more than 8.")]
        public string Username { get; set; }

        [Required]
        [EmailAddress]
        public string Email { get; set; }

        [Required]
        [StringLength(30, ErrorMessage = "Password must be at least 8 characters long.", MinimumLength = 8)]
        public string Password { get; set; }

        [Required]
        [Compare(nameof(Password))]
        public string Password2 { get; set; }

    }

    private void OnValidSubmit(EditContext context)
    {
        success = true;
        StateHasChanged();
    }
}
