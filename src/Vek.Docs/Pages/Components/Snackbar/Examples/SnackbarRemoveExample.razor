@namespace Vek.Docs.Examples

@inject ISnackbar Snackbar

<VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Show">
    Open snackbar
</VekButton>
<VekButton Variant="Variant.Filled" Color="Color.Error" OnClick="@Hide">
    Hide snackbar
</VekButton>

@code {
    private Snackbar _snackbar;

    void Show()
    {
        _snackbar = Snackbar.Add("Now click hide snackbar", Severity.Normal, config =>
        {
            config.VisibleStateDuration = int.MaxValue;
        });
    }

    void Hide() {
        if (_snackbar is null) return;
        Snackbar.Remove(_snackbar);
    }
}
