@namespace Vek.Docs.Examples

<VekPaper Style="width: 800px">
    <VekStepper NonLinear ShowResetButton Ripple="Ripple">
        <VekStep Title="Write the code">Most programmers first start writing the code but some experts write the tests first</VekStep>
        <VekStep Title="Write the tests">If you write the tests first you will design a better API when you write the code</VekStep>
        <VekStep Title="Write the documentation" SecondaryText="... or not">Some consider writing readable code more important than writing documentation.</VekStep>
    </VekStepper>
</VekPaper>

<VekDivider />

<VekSwitch @bind-Value="@Ripple" Color="Color.Primary" Label="Ripple"></VekSwitch>

@code {
    public bool Ripple { get; set; } = true;
}