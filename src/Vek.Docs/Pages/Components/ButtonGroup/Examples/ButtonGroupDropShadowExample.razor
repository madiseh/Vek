@namespace Vek.Docs.Examples

<VekButtonGroup Color="Color.Primary" Variant="Variant.Filled" DropShadow="@_dropShadow">
    <VekButton>One</VekButton>
    <VekButton>Two</VekButton>
    <VekButton>Three</VekButton>
</VekButtonGroup>

<VekSwitch @bind-Value="_dropShadow" Label="Drop shadow" Color="Color.Primary" />

@code {
    private bool _dropShadow = false;
}
