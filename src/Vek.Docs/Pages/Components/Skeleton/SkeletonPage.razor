@page "/components/skeleton"

<DocsPage>
    <DocsPageHeader Title="Skeleton" Component="@nameof(VekSkeleton)" />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Variants">
                <Description>Choose text, circle, rectangle, or rounded card shapes. Use a circle for an avatar placeholder and set <CodeInline>BorderRadius</CodeInline> when the surrounding content uses a custom radius.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SkeletonVariantsExample)" Block="true">
                <SkeletonVariantsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Synchronized shimmer for loading cards">
                <Description>Use <CodeInline>Animation.Shimmer</CodeInline> on related bones so their wave starts together. The loading label can be replaced with a more specific accessible name, and reduced-motion settings stop the animation.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SkeletonShimmerExample)" Block="true">
                <SkeletonShimmerExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Animations">
                <Description>The default animation is pulse, but you can disable it or change to wave.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SkeletonAnimationsExample)" Block="true" FullWidth="true">
                <SkeletonAnimationsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Pulsate Example">
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(SkeletonPulsateExample)" ShowCode="false" Block="true">
                <SkeletonPulsateExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Wave Example">
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(SkeletonWaveExample)" ShowCode="false" Block="true">
                <SkeletonWaveExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
