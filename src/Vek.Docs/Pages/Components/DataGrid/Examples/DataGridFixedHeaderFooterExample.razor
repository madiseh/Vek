@namespace Vek.Docs.Examples

<div class="d-flex flex-wrap align-center gap-4 mb-4">
    <VekSwitch @bind-Value="_fixedHeader" Label="Fixed Header" Color="Color.Primary" />
    <VekSwitch @bind-Value="_fixedFooter" Label="Fixed Footer" Color="Color.Secondary" />
    <VekSwitch @bind-Value="_dense" Label="Dense" Color="Color.Info" />
</div>

<VekDataGrid Items="@_sales" T="SaleItem" Height="380px" FixedHeader="@_fixedHeader" FixedFooter="@_fixedFooter" Dense="@_dense" Bordered="true" Hover="true">
    <Columns>
        <PropertyColumn Property="x => x.OrderNumber" Title="Order #">
            <FooterTemplate>
                <b>@context.Items.Count() orders</b>
            </FooterTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Customer" Title="Customer" />
        <PropertyColumn Property="x => x.ProductCategory" Title="Category" />
        <PropertyColumn Property="x => x.Quantity" Title="Units" AggregateDefinition="_unitsAggregate" />
        <PropertyColumn Property="x => x.UnitPrice" Title="Unit Price" Format="C2" AggregateDefinition="_priceAggregate" />
        <PropertyColumn Property="x => x.TotalAmount" Title="Total Amount" Format="C0" AggregateDefinition="_revenueAggregate" />
    </Columns>
</VekDataGrid>

@code {
    private bool _fixedHeader = true;
    private bool _fixedFooter = true;
    private bool _dense = true;

    public record SaleItem(
        string OrderNumber,
        string Customer,
        string ProductCategory,
        int Quantity,
        decimal UnitPrice,
        decimal TotalAmount);

    private readonly AggregateDefinition<SaleItem> _unitsAggregate = new()
    {
        Type = AggregateType.Sum,
        DisplayFormat = "Total: {value:N0}"
    };

    private readonly AggregateDefinition<SaleItem> _priceAggregate = new()
    {
        Type = AggregateType.Avg,
        DisplayFormat = "Avg: {value:C2}"
    };

    private readonly AggregateDefinition<SaleItem> _revenueAggregate = new()
    {
        Type = AggregateType.Sum,
        DisplayFormat = "Total: {value:C0}"
    };

    private readonly List<SaleItem> _sales = GenerateSales();

    private static List<SaleItem> GenerateSales()
    {
        var customers = new[] { "TechCorp Solutions", "Apex Retail", "Meridian Health", "OmniGlobal Media", "Vanguard Financial", "Beacon Logistics" };
        var categories = new[] { "Cloud Infrastructure", "Security Licenses", "Developer Tooling", "Database Analytics", "AI Services" };
        var prices = new[] { 120m, 250m, 480m, 850m, 1200m, 2100m };

        var list = new List<SaleItem>(50);
        for (var i = 1; i <= 50; i++)
        {
            var customer = customers[(i * 3 + 1) % customers.Length];
            var category = categories[(i * 2 + 3) % categories.Length];
            var price = prices[i % prices.Length];
            var qty = (i % 7) + 2;
            list.Add(new SaleItem($"ORD-{202600 + i}", customer, category, qty, price, qty * price));
        }

        return list;
    }
}
