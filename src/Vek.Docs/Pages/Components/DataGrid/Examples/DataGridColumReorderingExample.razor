@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekDataGrid T="Element" Items="@_elements" DragDropColumnReordering="@_reorderingEnabled" ApplyDropClassesOnDragStarted="@_applyDropClassesOnDragStarted" 
                    DragIndicatorIcon="@_dragIndicatorIcon" Dense ColumnResizeMode="ResizeMode.Container" ColumnReorderMode="@_dragAndDropColumnReorderMode">
    <Columns>
        <SelectColumn T="Element"/>
        <PropertyColumn Property="x => x.Number" Title="Nr (fixed)" DragAndDropEnabled="false"/>
        <PropertyColumn Property="x => x.Sign"/>
        <PropertyColumn Property="x => x.Name" Title="Name (fixed)" DragAndDropEnabled="false" />
        <PropertyColumn Property="x => x.Position" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" />
        <PropertyColumn Property="x => x.Group" Title="Category" />
    </Columns>
    <PagerContent>
        <VekDataGridPager T="Element" />
    </PagerContent>
</VekDataGrid>

<div class="d-flex flex-column mt-4">
    <VekSwitch @bind-Value="_reorderingEnabled" Color="Color.Primary">DragDropColumnReordering</VekSwitch>
    <VekRadioGroup T="DataGridDragAndDropColumnReorderMode" @bind-Value="_dragAndDropColumnReorderMode">
        <VekRadio Dense="true" Value="@DataGridDragAndDropColumnReorderMode.Swap" Color="Color.Primary">Swap</VekRadio>
        <VekRadio Dense="true" Value="@DataGridDragAndDropColumnReorderMode.Insert" Color="Color.Tertiary">Insert</VekRadio>
    </VekRadioGroup>
    <VekSwitch @bind-Value="_applyDropClassesOnDragStarted" Color="Color.Primary">ApplyDropClassesOnDragStarted</VekSwitch>
</div>

@code {
    IEnumerable<Element> _elements = new List<Element>();
    bool _applyDropClassesOnDragStarted = false;

    string _dragIndicatorIcon = Icons.Material.Filled.DragIndicator;

    bool _reorderingEnabled = true;

    DataGridDragAndDropColumnReorderMode _dragAndDropColumnReorderMode = DataGridDragAndDropColumnReorderMode.Swap;

    protected override async Task OnInitializedAsync()
    {
        _elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}
