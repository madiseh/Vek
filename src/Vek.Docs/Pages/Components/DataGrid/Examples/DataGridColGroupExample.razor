@namespace Vek.Docs.Examples

<div class="d-flex flex-wrap align-center gap-4 mb-4">
    <VekSwitch @bind-Value="_dense" Label="Dense" Color="Color.Primary" />
    <VekSwitch @bind-Value="_highlightFinancials" Label="Highlight Financial Quarters" Color="Color.Secondary" />
</div>

<VekDataGrid Items="@_records" T="FinancialRecord" Dense="@_dense" Bordered="true" Hover="true">
    <ColGroup>
        <col style="width: 110px; background-color: var(--vek-palette-background-gray);" />
        <col span="2" style="border-right: 2px solid var(--vek-palette-lines-default);" />
        <col span="2" style="@(_highlightFinancials ? "background-color: var(--vek-palette-primary-hover);" : null)" />
        <col span="2" style="@(_highlightFinancials ? "background-color: var(--vek-palette-secondary-hover); border-right: 2px solid var(--vek-palette-lines-default);" : "border-right: 2px solid var(--vek-palette-lines-default);")" />
        <col style="width: 140px; background-color: var(--vek-palette-background-gray);" />
    </ColGroup>
    <Columns>
        <PropertyColumn Property="x => x.AccountCode" Title="Account" />
        <PropertyColumn Property="x => x.Company" Title="Company" />
        <PropertyColumn Property="x => x.Region" Title="Region" />
        <PropertyColumn Property="x => x.Q1Revenue" Title="Q1 Rev" Format="C0" />
        <PropertyColumn Property="x => x.Q2Revenue" Title="Q2 Rev" Format="C0" />
        <PropertyColumn Property="x => x.Q3Revenue" Title="Q3 Rev" Format="C0" />
        <PropertyColumn Property="x => x.Q4Revenue" Title="Q4 Rev" Format="C0" />
        <PropertyColumn Property="x => x.TotalAnnual" Title="Total Annual" Format="C0" />
    </Columns>
</VekDataGrid>

@code {
    private bool _dense = true;
    private bool _highlightFinancials = true;

    public record FinancialRecord(
        string AccountCode,
        string Company,
        string Region,
        decimal Q1Revenue,
        decimal Q2Revenue,
        decimal Q3Revenue,
        decimal Q4Revenue,
        decimal TotalAnnual);

    private readonly List<FinancialRecord> _records = new()
    {
        new("ACC-101", "Acme Corporation", "North America", 125_000m, 140_000m, 160_000m, 175_000m, 600_000m),
        new("ACC-102", "Globex Dynamics", "EMEA", 95_000m, 110_000m, 105_000m, 130_000m, 440_000m),
        new("ACC-103", "Soylent Tech", "Asia-Pacific", 210_000m, 230_000m, 255_000m, 290_000m, 985_000m),
        new("ACC-104", "Initech Systems", "North America", 80_000m, 85_000m, 90_000m, 95_000m, 350_000m),
        new("ACC-105", "Umbrella BioTech", "LATAM", 175_000m, 190_000m, 185_000m, 220_000m, 770_000m),
        new("ACC-106", "Stark Logistics", "EMEA", 310_000m, 340_000m, 360_000m, 395_000m, 1_405_000m)
    };
}
