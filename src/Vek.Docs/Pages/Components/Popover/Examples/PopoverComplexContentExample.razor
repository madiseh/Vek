@namespace Vek.Docs.Examples

<div class="d-flex">
    <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ToggleOpen">
        @(_open? "Close" : "Open")
    </VekButton>
    <VekPopover Open="@_open" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
        <div class="d-flex flex-column pa-1">
            <PopoverDynamicContentExample />
        </div>
    </VekPopover>
</div>

@code {

    public bool _open;

    public void ToggleOpen()
    {
        if (_open)
            _open = false;
        else
            _open = true;
    }
}