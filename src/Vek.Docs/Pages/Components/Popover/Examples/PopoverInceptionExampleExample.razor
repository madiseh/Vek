@namespace Vek.Docs.Examples

<VekMenu Class="" Label="A menu with tooltip" Variant="Variant.Filled" Color="Color.Primary">
    <div class="d-flex align-center">
        <VekText Class="ml-4">1</VekText>
        <VekTooltip Text="1 is good option">
            <VekIconButton Class="mx-2" Icon="@Icons.Material.Outlined.Info" />
        </VekTooltip>
    </div>
    <div class="d-flex align-center">
        <VekText Class="ml-4">2</VekText>
        <VekMenu Icon="@Icons.Material.Outlined.Mouse" ActivationEvent="@MouseEvent.MouseOver" Class="mx-2">
            <ChildContent>
                <VekMenuItem Label="Profile" />
                <VekMenuItem Label="Theme" />
                <VekMenuItem Label="Usage" />
                <VekMenuItem Label="Sign Out" />
            </ChildContent>
        </VekMenu>
        <VekTooltip Text="2 can be a better option">
            <VekIconButton Class="mx-2" Icon="@Icons.Material.Outlined.Info" />
        </VekTooltip>
    </div>
    <div class="d-flex align-center">
        <VekText Class="ml-4">3</VekText>
        <VekTooltip Text="3 is one more than 2">
            <VekIconButton Class="mx-2" Icon="@Icons.Material.Outlined.Info" />
        </VekTooltip>
    </div>
</VekMenu>
