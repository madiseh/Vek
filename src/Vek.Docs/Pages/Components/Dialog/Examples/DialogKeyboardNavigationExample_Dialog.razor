@namespace Vek.Docs.Examples

<VekDialog OnKeyDown="OnKeyDownAsync">
    <DialogContent>
        <VekText>Select your favourite coffee. Hit Enter to accept or Escape to cancel.</VekText>
        <VekSelect T="string" Label="Favorite Coffee" @bind-Value="_returnValue">
            <VekSelectItem Value="@("Cappuccino")" />
            <VekSelectItem Value="@("Cafe Latte")" />
            <VekSelectItem Value="@("Espresso")" />
            <VekSelectItem Value="@("Irish Coffee")" />
        </VekSelect>
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="Cancel">Cancel</VekButton>
        <VekButton Color="Color.Primary" OnClick="Submit">OK</VekButton>
    </DialogActions>
</VekDialog>

@code {
    [Inject] 
    private IDialogService DialogService { get; set; } // for MessageBox

    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; }

    private string _returnValue;

    private void Submit() => VekDialog.Close(DialogResult.Ok(_returnValue));

    private void Cancel() => VekDialog.Cancel();

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        switch(args.Key) {
            case "Enter":
            case "NumpadEnter":
                if (string.IsNullOrEmpty(_returnValue)) {
                    await DialogService.ShowMessageBoxAsync(
                        "Sorry",
                        @"You must either select a coffee and close with Enter or cancel with Escape!", 
                        yesText:"Got it", 
                        options: new DialogOptions() { CloseOnEscapeKey = true });
                    return;
                }
                Submit();
                break;
        }
    }

}
