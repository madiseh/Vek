@namespace Vek.Docs.Examples

<VekDialog>
    <DialogContent>
        <VekText>@ContentText</VekText>
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="Cancel">Cancel</VekButton>
        <VekButton Color="@Color" Variant="Variant.Filled" OnClick="Submit">@ButtonText</VekButton>
    </DialogActions>
</VekDialog>

@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; }

    [Parameter]
    public string ContentText { get; set; }

    [Parameter]
    public string ButtonText { get; set; }

    [Parameter]
    public Color Color { get; set; }

    private void Submit() => VekDialog.Close(DialogResult.Ok(true));

    private void Cancel() => VekDialog.Cancel();
}
