@namespace Vek.Docs.Examples

@inject IDialogService DialogService

<VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Open">Open inline</VekButton>
<VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Open2Async">Open with show</VekButton>

@*Outer inline dialog*@
<VekDialog @bind-Visible="_visible">
    <DialogContent>
        <VekText>Hi There, I'm an inline dialog!</VekText>
        <VekButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="OpenNested">Open nested</VekButton>
        @*Nested inline dialog*@
        <VekDialog @bind-Visible="_nestedVisible">
            <DialogContent>
                <VekText Class="nested">Nested inline dialog!</VekText>
            </DialogContent>
            <DialogActions>
                <VekButton Color="Color.Primary" OnClick="CloseNested">Close</VekButton>
            </DialogActions>
        </VekDialog>
    </DialogContent>
    <DialogActions>
        <VekButton Color="Color.Primary" OnClick="Close">Close</VekButton>
    </DialogActions>
</VekDialog>

@code {
    private bool _visible;
    private bool _nestedVisible;

    private void Open() => _visible = true;

    private void Close() => _visible = false;

    private void OpenNested() => _nestedVisible = true;

    private void CloseNested() => _nestedVisible = false;

    @*Open a non-inline dialog component that nests an inline dialog*@
    private Task Open2Async() => DialogService.ShowAsync<DialogNestedInlineExample_Dialog>();
}
