@namespace Vek.Docs.Examples

<VekDialog>
    <DialogContent>
        Dialog Content
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="Cancel">Cancel</VekButton>
        <VekButton Color="Color.Primary" OnClick="CancelAll">Close All</VekButton>
    </DialogActions>
</VekDialog>


@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; }

    private void Cancel() => VekDialog.Cancel();

    private void CancelAll() => VekDialog.CancelAll();
}