@namespace Vek.Docs.Examples

<VekStack>
    <VekDateRangePicker @ref="_picker" Label="With action buttons" @bind-DateRange="_dateRange" 
                        AutoClose="@_autoClose" PickerVariant="PickerVariant.Dialog">
        <PickerActions>
            <VekButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Clear</VekButton>
            <VekButton OnClick="@(() => _picker.CloseAsync(false))">Cancel</VekButton>
            <VekButton Color="Color.Primary" OnClick="@(() => _picker.CloseAsync())">OK</VekButton>
        </PickerActions>
    </VekDateRangePicker>
    <VekSwitch @bind-Value="_autoClose" Color="Color.Secondary">AutoClose</VekSwitch>
</VekStack>

@code {
    private VekDateRangePicker _picker;
    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);
    private bool _autoClose;
}