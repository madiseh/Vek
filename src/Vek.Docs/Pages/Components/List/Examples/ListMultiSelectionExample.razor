@namespace Vek.Docs.Examples

<VekPaper Width="300px">
    <VekList T="string" @bind-SelectedValues="SelectedValues" SelectionMode="SelectionMode.MultiSelection" ReadOnly="@ReadOnly" CheckBoxColor="Color.Tertiary">
        <VekListSubheader>
            Select your favourite drinks:
        </VekListSubheader>
        <VekListItem Text="Milk" />
        <VekListItem Text="Sparkling Water" Value='"Carbonated H²O"' />
        <VekListItem Text="Teas">
            <NestedList>
                <VekListItem Text="English Tea" Value='"Earl Grey"' />
                <VekListItem Text="Chinese Tea" Value='"Gunpowder Tea"' />
                <VekListItem Text="Bubble Tea" />
            </NestedList>
        </VekListItem>
        <VekListItem Text="Coffees">
            <NestedList>
                <VekListItem Text="Irish Coffee" />
                <VekListItem Text="Double Espresso" />
                <VekListItem Text="Cafe Latte" />
            </NestedList>
        </VekListItem>
    </VekList>
</VekPaper>

<VekStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <VekChipSet T="string" @bind-SelectedValues="SelectedValues" SelectionMode="SelectionMode.MultiSelection" Color="Color.Tertiary" Variant="Variant.Text">
        <VekChip Text="Milk"/>
        <VekChip Text="Carbonated H²O"/>
        <VekChip Text="Earl Grey"/>
        <VekChip Text="Gunpowder Tea" />
        <VekChip Text="Bubble Tea" />
        <VekChip Text="Irish Coffee" />
        <VekChip Text="Double Espresso"/>
        <VekChip Text="Cafe Latte"/>
    </VekChipSet>
    <VekSwitch @bind-Value="ReadOnly" Color="Color.Info">ReadOnly</VekSwitch>    
</VekStack>

@code
{
    public IReadOnlyCollection<string> SelectedValues = ["Milk", "Cafe Latte"];
    public bool ReadOnly;
}
