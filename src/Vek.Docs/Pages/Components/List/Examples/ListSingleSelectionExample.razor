@namespace Vek.Docs.Examples

<VekPaper Width="300px">
<VekList T="string" @bind-SelectedValue="SelectedValue" SelectionMode="@SelectionMode" ReadOnly="@ReadOnly" Color="@Color.Info">
        <VekListSubheader>
            Your drink:
        <VekChip Color="@Color.Info">
            @(SelectedValue ?? "You are dry")
        </VekChip>
        </VekListSubheader>
        <VekListItem Text="Milk" />
        <VekListItem Text="Sparkling Water" Value='"Carbonated H²O"' />
        <VekListItem Text="Teas">
            <NestedList>
                <VekListItem Text="English Tea" Value='"Earl Grey"' />
                <VekListItem Text="Chinese Tea" Value='"Gunpowder Tea"' />
                <VekListItem Text="Bubble Tea" />
            </NestedList>
        </VekListItem>
        <VekListItem Text="Coffees">
            <NestedList>
                <VekListItem Text="Irish Coffee" />
                <VekListItem Text="Double Espresso" />
                <VekListItem Text="Cafe Latte" />
            </NestedList>
        </VekListItem>
    </VekList>
</VekPaper>

<VekStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <VekRadioGroup @bind-Value="SelectionMode">
        <VekRadio Value="SelectionMode.SingleSelection" Color="Color.Primary">SingleSelection</VekRadio>
        <VekRadio Value="SelectionMode.ToggleSelection" Color="Color.Primary">ToggleSelection</VekRadio>
    </VekRadioGroup>
    <VekChipSet T="string" @bind-SelectedValue="SelectedValue" SelectionMode="@SelectionMode" Color="Color.Info" Variant="Variant.Text">
        <VekChip Text="Milk" />
        <VekChip Text="Carbonated H²O" />
        <VekChip Text="Earl Grey" />
        <VekChip Text="Gunpowder Tea" />
        <VekChip Text="Bubble Tea" />
        <VekChip Text="Irish Coffee" />
        <VekChip Text="Double Espresso" />
        <VekChip Text="Cafe Latte" />
    </VekChipSet>
    <VekSwitch @bind-Value="ReadOnly" Color="Color.Primary">ReadOnly</VekSwitch>    
</VekStack>



@code
{
    public string SelectedValue = "Milk";
    public SelectionMode SelectionMode = SelectionMode.SingleSelection;
    public bool ReadOnly;
}
