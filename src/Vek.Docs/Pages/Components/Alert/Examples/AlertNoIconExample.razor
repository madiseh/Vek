@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" NoIcon="true" Class="mb-2 mt-3">Default No Icon</VekAlert>
        <VekAlert Severity="Severity.Info" NoIcon="true" Class="my-2">Info No Icon</VekAlert>
        <VekAlert Severity="Severity.Success" NoIcon="true" Class="my-2">Success No Icon</VekAlert>
        <VekAlert Severity="Severity.Warning" NoIcon="true" Class="my-2">Warning No Icon</VekAlert>
        <VekAlert Severity="Severity.Error" NoIcon="true" Class="my-2">Error No Icon</VekAlert>
    </VekItem>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Icon Default No</VekAlert>
        <VekAlert Severity="Severity.Info" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Info No Icon</VekAlert>
        <VekAlert Severity="Severity.Success" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Success No Icon</VekAlert>
        <VekAlert Severity="Severity.Warning" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Warning No Icon</VekAlert>
        <VekAlert Severity="Severity.Error" Variant="Variant.Outlined" NoIcon="true" Class="my-2">Error No Icon</VekAlert>
    </VekItem>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" Variant="Variant.Filled" NoIcon="true" Class="mb-2 mt-3">Default No Icon</VekAlert>
        <VekAlert Severity="Severity.Info" Variant="Variant.Filled" NoIcon="true" Class="my-2">Info No Icon</VekAlert>
        <VekAlert Severity="Severity.Success" Variant="Variant.Filled" NoIcon="true" Class="my-2">Success No Icon</VekAlert>
        <VekAlert Severity="Severity.Warning" Variant="Variant.Filled" NoIcon="true" Class="my-2">Warning No Icon</VekAlert>
        <VekAlert Severity="Severity.Error" Variant="Variant.Filled" NoIcon="true" Class="my-2">Error No Icon</VekAlert>
    </VekItem>
</VekGrid>