                                <h2 class="header-title">Utilities</h2>
                                <p class="header-desc">CSS helper utility classes for border radius, display, flexbox, and spacing.</p>
                            </div>
                        </div>
                        <span class="header-badge">4 components</span>
                    </div>

                    <div class="vek-bento-grid">
                        @if (Matches("Border Radius", "utilities", "CSS utility classes for applying standard rounded corner radii."))
                        {
                            <DocsExploreCard Title="Border Radius" Category="Utilities" Link="/utilities/border-radius" Description="CSS utility classes for applying standard rounded corner radii.">
                                <div style="width:48px; height:48px; border-radius:14px; background:var(--vek-palette-primary);" class="shadow-sm"></div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Display", "utilities", "CSS utility classes for controlling element display, hidden states, and block flow."))
                        {
                            <DocsExploreCard Title="Display" Category="Utilities" Link="/utilities/display" Description="CSS utility classes for controlling element display, hidden states, and block flow.">
                                <div class="d-flex gap-1">
                                    <span class="pa-1 rounded docs-gray-bg text-caption font-weight-bold">d-flex</span>
                                    <span class="pa-1 rounded docs-gray-bg text-caption font-weight-bold">d-none</span>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Flex", "utilities", "Flexbox layout utility helpers for alignment, justification, wrapping, and direction."))
                        {
                            <DocsExploreCard Title="Flex" Category="Utilities" Link="/utilities/flex" Description="Flexbox layout utility helpers for alignment, justification, wrapping, and direction.">
                                <div class="d-flex justify-space-between align-center px-2 py-1 rounded border border-solid vek-border-lines-default" style="width:130px;">
                                    <span style="font-size:0.65rem; font-weight:600;">Start</span>
                                    <span style="font-size:0.65rem; font-weight:600; color:var(--vek-palette-primary);">Between</span>
                                    <span style="font-size:0.65rem; font-weight:600;">End</span>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Spacing", "utilities", "Comprehensive margin and padding spacing utility classes (ma-*, pa-*)."))
                        {
                            <DocsExploreCard Title="Spacing" Category="Utilities" Link="/utilities/spacing" Description="Comprehensive margin and padding spacing utility classes (ma-*, pa-*).">
                                <div class="pa-2 rounded border-2 border-dashed vek-border-primary docs-gray-bg">
                                    <div class="pa-2 rounded vek-theme-primary text-white text-caption font-weight-bold">pa-4 ma-2</div>
                                </div>
                            </DocsExploreCard>
                        }
                    </div>
                </div>
            }

            <!-- Empty Search State -->
            @if (GetTotalVisibleCount() == 0)
            {
                <div class="vek-bento-empty">
                    <VekIcon Icon="@Icons.Material.Rounded.SearchOff" Style="font-size: 48px;" Color="Color.Default" Class="mb-3" />
                    <VekText Typo="Typo.h6">No components found</VekText>
                    <VekText Typo="Typo.body2" Class="text-secondary mt-1">We couldn't find any components matching "@_searchQuery".</VekText>
                    <VekButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ClearSearch" Class="mt-4" Size="Size.Small">
                        Clear Filter
                    </VekButton>
                </div>
            }
        </DocsPageSection>
    </DocsPageContent>
</DocsPage>

@code {
    [Inject] IMenuService MenuService { get; set; }

    private string _searchQuery = "";
    private string _selectedCategory = "all";

    private record CategoryInfo(string Key, string Name, int Count);

    private readonly List<CategoryInfo> _categories = new()
    {
        new("all", "All", 66),
        new("foundation", "Foundation", 4),
        new("layout", "Layout", 10),
        new("buttons", "Buttons", 6),
        new("inputs", "Forms & Inputs", 17),
        new("data", "Data Display", 19),
        new("navigation", "Navigation", 4),
        new("feedback", "Feedback", 8),
        new("utilities", "Utilities", 4)
    };

    private readonly Dictionary<string, string[]> _sectionItems = new(StringComparer.OrdinalIgnoreCase)
    {
        ["foundation"] = ["Colors", "Typography", "Shadows", "Icons"],
        ["layout"] = ["App Bar", "Container", "Drawer", "Grid", "Hidden", "Paper", "Divider", "Stack", "ToolBar", "Split Panel"],
        ["buttons"] = ["Button", "Button Group", "Button FAB", "Icon Button", "Toggle Icon Button", "Scroll To Top"],
        ["inputs"] = ["Autocomplete", "Check Box", "Color Picker", "Date Picker", "Field", "File Upload", "Form", "Focus Trap", "Highlighter", "Numeric Field", "Radio", "Rating", "Select", "Slider", "Switch", "Text Field", "Time Picker"],
        ["data"] = ["Avatar", "Card", "Carousel", "Chips", "Chip Set", "Data Grid", "Drop Zone", "Expansion Panels", "Image", "List", "Pagination", "Popover", "Simple Table", "Stepper", "Table", "Tabs", "Timeline", "Tooltip", "Tree View"],
        ["navigation"] = ["Breadcrumbs", "Link", "Menu", "Nav Menu"],
        ["feedback"] = ["Alert", "Badge", "Dialog", "Message Box", "Progress", "Skeleton", "Snackbar", "Overlay"],
        ["utilities"] = ["Border Radius", "Display", "Flex", "Spacing"]
    };

    private bool Matches(string title, string category, string description = "")
    {
        if (_selectedCategory != "all" && !string.Equals(_selectedCategory, category, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            return true;
        }

        var q = _searchQuery.Trim();
        return title.Contains(q, StringComparison.OrdinalIgnoreCase)
            || category.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrEmpty(description) && description.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private bool SectionHasMatches(string sectionKey)
    {
        if (_selectedCategory != "all" && !string.Equals(_selectedCategory, sectionKey, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            return true;
        }

        if (!_sectionItems.TryGetValue(sectionKey, out var items))
        {
            return true;
        }

        return items.Any(item => Matches(item, sectionKey));
    }

    private int GetTotalVisibleCount()
    {
        int count = 0;
        foreach (var (sec, items) in _sectionItems)
        {
            if (_selectedCategory == "all" || string.Equals(_selectedCategory, sec, StringComparison.OrdinalIgnoreCase))
            {
                count += items.Count(item => Matches(item, sec));
            }
        }
        return count;
    }

    private void SelectCategory(string categoryKey)
    {
        _selectedCategory = categoryKey;
    }

    private void ClearSearch()
    {
        _searchQuery = string.Empty;
        _selectedCategory = "all";
    }
}
