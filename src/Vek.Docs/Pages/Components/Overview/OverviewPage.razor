@page "/docs"
@page "/docs/overview"

<DocsPage DisplayFooter="true">
    <DocsPageHeader Title="Explore Vek">
        <SpecialHeaderContent>
            <div class="vek-bento-hero">
                <div class="vek-bento-badge">
                    <span class="vek-bento-badge-dot"></span>
                    <span>Vek Component Directory</span>
                    <span class="vek-bento-badge-sep">&bull;</span>
                    <span class="vek-bento-badge-sub">66 Production-Ready Controls</span>
                </div>
                <h1 class="vek-bento-title">
                    Explore <span class="vek-bento-gradient-text">Vek</span> Components
                </h1>
                <p class="vek-bento-subtitle">
                    A comprehensive, high-performance Blazor component library crafted with modern aesthetics, full WAI-ARIA accessibility, and deep theming flexibility.
                </p>

                <!-- Search Input -->
                <div class="vek-bento-search-box">
                    <VekTextField @bind-Value="_searchQuery"
                                  Placeholder="Search components by name or keyword (e.g. Button, Table, Dialog, Colors)..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Rounded.Search"
                                  AdornmentColor="Color.Primary"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Clearable="true"
                                  Class="docs-search-bar" />
                </div>

                <!-- Category Filter Chips -->
                <div class="vek-bento-filters" role="tablist" aria-label="Component Categories">
                    @foreach (var cat in _categories)
                    {
                        <button type="button"
                                role="tab"
                                aria-selected="@(_selectedCategory == cat.Key ? "true" : "false")"
                                class="vek-bento-chip @(_selectedCategory == cat.Key ? "active" : "")"
                                @onclick="() => SelectCategory(cat.Key)">
                            <span>@cat.Name</span>
                            <span class="vek-bento-chip-count">@cat.Count</span>
                        </button>
                    }
                </div>
            </div>
        </SpecialHeaderContent>
    </DocsPageHeader>

    <DocsPageContent>
        <DocsPageSection>
            <!-- 1. Foundation -->
            @if (SectionHasMatches("foundation"))
            {
                <div class="vek-bento-section">
                    <div class="vek-bento-section-header">
                        <div class="header-left">
                            <div class="header-icon">
                                <VekIcon Icon="@Icons.Material.Rounded.Palette" Size="Size.Small" />
                            </div>
                            <div>
                                <h2 class="header-title">Foundation</h2>
                                <p class="header-desc">Theming, color palette, typographic scale, and design tokens.</p>
                            </div>
                        </div>
                        <span class="header-badge">4 components</span>
                    </div>

                    <div class="vek-bento-grid">
                        @if (Matches("Colors", "foundation", "Theming color palette, dark mode contrasts, and semantic design tokens."))
                        {
                            <DocsExploreCard Title="Colors" Category="Foundation" Link="/features/colors" Description="Theming color palette, status tones, and semantic design tokens.">
                                <div class="vek-mini-swatches">
                                    <span class="swatch" style="background:#2563EB;"></span>
                                    <span class="swatch" style="background:#7C3AED;"></span>
                                    <span class="swatch" style="background:#10B981;"></span>
                                    <span class="swatch" style="background:#F59E0B;"></span>
                                    <span class="swatch" style="background:#EF4444;"></span>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Typography", "foundation", "Standardized typographic scale, font hierarchy, and responsive text styles."))
                        {
                            <DocsExploreCard Title="Typography" Category="Foundation" Link="/components/typography" Description="Standardized typographic scale, font hierarchy, and responsive text styles.">
                                <div class="vek-mini-typo">
                                    <span class="big-a">Aa</span>
                                    <span class="font-meta">Inter &bull; 16px</span>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Shadows", "foundation", "Layered surface elevation system with 25 distinct shadow depth levels."))
                        {
                            <DocsExploreCard Title="Shadows" Category="Foundation" Link="/features/elevation" Description="Layered surface elevation system with 25 distinct shadow depth levels.">
                                <div class="vek-mini-shadow">
                                    <span>Elevation 8</span>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Icons", "foundation", "Curated Material, Custom, and FontAwesome vector SVG icon collections."))
                        {
                            <DocsExploreCard Title="Icons" Category="Foundation" Link="/features/icons" Description="Curated Material, Custom, and FontAwesome vector SVG icon collections.">
                                <div class="vek-mini-icons">
                                    <div class="icon-box"><VekIcon Icon="@Icons.Material.Rounded.Dashboard" Color="Color.Primary" Size="Size.Small"/></div>
                                    <div class="icon-box"><VekIcon Icon="@Icons.Material.Rounded.Bolt" Color="Color.Warning" Size="Size.Small"/></div>
                                    <div class="icon-box"><VekIcon Icon="@Icons.Material.Rounded.Layers" Color="Color.Secondary" Size="Size.Small"/></div>
                                </div>
                            </DocsExploreCard>
                        }
                    </div>
                </div>
            }

            <!-- 2. Layout -->
            @if (SectionHasMatches("layout"))
            {
                <div class="vek-bento-section">
                    <div class="vek-bento-section-header">
                        <div class="header-left">
                            <div class="header-icon">
                                <VekIcon Icon="@Icons.Material.Rounded.ViewQuilt" Size="Size.Small" />
                            </div>
                            <div>
                                <h2 class="header-title">Layout</h2>
                                <p class="header-desc">Grid systems, containers, toolbars, and responsive surface structures.</p>
                            </div>
                        </div>
                        <span class="header-badge">10 components</span>
                    </div>

                    <div class="vek-bento-grid">
                        @if (Matches("App Bar", "layout", "Top application navigation bar with actions, titles, and branding."))
                        {
                            <DocsExploreCard Title="App Bar" Category="Layout" Description="Top application navigation bar with actions, titles, and branding.">
                                <div class="vek-mini-appbar">
                                    <div class="appbar-top"><span class="dot"></span><span class="dot"></span></div>
                                    <div class="appbar-body"><div class="line" style="width:60%;"></div><div class="line" style="width:30%;"></div></div>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Container", "layout", "Responsive horizontal centering container with standard breakpoint constraints."))
                        {
                            <DocsExploreCard Title="Container" Category="Layout" Description="Responsive horizontal centering container with standard breakpoint constraints.">
                                <VekPaper Elevation="0" Outlined="true" Class="px-5 py-2 rounded-lg docs-gray-bg d-flex align-center justify-center">
                                    <span style="font-size:0.75rem; font-weight:600; color:var(--vek-palette-primary);">MaxWidth.Large</span>
                                </VekPaper>
                            </DocsExploreCard>
                        }

                        @if (Matches("Drawer", "layout", "Collapsible navigation sidebar drawer supporting docked, persistent, or modal modes."))
                        {
                            <DocsExploreCard Title="Drawer" Category="Layout" Description="Collapsible navigation sidebar drawer supporting docked, persistent, or modal modes.">
                                <div style="width:130px; height:56px;" class="d-flex rounded-lg overflow-hidden border border-solid vek-border-lines-default">
                                    <div style="width:36px; height:100%;" class="vek-theme-primary d-flex flex-column pa-1 gap-1">
                                        <div style="height:3px; width:12px; background:#fff; border-radius:1px;"></div>
                                        <div style="height:3px; width:16px; background:#fff; border-radius:1px;"></div>
                                    </div>
                                    <div class="flex-grow-1 docs-gray-bg pa-2 d-flex flex-column gap-1">
                                        <div style="height:4px; width:70%;" class="border border-solid vek-border-lines-default rounded"></div>
                                    </div>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Grid", "layout", "Fluid 12-column responsive flex grid system with spacing and alignment options."))
                        {
                            <DocsExploreCard Title="Grid" Category="Layout" Description="Fluid 12-column responsive flex grid system with spacing and alignment options.">
                                <div style="width:130px;" class="d-flex gap-1">
                                    <div class="flex-grow-1 pa-2 rounded vek-theme-primary" style="height:42px;"></div>
                                    <div class="flex-grow-1 pa-2 rounded docs-gray-bg border border-solid vek-border-lines-default" style="height:42px;"></div>
                                    <div class="flex-grow-1 pa-2 rounded docs-gray-bg border border-solid vek-border-lines-default" style="height:42px;"></div>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Hidden", "layout", "Conditionally render or hide DOM elements based on active viewport breakpoints."))
                        {
                            <DocsExploreCard Title="Hidden" Category="Layout" Description="Conditionally render or hide DOM elements based on active viewport breakpoints.">
                                <div class="d-flex align-center gap-1">
                                    <VekChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">xs: Hidden</VekChip>
                                    <VekChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">md: Visible</VekChip>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Paper", "layout", "Elevated surface card container with customizable elevation, outline, and borders."))
                        {
                            <DocsExploreCard Title="Paper" Category="Layout" Description="Elevated surface card container with customizable elevation, outline, and borders.">
                                <VekPaper Elevation="4" Class="pa-3 rounded-lg d-flex align-center justify-center" Style="width:110px; height:48px;">
                                    <span style="font-size:0.75rem; font-weight:600;">Surface</span>
                                </VekPaper>
                            </DocsExploreCard>
                        }

                        @if (Matches("Divider", "layout", "Thin separator line dividing content sections horizontally or vertically."))
                        {
                            <DocsExploreCard Title="Divider" Category="Layout" Description="Thin separator line dividing content sections horizontally or vertically.">
                                <div style="width:130px;" class="d-flex flex-column gap-2">
                                    <div style="height:5px; width:60%; border-radius:2px;" class="docs-gray-bg"></div>
                                    <VekDivider />
                                    <div style="height:5px; width:80%; border-radius:2px;" class="docs-gray-bg"></div>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Stack", "layout", "Linear layout container for organizing child components along vertical or horizontal axes."))
                        {
                            <DocsExploreCard Title="Stack" Category="Layout" Description="Linear layout container for organizing child components along vertical or horizontal axes.">
                                <div class="d-flex gap-2">
                                    <div style="width:28px; height:28px;" class="rounded-lg vek-theme-primary d-flex align-center justify-center text-caption font-weight-bold text-white">1</div>
                                    <div style="width:28px; height:28px;" class="rounded-lg docs-gray-bg border border-solid vek-border-lines-default d-flex align-center justify-center text-caption font-weight-bold">2</div>
                                    <div style="width:28px; height:28px;" class="rounded-lg docs-gray-bg border border-solid vek-border-lines-default d-flex align-center justify-center text-caption font-weight-bold">3</div>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("ToolBar", "layout", "Flexible header and action toolbar with dense mode and responsive gutter control."))
                        {
                            <DocsExploreCard Title="ToolBar" Category="Layout" Description="Flexible header and action toolbar with dense mode and responsive gutter control.">
                                <VekPaper Elevation="0" Outlined="true" Class="px-3 py-1 rounded-lg d-flex align-center gap-2" Style="width:130px;">
                                    <VekIcon Icon="@Icons.Material.Rounded.Menu" Size="Size.Small" Color="Color.Primary"/>
                                    <div style="height:4px; width:40px; border-radius:2px;" class="docs-gray-bg"></div>
                                    <VekSpacer />
                                    <VekIcon Icon="@Icons.Material.Rounded.MoreVert" Size="Size.Small" Color="Color.Default"/>
                                </VekPaper>
                            </DocsExploreCard>
                        }

                        @if (Matches("Split Panel", "layout", "Interactive draggable split panes allowing users to resize adjacent views."))
                        {
                            <DocsExploreCard Title="Split Panel" Category="Layout" Badge="New" Description="Interactive draggable split panes allowing users to resize adjacent views.">
                                <div style="width:130px; height:46px;" class="d-flex border border-solid vek-border-lines-default rounded-lg overflow-hidden">
                                    <div style="width:45%; height:100%;" class="pa-1 docs-gray-bg"></div>
                                    <div style="width:4px; height:100%; background:var(--vek-palette-primary);"></div>
                                    <div style="width:55%; height:100%;" class="pa-1"></div>
                                </div>
                            </DocsExploreCard>
                        }
                    </div>
                </div>
            }

            <!-- 3. Buttons & Actions -->
            @if (SectionHasMatches("buttons"))
            {
                <div class="vek-bento-section">
                    <div class="vek-bento-section-header">
                        <div class="header-left">
                            <div class="header-icon">
                                <VekIcon Icon="@Icons.Material.Rounded.SmartButton" Size="Size.Small" />
                            </div>
                            <div>
                                <h2 class="header-title">Buttons &amp; Actions</h2>
                                <p class="header-desc">Interactive triggers, grouped actions, floating action buttons, and icons.</p>
                            </div>
                        </div>
                        <span class="header-badge">6 components</span>
                    </div>

                    <div class="vek-bento-grid">
                        @if (Matches("Button", "buttons", "Interactive button with filled, outlined, and text variants plus loading states."))
                        {
                            <DocsExploreCard Title="Button" Category="Buttons" Description="Interactive button with filled, outlined, and text variants plus loading states.">
                                <VekButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Rounded.ArrowForward">Primary</VekButton>
                            </DocsExploreCard>
                        }

                        @if (Matches("Button Group", "buttons", "Group related action buttons together into a single segmented horizontal strip."))
                        {
                            <DocsExploreCard Title="Button Group" Category="Buttons" Description="Group related action buttons together into a single segmented horizontal strip.">
                                <VekButtonGroup Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">
                                    <VekButton>Day</VekButton>
                                    <VekButton Variant="Variant.Filled">Week</VekButton>
                                    <VekButton>Month</VekButton>
                                </VekButtonGroup>
                            </DocsExploreCard>
                        }

                        @if (Matches("Button FAB", "buttons", "Floating action button for emphasizing the primary call-to-action on a view."))
                        {
                            <DocsExploreCard Title="Button FAB" Category="Buttons" Description="Floating action button for emphasizing the primary call-to-action on a view.">
                                <VekFab Color="Color.Primary" StartIcon="@Icons.Material.Rounded.Add" Size="Size.Small" />
                            </DocsExploreCard>
                        }

                        @if (Matches("Icon Button", "buttons", "Compact circular clickable icon button for toolbars and compact interfaces."))
                        {
                            <DocsExploreCard Title="Icon Button" Category="Buttons" Description="Compact circular clickable icon button for toolbars and compact interfaces.">
                                <div class="d-flex gap-2">
                                    <VekIconButton Icon="@Icons.Material.Rounded.Favorite" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" />
                                    <VekIconButton Icon="@Icons.Material.Rounded.Bookmark" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined" />
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Toggle Icon Button", "buttons", "Two-state toggle button switching between icons and colors upon interaction."))
                        {
                            <DocsExploreCard Title="Toggle Icon Button" Category="Buttons" Description="Two-state toggle button switching between icons and colors upon interaction.">
                                <VekToggleIconButton Toggled="true" Icon="@Icons.Material.Outlined.DarkMode" ToggledIcon="@Icons.Material.Filled.LightMode" ToggledColor="Color.Warning" Color="Color.Default" Size="Size.Medium" />
                            </DocsExploreCard>
                        }

                        @if (Matches("Scroll To Top", "buttons", "Floating button that smoothly returns the viewport to the top of the page."))
                        {
                            <DocsExploreCard Title="Scroll To Top" Category="Buttons" Description="Floating button that smoothly returns the viewport to the top of the page.">
                                <VekFab Color="Color.Primary" StartIcon="@Icons.Material.Rounded.KeyboardArrowUp" Size="Size.Small" />
                            </DocsExploreCard>
                        }
                    </div>
                </div>
            }

            <!-- 4. Forms & Inputs -->
            @if (SectionHasMatches("inputs"))
            {
                <div class="vek-bento-section">
                    <div class="vek-bento-section-header">
                        <div class="header-left">
                            <div class="header-icon">
                                <VekIcon Icon="@Icons.Material.Rounded.EditCalendar" Size="Size.Small" />
                            </div>
                            <div>
                                <h2 class="header-title">Forms &amp; Inputs</h2>
                                <p class="header-desc">Form controls, validation, pickers, selection inputs, and text fields.</p>
                            </div>
                        </div>
                        <span class="header-badge">17 components</span>
                    </div>

                    <div class="vek-bento-grid">
                        @if (Matches("Autocomplete", "inputs", "Searchable text input with dynamic asynchronous suggestions and keyboard navigation."))
                        {
                            <DocsExploreCard Title="Autocomplete" Category="Inputs" Description="Searchable text input with dynamic asynchronous suggestions and keyboard navigation.">
                                <div class="vek-mini-ac">
                                    <div class="ac-field"><span>Blazor</span><VekIcon Icon="@Icons.Material.Rounded.ArrowDropDown" Size="Size.Small"/></div>
                                    <div class="ac-dropdown"><span class="selected">&check; Blazor</span><span>Bootstrap</span></div>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Check Box", "inputs", "Standard binary toggle checkbox for forms, multi-selections, and lists."))
                        {
                            <DocsExploreCard Title="Check Box" Category="Inputs" Description="Standard binary toggle checkbox for forms, multi-selections, and lists.">
                                <div class="d-flex align-center">
                                    <VekCheckBox T="bool" Value="true" Color="Color.Primary" ReadOnly="true" Dense="true" />
                                    <span style="font-size:0.8rem; font-weight:600;">Accepted</span>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Color Picker", "inputs", "Full interactive RGB, HSL, and Hex color selector with palette swatches."))
                        {
                            <DocsExploreCard Title="Color Picker" Category="Inputs" Description="Full interactive RGB, HSL, and Hex color selector with palette swatches.">
                                <div class="d-flex align-center gap-2 pa-1 rounded-lg border border-solid vek-border-lines-default" style="width:125px;">
                                    <div style="width:24px; height:24px; background:#2563EB; border-radius:4px;"></div>
                                    <span style="font-size:0.75rem; font-family:monospace; font-weight:600;">#2563EB</span>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Date Picker", "inputs", "Calendar date selector popup with range selection, culture, and masking support."))
                        {
                            <DocsExploreCard Title="Date Picker" Category="Inputs" Description="Calendar date selector popup with range selection, culture, and masking support.">
                                <VekPaper Outlined="true" Class="px-3 py-1 rounded-lg d-flex align-center gap-2" Style="width:130px;">
                                    <VekIcon Icon="@Icons.Material.Rounded.Event" Size="Size.Small" Color="Color.Primary"/>
                                    <span style="font-size:0.75rem; font-weight:600;">2026-11-19</span>
                                </VekPaper>
                            </DocsExploreCard>
                        }

                        @if (Matches("Field", "inputs", "Base wrapper control providing labels, helper text, and validation messages."))
                        {
                            <DocsExploreCard Title="Field" Category="Inputs" Description="Base wrapper control providing labels, helper text, and validation messages.">
                                <div style="width:130px;">
                                    <div style="font-size:0.6875rem; font-weight:600; color:var(--vek-palette-primary); margin-bottom:2px;">Label</div>
                                    <div style="height:24px;" class="rounded border border-solid vek-border-primary pa-1 docs-gray-bg"></div>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("File Upload", "inputs", "File selection button or drop target supporting multi-file and type filters."))
                        {
                            <DocsExploreCard Title="File Upload" Category="Inputs" Description="File selection button or drop target supporting multi-file and type filters.">
                                <VekButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Rounded.CloudUpload">Upload</VekButton>
                            </DocsExploreCard>
                        }

                        @if (Matches("Form", "inputs", "Form orchestrator managing validation state, model binding, and submission."))
                        {
                            <DocsExploreCard Title="Form" Category="Inputs" Description="Form orchestrator managing validation state, model binding, and submission.">
                                <div style="width:130px;" class="d-flex flex-column gap-1">
                                    <div style="height:5px; width:40%; border-radius:2px;" class="docs-gray-bg"></div>
                                    <div style="height:14px; border-radius:4px;" class="border border-solid vek-border-lines-default"></div>
                                    <div style="height:10px; width:45px; border-radius:3px; background:var(--vek-palette-primary); margin-left:auto; margin-top:2px;"></div>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Focus Trap", "inputs", "Traps keyboard tab navigation within a specified boundary for accessible modals."))
                        {
                            <DocsExploreCard Title="Focus Trap" Category="Inputs" Description="Traps keyboard tab navigation within a specified boundary for accessible modals.">
                                <div class="pa-2 rounded border-2 border-dashed vek-border-primary d-flex align-center justify-center" style="width:120px;">
                                    <span style="font-size:0.7rem; font-weight:600; color:var(--vek-palette-primary);">[ Focus Trap ]</span>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Highlighter", "inputs", "Highlights search query matches and substrings within text blocks."))
                        {
                            <DocsExploreCard Title="Highlighter" Category="Inputs" Description="Highlights search query matches and substrings within text blocks.">
                                <div style="font-size:0.78rem;">
                                    Find <mark style="background:rgba(37,99,235,0.2); color:var(--vek-palette-primary); padding:1px 4px; border-radius:2px; font-weight:700;">keyword</mark> here
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Numeric Field", "inputs", "Specialized number input with min/max bounds, step incrementors, and formats."))
                        {
                            <DocsExploreCard Title="Numeric Field" Category="Inputs" Description="Specialized number input with min/max bounds, step incrementors, and formats.">
                                <VekPaper Outlined="true" Class="px-2 py-1 rounded-lg d-flex align-center justify-space-between" Style="width:120px;">
                                    <span style="font-size:0.8rem; font-weight:700;">42</span>
                                    <div class="d-flex flex-column">
                                        <VekIcon Icon="@Icons.Material.Rounded.ArrowDropUp" Size="Size.Small" Class="my-n2" Color="Color.Primary"/>
                                        <VekIcon Icon="@Icons.Material.Rounded.ArrowDropDown" Size="Size.Small" Class="my-n2" Color="Color.Primary"/>
                                    </div>
                                </VekPaper>
                            </DocsExploreCard>
                        }

                        @if (Matches("Radio", "inputs", "Mutually exclusive single-selection radio button for grouped options."))
                        {
                            <DocsExploreCard Title="Radio" Category="Inputs" Description="Mutually exclusive single-selection radio button for grouped options.">
                                <div class="d-flex align-center gap-2">
                                    <VekRadioGroup Value="1" T="int" ReadOnly="true">
                                        <VekRadio Value="1" Color="Color.Primary" Dense="true">Option A</VekRadio>
                                    </VekRadioGroup>
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Rating", "inputs", "Interactive star rating component for customer reviews, feedback, and scoring."))
                        {
                            <DocsExploreCard Title="Rating" Category="Inputs" Description="Interactive star rating component for customer reviews, feedback, and scoring.">
                                <VekRating SelectedValue="4" MaxValue="5" ReadOnly="true" Size="Size.Small" Color="Color.Warning" />
                            </DocsExploreCard>
                        }

                        @if (Matches("Select", "inputs", "Dropdown picker menu supporting single or multiple item selection."))
                        {
                            <DocsExploreCard Title="Select" Category="Inputs" Description="Dropdown picker menu supporting single or multiple item selection.">
                                <VekPaper Outlined="true" Class="px-3 py-1 rounded-lg d-flex align-center justify-space-between" Style="width:130px;">
                                    <span style="font-size:0.75rem; font-weight:600;">Active</span>
                                    <VekIcon Icon="@Icons.Material.Rounded.ArrowDropDown" Size="Size.Small" Color="Color.Primary"/>
                                </VekPaper>
                            </DocsExploreCard>
                        }

                        @if (Matches("Slider", "inputs", "Fluid range slider for selecting continuous or discrete numeric values."))
                        {
                            <DocsExploreCard Title="Slider" Category="Inputs" Description="Fluid range slider for selecting continuous or discrete numeric values.">
                                <div style="width:120px;">
                                    <VekSlider T="int" Value="60" Min="0" Max="100" Color="Color.Primary" Disabled="true" />
                                </div>
                            </DocsExploreCard>
                        }

                        @if (Matches("Switch", "inputs", "Smooth interactive toggle switch for boolean preferences and settings."))
                        {
                            <DocsExploreCard Title="Switch" Category="Inputs" Description="Smooth interactive toggle switch for boolean preferences and settings.">
