@namespace Vek.Docs.Examples

<VekToggleGroup  Class="vek-width-full" T="string" SelectedClass="black white-text">
    <VekToggleItem Value="@("Basic Edition")">
        <div class="vek-width-full vek-height-full">
            <div class="d-flex align-center justify-space-between flex-wrap">
                <VekText Class="ellipsis">Indie Developer</VekText>
                <VekChip Color="@(context ? Color.Success : Color.Primary)" Icon="@(context ? Icons.Material.Filled.Check : "")">Basic</VekChip>
            </div>
            <VekText Typo="Typo.subtitle2">Perfect for lone wolves</VekText>
        </div>
    </VekToggleItem>
    <VekToggleItem Value="@("Pro Edition")">
        <div class="vek-width-full vek-height-full">
            <div class="d-flex align-center justify-space-between flex-wrap">
                <VekText Class="ellipsis">Small Team</VekText>
                <VekChip Color="@(context ? Color.Success : Color.Primary)" Icon="@(context ? Icons.Material.Filled.Check : "")">Pro</VekChip>
            </div>
            <VekText Typo="Typo.subtitle2">Up to five devs and two interns</VekText>
        </div>
    </VekToggleItem>
    <VekToggleItem Value="@("Enterprise Edition")">
        <div class="vek-width-full vek-height-full">
            <div class="d-flex align-center justify-space-between flex-wrap">
                <VekText Class="ellipsis">Corporation</VekText>
                <VekChip Color="@(context ? Color.Success : Color.Primary)" Icon="@(context ? Icons.Material.Filled.Check : "")">Enterprise</VekChip>
            </div>
            <VekText Typo="Typo.subtitle2">Unlimited edition</VekText>
        </div>
    </VekToggleItem>
</VekToggleGroup>

<style>
    .ellipsis {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
</style>
