@namespace Vek.Docs.Examples

<VekStack>
    <VekStack AlignItems="AlignItems.Center" Justify="Justify.Center">
        <VekStack Spacing="8" AlignItems="@AlignItems.Center">
            <VekToggleGroup T="string" @bind-Value="_value1" Vertical="@_vertical" Outlined="@_outlined" Delimiters="@_delimiters" Size="@_size" Color="@_color" CheckMark="@_checkMark" FixedContent="@_fixedContent" Disabled="@_disabled" Style="width: 20rem">
                <VekToggleItem Value="@("One")" />
                <VekToggleItem Value="@("Two")" />
                <VekToggleItem Value="@("Three")" />
            </VekToggleGroup>

            <VekToggleGroup T="string" Vertical="@_vertical" Outlined="@_outlined" Delimiters="@_delimiters" Size="@_size" Color="@_color" CheckMark="@_checkMark" FixedContent="@_fixedContent" Disabled="@_disabled">
                <VekToggleItem Value="@("left")">
                    <VekIcon Icon="@Icons.Material.Filled.FormatAlignLeft" />
                </VekToggleItem>
                <VekToggleItem Value="@("center")">
                    <VekIcon Icon="@Icons.Material.Filled.FormatAlignCenter" />
                </VekToggleItem>
                <VekToggleItem Value="@("right")">
                    <VekIcon Icon="@Icons.Material.Filled.FormatAlignRight" />
                </VekToggleItem>
                <VekToggleItem Value="@("justify")">
                    <VekIcon Icon="@Icons.Material.Filled.FormatAlignJustify" />
                </VekToggleItem>
            </VekToggleGroup>
        </VekStack>
    </VekStack>

    <VekDivider />

    <VekStack>
        <VekSelect @bind-Value="_size" Label="Size">
            @foreach (var size in Enum.GetValues(typeof(Size)).Cast<Size>())
            {
                <VekSelectItem Value="@size">@size</VekSelectItem>
            }
        </VekSelect>

        <VekSelect @bind-Value="_color" Label="Color">
            @foreach (var color in Enum.GetValues(typeof(Color)).Cast<Color>())
            {
                <VekSelectItem Value="@color">@color</VekSelectItem>
            }
        </VekSelect>
    </VekStack>
    <VekStack Row Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
        <VekCheckBox @bind-Value="_checkMark" Label="CheckMark" />
        <VekCheckBox @bind-Value="_fixedContent" Label="FixedContent" />
        <VekCheckBox @bind-Value="_outlined" Label="Outlined" />
        <VekCheckBox @bind-Value="_delimiters" Label="Delimiters" />
        <VekCheckBox @bind-Value="_disabled" Label="Disabled" />
        <VekCheckBox @bind-Value="_vertical" Label="Vertical" />
    </VekStack>
</VekStack>

@code {
    string _value1;
    Size _size = Size.Medium;
    Color _color = Color.Primary;
    bool _checkMark = false;
    bool _outlined = true;
    bool _delimiters = true;
    bool _fixedContent = false;
    bool _disabled = false;
    bool _vertical = false;
}
