@namespace Vek.Docs.Examples

<VekStack>
    <VekToggleGroup T="string" SelectedClass="@_style" @bind-Value="_value">
        <VekToggleItem Value="@("Antimatter")" />
        <VekToggleItem Value="@("Dark Matter")" />
        <VekToggleItem Value="@("Dark Energy")" />
    </VekToggleGroup>

    <VekSelect T="string" @bind-Value="_style" Variant="Variant.Outlined">
        <VekSelectItem Value="@("vek-theme-primary")" />
        <VekSelectItem Value="@("vek-theme-secondary")" />
        <VekSelectItem Value="@("custom-gradient")" />
        <VekSelectItem Value="@("custom-striped")" />
    </VekSelect>
</VekStack>

<style>
    .custom-gradient {
        background-image: linear-gradient(to right top, #051937, #004d7a, #008793, #00bf72, #a8eb12);
        color: white !important;
    }

    .custom-striped {
        background: repeating-linear-gradient( 45deg, #606dbc, #606dbc 10px, #465298 10px, #465298 20px );
        color: white !important;
    }
</style>

@code {
    private string _style = "custom-striped";
    private string _value = "Antimatter";
}
