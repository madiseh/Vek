@namespace Vek.Docs.Examples

<VekStack Row Justify="Justify.SpaceAround" AlignItems="AlignItems.Start" Class="vek-width-full">
    <VekFileUpload T="IReadOnlyList<IBrowserFile>" AppendMultipleFiles="true">
        <CustomContent>
            <VekButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@context.OpenFilePickerAsync"
                       StartIcon="@Icons.Material.Filled.CloudUpload">
                AppendMultipleFiles = true
            </VekButton>
        </CustomContent>
        <SelectedTemplate>
            @if (context != null)
            {
                @foreach (var file in context)
                {
                    <VekText>@file.Name</VekText>
                }
            }
            else
            {
                <VekText>No files selected</VekText>
            }
        </SelectedTemplate>
    </VekFileUpload>

    <VekFileUpload T="IReadOnlyList<IBrowserFile>" AppendMultipleFiles="false">
        <CustomContent>
            <VekButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@context.OpenFilePickerAsync"
                       StartIcon="@Icons.Material.Filled.CloudUpload">
                AppendMultipleFiles = false
            </VekButton>
        </CustomContent>
        <SelectedTemplate>
            @if (context != null)
            {
                @foreach (var file in context)
                {
                    <VekText>@file.Name</VekText>
                }
            }
            else
            {
                <VekText>No files selected</VekText>
            }
        </SelectedTemplate>
    </VekFileUpload>
</VekStack>
