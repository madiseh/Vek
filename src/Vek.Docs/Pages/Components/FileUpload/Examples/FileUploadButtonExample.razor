@namespace Vek.Docs.Examples

<VekStack Row Justify="Justify.SpaceAround" AlignItems="AlignItems.Center" Class="vek-width-full">
    <VekFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
        <CustomContent>
            <VekButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="@context.OpenFilePickerAsync"
                       StartIcon="@Icons.Material.Filled.CloudUpload">
                Choose file
            </VekButton>
        </CustomContent>
        <SelectedTemplate />
    </VekFileUpload>

    <VekFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
        <CustomContent>
            <VekFab Color="Color.Secondary"
                    StartIcon="@Icons.Material.Filled.Image"
                    OnClick="@context.OpenFilePickerAsync"
                    Label="Choose photo" />
        </CustomContent>
        <SelectedTemplate />
    </VekFileUpload>

    <VekFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
        <CustomContent>
            <VekFab Color="Color.Success"
                    OnClick="@context.OpenFilePickerAsync"
                    StartIcon="@Icons.Material.Filled.AttachFile" />
        </CustomContent>
        <SelectedTemplate />
    </VekFileUpload>

    <VekFileUpload T="IBrowserFile" FilesChanged="UploadFiles">
        <CustomContent>
            <VekIconButton Color="Color.Info"
                           OnClick="@context.OpenFilePickerAsync"
                           Icon="@Icons.Material.Filled.PhotoCamera">
            </VekIconButton>
        </CustomContent>
        <SelectedTemplate />
    </VekFileUpload>

    <VekFileUpload T="IBrowserFile" FilesChanged="UploadFiles" Disabled>
        <CustomContent>
            <VekButton Variant="Variant.Filled"
                       OnClick="@context.OpenFilePickerAsync"
                       Color="Color.Primary">
                Disabled button
            </VekButton>
        </CustomContent>
        <SelectedTemplate />
    </VekFileUpload>
</VekStack>

<VekFlexBreak />

@if (_files != null)
{
    <VekText Typo="@Typo.h6">@_files.Count() File@(_files.Count() == 1 ? "" : "s"):</VekText>
    @if (_files.Count > 0)
    {
        <VekFlexBreak />
        <VekList T="string">
            @foreach (var file in _files)
            {
                <VekListItem Icon="@Icons.Material.Filled.AttachFile" @key="@file">
                    @file.Name <code>@file.Size bytes</code>
                </VekListItem>
            }
        </VekList>
    }
}

@code
{
    private readonly IList<IBrowserFile> _files = new List<IBrowserFile>();

    private void UploadFiles(IBrowserFile file)
    {
        _files.Add(file);
        //TODO upload the files to the server
    }
}
