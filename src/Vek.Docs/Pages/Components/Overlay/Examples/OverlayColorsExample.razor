@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem xs="12" sm="6">
        <VekPaper Class="pa-4 my-2" Style="position:relative;">
            <VekOverlay Visible="lightVisible" LightBackground="true" Absolute="true" />
            <VekText>
                Det var en gång en spindel, som hette laban. Laban tyckte om kebab pizza, men det gjorde inte hans kompis åke.
                Åke och Laban skulle en dag ut och fiska. På vägen dit skrek Laban till, faaan du åke!!! det luktar kebab!!!
            </VekText>
            <VekButton Variant="Variant.Filled" Class="mt-2">Action</VekButton>
        </VekPaper>
        <VekSwitch @bind-Value="lightVisible" Label="Light Overlay" Color="Color.Primary"/>
    </VekItem>
    <VekItem xs="12" sm="6">
        <VekPaper Class="pa-4 my-2" Style="position:relative;">
            <VekOverlay Visible="darkVisible" DarkBackground="true" Absolute="true" />
            <VekText>
                Det var en gång en spindel, som hette laban. Laban tyckte om kebab pizza, men det gjorde inte hans kompis åke.
                Åke och Laban skulle en dag ut och fiska. På vägen dit skrek Laban till, faaan du åke!!! det luktar kebab!!!
            </VekText>
            <VekButton Variant="Variant.Filled" Class="mt-2">Action</VekButton>
        </VekPaper>
        <VekSwitch @bind-Value="darkVisible" Label="Dark Overlay" Color="Color.Secondary" />
    </VekItem>
</VekGrid>


@code {
    private bool lightVisible;
    private bool darkVisible;
} 