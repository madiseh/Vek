@namespace Vek.Docs.Examples

<VekButton Variant="Variant.Filled" Color="Color.Tertiary" OnClick="OpenOverlay">Show overlay</VekButton>

<VekOverlay @bind-Visible="_visible" DarkBackground="true" ZIndex="@(_setZIndex ? 9999 : 5)" AutoClose="true"/>

<div>
    <VekSwitch @bind-Value="_withPopover" Label="With Popover" />
    @if (_withPopover)
    {
        <VekPopover Open="_visible" AnchorOrigin="Origin.BottomLeft">
            <VekText Typo="Typo.h6">This Is a Popover</VekText>
        </VekPopover>
    }
</div>
<VekSwitch @bind-Value="_setZIndex" Label="Set ZIndex to 9999" />

@code {
    private bool _visible;
    private bool _setZIndex = true;
    private bool _withPopover;

    public void OpenOverlay()
    {
        _visible = true;
    }
} 
