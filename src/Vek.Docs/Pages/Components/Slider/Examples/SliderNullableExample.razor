@namespace Vek.Docs.Examples

<VekSlider T="int" @bind-Value="@_value" @bind-NullableValue="@_nullableValue" />
<div class="d-flex flex-column align-center">
    <VekText Class="pb-4">@_value</VekText>
    <VekText Class="pb-4">Nullable Value: @(_nullableValue is null ? "null" : _nullableValue)</VekText>
    <VekButton @onclick="Reset" Variant="Variant.Filled" Color="Color.Primary">Reset to null</VekButton>
</div>

@code {
    private int _value;
    private int? _nullableValue;

    private void Reset() => _nullableValue = null;
}
