@namespace Vek.Docs.Examples

<VekCard>
    <VekCardHeader>
        <CardHeaderContent>
            <VekText Typo="Typo.h6">The Story Book</VekText>
        </CardHeaderContent>
        <CardHeaderActions>
            <VekIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" />
        </CardHeaderActions>
    </VekCardHeader>
    <VekCardContent>
        <VekText>This day everything happened.</VekText>
        <VekText Typo="Typo.body2">The quick, brown fox jumps over a lazy dog.</VekText>
    </VekCardContent>
    <VekCardActions>
        <VekButton Variant="Variant.Text" Color="Color.Primary">Read more</VekButton>
    </VekCardActions>
</VekCard>
