@namespace Vek.Docs.Examples

<VekCard Collapsible="true" @bind-Expanded="_expanded">
    <VekCardHeader>
        <CardHeaderContent>
            <VekText Typo="Typo.h6">Release notes</VekText>
        </CardHeaderContent>
    </VekCardHeader>
    <VekCardContent>
        <VekText>Review the latest improvements before sharing this update with your team.</VekText>
    </VekCardContent>
</VekCard>

@code {
    private bool _expanded = true;
}
