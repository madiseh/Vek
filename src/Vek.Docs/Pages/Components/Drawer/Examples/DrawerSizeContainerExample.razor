@namespace Vek.Docs.Examples

<VekPaper Height="200px" Class="vek-theme-primary" Style="overflow:hidden; position:relative;">
    <VekDrawerContainer Class="vek-height-full">
        <VekDrawer @bind-Open="@_openStart" Width="150px" Fixed="false" Anchor="Anchor.Start" Elevation="0" Variant="@DrawerVariant.Persistent">
            <VekDrawerHeader>
                <VekText Typo="Typo.h6">My App</VekText>
            </VekDrawerHeader>
            <VekNavMenu>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Store">Store</VekNavLink>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalLibrary">Library</VekNavLink>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Forum">Community</VekNavLink>
            </VekNavMenu>
        </VekDrawer>
        <VekDrawer @bind-Open="@_openEnd" Width="300px" Fixed="false" Anchor="Anchor.End" Elevation="0" Variant="@DrawerVariant.Persistent">
            <VekDrawerHeader>
                <VekText Typo="Typo.h6">Settings</VekText>
            </VekDrawerHeader>
            <VekNavMenu>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBox">Profile</VekNavLink>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ShoppingCart">Orders</VekNavLink>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.History">Order History</VekNavLink>
            </VekNavMenu>
        </VekDrawer>
        <div class="d-flex justify-center align-center vek-height-full">
            <VekButton Color="Color.Inherit" OnClick="@ToggleStartDrawer" StartIcon="@(Rtl ? Icons.Material.Filled.East : Icons.Material.Filled.West)" Class="mx-2">Toggle start</VekButton>
            <VekButton Color="Color.Inherit" OnClick="@ToggleEndDrawer" EndIcon="@(Rtl ? Icons.Material.Filled.West : Icons.Material.Filled.East)" Class="mx-2">Toggle end</VekButton>
        </div>
    </VekDrawerContainer>
</VekPaper>

@code
{
    private bool _openStart = false;
    private bool _openEnd = false;

    [CascadingParameter]
    public bool Rtl { get; set; }

    private void ToggleStartDrawer()
    {
        _openStart = !_openStart;
    }

    private void ToggleEndDrawer()
    {
        _openEnd = !_openEnd;
    } 
}
