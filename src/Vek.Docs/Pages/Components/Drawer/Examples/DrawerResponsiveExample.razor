@layout IframeLayout
@namespace Vek.Docs.Examples
@page "/iframe/docs/examples/drawer/persistent"

<VekLayout>
    <VekAppBar Elevation="1">
        <VekIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <VekSpacer />
        <VekIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/madiseh/vek" Target="_blank" />
    </VekAppBar>
    <VekDrawer @bind-Open="@_open" Elevation="1">
        <VekDrawerHeader>
            <VekText Typo="Typo.h6">My App</VekText>
        </VekDrawerHeader>
        <VekNavMenu>
            <VekNavLink Match="NavLinkMatch.All">Store</VekNavLink>
            <VekNavLink Match="NavLinkMatch.All">Library</VekNavLink>
            <VekNavLink Match="NavLinkMatch.All">Community</VekNavLink>
        </VekNavMenu>
    </VekDrawer>
    <VekMainContent Class="pt-16 px-16">
        <VekContainer Class="mt-6">
            <VekAlert Severity="Severity.Success" Class="mt-16">Text inside VekContainer</VekAlert>
        </VekContainer>
    </VekMainContent>
</VekLayout>

@code{
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}
