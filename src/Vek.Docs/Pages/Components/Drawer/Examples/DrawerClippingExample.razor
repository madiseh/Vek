@layout IframeLayout
@namespace Vek.Docs.Examples
@page "/iframe/docs/examples/drawer/clipped"

<VekLayout>
    <VekAppBar Elevation="1" Dense="@_dense">
        <VekIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <VekSpacer />
        <VekIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/madiseh/vek" Target="_blank" />
    </VekAppBar>
    <VekDrawer @bind-Open="@_open" ClipMode="_clipMode" Elevation="1" Variant="@DrawerVariant.Responsive">
        <VekDrawerHeader>
            <VekText Typo="Typo.h6">My App</VekText>
        </VekDrawerHeader>
        <VekNavMenu>
            <VekNavLink Match="NavLinkMatch.All">Store</VekNavLink>
            <VekNavLink Match="NavLinkMatch.All">Library</VekNavLink>
            <VekNavLink Match="NavLinkMatch.All">Community</VekNavLink>
        </VekNavMenu>
    </VekDrawer>
    <VekMainContent Class="pt-16 px-16">
        <VekContainer Class="mt-6">
            <VekSelect Label="Select clip mode" @bind-Value="_clipMode">
                <VekSelectItem Value="@DrawerClipMode.Never">Not clipped (DrawerClipMode.Never)</VekSelectItem>
                <VekSelectItem Value="@DrawerClipMode.Docked">Drawer is docked (DrawerClipMode.Docked)</VekSelectItem>
                <VekSelectItem Value="@DrawerClipMode.Always">Always (DrawerClipMode.Always)</VekSelectItem>
            </VekSelect>
            <VekSwitch @bind-Value="_dense" Label="Dense appbar" Color="Color.Primary" Style="width:100%;" />
        </VekContainer>
    </VekMainContent>
</VekLayout>

@code{
    private bool _open = false;
    private bool _dense = false;
    private DrawerClipMode _clipMode = DrawerClipMode.Never;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}
