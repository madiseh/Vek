@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@using System.Threading
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekGrid>
    <VekItem xs="12" sm="6" md="4">
        <VekAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value1" 
                         SearchFunc="@Search" ToStringFunc="@(e=> e==null?null : $"{e.Name} ({e.Sign})")" />
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value2" 
                         SearchFunc="@Search" ToStringFunc="@(e=> e==null?null : $"{e.Name} ({e.Sign})")">
            <ItemTemplate Context="e">                          
                <VekText>
                    <VekIcon Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" Class="mb-n1 mr-3"/>@($"{e.Name} ({e.Sign})")
                </VekText>
            </ItemTemplate>
            <ItemSelectedTemplate Context="e">                
                <VekText>
                    <VekIcon Icon="@Icons.Material.Filled.CheckBox" Class="mb-n1 mr-3"/>@($"{e.Name} ({e.Sign})")
                </VekText>
            </ItemSelectedTemplate>
        </VekAutocomplete>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekAutocomplete T="Element" Label="Periodic Table Element" @bind-Value="value3"
                   SearchFunc="@Search" ItemDisabledFunc="@((Element e) => (e.Name.Contains("H")))" ToStringFunc="@(e=> e==null?null : $"{e.Name} ({e.Sign})")">
            <ItemDisabledTemplate>
                <VekText>Not available: @context.ToString()</VekText>
            </ItemDisabledTemplate>
        </VekAutocomplete>
    </VekItem>
    <VekItem xs="12" md="12">
        <VekText Class="mb-n3" Typo="Typo.body2">
            Selected values: <VekChip T="string">@(value1?.ToString() ?? "Not selected")</VekChip><VekChip T="string">@(value2?.ToString() ?? "Not selected")</VekChip><VekChip T="string">@(value3?.ToString() ?? "Not selected")</VekChip>
        </VekText>
    </VekItem>
</VekGrid>

@code {
    private Element value1, value2, value3;

    private async Task<IEnumerable<Element>> Search(string value, CancellationToken token)
    {
        return  await httpClient.GetFromJsonAsync<List<Element>>($"webapi/periodictable/{value}", token);
    }
}
