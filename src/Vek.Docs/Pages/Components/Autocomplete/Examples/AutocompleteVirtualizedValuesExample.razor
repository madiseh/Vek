@namespace Vek.Docs.Examples
@using System.Threading

<VekAutocomplete T="string"
                 Label="Customer"
                 SearchFunc="SearchCustomersAsync"
                 DebounceInterval="150"
                 MaxItems="null"
                 Virtualize="true"
                 AllowCustomValues="true"
                 HelperText="Search by customer number or press Enter to enter a new customer name." />

@code {
    private readonly string[] _customers = Enumerable.Range(1, 500).Select(index => $"Customer {index:0000}").ToArray();

    private Task<IEnumerable<string>> SearchCustomersAsync(string text, CancellationToken cancellationToken)
    {
        cancellationToken.ThrowIfCancellationRequested();

        var tokens = text?.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? [];
        IEnumerable<string> matches = _customers;
        foreach (var token in tokens)
        {
            matches = matches.Where(customer => customer.Contains(token, StringComparison.OrdinalIgnoreCase));
        }

        return Task.FromResult(matches);
    }
}
