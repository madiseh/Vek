@namespace Vek.Docs.Examples
<VekChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <VekChip Text="Brunsås" Variant="Variant.Text" Color="Color.Default" SelectedColor="Color.Primary"></VekChip>
    <VekChip Text="Spotted Dick" Variant="Variant.Text" Color="Color.Primary" SelectedColor="Color.Secondary"></VekChip>
    <VekChip Text="Sushi" Variant="Variant.Text" Color="Color.Dark" SelectedColor="Color.Warning"></VekChip>
    <VekChip Text="Schnitzel" Variant="Variant.Text" Color="Color.Info" SelectedColor="Color.Error"></VekChip>
    <VekChip Text="Hamburger" Variant="Variant.Text" Color="Color.Success" SelectedColor="Color.Error"></VekChip>
</VekChipSet>
<VekChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <VekChip Text="Brunsås" Variant="Variant.Outlined" Color="Color.Default" SelectedColor="Color.Primary"></VekChip>
    <VekChip Text="Spotted Dick" Variant="Variant.Outlined" Color="Color.Primary" SelectedColor="Color.Secondary"></VekChip>
    <VekChip Text="Sushi" Variant="Variant.Outlined" Color="Color.Dark" SelectedColor="Color.Warning"></VekChip>
    <VekChip Text="Schnitzel" Variant="Variant.Outlined" Color="Color.Info" SelectedColor="Color.Error"></VekChip>
    <VekChip Text="Hamburger" Variant="Variant.Outlined" Color="Color.Success" SelectedColor="Color.Error"></VekChip>
</VekChipSet>
<VekChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <VekChip Text="Brunsås" Variant="Variant.Filled" Color="Color.Default" SelectedColor="Color.Primary"></VekChip>
    <VekChip Text="Spotted Dick" Variant="Variant.Filled" Color="Color.Primary" SelectedColor="Color.Secondary"></VekChip>
    <VekChip Text="Sushi" Variant="Variant.Filled" Color="Color.Dark" SelectedColor="Color.Warning"></VekChip>
    <VekChip Text="Schnitzel" Variant="Variant.Filled" Color="Color.Info" SelectedColor="Color.Error"></VekChip>
    <VekChip Text="Hamburger" Variant="Variant.Filled" Color="Color.Success" SelectedColor="Color.Error"></VekChip>
</VekChipSet>
<VekCheckBox @bind-Value="_checkMark">Check marks</VekCheckBox>

@code
{
    private bool _checkMark = true;
}

