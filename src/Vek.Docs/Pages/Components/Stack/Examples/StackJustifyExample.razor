@namespace Vek.Docs.Examples

<VekPaper Outlined="true" Class="border-dashed">
    <VekStack Justify="@_justify" Row="true">
        <VekPaper Class="pa-3 vek-theme-primary">Item 1</VekPaper>
        <VekPaper Class="pa-3 vek-theme-primary">Item 2</VekPaper>
        <VekPaper Class="pa-3 vek-theme-primary">Item 3</VekPaper>
    </VekStack>
</VekPaper>

<VekChipSet T="string" CheckMark Class="d-flex justify-center mt-12">
    <VekChip Text="Start" OnClick="@(() => _justify = Justify.FlexStart)" SelectedColor="Color.Primary" />
    <VekChip Text="Center" OnClick="@(() => _justify = Justify.Center)" SelectedColor="Color.Primary" Default="true" />
    <VekChip Text="End" OnClick="@(() => _justify = Justify.FlexEnd)" SelectedColor="Color.Primary" />
    <VekChip Text="Space Around" OnClick="@(() => _justify = Justify.SpaceAround)" SelectedColor="Color.Primary" />
    <VekChip Text="Space Between" OnClick="@(() => _justify = Justify.SpaceBetween)" SelectedColor="Color.Primary" />
    <VekChip Text="Space Evenly" OnClick="@(() => _justify = Justify.SpaceEvenly)" SelectedColor="Color.Primary" />
</VekChipSet>


@code {
    Justify _justify = Justify.Center;
}