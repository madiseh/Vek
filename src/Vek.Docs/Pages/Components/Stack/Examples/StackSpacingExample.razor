@namespace Vek.Docs.Examples

<VekStack Spacing="@_spacing" Row="true">
    <VekPaper Class="pa-3">Item 1</VekPaper>
    <VekPaper Class="pa-3">Item 2</VekPaper>
    <VekPaper Class="pa-3">Item 3</VekPaper>
</VekStack>

<VekSlider @bind-Value="_spacing" Min="0" Max="16">Spacing: @_spacing.ToString()</VekSlider>

@code {
    private int _spacing { get; set; } = 3;
}