@namespace Vek.Docs.Examples

<VekStack>
    <VekDateRangePicker Label="Basic range picker" @bind-DateRange="_dateRange" />
    <VekDateRangePicker Label="Basic range picker (editable)" Editable="true" @bind-DateRange="_dateRange" />
    <VekDateRangePicker Label="Placeholder" @bind-DateRange="_dateRange" PlaceholderStart="Start Date" PlaceholderEnd="End Date" />
    <VekDateRangePicker Label="Clearable" @bind-DateRange="_dateRange" Clearable="true" />
    <VekDateRangePicker Label="Range picker format" HelperText="For custom cultures" DateFormat="dd/MM/yyyy" TitleDateFormat="dddd, dd. MMMM" @bind-DateRange="_dateRange" />
    <VekDateRangePicker Label="Custom start month" StartMonth="@DateTime.Now.AddMonths(-1)" @bind-DateRange="_dateRange" />
    <VekDateRangePicker Label="Show adjacent month days" ShowAdjacentMonthDays="true" @bind-DateRange="_dateRange" />
    <VekDateRangePicker @ref="_picker" Label="With action buttons" @bind-DateRange="_dateRange" AutoClose="@_autoClose">
        <PickerActions>
            <VekButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Clear</VekButton>
            <VekButton OnClick="@(() => _picker.CloseAsync(false))">Cancel</VekButton>
            <VekButton Color="Color.Primary" OnClick="@(() => _picker.CloseAsync())">OK</VekButton>
        </PickerActions>
    </VekDateRangePicker>
    <VekSwitch @bind-Value="_autoClose" Color="Color.Secondary">AutoClose</VekSwitch>
</VekStack>

@code { 
    private VekDateRangePicker _picker;
    private DateRange _dateRange = new DateRange(DateTime.Now.Date, DateTime.Now.AddDays(5).Date);
    private bool _autoClose;
}