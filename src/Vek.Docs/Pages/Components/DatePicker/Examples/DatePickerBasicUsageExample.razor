@namespace Vek.Docs.Examples

<VekDatePicker Label="Basic example" @bind-Date="_date"/>
<VekDatePicker Label="Editable with Placeholder" Editable="true" @bind-Date="_date" Placeholder="Select Date" />
<VekDatePicker Label="Only Calendar" @bind-Date="_date" ShowToolbar="false" />
<VekDatePicker Label="Date Format" @bind-Date="_date" DateFormat="dd.MM.yyyy" />
<VekDatePicker Label="Show week number" ShowWeekNumbers="true" @bind-Date="_date" />
<VekDatePicker Label="Show adjacent month days" ShowAdjacentMonthDays="true" @bind-Date="_date" />
<VekDatePicker Label="Display two months" DisplayMonths="2" TitleDateFormat="dddd, dd MMMM" @bind-Date="_date" />

@code {
    private DateTime? _date = DateTime.Today;
}
