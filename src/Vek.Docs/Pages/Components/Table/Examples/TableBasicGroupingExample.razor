@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<style>
    .vek-table-cell-custom-group {
        font-weight: 500;
    }

    .vek-table-cell-custom-group-footer {
        padding-bottom: 50px;
        text-align: right;
    }
</style>

<VekTable Hover="true" Breakpoint="Breakpoint.Sm" Height="500px" FixedHeader="true"
          Items="@Elements"
          Virtualize="@_virtualize"
          GroupBy="@_groupDefinition"
          GroupHeaderStyle="background-color:var(--vek-palette-background-gray)"
          GroupFooterClass="mb-4"
          Dense="_dense"
          MultiSelection="_multiSelect">
    <ColGroup>
        @if (_multiSelect)
        {
            <col style="width: 60px;" />
        }
        @if (_groupDefinition.Expandable)
        {
            <col style="width: 60px;" />
        }
        <col />
        <col />
        <col />
        <col />
        <col />
    </ColGroup>
    <HeaderContent>
        <VekTh>Nr</VekTh>
        <VekTh>Sign</VekTh>
        <VekTh>Name</VekTh>
        <VekTh>Position</VekTh>
        <VekTh>Molar mass</VekTh>
    </HeaderContent>
    <GroupHeaderTemplate>
        <VekTh Class="vek-table-cell-custom-group" colspan="5">@($"{context.GroupName}: {context.Key}")</VekTh>
    </GroupHeaderTemplate>
    <RowTemplate>
        <VekTd DataLabel="Nr">@context.Number</VekTd>
        <VekTd DataLabel="Sign">@context.Sign</VekTd>
        <VekTd DataLabel="Name">@context.Name</VekTd>
        <VekTd DataLabel="Position">@context.Position</VekTd>
        <VekTd Style="text-align: right" DataLabel="Molar mass">@context.Molar"</VekTd>
    </RowTemplate>
    <GroupFooterTemplate>
        <VekTh Class="vek-table-cell-custom-group vek-table-cell-custom-group-footer" colspan="5">Total Mass: @context.Items.Sum((e) => e.Molar)</VekTh>
    </GroupFooterTemplate>
</VekTable>

<VekSwitch @bind-Value="_dense" Color="Color.Primary">Dense</VekSwitch>
<VekSwitch @bind-Value="_multiSelect" Color="Color.Primary">MultiSelect</VekSwitch>
<VekSwitch @bind-Value="_virtualize" Color="Color.Primary">Virtualize</VekSwitch>
<VekSwitch @bind-Value="_groupDefinition.Indentation" Color="Color.Primary">Indentation</VekSwitch>
<VekSwitch @bind-Value="_groupDefinition.Expandable" Color="Color.Primary">Expandable</VekSwitch>

@code { 
    private bool _dense = false;
    private bool _multiSelect = true;
    private bool _virtualize = false;    

    private TableGroupDefinition<Element> _groupDefinition = new()
    {
        GroupName = "Group",
        Indentation = false,
        Expandable = false,
        Selector = (e) => e.Group
    };

    private IEnumerable<Element> Elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}