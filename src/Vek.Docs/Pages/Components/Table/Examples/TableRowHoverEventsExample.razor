@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekTable T="Element" Items="@elements.Take(3)" Hover="true" OnRowMouseEnter="RowMouseEnterEvent" OnRowMouseLeave="RowMouseLeaveEvent" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <VekTh>Nr</VekTh>
        <VekTh>Sign</VekTh>
        <VekTh>Name</VekTh>
        <VekTh>Position</VekTh>
        <VekTh>Molar mass</VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd DataLabel="Nr">@context.Number</VekTd>
        <VekTd DataLabel="Sign">@context.Sign</VekTd>
        <VekTd DataLabel="Name">@context.Name</VekTd>
        <VekTd DataLabel="Position">@context.Position</VekTd>
        <VekTd DataLabel="Molar mass">@context.Molar</VekTd>
    </RowTemplate>
</VekTable>

<VekText>Currently hovered: @(currentlyHoveredElement)</VekText>
<VekText>Last hovered: @(lastHoveredElement)</VekText>

@code {
    private IEnumerable<Element> elements = new List<Element>();

    private string currentlyHoveredElement;
    private string lastHoveredElement;

    protected override async Task OnInitializedAsync()
    {
        elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    private void RowMouseEnterEvent(TableRowHoverEventArgs<Element> eventArgs)
    {
        currentlyHoveredElement = eventArgs.Item.Name;
    }

    private void RowMouseLeaveEvent(TableRowHoverEventArgs<Element> eventArgs)
    {
        currentlyHoveredElement = "";
        lastHoveredElement = eventArgs.Item.Name;
    }
}
