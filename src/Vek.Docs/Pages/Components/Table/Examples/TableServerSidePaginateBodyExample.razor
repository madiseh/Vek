@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@using System.Threading
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekTable ServerData="ServerReload" Dense="true" Hover="true"
    LoadingContent="@(useLoadingContentBody ? null : loadingContent)"
    LoadingContentBody="@(useLoadingContentBody ? loadingContentBody : null)">
    <ToolBarContent>
        <VekText Typo="Typo.h6">Periodic Elements</VekText>
    </ToolBarContent>
    <HeaderContent>
        <VekTh><VekTableSortLabel SortLabel="nr_field" T="Element">Nr</VekTableSortLabel></VekTh>
        <VekTh><VekTableSortLabel SortLabel="sign_field" T="Element">Sign</VekTableSortLabel></VekTh>
        <VekTh><VekTableSortLabel SortLabel="name_field" T="Element">Name</VekTableSortLabel></VekTh>
        <VekTh><VekTableSortLabel SortLabel="position_field" T="Element">Position</VekTableSortLabel></VekTh>
        <VekTh><VekTableSortLabel SortLabel="mass_field" T="Element">Molar mass</VekTableSortLabel></VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd DataLabel="Nr">@context.Number</VekTd>
        <VekTd DataLabel="Sign">@context.Sign</VekTd>
        <VekTd DataLabel="Name">@context.Name</VekTd>
        <VekTd DataLabel="Position">@context.Position</VekTd>
        <VekTd DataLabel="Molar mass">@context.Molar</VekTd>
    </RowTemplate>
    <NoRecordsContent>
        <VekText>No records found</VekText>
    </NoRecordsContent>
    <PagerContent>
        <VekTablePager />
    </PagerContent>
</VekTable>
<VekSwitch @bind-Value="@useLoadingContentBody">Use Loading Content Body</VekSwitch>

@code {
    private bool useLoadingContentBody = true;

    private readonly RenderFragment loadingContent = @<VekSkeleton/>;
    private readonly RenderFragment loadingContentBody = @<text>
        @for (int r = 0; r < 4; r++) // 4 fake rows
        {
            <VekTr>
                @for (int c = 0; c < 5; c++) // 5 columns as above
                {
                    <VekTd><VekSkeleton/></VekTd>
                }
            </VekTr>
        }
    </text>;

    /// <summary>
    /// Here we simulate a perpetual loading for the purpose of the example.
    /// </summary>
    private async Task<TableData<Element>> ServerReload(TableState state, CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            await Task.Delay(1000, token);
        }
        return new TableData<Element>() { TotalItems = 0, Items = Enumerable.Empty<Element>() };
    }
}


