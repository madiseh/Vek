@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekTable Items="@Elements" Dense="@dense" Hover="@hover" Bordered="@bordered" Striped="@striped" Filter="new Func<Element,bool>(FilterFunc1)" @bind-SelectedItem="selectedItem1" PagerPosition="@pagerPosition">
    <ToolBarContent>
        <VekText Typo="Typo.h6">Periodic Elements</VekText>
        <VekSpacer />
        <VekTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></VekTextField>
    </ToolBarContent>
    <HeaderContent>
        <VekTh>Nr</VekTh>
        <VekTh>Sign</VekTh>
        <VekTh>Name</VekTh>
        <VekTh>Position</VekTh>
        <VekTh>Molar mass</VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd DataLabel="Nr">@context.Number</VekTd>
        <VekTd DataLabel="Sign">@context.Sign</VekTd>
        <VekTd DataLabel="Name">@context.Name</VekTd>
        <VekTd DataLabel="Position">@context.Position</VekTd>
        <VekTd DataLabel="Molar mass">@context.Molar</VekTd>
    </RowTemplate>
    <PagerContent>
        <VekTablePager />
    </PagerContent>
</VekTable>

<div class="d-flex flex-wrap mt-4">
    <VekSwitch @bind-Value="hover" Color="Color.Primary">Hover</VekSwitch>
    <VekSwitch @bind-Value="dense" Color="Color.Secondary">Dense</VekSwitch>
    <VekSwitch @bind-Value="striped" Color="Color.Tertiary">Striped</VekSwitch>
    <VekSwitch @bind-Value="bordered" Color="Color.Warning">Bordered</VekSwitch>
    <VekSelect @bind-Value="pagerPosition" Label="Pager position" Class="ml-4">
        <VekSelectItem Value="PagerPosition.Top">Top</VekSelectItem>
        <VekSelectItem Value="PagerPosition.Bottom">Bottom</VekSelectItem>
        <VekSelectItem Value="PagerPosition.TopAndBottom">Top And Bottom</VekSelectItem>
    </VekSelect>
    <VekSpacer />
    <div style="min-width:200px;">
        <VekText Class="align-self-center d-inline">Selected1: @selectedItem1?.Name</VekText>
    </div>
</div>

@code {
    private bool dense = false;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = false;
    private string searchString1 = "";
    private Element selectedItem1 = null;
    private HashSet<Element> selectedItems = new HashSet<Element>();
    private PagerPosition pagerPosition = PagerPosition.Bottom;

    private IEnumerable<Element> Elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    private bool FilterFunc1(Element element) => FilterFunc(element, searchString1);

    private bool FilterFunc(Element element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (element.Sign.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if ($"{element.Number} {element.Position} {element.Molar}".Contains(searchString))
            return true;
        return false;
    }
}
