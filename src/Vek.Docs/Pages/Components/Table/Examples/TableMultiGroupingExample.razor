@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<style>
    .vek-table-cell-custom-group {
        font-weight: 500;
    }

    .vek-table-cell-custom-group-footer {
        padding-bottom: 50px;
        text-align: right;
    }

    .vek-table-cell-custom-group-header-outer {
        background-color: var(--vek-palette-background-gray);
    }

    .vek-table-cell-custom-group-header-inner {
        background-color: var(--vek-palette-primary-hover);
    }
</style>

<VekText>Total items: @Elements?.Count() - Selected items: @selectedItems?.Count</VekText>

<VekTable Hover="true" Breakpoint="Breakpoint.Sm" Height="500px" FixedHeader="true"
          Items="@Elements"
          GroupBy="@_groupDefinition"
          GroupFooterClass="mb-4"
          Dense="_dense"
          MultiSelection="_multiSelect"
          @bind-SelectedItems="selectedItems">
    <HeaderContent>
        <VekTh>Nr</VekTh>
        <VekTh>Sign</VekTh>
        <VekTh>Name</VekTh>
        <VekTh>Group</VekTh>
        <VekTh>Position</VekTh>
        <VekTh>Molar mass</VekTh>
    </HeaderContent>
    <GroupHeaderTemplate>
        <VekTh Class="vek-table-cell-custom-group" colspan="6">@($"{context.GroupName}: {context.Key}")</VekTh>
    </GroupHeaderTemplate>
    <RowTemplate>
        <VekTd DataLabel="Nr">@context.Number</VekTd>
        <VekTd DataLabel="Sign">@context.Sign</VekTd>
        <VekTd DataLabel="Name">@context.Name</VekTd>
        <VekTd DataLabel="Group">@context.Group</VekTd>
        <VekTd DataLabel="Position">@context.Position</VekTd>
        <VekTd Style="text-align:right" DataLabel="Molar mass">@context.Molar</VekTd>
    </RowTemplate>
    <GroupFooterTemplate>
        <VekTh Class="vek-table-cell-custom-group vek-table-cell-custom-group-footer" colspan="6">Total Mass: @context.Items.Sum((e) => e.Molar)</VekTh>
    </GroupFooterTemplate>
</VekTable>
<VekSwitch @bind-Value="_dense" Color="Color.Primary">Dense</VekSwitch>
<VekSwitch @bind-Value="_multiSelect" Color="Color.Primary">MultiSelect</VekSwitch>
<VekSwitch @bind-Value="_groupDefinition.Indentation" Color="Color.Primary">Indentation</VekSwitch>
<VekSwitch @bind-Value="_groupDefinition.Expandable" Color="Color.Primary">Expandable (Root Level)</VekSwitch>
<VekSwitch @bind-Value="_groupDefinition.InnerGroup.Expandable" Color="Color.Primary">Expandable (Second Level)</VekSwitch>

@code {
    private bool _dense = false;
    private bool _multiSelect = true;
    private HashSet<Element> selectedItems = new HashSet<Element>();

    private TableGroupDefinition<Element> _groupDefinition = new TableGroupDefinition<Element>()
    {
        GroupName = "Group",
        Indentation = false,
        Expandable = false,
        Selector = (e) => e.Group,
        GroupHeaderClass = "vek-table-cell-custom-group-header-outer",
        InnerGroup = new TableGroupDefinition<Element>()
        {
            GroupName = "Position",
            Expandable = false,
            Selector = (e) => e.Position,
            GroupHeaderClass = "vek-table-cell-custom-group-header-inner"
        }

    };


    private IEnumerable<Element> Elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}
