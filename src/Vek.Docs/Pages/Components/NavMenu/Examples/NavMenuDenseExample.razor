@namespace Vek.Docs.Examples

<VekPaper Width="250px" Class="py-3" Elevation="0">
    <VekNavMenu Dense="true" Color="Color.Info">
        <VekNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</VekNavLink>
            <VekNavLink Href="/components/navmenu" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">Servers</VekNavLink>
            <VekNavLink Href="/billing" Disabled="true">Billing</VekNavLink>
            <VekNavGroup Title="Settings" Expanded="true">
                <VekNavLink Href="/users">Users</VekNavLink>
                <VekNavLink Href="/security">Security</VekNavLink>
            </VekNavGroup>
            <VekNavLink Href="/about">About</VekNavLink>
    </VekNavMenu>
</VekPaper>
<VekPaper Width="250px" Class="py-3" Elevation="0">
    <VekNavMenu Dense="true" Rounded="true" Margin="Margin.Dense" Color="Color.Secondary" Class="pa-2">
        <VekNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</VekNavLink>
        <VekNavLink Href="/components/navmenu" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Storage">Servers</VekNavLink>
        <VekNavLink Href="/billing" Disabled="true">Billing</VekNavLink>
        <VekNavGroup Title="Settings" Expanded="true">
            <VekNavLink Href="/users">Users</VekNavLink>
            <VekNavLink Href="/security">Security</VekNavLink>
        </VekNavGroup>
        <VekNavLink Href="/about">About</VekNavLink>
    </VekNavMenu>
</VekPaper>
