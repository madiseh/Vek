@namespace Vek.Docs.Examples


<div Class="d-flex justify-space-around flex-wrap mt-4">
    <VekBadge Content="3" Overlap="true" Class="mx-6 my-4">
        <VekIcon Icon="@Icons.Material.Filled.Email" Color="Color.Default" />
    </VekBadge>
    <VekBadge Content="100" Color="Color.Primary" Overlap="true" Class="mx-6 my-4">
        <VekIcon Icon="@Icons.Material.Filled.Email" Color="Color.Default" />
    </VekBadge>
    <VekBadge Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Overlap="true" Bordered="true" Class="mx-6 my-4">
        <VekButton Color="Color.Error" Variant="Variant.Filled" DropShadow="false">Security Issues</VekButton>
    </VekBadge>
    <VekBadge Dot="true" Color="Color.Info" Class="mx-6 my-4">
        <VekText>Bug Reports</VekText>
    </VekBadge>
</div>
