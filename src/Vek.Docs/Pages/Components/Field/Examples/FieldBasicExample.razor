@namespace Vek.Docs.Examples


<VekGrid>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Standard" Variant="Variant.Text">Some Content <VekIcon Icon="@Icons.Material.Filled.Favorite" Color="@Color.Warning" /> follows here</VekField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Filled" Variant="Variant.Filled">Some Content <VekIcon Icon="@Icons.Material.Filled.Favorite" Color="@Color.Warning" /> follows here</VekField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Outlined" Variant="Variant.Outlined">Some Content <VekIcon Icon="@Icons.Material.Filled.Favorite" Color="@Color.Warning" /> follows here</VekField>
    </VekItem>
</VekGrid>
<VekGrid>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Standard" Variant="Variant.Text"></VekField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Filled" Variant="Variant.Filled"></VekField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Outlined" Variant="Variant.Outlined"></VekField>
    </VekItem>
</VekGrid>
<VekGrid>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Standard" Variant="Variant.Text" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CheckCircle" AdornmentColor="Color.Success"></VekField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Filled" Variant="Variant.Filled" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Money"></VekField>
    </VekItem>
    <VekItem xs="12" sm="6" md="4">
        <VekField Label="Outlined" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Warning" AdornmentColor="Color.Warning"></VekField>
    </VekItem>
</VekGrid>