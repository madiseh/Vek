@namespace Vek.Docs.Examples

<VekPaper Elevation="0">
    <VekList T="string">
        <VekListSubheader>
            <VekTextField @bind-Value="searchTerm" AdornmentIcon="@Icons.Material.Filled.Brush"
                          Adornment="Adornment.End" Immediate="true" Variant="Variant.Outlined" />
        </VekListSubheader>

        @foreach (var sentence in sentences)
        {
            <VekListItem @key="sentence" Icon="@Icons.Material.Filled.Folder">
                <VekHighlighter Class="vek-primary-text"
                             Style="background-color:transparent;font-weight:bold"
                             Text="@sentence"
                             HighlightedText="@searchTerm" />
            </VekListItem>
        }
    </VekList>
</VekPaper>

@code {
    string searchTerm = "it";
    IEnumerable<string> sentences = new List<string>
    {
        "This is the first item", "This is the second item", "This is the third item"
    };
}