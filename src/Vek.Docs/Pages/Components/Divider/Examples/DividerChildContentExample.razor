@namespace Vek.Docs.Examples

<VekPaper Width="300px" Square="true" Class="pa-4 d-flex flex-column gap-4">
    <VekButton Variant="Variant.Filled" Color="Color.Primary">Sign in with email</VekButton>
    <VekDivider>or</VekDivider>
    <VekButton Variant="Variant.Outlined">Sign in with a passkey</VekButton>
</VekPaper>

<VekPaper Width="300px" Square="true" Class="py-4 mt-4">
    <VekText Class="px-4">Can we move the meeting?</VekText>
    <VekDivider DividerType="DividerType.Middle" Class="my-2">Today</VekDivider>
    <VekText Class="px-4">Sure, how about 3 PM?</VekText>
</VekPaper>

<VekPaper Width="300px" Height="100px" Square="true" Class="d-flex justify-space-around align-center mt-4">
    <VekButton Variant="Variant.Outlined">Delivery</VekButton>
    <VekDivider Vertical="true">or</VekDivider>
    <VekButton Variant="Variant.Outlined">Pickup</VekButton>
</VekPaper>
