@namespace Vek.Docs.Examples

<VekChart T="int" ChartType="ChartType.Donut" Width="100%" Height="300px" ChartSeries="@Data.AsChartDataSet()" ChartLabels="@Labels">
    <CustomGraphics>
        <text class="vek-donut-text vek-typography-h3" x="50%" y="50%">@Data.Sum()</text>
    </CustomGraphics>
</VekChart>

@code {
    private static readonly int[] Data = [25, 77, 28, 5];
    private static readonly string[] Labels = ["Oil", "Coal", "Gas", "Biomass"];
}
