@page "/vek/project/team"

<PageTitle>Meet the Team - Vek</PageTitle>
<DocsPage DisplayFooter="true">

    <VekContainer>
        @* Preamble *@
        <VekText Typo="Typo.h3" GutterBottom="true">Meet the Team</VekText>
        <VekText Typo="Typo.subtitle1">
            Vek is an open-source project maintained by its core team and contributors.
            Contributions of all kinds are welcome, from a single pull request to ongoing involvement.
            <VekLink Href="/vek/introduction" Typo="Typo.inherit">Read more</VekLink>
        </VekText>

        @* Core Team *@
        <VekText Typo="Typo.h4" Class="mt-16" GutterBottom="true" Color="Color.Primary">Core Team</VekText>
        <VekText Class="mb-8">
            Project lead who oversees development and maintenance.
        </VekText>
        <VekGrid>
            @foreach (var member in TeamMemberData.GetTeam().Where(member => member.Team is Team.Core or Team.CoreMaintainer))
            {
                <VekItem xs="12" md="6">
                    <VekTeamCard Member="member" />
                </VekItem>
            }
        </VekGrid>

        <VekText Typo="Typo.h4" Class="mt-16" GutterBottom="true" Color="Color.Primary">Contributors</VekText>
        <VekText Class="mb-8">
            Contributors help improve Vek through code, documentation, and community support.
        </VekText>
        <VekGrid>
            @foreach (var member in TeamMemberData.GetTeam().Where(member => member.Team == Team.Contribution))
            {
                <VekItem xs="12" md="6">
                    <VekTeamCard Member="member" />
                </VekItem>
            }
        </VekGrid>
    </VekContainer>

    <VekContainer>
        <div class="my-16"></div>
    </VekContainer>

</DocsPage>
