@page "/vek/announcements"

<DocsPage DisplayFooter="true">
    <DocsPageHeader Title="Announcements" SubTitle="Discover articles from Vek team.">
        <SpecialHeaderContent>
            <VekText Typo="Typo.h2" Class="docs-title">Announcements&nbsp;</VekText>
            <VekText Typo="Typo.subtitle1" Class="docs-title-description">Discover articles from Vek team.</VekText>
        </SpecialHeaderContent>
    </DocsPageHeader>
    <DocsPageContent>
        @if (_messages == null)
        {
            <VekProgressCircular Color="Color.Default" Indeterminate="true"/>
        }
        else if (_messages.Count == 0)
        {
            <VekText Typo="Typo.h6">No announcements yet.</VekText>
        }
        else
        {
            <VekGrid>
                @foreach (var (message, _) in _messages)
                {
                    <VekItem xs="12" sm="6" md="4">
                        <a href="@($"/vek/announcements/{message.Id}")">
                            <VekCard Class="announcement-card rounded-lg">
                                <VekCardMedia Image="@message.ImgUrl" Height="175"/>
                                <VekCardContent Class="pa-4">
                                    <VekText Typo="Typo.subtitle2" Class="vek-text-secondary">@message.Category</VekText>
                                    <VekText Typo="Typo.h6" GutterBottom="true">@message.Title</VekText>
                                    <VekText Typo="Typo.body2">@message.Except</VekText>
                                </VekCardContent>
                                <VekCardActions Class="pa-4">
                                    <VekAvatarGroup Max="6" Spacing="3" MaxColor="Color.Primary">
                                        @foreach (var author in message.Authors)
                                        {
                                            <VekAvatar>
                                                <VekImage Src="@author.AvatarUrl"/>
                                            </VekAvatar>
                                        }
                                    </VekAvatarGroup>
                                    <div class="mx-4 d-flex flex-column">
                                        @if (message.Authors.Count() > 1)
                                        {
                                            <VekText Typo="Typo.subtitle2">Multiple Authors</VekText>
                                            <VekText Typo="Typo.subtitle2" Class="vek-text-secondary">@message.PublishDate.ToString("MMM dd, yyyy")</VekText>
                                        }
                                        else
                                        {
                                            <VekText Typo="Typo.subtitle2">@message.Authors.FirstOrDefault()?.DisplayName</VekText>
                                            <VekText Typo="Typo.subtitle2" Class="vek-text-secondary">@message.PublishDate.ToString("MMM dd, yyyy")</VekText>
                                        }
                                    </div>
                                </VekCardActions>
                            </VekCard>
                        </a>
                    </VekItem>
                }
            </VekGrid>
        }
    </DocsPageContent>
</DocsPage>
