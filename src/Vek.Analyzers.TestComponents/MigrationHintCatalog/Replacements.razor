@using Microsoft.AspNetCore.Components.Web
@*the current markup every hint and every documented example points at, which has to compile and stay silent*@

@*buttons*@
<VekButton Href="/button" Ripple="false" DropShadow="false">Button</VekButton>
<VekIconButton Icon="@Icons.Material.Filled.Add" Href="/icon-button" Ripple="@(!_flag)" DropShadow="@_flag" />
<VekFab StartIcon="@Icons.Material.Filled.Add" Href="/fab" Ripple="true" DropShadow="@(!(_flag && _other))" />
<VekToggleIconButton Icon="@Icons.Material.Filled.AlarmOff" ToggledIcon="@Icons.Material.Filled.AlarmOn" Ripple="false" DropShadow="false" />
<VekButtonGroup DropShadow="false" Vertical="true">
    <VekButton>One</VekButton>
</VekButtonGroup>

@*selection controls, including a nullable checkbox*@
<VekCheckBox @bind-Value="_flag" Ripple="false" LabelPlacement="Placement.Start" />
<VekCheckBox T="bool?" Value="@_nullable" ValueChanged="@((bool? value) => _nullable = value)" TriState="true" />
<VekSwitch @bind-Value="_flag" Ripple="@(!_flag)" LabelPlacement="Placement.End" />
<VekRadioGroup @bind-Value="_text">
    <VekRadio Value="@("a")" Ripple="false" LabelPlacement="Placement.End">A</VekRadio>
</VekRadioGroup>
<VekToggleGroup T="string" Ripple="false" Outlined="false" />
<VekRating Ripple="true" />
<VekRatingItem Ripple="true" />

@*chips and lists: an unset Ripple or Gutters follows the parent*@
<VekChipSet T="string" CheckMark="true" Ripple="false">
    <VekChip T="string" Href="/chip" />
    <VekChip T="string" Ripple="true" />
    <VekChip T="string" Ripple="@(_flag ? false : null)" />
</VekChipSet>
<VekList T="string" Padding="true" ReadOnly="@(!_flag)" Gutters="false">
    <VekListSubheader Gutters="false">Header</VekListSubheader>
    <VekListItem T="string" Ripple="false" ExpandIconColor="Color.Primary" OnClickPreventDefault="true" Expanded="true" />
    <VekListItem T="string" Gutters="true" />
    <VekListItem T="string" Gutters="@(_flag ? false : null)" />
</VekList>

@*menus*@
<VekMenu Ripple="false" DropShadow="@(!_flag)" OpenChanged="@((bool open) => _flag = open)" PositionAtCursor="true">
    <VekMenuItem Href="/menu-item">Item</VekMenuItem>
</VekMenu>

@*alerts, dialogs, tooltips, and visibility*@
<VekAlert ContentAlignment="HorizontalAlignment.Center">Alert</VekAlert>
<VekDialog @bind-Visible="_flag" Gutters="false" ActionsClass="actions" ContentClass="content" />
<VekMessageBox @bind-Visible="_flag" />
<VekTooltip Text="Tooltip" @bind-Visible="_flag" Delay="500" />
<VekTooltip Text="Tooltip" Delay="@(_seconds * 1000)" />
<VekHidden Breakpoint="Breakpoint.Sm" @bind-Hidden="_flag" />

@*layout*@
<VekExpansionPanels Outlined="false" Gutters="false">
    <VekExpansionPanel Text="Panel" @bind-Expanded="_flag" Gutters="false" />
    <VekExpansionPanel Text="Starts expanded" Expanded="true" />
</VekExpansionPanels>
<VekAppBar Gutters="false" />
<VekToolBar Gutters="false" />
<VekDrawer Overlay="false" />

@*inputs*@
<VekTextField @bind-Value="_text" Underline="false" OnKeyDown="@((KeyboardEventArgs args) => _text = args.Key)" Sizing="InputSizing.Auto" />
<VekNumericField @bind-Value="_number" Underline="false" OnKeyDown="@((KeyboardEventArgs args) => _text = args.Key)" />
<VekSelect T="string" Underline="false" OpenChanged="@(open => { if (open) Handler(); })" />
<VekSelect T="string" OpenChanged="@(open => { if (!open) Handler(); })" />
<VekSelect T="string" OpenChanged="@(async open => { if (open) await HandlerAsync(); })" />
<VekAutocomplete T="string" Underline="false" OpenChanged="@((bool open) => _flag = open)" SelectOnActivation="true" SearchFunc="@SearchAsync" />
<VekField Underline="false" />
<VekInput T="string" Sizing="@(_flag ? InputSizing.Auto : InputSizing.Fixed)" />

@*pickers*@
<VekDatePicker ShowToolbar="false" Underline="false" AdornmentIcon="@Icons.Material.Filled.Event" Variant="Variant.Outlined" />
<VekDateRangePicker ShowToolbar="false" />
<VekTimePicker ShowToolbar="true" ActionsClass="actions" />
<VekColorPicker ShowToolbar="false" ShowSliders="false" ShowPreview="false" ShowModeSwitch="false" ShowInputs="false" DragEffect="false" ShowColorField="false" ShowAlpha="false" />
<VekPickerToolbar ShowToolbar="false" />

@*navigation, tabs, and progress*@
<VekNavMenu>
    <VekNavGroup Title="Group" Ripple="false">
        <VekNavLink Href="/link" Ripple="false">Link</VekNavLink>
    </VekNavGroup>
</VekNavMenu>
<VekTabs Ripple="false" SliderAnimation="false" TabButtonsClass="buttons" TabPanelsClass="panels">
    <VekTabPanel Text="One" PanelClass="one-panel" />
</VekTabs>
<VekDynamicTabs TabPanelsClass="panels" />
<VekTimeline Modifiers="false" />
<VekProgressCircular Value="50" Min="0" Max="100" />
<VekProgressLinear Value="50" Min="0" Max="100" />
<VekCarousel TData="string" ShowBullets="true" BulletsColor="Color.Primary" BulletsClass="bullets" BulletTemplate="@_bulletTemplate" />
<VekPagination Count="3" DropShadow="false" />

@*tables and data grids*@
<VekTablePager HideRowsPerPage="true" />
<VekDataGridPager T="string" PageSizeSelector="false" />
<VekDataGrid T="Row" Items="_rows" CanceledEditingItem="@((Row row) => _text = row.Name)">
    <Columns>
        <PropertyColumn Property="x => x.Name" Editable="true" />
        <TemplateColumn Editable="false" />
    </Columns>
</VekDataGrid>
<VekTable T="string" Items="_items">
    <HeaderContent>
        <VekTHeadRow Checkable="true" Expandable="true" />
    </HeaderContent>
    <RowTemplate>
        <VekTr Checkable="true" @bind-Checked="_flag" Expandable="true" Editable="true" />
    </RowTemplate>
    <FooterContent>
        <VekTFootRow Checkable="true" Expandable="true" />
    </FooterContent>
</VekTable>
<VekTableGroupRow T="string" Checkable="true" />

@*trees, drag and drop, and charts*@
<VekTreeView T="string" Hover="true" SelectedValueChanged="@((string? value) => _text = value ?? string.Empty)">
    <VekTreeViewItem T="string" Value="@("item")" ExpandButtonIcon="@Icons.Material.Filled.ChevronRight" ExpandButtonIconColor="Color.Primary" />
</VekTreeView>
<VekDropContainer T="string" Items="_items" ItemsSelector="@((item, zone) => true)" ItemDisabled="@(item => item.Length == 0)">
    <ChildContent>
        <VekDropZone T="string" Identifier="zone" ItemDisabled="@(item => false)" />
    </ChildContent>
</VekDropContainer>
<VekChart T="double" ChartLabels="@_labels" />

@code
{
    public static string __description__ = "Current markup that the VEK0002 migration hints point at";

    private bool _flag = true;

    private bool _other = true;

    private bool? _nullable;

    private string _text = "a";

    private int _number;

    private double _seconds = 0.5;

    private readonly string[] _items = ["a", "b"];

    private readonly string[] _labels = ["Jan", "Feb"];

    private readonly Row[] _rows = [new("a")];

    private readonly RenderFragment<bool> _bulletTemplate = selected => builder => builder.AddContent(0, selected);

    private void Handler() => _flag = !_flag;

    private Task HandlerAsync() => Task.CompletedTask;

    private Task<IEnumerable<string>> SearchAsync(string? value, CancellationToken token) => Task.FromResult<IEnumerable<string>>(_items);

    public sealed record Row(string Name);
}
