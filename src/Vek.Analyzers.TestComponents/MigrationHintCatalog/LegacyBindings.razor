@*legacy @bind- spellings lower into a removed value and its removed callback, so both halves are reported*@
@*a generic component needs an explicit T here; without it Razor stops with RZ10001 before VEK0002 runs*@
<VekCheckBox T="bool" @bind-Checked="_flag" />
<VekCheckBox T="bool?" @bind-Checked="_nullable" />
<VekSwitch T="bool" @bind-Checked="_flag" />
<VekRadioGroup T="string" @bind-SelectedOption="_text" />
<VekDialog @bind-IsVisible="_flag" />
<VekMessageBox @bind-IsVisible="_flag" />
<VekTooltip Text="Tooltip" @bind-IsVisible="_flag" />
<VekHidden Breakpoint="Breakpoint.Sm" @bind-IsHidden="_flag" />
<VekExpansionPanels>
    <VekExpansionPanel Text="Panel" @bind-IsExpanded="_flag" />
</VekExpansionPanels>
<VekTable T="string" Items="_items">
    <RowTemplate>
        <VekTr @bind-IsChecked="_flag" />
    </RowTemplate>
</VekTable>

@*explicitly typed callbacks reach the same hints; a bare method group no longer compiles cleanly because the attribute has no parameter type (CS8974)*@
<VekCheckBox T="bool?" Checked="@_nullable" CheckedChanged="@((bool? value) => _nullable = value)" />
<VekSwitch T="bool" CheckedChanged="@((bool value) => OnChecked(value))" />

@code
{
    public static string __description__ = "Legacy two-way bindings that VEK0002 explains";

    private bool _flag = true;

    private bool? _nullable;

    private string _text = "a";

    private readonly string[] _items = ["a", "b"];

    private void OnChecked(bool value) => _flag = value;
}
