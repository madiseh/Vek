@*names that look like catalog entries but must keep the generic warning*@
<VekMenu Link="/menu" IsOpen="true" />
<VekSelect T="string">
    <VekSelectItem T="string" Value="@("a")" DisableRipple="true" />
</VekSelect>
<VekAutocomplete T="string" IsOpen="true" />
<VekRadio T="string" Checked="true" />
<VekTHeadRow IsChecked="true" />
<VekIconButton Icon="@Icons.Material.Filled.Add" Title="Title moved to the HTML title attribute" />

@*current parameters, a case-only rename, and a component VEK0002 does not inspect raise nothing*@
<VekTabs>
    <VekTabPanel Text="One" PanelClass="one-panel" />
</VekTabs>
<VekTreeView T="string">
    <VekTreeViewItem T="string" Value="@("item")" IconExpanded="@Icons.Material.Filled.FolderOpen" />
</VekTreeView>
<VekTreeViewItemToggleButton ExpandedIcon="@Icons.Material.Filled.ChevronRight" />
<VekCheckBox T="bool" UnCheckedColor="Color.Primary" />
<VekThemeProvider ObserveSystemThemeChange="true" />

@code
{
    public static string __description__ = "Lookalikes of VEK0002 migration hints that must not be explained";
}
