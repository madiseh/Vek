@page "/"
@layout LandingLayout
@inject NugetApiClient NugetApiClient
@inject GitHubApiClient GitHubApiClient
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@using Vek.Docs.Extensions

<PageTitle>Vek - Accessible Blazor Components for .NET</PageTitle>
<HeadContent>
    <meta name="description" content="Vek is an open-source Blazor component library with accessible, customizable UI components for .NET 8–11. Explore components, examples, and setup guides." />
    <meta property="og:title" content="Vek - Blazor Components for .NET" />
    <meta property="og:description" content="Vek is an open-source Blazor component library with accessible, customizable UI components for .NET 8–11. Explore components, examples, and setup guides." />
    <meta property="og:url" content="https://vekui.dev/" />
    <meta name="twitter:title" content="Vek - Blazor Components for .NET" />
    <meta name="twitter:description" content="Vek is an open-source Blazor component library with accessible, customizable UI components for .NET 8–11. Explore components, examples, and setup guides." />
    <link rel="canonical" href="https://vekui.dev/" />
</HeadContent>

<div class="landing-container">
    <!-- Hero Section -->
    <section class="hero-section">
        <a href="/getting-started/installation" class="hero-badge">
            <span class="hero-badge-dot"></span>
            <span>Vek @Metadata.Version • Next-Generation Blazor UI</span>
            <VekIcon Icon="@Icons.Material.Rounded.ArrowForward" Size="Size.Small" />
        </a>

        <h1 class="hero-title">
            Precision Components for <span class="hero-gradient-text">Modern Blazor</span>
        </h1>

        <p class="hero-subtitle">
            Over 70 accessible, production-ready components multi-targeted for .NET 8, 9, 10, and 11.
            Engineered with reactive parameter state, dynamic design tokens, and zero JavaScript bloat.
        </p>

        <div class="hero-actions">
            <VekButton Href="/getting-started/installation" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" DropShadow="false" Class="vek-button-gradient-primary">
                Get Started
            </VekButton>
            <VekButton Href="/docs/overview" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Large">
                Explore Components
            </VekButton>
            <VekButton Href="https://github.com/madiseh/vek" Target="_blank" Color="Color.Default" Variant="Variant.Text" Size="Size.Large" StartIcon="@Icons.Custom.Brands.GitHub">
                Star on GitHub @(_gitHubRepo?.StargazersCount > 0 ? $"({_gitHubRepo.StargazersCount:N0})" : "")
            </VekButton>
        </div>

        <div>
            <div class="hero-install-box">
                <span style="color: var(--vek-palette-primary);">$</span>
                <span class="install-cmd">dotnet add package Vek</span>
                <button type="button" class="install-copy-btn" @onclick="CopyInstallCommand" title="Copy to clipboard" aria-label="Copy install command">
                    <VekIcon Icon="@Icons.Material.Rounded.ContentCopy" Size="Size.Small" />
                </button>
            </div>
        </div>

        <!-- Interactive IDE Component Preview -->
        <div class="hero-preview-container">
            <div class="preview-header">
                <div class="window-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="preview-tabs">
                    <button type="button" class="preview-tab-btn @(_selectedTab == 0 ? "active" : "")" @onclick="() => _selectedTab = 0">Buttons & Chips</button>
                    <button type="button" class="preview-tab-btn @(_selectedTab == 1 ? "active" : "")" @onclick="() => _selectedTab = 1">Inputs & State</button>
                    <button type="button" class="preview-tab-btn @(_selectedTab == 2 ? "active" : "")" @onclick="() => _selectedTab = 2">Feedback & Alerts</button>
                </div>
                <div class="preview-chip">VekComponentDemo.razor</div>
            </div>

            <div class="preview-body">
                <div class="preview-code-pane">
                    @if (_selectedTab == 0)
                    {
                        <pre><code><span class="code-comment">&lt;!-- Interactive Vek Components --&gt;</span>
&lt;<span class="code-tag">VekStack</span> <span class="code-attr">Row</span>=<span class="code-val">"true"</span> <span class="code-attr">Spacing</span>=<span class="code-val">"3"</span> <span class="code-attr">AlignItems</span>=<span class="code-val">"AlignItems.Center"</span>&gt;
    &lt;<span class="code-tag">VekButton</span> <span class="code-attr">Variant</span>=<span class="code-val">"Variant.Filled"</span> <span class="code-attr">Color</span>=<span class="code-val">"Color.Primary"</span>&gt;
        Primary Action
    &lt;/<span class="code-tag">VekButton</span>&gt;

    &lt;<span class="code-tag">VekBadge</span> <span class="code-attr">Content</span>=<span class="code-val">"3"</span> <span class="code-attr">Color</span>=<span class="code-val">"Color.Secondary"</span> <span class="code-attr">Overlap</span>=<span class="code-val">"true"</span>&gt;
        &lt;<span class="code-tag">VekButton</span> <span class="code-attr">Variant</span>=<span class="code-val">"Variant.Outlined"</span>&gt;Notifications&lt;/<span class="code-tag">VekButton</span>&gt;
    &lt;/<span class="code-tag">VekBadge</span>&gt;

    &lt;<span class="code-tag">VekChip</span> <span class="code-attr">T</span>=<span class="code-val">"string"</span> <span class="code-attr">Color</span>=<span class="code-val">"Color.Success"</span> <span class="code-attr">Variant</span>=<span class="code-val">"Variant.Filled"</span> <span class="code-attr">Size</span>=<span class="code-val">"Size.Small"</span>&gt;
        Online
    &lt;/<span class="code-tag">VekChip</span>&gt;
&lt;/<span class="code-tag">VekStack</span>&gt;</code></pre>
                    }
                    else if (_selectedTab == 1)
                    {
                        <pre><code><span class="code-comment">&lt;!-- Reactive Two-Way Data Binding --&gt;</span>
&lt;<span class="code-tag">VekTextField</span> <span class="code-attr">T</span>=<span class="code-val">"string"</span>
              <span class="code-attr">Label</span>=<span class="code-val">"Project Name"</span>
              <span class="code-attr">Variant</span>=<span class="code-val">"Variant.Outlined"</span>
              <span class="code-attr">@@bind-Value</span>=<span class="code-val">"_sampleText"</span> /&gt;

&lt;<span class="code-tag">VekStack</span> <span class="code-attr">Row</span>=<span class="code-val">"true"</span> <span class="code-attr">AlignItems</span>=<span class="code-val">"AlignItems.Center"</span> <span class="code-attr">Spacing</span>=<span class="code-val">"4"</span>&gt;
    &lt;<span class="code-tag">VekSwitch</span> <span class="code-attr">T</span>=<span class="code-val">"bool"</span> <span class="code-attr">@@bind-Value</span>=<span class="code-val">"_switchState"</span> <span class="code-attr">Color</span>=<span class="code-val">"Color.Primary"</span>&gt;
        Notifications Active
    &lt;/<span class="code-tag">VekSwitch</span>&gt;
&lt;/<span class="code-tag">VekStack</span>&gt;</code></pre>
                    }
                    else
                    {
                        <pre><code><span class="code-comment">&lt;!-- Modern Feedback &amp; Alerts --&gt;</span>
&lt;<span class="code-tag">VekAlert</span> <span class="code-attr">Severity</span>=<span class="code-val">"Severity.Success"</span> <span class="code-attr">Variant</span>=<span class="code-val">"Variant.Filled"</span>&gt;
    Application built with zero compiler warnings!
&lt;/<span class="code-tag">VekAlert</span>&gt;

&lt;<span class="code-tag">VekProgressLinear</span> <span class="code-attr">Color</span>=<span class="code-val">"Color.Primary"</span> <span class="code-attr">Value</span>=<span class="code-val">"85"</span> <span class="code-attr">Class</span>=<span class="code-val">"my-4"</span> /&gt;</code></pre>
                    }
                </div>

                <div class="preview-live-pane">
                    @if (_selectedTab == 0)
                    {
                        <div class="d-flex align-center flex-wrap gap-4">
                            <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => _badgeCount++">
                                Click Me (@_badgeCount)
                            </VekButton>

                            <VekBadge Content="@_badgeCount" Color="Color.Secondary" Overlap="true">
                                <VekButton Variant="Variant.Outlined" Color="Color.Default">
                                    Notifications
                                </VekButton>
                            </VekBadge>

                            <VekChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                Live Preview
                            </VekChip>
                        </div>
                        <VekText Typo="Typo.body2" Class="vek-text-secondary">
                            Click the button to watch reactive ParameterState update the badge counter in real time.
                        </VekText>
                    }
                    else if (_selectedTab == 1)
                    {
                        <VekTextField T="string" Label="Project Name" Variant="Variant.Outlined" @bind-Value="_sampleText" FullWidth="true" />
                        <div class="d-flex align-center justify-space-between">
                            <VekSwitch T="bool" @bind-Value="_switchState" Color="Color.Primary">
                                Status: @(_switchState ? "Enabled" : "Disabled")
                            </VekSwitch>
                            <VekChip T="string" Color="@(_switchState ? Color.Primary : Color.Default)" Size="Size.Small">
                                @_sampleText
                            </VekChip>
                        </div>
                    }
                    else
                    {
                        <VekAlert Severity="Severity.Success" Variant="Variant.Filled">
                            Application built with zero compiler warnings!
                        </VekAlert>
                        <VekProgressLinear Color="Color.Primary" Value="85" Size="Size.Medium" Rounded="true" />
                        <div class="d-flex justify-space-between align-center">
                            <VekText Typo="Typo.caption">Performance benchmark</VekText>
                            <VekText Typo="Typo.caption" Color="Color.Primary">85% faster rendering</VekText>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Metrics Bar -->
    <section class="metrics-section">
        <VekGrid Spacing="4">
            <VekItem xs="6" md="3">
                <div class="metric-card">
                    <div class="metric-value">70+</div>
                    <div class="metric-label">Accessible Components</div>
                </div>
            </VekItem>
            <VekItem xs="6" md="3">
                <div class="metric-card">
                    <div class="metric-value">4</div>
                    <div class="metric-label">.NET Versions (8, 9, 10, 11)</div>
                </div>
            </VekItem>
            <VekItem xs="6" md="3">
                <div class="metric-card">
                    <div class="metric-value">0</div>
                    <div class="metric-label">External JS Runtimes</div>
                </div>
            </VekItem>
            <VekItem xs="6" md="3">
                <div class="metric-card">
                    <div class="metric-value">@NumericExtensions.RoundedToString(_nugetPackage?.TotalDownloads ?? 125000)</div>
                    <div class="metric-label">Total Downloads</div>
                </div>
            </VekItem>
        </VekGrid>
    </section>

    <!-- Bento Grid Showcase -->
    <section class="bento-section">
        <div class="section-header">
            <div class="section-badge">Why Vek</div>
            <h2 class="section-title">Engineered for Enterprise Performance</h2>
            <p class="section-subtitle">
                Built from the ground up to solve real-world Blazor challenges: zero re-render cascades, full keyboard access, and native tooling.
            </p>
        </div>

        <VekGrid Spacing="6">
            <!-- Bento 1: Large feature -->
            <VekItem xs="12" md="8">
                <div class="bento-card">
                    <div class="bento-icon-wrapper">
                        <VekIcon Icon="@Icons.Material.Rounded.Speed" Size="Size.Medium" />
                    </div>
                    <h3 class="bento-title">Reactive ParameterState&lt;T&gt; Architecture</h3>
                    <p class="bento-desc">
                        Say goodbye to unnecessary cascading re-renders. Every component parameter in Vek is backed by a reactive ParameterState scope that triggers re-renders only when underlying values genuinely mutate, giving your Blazor applications enterprise-grade responsiveness.
                    </p>
                    <div class="bento-pills">
                        <span class="pill">Zero Cascade Lag</span>
                        <span class="pill">Fine-Grained Change Handlers</span>
                        <span class="pill">Blazor WebAssembly &amp; Server</span>
                    </div>
                </div>
            </VekItem>

            <!-- Bento 2 -->
            <VekItem xs="12" md="4">
                <div class="bento-card">
                    <div class="bento-icon-wrapper">
                        <VekIcon Icon="@Icons.Material.Rounded.Layers" Size="Size.Medium" />
                    </div>
                    <h3 class="bento-title">True Multi-Targeting</h3>
                    <p class="bento-desc">
                        Natively compiled for .NET 8.0, 9.0, 10.0, and 11.0. Migrate seamlessly between LTS and preview releases without breaking changes.
                    </p>
                    <div class="bento-pills">
                        <span class="pill">net8.0</span>
                        <span class="pill">net9.0</span>
                        <span class="pill">net10.0</span>
                        <span class="pill">net11.0</span>
                    </div>
                </div>
            </VekItem>

            <!-- Bento 3 -->
            <VekItem xs="12" md="4">
                <div class="bento-card">
                    <div class="bento-icon-wrapper">
                        <VekIcon Icon="@Icons.Material.Rounded.AccessibilityNew" Size="Size.Medium" />
                    </div>
                    <h3 class="bento-title">WAI-ARIA Accessibility</h3>
                    <p class="bento-desc">
                        Full keyboard navigation, visible focus rings, APG compliance, and screen-reader tested landmark roles out of the box.
                    </p>
                    <div class="bento-pills">
                        <span class="pill">WCAG 2.1 AA</span>
                        <span class="pill">Keyboard Nav</span>
                        <span class="pill">bUnit Verified</span>
                    </div>
                </div>
            </VekItem>

            <!-- Bento 4 -->
            <VekItem xs="12" md="4">
                <div class="bento-card">
                    <div class="bento-icon-wrapper">
                        <VekIcon Icon="@Icons.Material.Rounded.Palette" Size="Size.Medium" />
                    </div>
                    <h3 class="bento-title">CSS Design Tokens</h3>
                    <p class="bento-desc">
                        First-class dark mode, CSS custom properties, responsive breakpoints, and zero hard-coded colors. Customize any token dynamically at runtime.
                    </p>
                    <div class="bento-pills">
                        <span class="pill">Dark / Light Modes</span>
                        <span class="pill">Token Variables</span>
                        <span class="pill">RTL Support</span>
                    </div>
                </div>
            </VekItem>

            <!-- Bento 5 -->
            <VekItem xs="12" md="4">
                <div class="bento-card">
                    <div class="bento-icon-wrapper">
                        <VekIcon Icon="@Icons.Material.Rounded.AutoFixHigh" Size="Size.Medium" />
                    </div>
                    <h3 class="bento-title">Roslyn Analyzers &amp; Fixes</h3>
                    <p class="bento-desc">
                        Built-in Roslyn analyzers catch anti-patterns during compilation and provide one-click code fixes directly in your IDE.
                    </p>
                    <div class="bento-pills">
                        <span class="pill">Roslyn Rules</span>
                        <span class="pill">Automated Fixes</span>
                        <span class="pill">IDE Integrated</span>
                    </div>
                </div>
            </VekItem>
        </VekGrid>
    </section>

    <!-- Component Categories Section -->
    <section class="categories-section">
        <div class="section-header">
            <div class="section-badge">Component Catalog</div>
            <h2 class="section-title">Explore 70+ Ready-To-Use Components</h2>
            <p class="section-subtitle">
                Everything you need to ship world-class Blazor user interfaces faster.
            </p>
        </div>

        <VekGrid Spacing="6">
            <VekItem xs="12" sm="6" md="3">
                <a href="/components/button" class="category-card">
                    <div class="cat-title">Forms &amp; Inputs</div>
                    <div class="cat-desc">Buttons, TextFields, Selects, Autocomplete, Checkboxes, Switches, Sliders, and DatePickers.</div>
                    <div class="cat-items">
                        <span>VekButton</span>
                        <span>VekTextField</span>
                        <span>VekSelect</span>
                    </div>
                </a>
            </VekItem>
            <VekItem xs="12" sm="6" md="3">
                <a href="/components/table" class="category-card">
                    <div class="cat-title">Data &amp; Grids</div>
                    <div class="cat-desc">High-performance DataGrid, sortable tables, virtualized lists, pagination, and tree views.</div>
                    <div class="cat-items">
                        <span>VekDataGrid</span>
                        <span>VekTable</span>
                        <span>VekVirtualize</span>
                    </div>
                </a>
            </VekItem>
            <VekItem xs="12" sm="6" md="3">
                <a href="/components/drawer" class="category-card">
                    <div class="cat-title">Layout &amp; Navigation</div>
                    <div class="cat-desc">Drawers, AppBars, Toolbars, Menus, Breadcrumbs, Tabs, Responsive Grids, and Stacks.</div>
                    <div class="cat-items">
                        <span>VekDrawer</span>
                        <span>VekAppBar</span>
                        <span>VekTabs</span>
                    </div>
                </a>
            </VekItem>
            <VekItem xs="12" sm="6" md="3">
                <a href="/components/dialog" class="category-card">
                    <div class="cat-title">Feedback &amp; Overlays</div>
                    <div class="cat-desc">Modal dialogs, snackbar toasts, popovers, tooltips, alert banners, and progress bars.</div>
                    <div class="cat-items">
                        <span>VekDialog</span>
                        <span>VekSnackbar</span>
                        <span>VekAlert</span>
                    </div>
                </a>
            </VekItem>
        </VekGrid>
    </section>

    <!-- Real-world showcase from the separate examples project -->
    <section class="showcases-section">
        <div class="section-header">
            <div class="section-badge">Real-world examples</div>
            <h2 class="section-title">See complete apps built with Vek</h2>
            <p class="section-subtitle">
                Explore practical use cases that combine Vek components into complete, interactive experiences.
            </p>
        </div>

        <ExpenseTrackerPreview />
    </section>

    <!-- Final Call to Action -->
    <section class="final-cta-section">
        <div class="final-cta-card">
            <h2 class="cta-title">Start Building with Vek Today</h2>
            <p class="cta-subtitle">
                Install the package, import the styles, and experience the speed and elegance of modern Blazor engineering.
            </p>
            <div class="cta-buttons">
                <VekButton Href="/getting-started/installation" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large" DropShadow="false" Class="vek-button-gradient-primary">
                    Get Started in 2 Minutes
                </VekButton>
                <VekButton Href="/docs/overview" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Large">
                    View Component Docs
                </VekButton>
            </div>
        </div>
    </section>
</div>

@code {
#nullable enable
    private int _selectedTab = 0;
    private int _badgeCount = 3;
    private string _sampleText = "VekBlazor";
    private bool _switchState = true;

    private NugetPackage? _nugetPackage { get; set; } = new();
    private GitHubRepository? _gitHubRepo { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _nugetPackage = await NugetApiClient.GetPackageAsync("vek");
            _gitHubRepo = await GitHubApiClient.GetRepositoryAsync("Vek", "Vek");
        }
        catch
        {
            // Fallback gracefully if API calls fail or offline
        }
    }

    private async Task CopyInstallCommand()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", "dotnet add package Vek");
            Snackbar.Add("Command copied to clipboard: dotnet add package Vek", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Command: dotnet add package Vek", Severity.Info);
        }
    }
}
