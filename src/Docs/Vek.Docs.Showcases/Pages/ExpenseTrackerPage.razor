@page "/showcases/expense-tracker"
@layout DocsLayout
@using System.Globalization
@inject IJSRuntime JSRuntime

<PageTitle>Expense Tracker Showcase - Vek</PageTitle>
<HeadContent>
    <meta name="description" content="Explore Vek's interactive expense tracker showcase: record expenses, compare spending trends, and review recent activity in a responsive Blazor dashboard." />
    <meta property="og:title" content="Expense Tracker Showcase - Vek" />
    <meta property="og:description" content="Explore Vek's interactive expense tracker showcase: record expenses, compare spending trends, and review recent activity in a responsive Blazor dashboard." />
    <meta property="og:url" content="https://vekui.dev/showcases/expense-tracker" />
    <link rel="canonical" href="https://vekui.dev/showcases/expense-tracker" />
</HeadContent>

<VekMainContent>
<VekStack Spacing="5" Class="expense-dashboard" vek-showcase-expense-tracker="">
    <VekStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="dashboard-heading">
        <VekStack Spacing="1" Class="dashboard-title-group">
            <VekText Typo="Typo.overline">PERSONAL FINANCE</VekText>
            <VekText Typo="Typo.h3">Expense Tracker</VekText>
            <VekText Typo="Typo.body1">A practical view of your spending, trends, and recent activity.</VekText>
            <VekChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Demo data · saved in this browser</VekChip>
        </VekStack>

        <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="dashboard-actions">
            <VekSelect T="int" Label="Time period" @bind-Value="_periodDays" Class="period-select">
                <VekSelectItem T="int" Value="30">Last 30 days</VekSelectItem>
                <VekSelectItem T="int" Value="90">Last 90 days</VekSelectItem>
                <VekSelectItem T="int" Value="180">Last 6 months</VekSelectItem>
            </VekSelect>
            <VekStack Spacing="0" Class="account-balance">
                        <VekText Typo="Typo.caption">Estimated balance</VekText>
                <VekText Typo="Typo.h6">@FormatMoney(Balance)</VekText>
            </VekStack>
            <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenNewExpenseForm" aria-expanded="@_showExpenseForm" aria-controls="expense-entry-form">
                Add expense
            </VekButton>
        </VekStack>
    </VekStack>

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <VekAlert Severity="Severity.Info" Dense="true" Class="dashboard-feedback">@_feedback</VekAlert>
    }

    @if (_showExpenseForm)
    {
        <VekCard Outlined="true" Class="expense-entry-form" id="expense-entry-form">
            <VekCardContent>
                <VekStack Spacing="4">
                    <VekStack Spacing="1">
                        <VekText Typo="Typo.h5">@(_editingExpenseId is null ? "Add an expense" : "Edit expense")</VekText>
                        <VekText Typo="Typo.body2">Track the details so your summaries stay useful.</VekText>
                    </VekStack>
                    <VekGrid Spacing="3">
                        <VekItem xs="12" sm="6">
                            <VekTextField @bind-Value="_newDescription" Immediate="true" Label="Description" Placeholder="e.g. Weekly groceries" MaxLength="60" Required="true" />
                        </VekItem>
                        <VekItem xs="12" sm="6">
                            <VekTextField @bind-Value="_newMerchant" Immediate="true" Label="Merchant" Placeholder="e.g. Green Market" MaxLength="60" Required="true" />
                        </VekItem>
                        <VekItem xs="12" sm="4">
                            <VekNumericField @bind-Value="_newAmount" Immediate="true" Label="Amount" Min="0.01M" Step="0.01M" Variant="Variant.Outlined" />
                        </VekItem>
                        <VekItem xs="12" sm="4">
                            <VekSelect T="string" Label="Category" @bind-Value="_newCategory">
                                @foreach (var category in CategoryNames)
                                {
                                    <VekSelectItem T="string" Value="@category">@category</VekSelectItem>
                                }
                            </VekSelect>
                        </VekItem>
                        <VekItem xs="12" sm="4">
                            <VekDatePicker Label="Date" @bind-Date="_newDate" />
                        </VekItem>
                    </VekGrid>
                    <VekStack Row="true" Justify="Justify.FlexEnd" Spacing="2">
                        <VekButton Variant="Variant.Text" OnClick="CloseExpenseForm">Cancel</VekButton>
                        <VekButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSaveExpense)" OnClick="SaveExpenseAsync">
                            @(_editingExpenseId is null ? "Save expense" : "Save changes")
                        </VekButton>
                    </VekStack>
                </VekStack>
            </VekCardContent>
        </VekCard>
    }

    <VekGrid Spacing="3" Class="summary-grid">
        <VekItem xs="12" sm="6" md="3">
            <VekCard Outlined="true" Class="summary-card">
                <VekCardContent><VekStack Spacing="1"><VekText Typo="Typo.body2">Estimated income</VekText><VekText Typo="Typo.h5">@FormatMoney(Income)</VekText><VekText Typo="Typo.caption">Based on @FormatMoney(MonthlyIncomeEstimate) per month</VekText></VekStack></VekCardContent>
            </VekCard>
        </VekItem>
        <VekItem xs="12" sm="6" md="3">
            <VekCard Outlined="true" Class="summary-card summary-card-primary">
                <VekCardContent><VekStack Spacing="1"><VekText Typo="Typo.body2">Expenses</VekText><VekText Typo="Typo.h5">@FormatMoney(Expenses)</VekText><VekText Typo="Typo.caption">Across the selected period</VekText></VekStack></VekCardContent>
            </VekCard>
        </VekItem>
        <VekItem xs="12" sm="6" md="3">
            <VekCard Outlined="true" Class="summary-card">
                <VekCardContent><VekStack Spacing="1"><VekText Typo="Typo.body2">Balance</VekText><VekText Typo="Typo.h5">@FormatMoney(Balance)</VekText><VekText Typo="Typo.caption">Estimated income after expenses</VekText></VekStack></VekCardContent>
            </VekCard>
        </VekItem>
        <VekItem xs="12" sm="6" md="3">
            <VekCard Outlined="true" Class="summary-card">
                <VekCardContent><VekStack Spacing="1"><VekText Typo="Typo.body2">Transactions</VekText><VekText Typo="Typo.h5">@PeriodExpenses.Count.ToString("N0", CultureInfo.InvariantCulture)</VekText><VekText Typo="Typo.caption">In the selected period</VekText></VekStack></VekCardContent>
            </VekCard>
        </VekItem>
    </VekGrid>

    <VekGrid Spacing="4" Class="insights-grid">
        <VekItem xs="12" md="7">
            <VekCard Outlined="true" Class="dashboard-panel spending-panel">
                <VekCardContent>
                    <VekStack Spacing="4">
                        <VekStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <VekStack Spacing="1"><VekText Typo="Typo.h5">Spending over time</VekText><VekText Typo="Typo.body2">Monthly totals from your recorded expenses</VekText></VekStack>
                            <VekChip T="string" Size="Size.Small" Variant="Variant.Outlined">@RangeLabel</VekChip>
                        </VekStack>
                        @if (ChartMonths.Count == 0)
                        {
                            <VekText Typo="Typo.body2">Add expenses to see your spending trend.</VekText>
                        }
                        else
                        {
                            <VekGrid Spacing="2" Class="spending-chart">
                                @foreach (var month in ChartMonths)
                                {
                                    <VekItem xs="4" sm="2">
                                        <VekStack Spacing="2" AlignItems="AlignItems.Center" Class="chart-column">
                                            <VekText Typo="Typo.caption">@FormatMoney(month.Amount)</VekText>
                                            <VekProgressLinear Value="@month.Percentage" Color="@(month.IsCurrent ? Color.Primary : Color.Info)" Rounded="true" Class="chart-bar" />
                                            <VekText Typo="Typo.caption">@month.Label</VekText>
                                        </VekStack>
                                    </VekItem>
                                }
                            </VekGrid>
                        }
                    </VekStack>
                </VekCardContent>
            </VekCard>
        </VekItem>
        <VekItem xs="12" md="5">
            <VekCard Outlined="true" Class="dashboard-panel category-panel">
                <VekCardContent>
                    <VekStack Spacing="2" AlignItems="AlignItems.Center">
                        <VekStack Spacing="1" Class="chart-heading"><VekText Typo="Typo.h5">Spending mix</VekText><VekText Typo="Typo.body2">How your expenses are distributed</VekText></VekStack>
                        @if (CategorySummaries.Count > 0)
                        {
                            <VekChart T="double" ChartType="ChartType.Pie" ChartSeries="@CategoryChartSeries" ChartLabels="@CategoryChartLabels" Width="100%" Height="260px" />
                        }
                    </VekStack>
                </VekCardContent>
                <VekCardContent>
                    <VekStack Spacing="4">
                        <VekStack Spacing="1"><VekText Typo="Typo.h5">Spending categories</VekText><VekText Typo="Typo.body2">Select a category to filter transactions</VekText></VekStack>
                        @if (CategorySummaries.Count == 0)
                        {
                            <VekText Typo="Typo.body2">No category spending in this period yet.</VekText>
                        }
                        else
                        {
                            @foreach (var category in CategorySummaries)
                            {
                                <VekButton Variant="Variant.Text" FullWidth="true" Class="category-item" aria-label="@GetCategorySummaryAriaLabel(category)" aria-pressed="@(IsCategorySelected(category.Name) ? "true" : "false")" OnClick="@(() => ToggleCategoryFilter(category.Name))">
                                    <VekStack Spacing="2" Class="category-content">
                                        <VekStack Row="true" Justify="Justify.SpaceBetween" Class="category-heading">
                                            <VekText Typo="Typo.body1">@category.Name · @category.Share% of spending</VekText>
                                            <VekText Typo="Typo.subtitle1">@FormatMoney(category.Amount)</VekText>
                                        </VekStack>
                                        <VekProgressLinear Value="@category.RelativePercent" Color="@category.Color" Rounded="true" />
                                    </VekStack>
                                </VekButton>
                            }
                        }
                    </VekStack>
                </VekCardContent>
            </VekCard>
        </VekItem>
    </VekGrid>

    <VekCard Outlined="true" Class="dashboard-panel transactions-panel" id="transactions">
        <VekCardContent>
            <VekStack Spacing="4">
                <VekStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="transactions-heading">
                    <VekStack Spacing="1"><VekText Typo="Typo.h5">Recent transactions</VekText><VekText Typo="Typo.body2">Search, filter, sort, edit, or remove recorded expenses.</VekText></VekStack>
                    <VekChip T="string" Size="Size.Small" Variant="Variant.Outlined">@FilteredExpenses.Count transactions</VekChip>
                </VekStack>
                <VekGrid Spacing="3" Class="transaction-controls">
                    <VekItem xs="12" md="6">
                        <VekTextField @bind-Value="_searchText" Immediate="true" Label="Search transactions" Placeholder="Description or merchant" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                    </VekItem>
                    <VekItem xs="12" sm="6" md="3">
                        <VekSelect T="string" Label="Category filter" @bind-Value="_categoryFilter">
                            <VekSelectItem T="string" Value="@string.Empty">All categories</VekSelectItem>
                            @foreach (var category in CategoryNames)
                            {
                                <VekSelectItem T="string" Value="@category">@category</VekSelectItem>
                            }
                        </VekSelect>
                    </VekItem>
                    <VekItem xs="12" sm="6" md="3">
                        <VekButton Variant="Variant.Text" Disabled="@(!HasActiveFilters)" OnClick="ClearFilters">Clear filters</VekButton>
                    </VekItem>
                </VekGrid>
                <VekDataGrid Items="@FilteredExpenses" RowsPerPage="6" Hover="true" Dense="true" SortMode="SortMode.Multiple" Class="transaction-grid">
                    <Columns>
                        <PropertyColumn Property="expense => expense.Description" Title="Transaction" />
                        <PropertyColumn Property="expense => expense.Merchant" Title="Merchant" />
                        <PropertyColumn Property="expense => expense.Category" Title="Category" />
                        <PropertyColumn Property="expense => expense.Date" Title="Date" Format="MMM dd, yyyy" />
                        <PropertyColumn Property="expense => expense.Amount" Title="Amount" Format="C2" />
                        <TemplateColumn Title="Actions" Sortable="false">
                            <CellTemplate Context="cell">
                                <VekStack Row="true" Spacing="1">
                                    <VekButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => EditExpense(cell.Item))">Edit</VekButton>
                                    <VekButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteExpenseAsync(cell.Item))">Delete</VekButton>
                                </VekStack>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <PagerContent>
                        <VekDataGridPager T="ExpenseEntry" PageSizeOptions="new[] { 6 }" />
                    </PagerContent>
                </VekDataGrid>
            </VekStack>
        </VekCardContent>
    </VekCard>
</VekStack>
</VekMainContent>
