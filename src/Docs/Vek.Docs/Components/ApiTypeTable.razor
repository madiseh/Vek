<VekTable T="DocumentedType" @ref="Table" ServerData="@GetData" Elevation="0" Class="ma-0 vek-width-full" RowsPerPage="25" Hover="true" Dense="true" AllowUnsorted="false">
    <ToolBarContent>
        <VekTextField T="string"
                      Value="Keyword"
                      ValueChanged="OnKeywordChanged"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Placeholder="Search"
                      Immediate="true"
                      DebounceInterval="300" />
    </ToolBarContent>
    <HeaderContent>
        <VekTh Style="max-width:34%;"><VekTableSortLabel T="DocumentedType" SortLabel="Name" InitialDirection="SortDirection.Ascending">Name</VekTableSortLabel></VekTh>
        <VekTh Style="max-width:66%;"><VekTableSortLabel T="DocumentedType" SortLabel="Description">Description</VekTableSortLabel></VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd Class="docs-content-api-cell" DataLabel="Name">
            <ApiTypeLink Type="@context" TypeName="@context.NameFriendly" ShowTooltip="false" />
        </VekTd>
        <VekTd id="@context.Name" Class="docs-content-api-cell docs-content-api-description" DataLabel="Description">
            <ApiText Text="@(context.Summary + " " + context.Remarks)" />
        </VekTd>
    </RowTemplate>
    <PagerContent>
        <VekTablePager />
    </PagerContent>
    <NoRecordsContent>
        <VekAlert Severity="Severity.Info">No types match the current filters.</VekAlert>
    </NoRecordsContent>
</VekTable>
