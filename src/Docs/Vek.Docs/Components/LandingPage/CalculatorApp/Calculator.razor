@using PrimitiveCalculator
@using System.Globalization
@namespace Vek.Docs.Components.LandingPage

<VekPaper Square="true" Elevation="0" Height="30%" Class="d-flex justify-end align-center px-10 vek-transparent">
    <div>
        <VekText Typo="Typo.h4" Align="Align.End" Class="vek-text-secondary">
            @Last
        </VekText>
        <VekText Typo="Typo.h1">
            @CalcExpression
        </VekText>
    </div>
</VekPaper>
<VekPaper Square="true" Elevation="0" Height="70%" Class="lp-calc-buttons pb-16">
    <VekGrid Spacing="0" Class="vek-height-full">
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton OnClick="@(() => CalcExpression += "(")" Class="rounded-circle">(</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton OnClick="@(() => CalcExpression += ")")" Class="rounded-circle">)</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton OnClick="@(() => CalcExpression += "%")" Class="rounded-circle">
                <VekIcon Icon="@("<path d=\"M18.5 3.5l-15 15l2 2l15-15M7 4a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3m10 10a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3z\">")"/>
            </VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Variant="Variant.Filled" DropShadow="false"  OnClick="@(() => CalcExpression += "/")" Class="rounded-circle">
                <VekIcon Icon="@("<path d=\"M19 13H5v-2h14v2m-7-8a2 2 0 0 1 2 2a2 2 0 0 1-2 2a2 2 0 0 1-2-2a2 2 0 0 1 2-2m0 10a2 2 0 0 1 2 2a2 2 0 0 1-2 2a2 2 0 0 1-2-2a2 2 0 0 1 2-2z\">")"/>
            </VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=7)">7</VekButton>  
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=8)">8</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=9)">9</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Variant="Variant.Filled" DropShadow="false"  Class="rounded-circle" OnClick="@(()=>CalcExpression+="*")">
              <VekIcon Icon="@Icons.Material.Filled.Close"/>
          </VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=4)">4</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=5)">5</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=6)">6</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Variant="Variant.Filled" DropShadow="false"  Class="rounded-circle" OnClick="@(()=>CalcExpression+="-")">
               <VekIcon Icon="@Icons.Material.Filled.Remove"/>
           </VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=1)">1</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=2)">2</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=3)">3</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Variant="Variant.Filled" DropShadow="false" Class="rounded-circle" OnClick="@(()=>CalcExpression+="+")">
                <VekIcon Icon="@Icons.Material.Filled.Add"/>
            </VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton OnClick="Reset" Class="rounded-circle">C</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=0)">0</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Class="rounded-circle" OnClick="@(()=>CalcExpression+=".")">.</VekButton>
        </VekItem>
        <VekItem xs="3" Class="d-flex justify-center align-center pa-6">
            <VekButton Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" OnClick="Evaluate" Class="rounded-circle">
                <VekIcon Icon="@("<path d=\"M19,10H5V8H19V10M19,16H5V14H19V16Z\"/>")"/>
            </VekButton>
        </VekItem>
    </VekGrid>
</VekPaper>


@code
{
    
    protected string Last;
    protected string Current;
    protected string CalcExpression = "";

    public void Reset()
    {
        Last = "";
        Current = "";
        CalcExpression = "";
    }

    public void Evaluate()
    {
        Last = Current;
        if (string.IsNullOrWhiteSpace(CalcExpression))
        {
            Current = "";
            return;
        }
        var exp = new Expression(CalcExpression);
        var result=exp.Eval();
        if (double.IsNaN(result))
        {
            Current = "ERROR";
            return;
        }
        Current = Math.Round( result, 8).ToString(CultureInfo.InvariantCulture);
        CalcExpression=Current; // <-- this allows to continue calculating with the result
    }
}
