
<div @ref="@SectionReference" id="@GetSectionId()" class="@Classname">
    @if (!String.IsNullOrWhiteSpace(Title) && HideTitle == false)
    {
        <VekText Typo="@GetTitleTypo()">
            <b>@Title</b>
        </VekText>
    }
    @if (SubTitle != null)
    {
        <VekText Typo="Typo.h6">@SubTitle</VekText>
    }
    @if (Description != null)
    {
        <VekText Class="mb-5">@Description</VekText>
    }
</div>