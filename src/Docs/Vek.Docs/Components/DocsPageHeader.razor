@*html head (for server prerendering)*@
<PageTitle>@(GetTitle())</PageTitle>
<HeadContent>
    <meta Property="og:title" Content="@GetTitle()" />
    <meta Property="og:url" Content="@GetCanonicalUri()" />
    <meta Name="twitter:title" Content="@GetTitle()" />
    <meta Name="description" Content="@GetMetaDescription()" />
    <meta Property="og:description" Content="@GetMetaDescription()" />
    <meta Name="twitter:description" Content="@GetMetaDescription()" />
    <link rel="canonical" href="@GetCanonicalUri()" />
</HeadContent>

@if (SpecialHeaderContent != null)
{
    <div class="docs-page-header my-16">
        @SpecialHeaderContent
        <DocsRenderBenchmark />
    </div>
}
else
{
    <div class="docs-page-header">
        <VekText Typo="@Typo.h4">@Title</VekText>
        <ApiText Typo="@Typo.subtitle1" Text="@GetSubTitle()" />
        <VekText Typo="@Typo.body1">@Description</VekText>
        <DocsRenderBenchmark />
    </div>
}

@if (!IsApi && DocumentedType != null)
{
    <DocsPageSection api-link-section>
        <SectionHeader Title="API" />
        <div class="docs-page-apilinks">
            <ul class="my-2">
                <li>
                    <VekLink Href="@(DocumentedType.ApiUrl.ToLowerInvariant())">
                        <CodeInline>@($"<{Component}>")</CodeInline>
                    </VekLink>
                </li>
                @if (Example != null && Example.ChildTypes != null)
                {
                    @foreach (var childType in Example.ChildTypes)
                    {
                        <li>
                            <VekLink Href="@($"api/{childType.Name.ToLowerInvariant()}")" Class="ms-1">
                                - <CodeInline>@($"<{childType.Name.Replace("`1", "")}>")</CodeInline>
                            </VekLink>
                        </li>
                    }
                }
            </ul>
        </div>
    </DocsPageSection>
}
@if (IsApi && Example != null)
{
    <DocsPageSection api-link-section>
        <SectionHeader Title="Pages" />
        <VekAlert Severity="Severity.Info" Class="mt-6">
            For examples and details on the usage of this component, visit the <VekLink Href="@($"/components/{Example.Link.ToLowerInvariant()}")">@Example.Name</VekLink> page.
        </VekAlert>
    </DocsPageSection>
}
