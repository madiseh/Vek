@namespace Vek.Docs.Examples

<VekStack Spacing="4">
    <VekStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="flex-wrap gap-4">
        <VekRadioGroup T="TabPosition" @bind-Value="_tabPosition" Class="d-flex flex-row flex-wrap gap-2">
            <VekRadio Value="TabPosition.Top" Color="Color.Primary">Top</VekRadio>
            <VekRadio Value="TabPosition.Bottom" Color="Color.Primary">Bottom</VekRadio>
            <VekRadio Value="TabPosition.Left" Color="Color.Primary">Left (Vertical)</VekRadio>
            <VekRadio Value="TabPosition.Right" Color="Color.Primary">Right (Vertical)</VekRadio>
        </VekRadioGroup>

        <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <VekChip T="string" Color="@(_isVertical ? Color.Secondary : Color.Info)" Size="Size.Small" Variant="Variant.Filled">
                @(_isVertical ? "Vertical Layout" : "Horizontal Layout")
            </VekChip>
            <VekChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                @(_isVertical ? "Keys: ArrowUp / ArrowDown" : "Keys: ArrowLeft / ArrowRight")
            </VekChip>
        </VekStack>
    </VekStack>

    <VekTabs TabPosition="@_tabPosition"
             Outlined="true"
             Border="true"
             ApplyEffectsToContainer="true"
             Class="mt-2"
             TabPanelsClass="pa-6"
             Color="Color.Primary"
             SliderColor="Color.Primary">
        <VekTabPanel Text="General" Icon="@Icons.Material.Filled.Settings">
            <VekStack Spacing="2">
                <VekText Typo="Typo.h6">General Settings</VekText>
                <VekText Typo="Typo.body2" Color="Color.Secondary">
                    Configure your workspace preferences and display density.
                </VekText>
                <VekText Typo="Typo.body2">
                    Tab strip is currently positioned at <b>@_tabPosition</b> with <b>@(_isVertical ? "vertical" : "horizontal")</b> alignment.
                </VekText>
            </VekStack>
        </VekTabPanel>
        <VekTabPanel Text="Profile" Icon="@Icons.Material.Filled.Person">
            <VekStack Spacing="2">
                <VekText Typo="Typo.h6">User Profile</VekText>
                <VekText Typo="Typo.body2">
                    Manage your personal account details, avatar, and contact email.
                </VekText>
            </VekStack>
        </VekTabPanel>
        <VekTabPanel Text="Notifications" Icon="@Icons.Material.Filled.Notifications" BadgeDot="true" BadgeColor="Color.Error">
            <VekStack Spacing="2">
                <VekText Typo="Typo.h6">Notification Preferences</VekText>
                <VekText Typo="Typo.body2">
                    Subscribe to email digests, push notifications, and critical alerts.
                </VekText>
            </VekStack>
        </VekTabPanel>
        <VekTabPanel Text="Security" Icon="@Icons.Material.Filled.Security">
            <VekStack Spacing="2">
                <VekText Typo="Typo.h6">Security & Authentication</VekText>
                <VekText Typo="Typo.body2">
                    Configure multi-factor authentication, active sessions, and API tokens.
                </VekText>
            </VekStack>
        </VekTabPanel>
    </VekTabs>
</VekStack>

@code {
    private TabPosition _tabPosition = TabPosition.Left;
    private bool _isVertical => _tabPosition is TabPosition.Left or TabPosition.Right;
}
