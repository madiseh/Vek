@namespace Vek.Docs.Examples

<VekStack Spacing="4">
    <VekPaper Class="pa-4" Outlined="true">
        <VekStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="4">
            <VekSelect T="TabsRenderMode" Label="Render Mode" Value="@_renderMode" ValueChanged="HandleRenderModeChanged" Dense="true" Style="min-width: 220px;">
                <VekSelectItem Value="TabsRenderMode.ActiveTab">ActiveTab (Default)</VekSelectItem>
                <VekSelectItem Value="TabsRenderMode.ActiveTabLazily">ActiveTabLazily</VekSelectItem>
                <VekSelectItem Value="TabsRenderMode.AllTabs">AllTabs</VekSelectItem>
            </VekSelect>
            <VekButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetExample" StartIcon="@Icons.Material.Filled.Refresh">
                Reset State
            </VekButton>
            <VekChip Color="@GetModeChipColor()" Size="Size.Small" T="string">
                @GetModeDescription()
            </VekChip>
        </VekStack>
    </VekPaper>

    <VekTabs @key="@_renderModeKey"
             RenderMode="@_renderMode"
             Elevation="2"
             Rounded="true"
             ApplyEffectsToContainer="true"
             TabPanelsClass="pa-6">
        <VekTabPanel Text="General Settings" Icon="@Icons.Material.Filled.Settings">
            <VekStack Spacing="3">
                <VekText Typo="Typo.h6">General Settings</VekText>
                <VekText Typo="Typo.body2">
                    Modify form input below. When switching tabs, state is preserved in <b>ActiveTabLazily</b> and <b>AllTabs</b>, but discarded in <b>ActiveTab</b>.
                </VekText>
                <VekTextField T="string" Label="Workspace Name" @bind-Value="_workspaceName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <TabsKeepAlivePanel ComponentName="General" FirstRender="@(() => _firstRenderCounts[0]++)" />
            </VekStack>
        </VekTabPanel>
        <VekTabPanel Text="User Profile" Icon="@Icons.Material.Filled.Person">
            <VekStack Spacing="3">
                <VekText Typo="Typo.h6">User Profile</VekText>
                <VekText Typo="Typo.body2">
                    In <b>ActiveTabLazily</b>, this panel's DOM is only created when you navigate to this tab for the first time.
                </VekText>
                <VekTextField T="string" Label="Display Name" @bind-Value="_displayName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <TabsKeepAlivePanel ComponentName="Profile" FirstRender="@(() => _firstRenderCounts[1]++)" />
            </VekStack>
        </VekTabPanel>
        <VekTabPanel Text="Notifications" Icon="@Icons.Material.Filled.Notifications">
            <VekStack Spacing="3">
                <VekText Typo="Typo.h6">Notification Preferences</VekText>
                <VekText Typo="Typo.body2">
                    Notice the render counter below. It only increments on the initial render of this panel.
                </VekText>
                <VekTextField T="string" Label="Notification Email" @bind-Value="_email" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <TabsKeepAlivePanel ComponentName="Notifications" FirstRender="@(() => _firstRenderCounts[2]++)" />
            </VekStack>
        </VekTabPanel>
    </VekTabs>

    <VekPaper Class="pa-4" Elevation="0" Outlined="true">
        <VekText Typo="Typo.subtitle2" GutterBottom="true"><b>Panel Render Status (First-Render Initialization Counts):</b></VekText>
        <VekStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
            <VekChip Color="@(_firstRenderCounts[0] > 0 ? Color.Success : Color.Default)" Variant="Variant.Text" T="string">
                General Tab: @(_firstRenderCounts[0] > 0 ? $"Initialized ({_firstRenderCounts[0]}x)" : "Not in DOM")
            </VekChip>
            <VekChip Color="@(_firstRenderCounts[1] > 0 ? Color.Success : Color.Default)" Variant="Variant.Text" T="string">
                Profile Tab: @(_firstRenderCounts[1] > 0 ? $"Initialized ({_firstRenderCounts[1]}x)" : "Not in DOM")
            </VekChip>
            <VekChip Color="@(_firstRenderCounts[2] > 0 ? Color.Success : Color.Default)" Variant="Variant.Text" T="string">
                Notifications Tab: @(_firstRenderCounts[2] > 0 ? $"Initialized ({_firstRenderCounts[2]}x)" : "Not in DOM")
            </VekChip>
        </VekStack>
    </VekPaper>
</VekStack>

@code {
    private TabsRenderMode _renderMode = TabsRenderMode.ActiveTabLazily;
    private int _renderModeKey = 0;
    private List<int> _firstRenderCounts = [0, 0, 0];
    private string _workspaceName = "Production Studio";
    private string _displayName = "Alex Morgan";
    private string _email = "alex@example.com";

    private void HandleRenderModeChanged(TabsRenderMode newMode)
    {
        _renderMode = newMode;
        ResetExample();
    }

    private void ResetExample()
    {
        _renderModeKey++;
        _firstRenderCounts = [0, 0, 0];
    }

    private Color GetModeChipColor() => _renderMode switch
    {
        TabsRenderMode.ActiveTabLazily => Color.Primary,
        TabsRenderMode.AllTabs => Color.Info,
        _ => Color.Secondary
    };

    private string GetModeDescription() => _renderMode switch
    {
        TabsRenderMode.ActiveTabLazily => "ActiveTabLazily: Created on first visit & cached in DOM across tab switches",
        TabsRenderMode.AllTabs => "AllTabs: All tab panels created in DOM immediately & hidden via CSS",
        TabsRenderMode.ActiveTab => "ActiveTab: Only the active tab panel is kept in DOM; inactive panels are destroyed",
        _ => string.Empty
    };
}
