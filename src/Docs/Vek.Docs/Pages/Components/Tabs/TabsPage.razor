@page "/components/tabs"

<DocsPage>
    <DocsPageHeader Title="Tabs" Component="@nameof(VekTabs)" />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Simple Tabs" />
            <SectionContent Code="@nameof(TabsSimpleExample)" ShowCode="true" Block="true">
                <TabsSimpleExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Icon Tabs">
                <Description>
                    Icons can be added alongside text in the tabs to enhance visuals.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TabsIconAndTextExample)" ShowCode="false">
                <TabsIconAndTextExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Explore Features">
                <Description>Browse specific features and usage patterns in detail:</Description>
            </SectionHeader>
            <div class="vek-bento-grid mt-4">
                <DocsExploreCard Title="Orientation & Positioning" Category="Tabs" Link="/components/tabs/orientation-positioning" Description="Vertical TabPosition modes, centered alignment, custom tab widths, and tooltips.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.ViewColumn" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Vertical · Horizontal · Centered</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Dynamic & Closable" Category="Tabs" Link="/components/tabs/dynamic-closable" Description="Closable tabs, lifecycle close events, dynamic tab binding, and drag-and-drop reordering.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Tab" Color="Color.Info" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Closable · Drag & Drop · Dynamic</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Rendering & Lifecycle" Category="Tabs" Link="/components/tabs/rendering-lifecycle" Description="Lazy rendering, tab panel caching, KeepPanelsAlive, and lexicographical sorting.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Cached" Color="Color.Success" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Lazy Render · KeepPanelsAlive</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Headers, Badges & Scrolling" Category="Tabs" Link="/components/tabs/headers-badges" Description="Custom HeaderTemplates, status notification badges, start/end icons, and scroll overflow buttons.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Badge" Color="Color.Warning" Size="Size.Large" />
                        <VekText Typo="Typo.body2">HeaderTemplate · Badges · Scroll</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Keyboard & Accessibility" Category="Tabs" Link="/components/tabs/keyboard-accessibility" Description="W3C APG tab pattern navigation: arrow keys, panel jumping, and closable tab shortcuts.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Keyboard" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Arrows · Home/End · APG</VekText>
                    </VekStack>
                </DocsExploreCard>
            </div>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
