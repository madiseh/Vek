@namespace Vek.Docs.Examples

<VekStack AlignItems="AlignItems.Center" Spacing="0" Class="vek-width-full">
    <VekSwitch T="bool" Value="@_notifications" ValueChanged="SaveNotificationsAsync"
               Disabled="@_saving" Label="Enable notifications" Color="Color.Primary" />
    <VekText role="status" Style="min-height: 1lh;">@(_saving ? "Saving preferences..." : string.Empty)</VekText>
</VekStack>

@code {
    private bool _notifications;
    private bool _saving;

    private async Task SaveNotificationsAsync(bool value)
    {
        var previous = _notifications;
        _notifications = value;
        _saving = true;

        try
        {
            // Replace this simulated save with your asynchronous persistence call.
            await Task.Delay(1000);
        }
        catch
        {
            _notifications = previous;
        }
        finally
        {
            _saving = false;
        }
    }
}
