@namespace Vek.Docs.Examples

<VekStack AlignItems="AlignItems.Center" Style="width:650px; height:450px">
    <VekDateRangePicker PickerVariant="@_variant" @bind-DateRange="@_dateRange" Margin="Margin.Dense" ShowAdjacentMonthDays="true" />
    <VekSpacer />
    <VekToggleGroup T="PickerVariant" SelectionMode="SelectionMode.SingleSelection" Value="@_variant" ValueChanged="@OnValueChanged" 
                    Color="Color.Primary" CheckMark="true" FixedContent="true">
        <VekToggleItem Value="@(PickerVariant.Inline)" Text="Inline" />
        <VekToggleItem Value="@(PickerVariant.Dialog)" Text="Dialog" />
        <VekToggleItem Value="@(PickerVariant.Static)" Text="Static" />
    </VekToggleGroup>
</VekStack>

@code {
    private PickerVariant _variant = PickerVariant.Static;
    private DateRange _dateRange { get; set; }

    private void OnValueChanged(PickerVariant variant)
    {
        _dateRange = null;
        _variant = variant;
    }
}
