@layout IframeLayout
@namespace Vek.Docs.Examples
@page "/iframe/docs/examples/appbar/bottom"

<VekLayout>
    <VekMainContent Class="pt-0">
        <VekList T="string">
            <VekListItem Text="App Bookmark Item 1" Icon="@Icons.Material.Filled.Bookmark" />
            <VekListItem Text="App Bookmark Item 2" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Primary" />
            <VekListItem Text="App Bookmark Item 3" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Secondary" />
            <VekListItem Text="App Bookmark Item 4" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Tertiary" />
            <VekListItem Text="App Bookmark Item 5" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Info" />
            <VekListItem Text="App Bookmark Item 6" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Success" />
            <VekListItem Text="App Bookmark Item 7" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Warning" />
            <VekListItem Text="App Bookmark Item 8" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Error" />
            <VekListItem Text="App Bookmark Item 9" Icon="@Icons.Material.Filled.Bookmark" IconColor="Color.Dark" />
        </VekList>
    </VekMainContent>
    <VekAppBar Bottom="true" Fixed="true" Color="Color.Primary" Elevation="1">
        <VekIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />
        <VekSpacer />
        <VekIconButton Icon="@Icons.Material.Filled.FavoriteBorder" Color="Color.Inherit" Edge="Edge.End" />
        <VekIconButton Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit" Edge="Edge.End" />
    </VekAppBar>
</VekLayout>


@code{
    bool open = false;

    void ToggleDrawer()
    {
        open = !open;
    }
}
