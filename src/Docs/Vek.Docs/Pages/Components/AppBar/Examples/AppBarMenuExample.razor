@namespace Vek.Docs.Examples

<VekAppBar Color="Color.Primary" Fixed="false">
    <VekMenu Dense
             Variant="Variant.Text"
             Size="Size.Medium"
             Color="Color.Inherit"
             Icon="@Icons.Material.TwoTone.MoreVert">

        <VekMenu StartIcon="@Icons.Material.TwoTone.Settings"
                 IconColor="Color.Primary"
                 Label="Settings">
            <VekMenuItem Icon="@Icons.Material.TwoTone.DarkMode"
                         IconColor="Color.Secondary"
                         Label="Dark Theme" />
        </VekMenu>

        <VekDivider />

        <VekMenuItem Href="/"
                     ForceLoad
                     Icon="@Icons.Material.TwoTone.Login"
                     IconColor="Color.Primary"
                     Label="Sign In" />

        <VekMenuItem Href="/"
                     ForceLoad
                     Icon="@Icons.Material.TwoTone.Logout"
                     IconColor="Color.Primary"
                     Label="Sign Out" />
    </VekMenu>

    <VekSpacer />

    <VekIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" />
</VekAppBar>