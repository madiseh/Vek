@namespace Vek.Docs.Examples

<VekAppBar Color="Color.Primary" Fixed="false" Dense="@dense" Elevation="@elevation">
    <VekIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" />
    <VekSpacer />
    <VekIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" />
</VekAppBar>

<VekGrid>
    <VekItem md="6" sm="12">
        <VekSlider @bind-Value="@elevation" Min="0" Max="24" ValueLabel="true">Elevation</VekSlider>
    </VekItem>
    <VekItem md="6" sm="12">
        <VekSwitch @bind-Value="@dense" Label="Dense" Class="mt-6" Color="Color.Primary"></VekSwitch>
    </VekItem>
</VekGrid>

@code
{
    int elevation = 4;
    bool dense = false;
}