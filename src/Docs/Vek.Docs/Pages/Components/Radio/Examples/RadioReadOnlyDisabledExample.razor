@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem sm="12" md="6">
        <VekRadioGroup @bind-Value="SelectedOption1" ReadOnly="ReadOnly">
            <VekRadio Value="@("Radio 1")">Radio 1</VekRadio>
            <VekRadio Value="@("Radio 2")">Radio 2</VekRadio>
            <VekRadio Value="@("Radio 3")">Radio 3</VekRadio>
            <VekRadio Value="@("Radio 4")">Radio 4</VekRadio>
        </VekRadioGroup>
        <VekSwitch @bind-Value="ReadOnly" Color="Color.Primary" Label="ReadOnly" />
        <VekText>Selected Option 1: @SelectedOption1</VekText>
    </VekItem>
    <VekItem sm="12" md="6">
        <VekRadioGroup @bind-Value="SelectedOption2" Disabled="Disabled">
            <VekRadio Value="@("Radio 1")">Radio 1</VekRadio>
            <VekRadio Value="@("Radio 2")">Radio 2</VekRadio>
            <VekRadio Value="@("Radio 3")">Radio 3</VekRadio>
            <VekRadio Value="@("Radio 4")">Radio 4</VekRadio>
        </VekRadioGroup>
        <VekSwitch @bind-Value="Disabled" Color="Color.Primary" Label="Disabled" />
        <VekText>Selected Option 2: @SelectedOption2</VekText>
    </VekItem>
</VekGrid>

@code {
    public string SelectedOption1 { get; set; }
    public string SelectedOption2 { get; set; }
    public bool Disabled { get; set; }
    public bool ReadOnly { get; set; }
}