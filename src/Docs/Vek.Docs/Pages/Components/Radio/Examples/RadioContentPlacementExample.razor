@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem xs="12" md="1">
        <VekRadioGroup @bind-Value="Placement">
            <VekRadio Color="Color.Primary" Value="@(Placement.Top)">Top</VekRadio>
            <VekRadio Color="Color.Primary" Value="@(Placement.Bottom)">Bottom</VekRadio>
            <VekRadio Color="Color.Primary" Value="@(Placement.Start)">Start</VekRadio>
            <VekRadio Color="Color.Primary" Value="@(Placement.End)">End</VekRadio>
            <VekRadio Color="Color.Primary" Value="@(Placement.Left)">Left</VekRadio>
            <VekRadio Color="Color.Primary" Value="@(Placement.Right)">Right</VekRadio>
        </VekRadioGroup>
    </VekItem>
    <VekItem xs="12" md="9" Class="d-flex justify-center align-center my-auto">
        <VekRadioGroup T="string">
            <VekRadio T="string" LabelPlacement="@Placement" Color="Color.Secondary">Content Placement</VekRadio>
        </VekRadioGroup>
    </VekItem>
    <VekItem xs="12" md="2" Style="width:100%"></VekItem>
</VekGrid>

@code {
    public Placement Placement { get; set; } = Placement.Right;
}