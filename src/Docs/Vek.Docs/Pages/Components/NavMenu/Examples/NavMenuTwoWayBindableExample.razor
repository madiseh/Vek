@namespace Vek.Docs.Examples

<VekPaper Width="250px" Class="py-3 mb-4" Elevation="0">
    <VekNavMenu>
        <VekNavGroup Title="Settings" @bind-Expanded=_expanded>
            <VekNavLink Href="/users">Users</VekNavLink>
            <VekNavLink Href="/security">Security</VekNavLink>
        </VekNavGroup>
    </VekNavMenu>
</VekPaper>

<VekText>
    The VekNavGroup is
    @if (_expanded)
    {
        <b class="vek-theme-tertiary rounded pa-2 ml-2">expanded</b>
    }
    else
    {
        <b class="vek-theme-error rounded pa-2 ml-2">collapsed</b>
    }
</VekText>

@code{
    bool _expanded = true;
}