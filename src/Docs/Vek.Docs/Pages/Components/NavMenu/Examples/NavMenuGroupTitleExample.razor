@namespace Vek.Docs.Examples

<VekPaper Width="250px" Class="py-3" Elevation="0">
    <VekNavMenu>
        <VekText Typo="Typo.h6" Class="px-4">My Application</VekText>
        <VekText Typo="Typo.body2" Class="px-4 vek-text-secondary">Secondary Text</VekText>
        <VekDivider Class="my-2" />
        <VekNavLink Href="/dashboard">Dashboard</VekNavLink>
        <VekNavLink Href="/servers">Servers</VekNavLink>
        <VekNavLink Href="/billing" Disabled="true">Billing</VekNavLink>
        <VekNavGroup Title="Settings" HeaderClass="settings-error" Expanded="true">
            <TitleContent>
                <VekBadge Icon="@Icons.Material.Filled.ErrorOutline" 
                          Color="Color.Error" 
                          Origin="@(RightToLeft ? Origin.CenterLeft : Origin.CenterRight)" 
                          BadgeClass="mx-2">
                    Settings
                </VekBadge>
            </TitleContent>
            <ChildContent>
                <VekNavLink Href="/users">Users</VekNavLink>
                <VekNavLink Href="/security">
                    <VekBadge Content="3" 
                              Color="Color.Error" 
                              Origin="@(RightToLeft ? Origin.CenterLeft : Origin.CenterRight)" 
                              BadgeClass="mx-2">
                        Security
                    </VekBadge>
                </VekNavLink>
            </ChildContent>
        </VekNavGroup>
        <VekNavLink Href="/about">About</VekNavLink>
    </VekNavMenu>
</VekPaper>

@code {
    [CascadingParameter(Name = "RightToLeft")] public bool RightToLeft { get; set; }
}

<style>    
    .settings-error {
        color: red;
    }
</style>
