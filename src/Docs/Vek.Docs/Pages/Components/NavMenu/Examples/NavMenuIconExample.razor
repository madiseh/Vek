@namespace Vek.Docs.Examples

<link href="https://use.fontawesome.com/releases/v5.14.0/css/all.css" rel="stylesheet">


<VekPaper Width="250px" Class="d-inline-flex py-3" Elevation="0">
    <VekNavMenu Class="vek-width-full">
        <VekText Typo="Typo.h6" Class="px-4">Material</VekText>
        <VekText Typo="Typo.body2" Class="px-4 vek-text-secondary">Icons</VekText>
        <VekDivider Class="my-2" />
        <VekNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</VekNavLink>
        <VekNavLink Href="/servers" Icon="@Icons.Material.Filled.Storage">Servers</VekNavLink>
        <VekNavLink Href="/billing" Icon="@Icons.Material.Filled.Receipt" Disabled="true">Billing</VekNavLink>
        <VekNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings" Expanded="true">
            <VekNavLink Href="/users" Icon="@Icons.Material.Filled.People" IconColor="Color.Success">Users</VekNavLink>
            <VekNavLink Href="/security" Icon="@Icons.Material.Filled.Security" IconColor="Color.Info">Security</VekNavLink>
        </VekNavGroup>
    </VekNavMenu>
</VekPaper>
<VekPaper Width="250px" Class="d-inline-flex py-3" Elevation="0">
    <VekNavMenu Class="vek-width-full">
        <VekText Typo="Typo.h6" Class="px-4">Font Awesome</VekText>
        <VekText Typo="Typo.body2" Class="px-4 vek-text-secondary">Icons</VekText>
        <VekDivider Class="my-2" />
        <VekNavLink Href="/dashboard" Icon="fas fa-chart-line">Dashboard</VekNavLink>
        <VekNavLink Href="/servers" Icon="fas fa-server">Servers</VekNavLink>
        <VekNavLink Href="/billing" Icon="fas fa-receipt" Disabled="true">Billing</VekNavLink>
        <VekNavGroup Title="Settings" Icon="fas fa-cogs" Expanded="true">
            <VekNavLink Href="/users" Icon="fas fa-users" IconColor="Color.Success">Users</VekNavLink>
            <VekNavLink Href="/security" Icon="fas fa-user-shield" IconColor="Color.Info">Security</VekNavLink>
        </VekNavGroup>
    </VekNavMenu>
</VekPaper>
