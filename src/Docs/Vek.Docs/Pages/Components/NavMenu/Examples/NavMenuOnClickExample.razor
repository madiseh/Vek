@namespace Vek.Docs.Examples
@inject ISnackbar Snackbar

<VekPaper Width="250px" Class="py-3" Elevation="0">
    <VekNavMenu Dense>
        <VekNavGroup Title="Settings" Expanded="true">
            <VekNavLink OnClick="@(() => GoTo("Settings/Users"))">Users</VekNavLink>
            <VekNavLink OnClick="@(() => GoTo("Settings/Security"))">Security</VekNavLink>
        </VekNavGroup>
        <VekNavLink OnClick="@(() => GoTo("About"))">About</VekNavLink>
    </VekNavMenu>
</VekPaper>

@code {
    private void GoTo(string page) => Snackbar.Add($"Clicked {page}");
}