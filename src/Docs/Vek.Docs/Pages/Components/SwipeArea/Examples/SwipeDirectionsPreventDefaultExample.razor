@namespace Vek.Docs.Examples

<VekSwipeArea @ref="_swipeArea" OnSwipeEnd="HandleSwipeEnd" Style="width: 100%; height: 300px; background-color:var(--vek-palette-surface)" Sensitivity="_sensitivity" PreventDefault="@_preventDefault">
    <VekText Style="user-select: none;" Typo="@Typo.body1">@($"{_swipeDirection} - Swiped: {_swipeDelta}px")</VekText>
</VekSwipeArea>
<VekSwitch @bind-Value="_preventDefault" Color="Color.Primary">Prevent Default</VekSwitch>
<VekNumericField @bind-Value="_sensitivity" Label="Sensitivity" Min="0" />

@code {
    private VekSwipeArea _swipeArea;
    private SwipeDirection _swipeDirection;
    private bool _preventDefault = true;
    private int _sensitivity = 100;
    private double? _swipeDelta;

    private void HandleSwipeEnd(SwipeEventArgs args)
    {
        _swipeDirection = args.SwipeDirection;
        _swipeDelta = args.SwipeDelta;
    }
}
