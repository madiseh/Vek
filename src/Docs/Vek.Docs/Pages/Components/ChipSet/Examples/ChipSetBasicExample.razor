@namespace Vek.Docs.Examples

<VekChipSet T="Color" @bind-SelectedValue="SelectedColor" CheckMark SelectionMode="@SelectionMode">
    <VekChip Text="purple" Color="Color.Primary" Value="@Color.Primary">Primary</VekChip>
    <VekChip Text="pink" Color="Color.Secondary" Value="@Color.Secondary">Secondary</VekChip>
    <VekChip Text="blue" Color="Color.Info" Value="@Color.Info">Info</VekChip>
    <VekChip Text="green" Color="Color.Success" Value="@Color.Success">Success</VekChip>
    <VekChip Text="orange" Color="Color.Warning" Value="@Color.Warning">Warning</VekChip>
    <VekChip Text="red" Color="Color.Error" Value="@Color.Error">Error</VekChip>
    <VekChip Text="black" Color="Color.Dark" Value="@Color.Dark">Dark</VekChip>
</VekChipSet>

<div class="d-flex flex-column align-center">
    @if (SelectedColor != default) {
        <VekText>You selected the <VekText Color="@SelectedColor" Inline>@SelectedColor.ToStringFast(true)</VekText> chip.</VekText>
    }
    else {
        <VekText>Nothing selected.</VekText>
    }
    <VekRadioGroup @bind-Value="SelectionMode">
        <VekRadio Value="@SelectionMode.SingleSelection" Color="Color.Primary">SingleSelection</VekRadio>
        <VekRadio Value="@SelectionMode.ToggleSelection" Color="Color.Primary">ToggleSelection</VekRadio>
    </VekRadioGroup>
</div>

@code
{
    public SelectionMode SelectionMode = SelectionMode.SingleSelection;
    public Color SelectedColor;
}

