@namespace Vek.Docs.Examples

<VekChipSet @bind-SelectedValues="_selected" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark" Variant="Variant.Text" Color="Color.Info">
    <VekChip Value="@("Milk")" />
    <VekChip Value="@("Eggs")" />
    <VekChip Value="@("Soap")" />
    <VekChip Value="@("Corn flakes")" />
    <VekChip Value="@("Salad")" />
    <VekChip Value="@("Apples")" />
    <VekChip Value="@("Red wine")" />
</VekChipSet>

<div class="d-flex flex-column align-center">
    @if (_selected is { Count: > 0 }) {
        <VekText>You selected @string.Join(", ", _selected.OrderBy(x => x))</VekText>
    }
    else {
        <VekText>Nothing selected.</VekText>
    }
    <VekCheckBox @bind-Value="_checkMark">Check marks</VekCheckBox>
</div>

@code
{
    private bool _checkMark = true;
    private IReadOnlyCollection<string> _selected;
}

