@namespace Vek.Docs.Examples

<VekChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <VekChip Text="gray" Variant="Variant.Text" Color="Color.Default">Default</VekChip>
    <VekChip Text="purple" Variant="Variant.Text" Color="Color.Primary">Primary</VekChip>
    <VekChip Text="pink" Variant="Variant.Text" Color="Color.Secondary">Secondary</VekChip>
    <VekChip Text="blue" Variant="Variant.Text" Color="Color.Info">Info</VekChip>
    <VekChip Text="green" Variant="Variant.Text" Color="Color.Success">Success</VekChip>
    <VekChip Text="orange" Variant="Variant.Text" Color="Color.Warning">Warning</VekChip>
    <VekChip Text="red" Variant="Variant.Text" Color="Color.Error">Error</VekChip>
    <VekChip Text="black" Variant="Variant.Text" Color="Color.Dark">Dark</VekChip>
</VekChipSet>
<VekChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <VekChip Text="gray" Variant="Variant.Outlined" Color="Color.Default">Default</VekChip>
    <VekChip Text="purple" Variant="Variant.Outlined" Color="Color.Primary">Primary</VekChip>
    <VekChip Text="pink" Variant="Variant.Outlined" Color="Color.Secondary">Secondary</VekChip>
    <VekChip Text="blue" Variant="Variant.Outlined" Color="Color.Info">Info</VekChip>
    <VekChip Text="green" Variant="Variant.Outlined" Color="Color.Success">Success</VekChip>
    <VekChip Text="orange" Variant="Variant.Outlined" Color="Color.Warning">Warning</VekChip>
    <VekChip Text="red" Variant="Variant.Outlined" Color="Color.Error">Error</VekChip>
    <VekChip Text="black" Variant="Variant.Outlined" Color="Color.Dark">Dark</VekChip>
</VekChipSet>
<VekChipSet T="string" SelectionMode="SelectionMode.MultiSelection" CheckMark="_checkMark">
    <VekChip Text="gray" Variant="Variant.Filled" Color="Color.Default">Default</VekChip>
    <VekChip Text="purple" Variant="Variant.Filled" Color="Color.Primary">Primary</VekChip>
    <VekChip Text="pink" Variant="Variant.Filled" Color="Color.Secondary">Secondary</VekChip>
    <VekChip Text="blue" Variant="Variant.Filled" Color="Color.Info">Info</VekChip>
    <VekChip Text="green" Variant="Variant.Filled" Color="Color.Success">Success</VekChip>
    <VekChip Text="orange" Variant="Variant.Filled" Color="Color.Warning">Warning</VekChip>
    <VekChip Text="red" Variant="Variant.Filled" Color="Color.Error">Error</VekChip>
    <VekChip Text="black" Variant="Variant.Filled" Color="Color.Dark">Dark</VekChip>
</VekChipSet>
<VekCheckBox @bind-Value="_checkMark">Check marks</VekCheckBox>


@code
{
    private bool _checkMark = true;
}

