@namespace Vek.Docs.Examples
<VekChipSet T="string" AllClosable OnClose="Closed">
    @foreach (var value in _values)
    {
        <VekChip Text="@value"></VekChip>
    }
</VekChipSet>

<div class="d-flex flex-column align-center">
    <VekButton StartIcon="@Icons.Material.Filled.Add" OnClick="Add">Add chip</VekButton>
</div>


@code
{
    private int _i = 1;
    private List<string> _values = new();
    public void Add() => _values.Add("Value " + (_i++));
    public void Closed(VekChip<string> chip) => _values.Remove(chip.Text);
}

