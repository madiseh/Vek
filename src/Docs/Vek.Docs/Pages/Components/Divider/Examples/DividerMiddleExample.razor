@namespace Vek.Docs.Examples

<VekCard>
    <VekCardHeader>
        <CardHeaderContent>
            <VekText Typo="Typo.h5">Uranium-235</VekText>
        </CardHeaderContent>
    </VekCardHeader>
    <VekCardContent>
        <VekText>This is the type of uranium used in the RBMK reactors.</VekText>
        <VekDivider DividerType="DividerType.Middle" Class="my-6"/>
        <VekText GutterBottom="true">Select Reactor Type</VekText>
        <VekChip T="string" Color="Color.Secondary">RBMK-1000</VekChip><VekChip T="string">RBMK-1500</VekChip><VekChip T="string">RBMKP-2400</VekChip>
    </VekCardContent>
    <VekCardActions>
        <VekButton Variant="Variant.Text" Color="Color.Primary">Read more</VekButton>
    </VekCardActions>
</VekCard>