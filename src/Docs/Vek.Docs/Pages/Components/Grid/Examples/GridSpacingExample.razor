    <VekItem>
        <VekPaper Height="140px" Width="140px"/>
    </VekItem>
    <VekItem>
        <VekPaper Height="140px" Width="140px"/>
    </VekItem>
    <VekItem>
        <VekPaper Height="140px" Width="140px" />
