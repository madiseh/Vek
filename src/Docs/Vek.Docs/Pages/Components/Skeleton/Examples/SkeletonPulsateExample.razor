
@namespace Vek.Docs.Examples


<VekCard>
    <VekSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px"/>
    <VekCardContent>
        <VekSkeleton Width="30%" Height="42px;" />
        <VekSkeleton Width="80%" />
        <VekSkeleton Width="100%" />
    </VekCardContent>
    <VekCardActions>
        <VekSkeleton Width="64px" Height="40px" Class="ml-2" />
        <VekSkeleton Width="105px" Height="40px" Class="ml-3" />
    </VekCardActions>
</VekCard>

<VekCard>
    <VekCardMedia Image="images/door.jpg" Height="200" />
    <VekCardContent>
        <VekText Typo="Typo.h5">Old Paint</VekText>
        <VekText Typo="Typo.body2">Old paint found on a stone house door.</VekText>
        <VekText Typo="Typo.body2">This photo was taken in a small village in Istra Croatia.</VekText>
    </VekCardContent>
    <VekCardActions>
        <VekButton Variant="Variant.Text" Color="Color.Primary">Share</VekButton>
        <VekButton Variant="Variant.Text" Color="Color.Primary">Learn more</VekButton>
    </VekCardActions>
</VekCard>