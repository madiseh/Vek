@namespace Vek.Docs.Examples

<VekCard Class="pa-4" Style="max-width: 420px">
    <VekCardHeader>
        <CardHeaderAvatar>
            <VekSkeleton SkeletonType="SkeletonType.Circle" Animation="Animation.Shimmer" Width="48px" Height="48px" aria-label="Loading profile photo" />
        </CardHeaderAvatar>
        <CardHeaderContent>
            <VekSkeleton Animation="Animation.Shimmer" Width="58%" aria-label="Loading profile name" />
            <VekSkeleton Animation="Animation.Shimmer" Width="36%" aria-label="Loading profile details" />
        </CardHeaderContent>
    </VekCardHeader>
    <VekSkeleton SkeletonType="SkeletonType.Card" Animation="Animation.Shimmer" Height="180px" BorderRadius="12px" aria-label="Loading profile image" />
    <VekCardContent>
        <VekSkeleton Animation="Animation.Shimmer" Width="94%" aria-label="Loading profile summary" />
        <VekSkeleton Animation="Animation.Shimmer" Width="72%" aria-label="Loading profile summary" />
    </VekCardContent>
</VekCard>
