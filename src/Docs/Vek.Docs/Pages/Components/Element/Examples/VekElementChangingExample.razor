@namespace Vek.Docs.Examples

<VekElement HtmlTag="@htmlTag"
            Class="reset-style"
            href="https://github.com/madiseh/vek"
            value="@($"The underlying tag is '{htmlTag}'")">
    The underlying tag is '@htmlTag'
</VekElement>

<VekButton OnClick="ChangeTag" Variant="Variant.Filled" Color="Color.Secondary">Change tag</VekButton>

@code{
    private string htmlTag = "a";
    private string[] tags = new[] { "a", "button", "input" };
    private int index = 0;

    private void ChangeTag()
    {
        index = (index + 1) % tags.Length;
        htmlTag = tags[index];
    }
}

<style>
    .reset-style, .reset-style * {
        all: revert;
    }
</style>