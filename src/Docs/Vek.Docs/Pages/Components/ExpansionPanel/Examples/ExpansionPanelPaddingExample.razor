@namespace Vek.Docs.Examples


<VekText Typo="Typo.h6" Class="mb-4">Default Gutters (Gutters="true")</VekText>
<VekExpansionPanels Class="mb-6">
    <VekExpansionPanel Text="Panel with Gutters" Gutters="true">
        <VekText>Both header and content have 24px horizontal padding (gutters).</VekText>
        <VekText>This is the default behavior when Gutters is not specified.</VekText>
    </VekExpansionPanel>
</VekExpansionPanels>

<VekText Typo="Typo.h6" Class="mb-4">No Gutters (Gutters="false")</VekText>
<VekExpansionPanels Class="mb-6">
    <VekExpansionPanel Text="Panel without Gutters" Gutters="false">
        <VekText>Both header and content have no horizontal padding.</VekText>
        <VekText>Notice how the text aligns to the left edge.</VekText>
    </VekExpansionPanel>
</VekExpansionPanels>

<VekText Typo="Typo.h6" Class="mb-4">Dense Panels</VekText>
<VekExpansionPanels Class="mb-6">
    <VekExpansionPanel Text="Dense with Gutters" Dense Gutters>
        Dense removes vertical padding from content while keeping horizontal gutters.
    </VekExpansionPanel>
    <VekExpansionPanel Text="Dense without Gutters" Dense Gutters="false">
        Dense with no gutters - minimal padding on all sides.
    </VekExpansionPanel>
</VekExpansionPanels>

<VekText Typo="Typo.h6" Class="mb-4">Parent Controls Gutters</VekText>
<VekExpansionPanels Dense Gutters="false">
    <VekExpansionPanel Text="Gutters inherited from parent">
        When the parent VekExpansionPanels has Gutters="false", all child panels inherit this setting.
    </VekExpansionPanel>
</VekExpansionPanels>