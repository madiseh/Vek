@namespace Vek.Docs.Examples

<label for="expand-mode">Accordion mode</label>
<select id="expand-mode" @bind="_expandMode">
    <option value="@AccordionExpandMode.Single">Keep one panel open</option>
    <option value="@AccordionExpandMode.SingleOrNone">Allow all panels closed</option>
    <option value="@AccordionExpandMode.Multiple">Allow multiple panels open</option>
</select>

<VekExpansionPanels ExpandMode="_expandMode">
    <VekExpansionPanel Text="Profile" IconPosition="AccordionExpandIconPosition.Start">
        Update your name, contact details, and preferred language.
    </VekExpansionPanel>
    <VekExpansionPanel Text="Notifications">
        Choose which account and product updates you want to receive.
    </VekExpansionPanel>
    <VekExpansionPanel Text="Security">
        Review your sign-in methods and recent account activity.
    </VekExpansionPanel>
</VekExpansionPanels>

@code {
    private AccordionExpandMode _expandMode = AccordionExpandMode.SingleOrNone;
}
