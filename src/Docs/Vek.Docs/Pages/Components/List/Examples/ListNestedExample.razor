@namespace Vek.Docs.Examples


<VekPaper Width="300px">
    <VekList T="string">
        <VekListSubheader>
            Nested List Items
        </VekListSubheader>
        <VekListItem Icon="@Icons.Material.Filled.Inbox" Text="Inbox" Expanded>
            <NestedList>
                <VekListItem Icon="@Icons.Material.Filled.StarRate">
                    Starred
                </VekListItem>
                <VekListItem Icon="@Icons.Material.Filled.WatchLater">
                    Snoozed
                </VekListItem>
            </NestedList>
        </VekListItem>
        <VekListItem Icon="@Icons.Material.Filled.Send" Text="Sent mail" @bind-Expanded="_expanded">
            <NestedList>
                <VekListItem>Re: Meeting tomorrow</VekListItem>
                <VekListItem>Fwd: JavaScript memes xD</VekListItem>
            </NestedList>
        </VekListItem>
        <VekListItem Icon="@Icons.Material.Filled.Drafts">
            Drafts
        </VekListItem>
        <VekDivider/>
        <VekListSubheader Class="mb-n3">
            <VekSwitch Color="Color.Primary" @bind-Value="_expanded">"Sent mail" Expansion</VekSwitch>
        </VekListSubheader>
    </VekList>
</VekPaper>

@code {
    bool _expanded;
}