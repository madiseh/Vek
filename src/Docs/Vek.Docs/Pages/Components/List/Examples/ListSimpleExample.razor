        <VekListItem Text="Inbox" Icon="@Icons.Material.Filled.Inbox" />
        <VekListItem Text="Sent" Icon="@Icons.Material.Filled.Send" />
        <VekListItem Text="Drafts" Disabled="true" IconColor="Color.Info" Icon="@Icons.Material.Filled.Drafts" />
