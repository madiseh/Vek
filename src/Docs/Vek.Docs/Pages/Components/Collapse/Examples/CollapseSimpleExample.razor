@namespace Vek.Docs.Examples

<VekPaper Class="pa-4">
    <VekStack Spacing="2">
        <VekButton OnClick="OnExpandCollapseClick">@(_expanded ? "Collapse" : "Expand")</VekButton>
        <VekDivider />
        <VekCollapse Expanded="_expanded">
                This content is collapsible.
        </VekCollapse>
    </VekStack>
</VekPaper>

@code {
    bool _expanded = true;

    private void OnExpandCollapseClick() {
        _expanded = !_expanded;
    }
}
