@namespace Vek.Docs.Examples

<VekDatePicker @bind-Date="_selectedDate"
               PickerVariant="PickerVariant.Static"
               StartMonth="new DateTime(2026, 11, 1)"
               IsDateDisabledFunc="IsWeekend">
    <DayCellTemplate Context="day">
        <span class="vek-typography vek-typography-body2 vek-inherit-text">@day.Day</span>
        @if (day.IsDisabled)
        {
            <span class="ml-1" aria-hidden="true">·</span>
        }
    </DayCellTemplate>
</VekDatePicker>

<VekText Typo="Typo.caption" Class="mt-2">
    Selected date: @(_selectedDate?.ToString("D") ?? "none")
</VekText>

@code {
    private DateTime? _selectedDate = new(2026, 11, 19);

    private static bool IsWeekend(DateTime date)
    {
        return date.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;
    }
}
