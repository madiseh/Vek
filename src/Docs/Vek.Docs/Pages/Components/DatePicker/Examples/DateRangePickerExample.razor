@namespace Vek.Docs.Examples

<VekStack Spacing="4">
    <VekDateRangePicker Label="Dual calendar with presets"
                        PickerVariant="PickerVariant.Static"
                        ShowPresets="true"
                        AutoSwapDates="true"
                        @bind-DateRange="_presetRange" />

    <VekPaper Class="pa-4" Outlined="true">
        <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <VekText Typo="Typo.subtitle2">Selected Date Range:</VekText>
            <VekChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                Start: @(_presetRange.Start?.ToString("yyyy-MM-dd") ?? "None")
            </VekChip>
            <VekText Typo="Typo.body2">→</VekText>
            <VekChip T="string" Color="Color.Secondary" Variant="Variant.Filled">
                End: @(_presetRange.End?.ToString("yyyy-MM-dd") ?? "None")
            </VekChip>
        </VekStack>
    </VekPaper>

    <VekDateRangePicker Label="Dropdown range picker with quick presets"
                        ShowPresets="true"
                        Clearable="true"
                        @bind-DateRange="_dropdownRange"
                        HelperText="Select preset or choose start and end dates directly" />
</VekStack>

@code {
    private DateRange _presetRange = new(DateTime.Today.AddDays(-6), DateTime.Today);
    private DateRange _dropdownRange = new(DateTime.Today, DateTime.Today.AddDays(14));
}
