@namespace Vek.Docs.Examples

<VekDatePicker @ref="_picker" @bind-Date="_date" PickerVariant="PickerVariant.Static" MaxDate="_maxDate">
    <PickerActions>
        <VekButton Class="mr-auto align-self-start" OnClick="TodayAsync">Today</VekButton>
    </PickerActions>
</VekDatePicker>

<div class="d-flex flex-column gap-4">
    <VekButton Color="Color.Primary" Variant="Variant.Filled" OnClick="CurrentDate">Move To Current Date</VekButton>
    <VekButton Color="Color.Primary" Variant="Variant.Filled" OnClick="VekReleaseAsync">When First Vek Released?</VekButton>
    <VekButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GoMaxDateWithoutSubmitAsync">Go To Max Date Without Submit</VekButton>
</div>

@code {
    private VekDatePicker _picker;
    private DateTime? _date = DateTime.Today.AddDays(210);
    private DateTime _maxDate = new DateTime(2050, 12, 31);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _picker.GoToDate();
        }
    }

    private Task TodayAsync()
    {
        return _picker.GoToDate(DateTime.Today);
    }

    private Task CurrentDate()
    {
        return _picker.GoToDate(DateTime.Today);
    }

    private Task VekReleaseAsync()
    {
        return _picker.GoToDate(new DateTime(2020, 10, 18));
    }

    private Task GoMaxDateWithoutSubmitAsync()
    {
        return _picker.GoToDate(_maxDate, false);
    }
}
