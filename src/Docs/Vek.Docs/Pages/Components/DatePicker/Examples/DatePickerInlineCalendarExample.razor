@namespace Vek.Docs.Examples

<VekStack Spacing="6">
    <VekGrid>
        <VekItem xs="12" md="6">
            <VekStack Spacing="3">
                <VekText Typo="Typo.subtitle1"><b>Single Date Selection &amp; Week Numbers</b></VekText>
                <VekCalendar @bind-Date="_selectedDate"
                             ShowWeekNumbers="true"
                             ShowTodayButton="true"
                             Elevation="2"
                             Color="Color.Primary" />

                <VekPaper Class="pa-3" Outlined="true">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekText Typo="Typo.body2">Selected Date:</VekText>
                        <VekChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                            @(_selectedDate?.ToString("yyyy-MM-dd") ?? "None")
                        </VekChip>
                    </VekStack>
                </VekPaper>
            </VekStack>
        </VekItem>

        <VekItem xs="12" md="6">
            <VekStack Spacing="3">
                <VekText Typo="Typo.subtitle1"><b>Multiple Dates Selection</b></VekText>
                <VekCalendar MultiSelection="true"
                             @bind-SelectedDates="_selectedDates"
                             ShowTodayButton="true"
                             Elevation="2"
                             Color="Color.Secondary" />

                <VekPaper Class="pa-3" Outlined="true">
                    <VekStack Spacing="2">
                        <VekText Typo="Typo.body2">Selected Dates (@(_selectedDates?.Count ?? 0)):</VekText>
                        <VekStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            @if (_selectedDates != null && _selectedDates.Count > 0)
                            {
                                @foreach (var d in _selectedDates)
                                {
                                    <VekChip T="string" Size="Size.Small" Color="Color.Secondary">
                                        @d.ToString("MM/dd")
                                    </VekChip>
                                }
                            }
                            else
                            {
                                <VekText Typo="Typo.caption" Color="Color.Default">No dates selected</VekText>
                            }
                        </VekStack>
                    </VekStack>
                </VekPaper>
            </VekStack>
        </VekItem>
    </VekGrid>
</VekStack>

@code {
    private DateTime? _selectedDate = DateTime.Today.AddDays(2);
    private IReadOnlyCollection<DateTime> _selectedDates = new List<DateTime>
    {
        DateTime.Today.AddDays(-2),
        DateTime.Today,
        DateTime.Today.AddDays(3),
        DateTime.Today.AddDays(5)
    }.AsReadOnly();
}
