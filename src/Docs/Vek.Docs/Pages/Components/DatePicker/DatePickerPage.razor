@page "/components/datepicker"

<DocsPage>
    <DocsPageHeader Title="Date Picker" Component="@nameof(VekDatePicker)">
        <Description>
            Choose one date for a form, milestone, or reminder. Start with the examples below, then explore focused guides for typing, availability, calendar navigation, display, and culture.
        </Description>
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Choose a project milestone">
                <Description>
                    Bind the selected date to a nullable <CodeInline>DateTime?</CodeInline> field and show the current selection beside the picker.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DatePickerBasicUsageExample)" ShowCode="false" Block="true">
                <DatePickerBasicUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Keep a reminder date optional">
                <Description>
                    A nullable date can stay empty until the user needs it. The picker and the bound value remain in sync when a date is chosen.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DatePickerOptionalDateExample)" ShowCode="false" Block="true">
                <DatePickerOptionalDateExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Explore Features">
                <Description>Browse specific features and usage patterns in detail:</Description>
            </SectionHeader>
            <div class="vek-bento-grid mt-4">
                <DocsExploreCard Title="Type a Date" Category="Date Picker" Link="/components/datepicker/typed-input" Description="Accept a date from the calendar or let people enter it with a mask and text parsing.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.EditCalendar" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">DD / MM / YYYY</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Control Available Dates" Category="Date Picker" Link="/components/datepicker/availability" Description="Disable unavailable days, mark important dates, or add useful details to a day cell.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Unavailable dates</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Navigate Calendar Views" Category="Date Picker" Link="/components/datepicker/calendar-navigation" Description="Move between dates, switch calendar views, or open directly to a useful period.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Day / Month / Year</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Choose a Calendar Display" Category="Date Picker" Link="/components/datepicker/display-modes" Description="Place a calendar in a page, show it as a dialog, or tune its visual presentation.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.CalendarViewMonth" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Inline / Dialog</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Format Dates for a Culture" Category="Date Picker" Link="/components/datepicker/culture-formatting" Description="Use culture-specific month names, calendars, and date formats in your app.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Language" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Culture-aware dates</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Keyboard & Accessibility" Category="Date Picker" Link="/components/datepicker/keyboard-accessibility" Description="Learn keyboard shortcuts for moving through calendar views and selecting dates.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Keyboard" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Arrow keys · Enter · Escape</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Select a Date Range" Category="Date Picker" Link="/components/daterangepicker" Description="Choose a start and end date with a dual-calendar picker, presets, and range limits.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.DateRange" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Start to end</VekText>
                    </VekStack>
                </DocsExploreCard>
            </div>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
