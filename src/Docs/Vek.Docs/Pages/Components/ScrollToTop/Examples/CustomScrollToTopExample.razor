@namespace Vek.Docs.Examples

<div id="another_unique_identifier" class="ma-0" style="height:300px;overflow: auto;">
    <VekPaper Elevation="0" Height="3500px" Class="d-flex flex-column justify-space-between py-6">
        <VekText Typo="Typo.h3" Align="Align.Center">Scroll inside this container</VekText>
        <VekText Typo="Typo.h3" Align="Align.Center">Some initial long text</VekText>
        <VekText Typo="Typo.h3" Align="Align.Center">Middle text</VekText>
        <VekText Typo="Typo.h3" Align="Align.Center">Bottom text</VekText>
        <VekScrollToTop TopOffset="100" 
                        Selector="#another_unique_identifier"
                        VisibleCssClass="visible absolute"
                        HiddenCssClass="hidden absolute">
            <div class="vek-theme-secondary px-3 py-6 vek-elevation-16 rounded-xl" style="bottom:20px;left:20px;">Scroll to top custom button</div>
        </VekScrollToTop>
    </VekPaper>
</div>
