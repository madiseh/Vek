@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekTable Items="@GetElements()">
    <ToolBarContent>
        <VekText Typo="Typo.h6">Periodic Elements</VekText>
        <VekSpacer />
        <VekTextField @bind-Value="_searchTerm" Placeholder="Search" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true"></VekTextField>
    </ToolBarContent>

    <HeaderContent>
        <VekTh>Name</VekTh>
    </HeaderContent>

    <RowTemplate>
        <VekTd DataLabel="Name">
            <VekHighlighter Text="@context.Name" HighlightedText="@_searchTerm" />
        </VekTd>
    </RowTemplate>
</VekTable>

@code {
    private string _searchTerm = "H";
    private IEnumerable<Element> _elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        _elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }

    private IEnumerable<Element> GetElements() => _elements.Where(e => e.Name.Contains(_searchTerm));
}