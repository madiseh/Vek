@namespace Vek.Docs.Examples

<VekStack Spacing="4">
    <VekText Typo="Typo.subtitle2">Price range: $@_start to $@_end</VekText>
    <VekRangeSlider T="int"
                    Min="0"
                    Max="100"
                    Step="5"
                    @bind-ValueStart="_start"
                    @bind-ValueEnd="_end"
                    Color="Color.Primary"
                    ValueLabel="true" />

    <VekText Typo="Typo.subtitle2">With MinDistance (minimum gap of 15): @_range.Start - @_range.End</VekText>
    <VekRangeSlider T="int"
                    Min="0"
                    Max="100"
                    MinDistance="15"
                    @bind-Value="_range"
                    Color="Color.Secondary"
                    ValueLabel="true" />
</VekStack>

@code {
    private int _start = 20;
    private int _end = 75;
    private SliderRange<int> _range = new(10, 60);
}
