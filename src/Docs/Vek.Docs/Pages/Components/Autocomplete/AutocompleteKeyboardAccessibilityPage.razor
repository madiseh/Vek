@page "/components/autocomplete/keyboard-accessibility"

<DocsPage>
    <DocsPageHeader Title="Autocomplete - Keyboard & Accessibility" Component="@nameof(VekAutocomplete<T>)">
        <Description>Navigate dropdown suggestions, select options, and dismiss popovers using APG combobox keyboard patterns.</Description>
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Try Keyboard Navigation">
                <Description>
                    Focus the input below and press <CodeInline>ArrowDown</CodeInline> to open suggestions. Use <CodeInline>ArrowUp</CodeInline> and <CodeInline>ArrowDown</CodeInline> to navigate, press <CodeInline>Enter</CodeInline> to select, or press <CodeInline>Escape</CodeInline> to dismiss.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteUsageExample)">
                <AutocompleteUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Keyboard Shortcuts">
                <Description>
                    VekAutocomplete implements the W3C APG combobox pattern with the following keyboard navigation keys:
                </Description>
            </SectionHeader>
            <SectionContent>
                <VekSimpleTable Outlined="true" Hover="true">
                    <thead>
                    <tr>
                        <th>Key</th>
                        <th>Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    <tr><td><CodeInline>ArrowDown</CodeInline> / <CodeInline>Enter</CodeInline></td><td>Opens the dropdown suggestions or moves focus to the next item.</td></tr>
                    <tr><td><CodeInline>ArrowUp</CodeInline></td><td>Moves focus to the previous suggestion item.</td></tr>
                    <tr><td><CodeInline>Enter</CodeInline> / <CodeInline>NumpadEnter</CodeInline></td><td>Selects the focused suggestion item into the input.</td></tr>
                    <tr><td><CodeInline>Escape</CodeInline> / <CodeInline>Alt + ArrowUp</CodeInline></td><td>Closes the dropdown popover.</td></tr>
                    </tbody>
                </VekSimpleTable>
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
