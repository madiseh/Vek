@page "/components/autocomplete"

<DocsPage>
    <DocsPageHeader Title="Autocomplete" Component="@nameof(VekAutocomplete<T>)" />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Usage">
                <Description>
                    How you write the search function determines whether or not the Autocomplete shows a full list initially. By setting <CodeInline>ResetValueOnEmptyText="true"</CodeInline>,
                    the <CodeInline>Value</CodeInline> will be reset when the user clears the input text. With <CodeInline>CoerceText="true"</CodeInline> upon selection of an entry from the list,
                    the <CodeInline>Text</CodeInline> is always updated. When the user types something that is not on the list and <CodeInline>CoerceValue</CodeInline> is true,
                    the <CodeInline>Value</CodeInline> will be overwritten with the user input which allows it to be passed to the validation function.
                </Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompleteUsageExample)">
                <AutocompleteUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Visual Playground">
                <Description>Experiment interactively with autocomplete parameters and display modes.</Description>
            </SectionHeader>
            <SectionContent ShowCode="false" Code="@nameof(AutocompletePlaygroundExample)">
                <AutocompletePlaygroundExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Explore Features">
                <Description>Browse specific features and usage patterns in detail:</Description>
            </SectionHeader>
            <div class="docs-explore-grid">
                <DocsExploreCard Title="Templates & Presentation" Category="Autocomplete" Link="/components/autocomplete/templates-presentation" Description="Custom item render fragments, selected templates, no-items fallbacks, and before/after slot content.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.DashboardCustomize" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">ItemTemplate · Slots · Fallback</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Async Search & Virtualization" Category="Autocomplete" Link="/components/autocomplete/async-search-virtualization" Description="Progress indicators, cancellation token race prevention, and virtualized high-volume lists.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.CloudSync" Color="Color.Info" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Async · Virtualize · Tokens</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Validation & Coercion" Category="Autocomplete" Link="/components/autocomplete/validation-coercion" Description="VekForm validation integration, strict mode selection, and custom value coercion.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Form Validation · CoerceValue</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Keyboard & Accessibility" Category="Autocomplete" Link="/components/autocomplete/keyboard-accessibility" Description="W3C APG combobox keyboard pattern: arrow keys, popup selection, and escape closing.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Keyboard" Color="Color.Warning" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Arrows · Enter · Escape · APG</VekText>
                    </VekStack>
                </DocsExploreCard>
            </div>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
