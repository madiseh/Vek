@page "/components/splitpanel"

<DocsPage>
    <DocsPageHeader Title="Split Panel" Component="@nameof(VekSplitPanel)" />
    <DocsPageContent>
        <DocsPageSection>
            <SectionHeader Title="Basic Usage" />
            <SectionContent Code="@nameof(SplitPanelBasicExample)" DarkenBackground="true">
                <SplitPanelBasicExample/>
            </SectionContent>
        </DocsPageSection>
        <DocsPageSection>
            <SectionHeader Title="Resize and collapse panes">
                <Description>
                    Drag the splitter or focus it and use the arrow keys. Double-click the bar to collapse and restore the first pane.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SplitPanelResizableExample)" DarkenBackground="true">
                <SplitPanelResizableExample />
            </SectionContent>
        </DocsPageSection>
        <DocsPageSection>
            <SectionHeader Title="Overlay">
                <Description>
                    Note that the background of a panel automatically becomes transparent if no content was added.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SplitPanelOverlayExample)" DarkenBackground="true">
                <SplitPanelOverlayExample/>
            </SectionContent>
        </DocsPageSection>
        <DocsPageSection>
            <SectionHeader Title="Nest horizontal and vertical panes">
                <Description>
                    Split a vertical pane again horizontally to build a compact workbench. Each divider resizes independently; focus a divider and use its arrow keys for precise adjustments.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(SplitPanelInsideSplitPanelExample)" DarkenBackground="true">
                <SplitPanelInsideSplitPanelExample/>
            </SectionContent>
        </DocsPageSection>
        <DocsPageSection>
            <SectionHeader Title="Functions"/>
            <SectionContent Code="@nameof(SplitPanelFunctionsExample)" DarkenBackground="true">
                <SplitPanelFunctionsExample/>
            </SectionContent>
        </DocsPageSection>
    </DocsPageContent>
</DocsPage>
