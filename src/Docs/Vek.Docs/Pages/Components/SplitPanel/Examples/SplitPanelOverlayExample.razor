@namespace Vek.Docs.Examples

<VekPaper Class="vek-width-full vek-height-full relative">
    <VekSplitPanel Class="vek-height-full"
                   UseAsOverlay="true"
                   Elevation="8"
                   FirstPanelInitialSize="150"
                   MinPanelSize="150"
                   Padding="4"
                   Rounded="true">
        <FirstPanel>
            <div style="display: grid; grid-template-rows: auto 1fr;" class="vek-height-full">
                <VekText Typo="Typo.h6">Toolbox</VekText>
                <VekStack Row="true" Wrap="Wrap.Wrap" Class="overflow-y-auto mt-2" AlignItems="AlignItems.Start" Style="align-content: flex-start;">
                    @for (var i = 0; i < 20; i++)
                    {
                        var iLocal = i;
                        <VekText>Some item @iLocal</VekText>
                    }
                </VekStack>
            </div>
        </FirstPanel>
    </VekSplitPanel>
