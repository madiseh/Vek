@namespace Vek.Docs.Examples

<VekSplitPanel Class="vek-width-full vek-height-full" Transparent="true" Rounded="true" Elevation="1">
    <FirstPanel>
        <VekSplitPanel Class="vek-width-full vek-height-full" Horizontal="true" Rounded="true" Elevation="1">
            <FirstPanel>
                <VekStack Style="height: 100%; min-height: 120px;" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <VekText Typo="Typo.h6">Top left</VekText>
                </VekStack>
            </FirstPanel>
            <SecondPanel>
                <VekStack Style="height: 100%; min-height: 120px;" AlignItems="AlignItems.Center" Justify="Justify.Center">
                    <VekText Typo="Typo.h6">Bottom left</VekText>
                </VekStack>
            </SecondPanel>
        </VekSplitPanel>
    </FirstPanel>
    <SecondPanel>
        <VekPaper Class="vek-height-full vek-width-full" Style="background-color: var(--vek-palette-surface);">
            <VekStack Style="height: 100%; min-height: 240px;" AlignItems="AlignItems.Center" Justify="Justify.Center">
                <VekText Typo="Typo.h6">Right pane</VekText>
            </VekStack>
        </VekPaper>
    </SecondPanel>
</VekSplitPanel>
