@page "/components/stepper"

<DocsPage>
    <DocsPageHeader Title="Stepper" Component="@nameof(VekStepper)">
        <Description>
            <DocsPageSection>
                <VekAlert Class="mt-4" Severity="Severity.Warning">
                    <b>Warning:</b> This component is currently under development.
                    <br />
                    <br />
                    Breaking changes such as updates to the API, look and feel, or CSS classes, may occur even in minor patch releases.
                    Please use it only if you are prepared to adapt your code accordingly and provide feedback or contribute code.
                </VekAlert>
            </DocsPageSection>
        </Description>
    </DocsPageHeader>

    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Horizontal Stepper">
                <Description>
                    Stepper needs <CodeInline>@nameof(VekStep)</CodeInline> in its child content. Each step can have <CodeInline>@nameof(VekStep.Title)</CodeInline> and <CodeInline>@nameof(VekStep.SecondaryText)</CodeInline>
                    so the component can be displayed properly. The reset button is only shown if <CodeInline>@nameof(VekStepper.ShowResetButton)</CodeInline> is set.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(StepperBasicExample)" ShowCode="true">
                <StepperBasicExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Explore Features">
                <Description>Browse specific features and usage patterns in detail:</Description>
            </SectionHeader>
            <div class="docs-explore-grid">
                <DocsExploreCard Title="Navigation & Validation" Category="Stepper" Link="/components/stepper/navigation-validation" Description="Preview interaction events, cancellable navigation guards, and step error states.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Flaky" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Validation · Guards · Error State</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Modes & Orientation" Category="Stepper" Link="/components/stepper/modes-orientation" Description="Vertical orientation, non-linear step jumping, and centered alternative labels.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.AltRoute" Color="Color.Info" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Vertical · Non-linear · Centered</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Templates & Customization" Category="Stepper" Link="/components/stepper/templates-customization" Description="Custom headers, connectors, action bars, dynamic steps, and completed content.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.DashboardCustomize" Color="Color.Warning" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Custom Actions · Dynamic Steps</VekText>
                    </VekStack>
                </DocsExploreCard>
            </div>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
