@page "/components/messagebox"

<DocsPage>
    <DocsPageHeader Title="Message Box" Component="@nameof(VekMessageBox)" />
    <DocsPageContent>
        
        <VekAlert Severity="Severity.Info">
            <VekText>The MessageBox component uses <CodeInline Class="docs-code-tertiary">IDialogService</CodeInline> and <CodeInline>VekDialogProvider</CodeInline> for its functionality.</VekText>
            <VekText>Global settings on VekDialogProvider affect all MessageBoxes in your app.</VekText>
            <VekText>See the Dialog <VekLink Href="/components/dialog#configuration">Configuration</VekLink> section for details on global dialog setup.</VekText>
        </VekAlert>

        <DocsPageSection>
            <SectionHeader Title="Message Box">
                <Description>
                    The easiest way to show a message box is with <CodeInline>IDialogService.ShowMessageBox</CodeInline>. This method displays a message box and waits for the user's response. You can control which buttons (Yes, No, Cancel) appear and their text. The result is a nullable <CodeInline>bool</CodeInline>: Yes = <CodeInline>true</CodeInline>, No = <CodeInline>false</CodeInline>, Cancel = <CodeInline>null</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(MessageBoxSimpleExample)">
                <MessageBoxSimpleExample />
            </SectionContent>
        </DocsPageSection>
        
        <DocsPageSection>
            <SectionHeader Title="Custom Message Box">
                <Description>
                    You can inline <CodeInline>VekMessageBox</CodeInline> in Razor to fully customize its appearance using render fragments. For example, you can change the color and icon of the Yes button, or customize the title and message using <CodeInline>TitleContent</CodeInline> and <CodeInline>MessageContent</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(MessageBoxInlineExample)">
                <MessageBoxInlineExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Fluent Confirm, Prompt, and Custom Actions">
                <Description>
                    Use <CodeInline>IDialogService.ShowConfirmAsync</CodeInline> when an action needs a clear yes-or-no decision,
                    <CodeInline>IDialogService.ShowPromptAsync</CodeInline> to collect a text value, or
                    <CodeInline>IDialogService.ShowCustomMessageBoxAsync</CodeInline> to return a value from caller-defined actions.
                    Custom actions can include a start icon and destructive styling. Closing the dialog restores focus to the element that opened it.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(MessageBoxFluentApiExample)">
                <MessageBoxFluentApiExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Multiline Message">
                <Description>
                    Use <CodeInline>MarkupString</CodeInline> for the message content to support multiline text or basic HTML styling. This is useful for highlighting parts of the message or displaying longer content without creating a custom dialog.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(MessageBoxMarkupContentExample)">
                <MessageBoxMarkupContentExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Message Box With DialogOptions">
                <Description>
                    Pass custom <CodeInline>DialogOptions</CodeInline> to override default or global settings, such as allowing the message box to close on Escape. This lets you tailor the behavior or appearance for specific message boxes.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(MessageBoxOptionsExample)">
                <MessageBoxOptionsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Button Order">
                <Description>
                    By default, MessageBox buttons are rendered in the order: Cancel, No, Yes.
                    If you want to reverse this order globally across your entire application (Yes, No, Cancel),
                    you can configure the <CodeInline>ReverseMessageBoxButtonOrder</CodeInline> property on your global <CodeInline>&lt;VekDialogProvider /&gt;</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(MessageBoxConfigurationExample)">
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>

