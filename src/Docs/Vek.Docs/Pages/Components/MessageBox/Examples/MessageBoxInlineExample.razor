@namespace Vek.Docs.Examples

<VekButton Variant="Variant.Filled" Color="Color.Error" OnClick="OnButtonClickedAsync">Delete</VekButton>
<VekChip T="string">@_state</VekChip>

<VekMessageBox @ref="_vekMessageBox" Title="Warning" CancelText="Cancel">
    <MessageContent>
        Deleting can <b><i>not</i></b> be undone!
    </MessageContent>
    <YesButton>
        <VekButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever">Delete!</VekButton>
    </YesButton>
</VekMessageBox>

@code
{
    private VekMessageBox _vekMessageBox;
    private string _state = "Message box hasn't been opened yet";

    private async Task OnButtonClickedAsync()
    {
        bool? result = await _vekMessageBox.ShowAsync();
        _state = result is null ? "Canceled" : "Deleted!";
        StateHasChanged();
    }
}
