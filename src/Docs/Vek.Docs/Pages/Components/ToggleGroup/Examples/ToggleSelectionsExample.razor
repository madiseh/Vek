@namespace Vek.Docs.Examples

<VekStack>
    <VekStack>
        <VekText>Single Selection</VekText>
        <VekText>Value: @_value1</VekText>
        <VekToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection" @bind-Value="_value1" Color="Color.Primary" CheckMark FixedContent>
            <VekToggleItem Value="@("Yes")" Text="Yes" />
            <VekToggleItem Value="@("No")" Text="No" />
            <VekToggleItem Value="@("Don't know")" Text="Don't know" />
        </VekToggleGroup>
    </VekStack>

    <VekDivider />

    <VekStack>
        <VekText>Multi Selection</VekText>
        <VekText>Values: @string.Join(", ", _value2 ?? new List<string>())</VekText>
        <VekToggleGroup T="string" SelectionMode="SelectionMode.MultiSelection" @bind-Values="_value2" Color="Color.Secondary" CheckMark>
            <VekToggleItem Value="@("Extra Bag")" UnselectedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank" SelectedIcon="@Icons.Material.Filled.CheckBox"/>
            <VekToggleItem Value="@("Vegan Menu")" UnselectedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank" SelectedIcon="@Icons.Material.Filled.CheckBox" />
            <VekToggleItem Value="@("Carbon Offset")" UnselectedIcon="@Icons.Material.Filled.CheckBoxOutlineBlank" SelectedIcon="@Icons.Material.Filled.CheckBox" />
        </VekToggleGroup>
    </VekStack>

    <VekDivider />

    <VekStack>
        <VekText>Toggle Selection</VekText>
        <VekText>Value: @(_value3 == null ? "null" : _value3.ToString())</VekText>
        <VekToggleGroup T="int?" SelectionMode="SelectionMode.ToggleSelection" @bind-Value="_value3" Color="Color.Tertiary" CheckMark>
            <VekToggleItem Value="@((int?)1)" Text="Coffee (1)" />
            <VekToggleItem Value="@((int?)2)" Text="Tee (2)" />
            <VekToggleItem Value="@((int?)3)" Text="Water (3)" />
        </VekToggleGroup>
    </VekStack>
</VekStack>

@code {
    private string _value1 = "Yes";
    private IEnumerable<string> _value2 = new []{ "Vegan Menu", "Carbon Offset"};
    private int? _value3;
}
