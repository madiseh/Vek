@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<div class="d-flex align-center gap-4 mb-4">
    <VekButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.FilterList"
               OnClick="@(() => _grid.ShowFilterBuilderAsync())">
        Open Filter Builder
    </VekButton>
    <VekText Typo="Typo.body2">
        Click to build nested multi-condition filters visually.
    </VekText>
</div>

<VekDataGrid T="Element" @ref="_grid" Items="@Elements" Filterable="true" SortMode="SortMode.Multiple">
    <Columns>
        <PropertyColumn Property="x => x.Number" Title="Nr" Filterable="true" />
        <PropertyColumn Property="x => x.Sign" Filterable="true" />
        <PropertyColumn Property="x => x.Name" Filterable="true" />
        <PropertyColumn Property="x => x.Position" Filterable="true" />
        <PropertyColumn Property="x => x.Molar" Title="Molar mass" Filterable="true" />
        <PropertyColumn Property="x => x.Group" Title="Category" Filterable="true" />
    </Columns>
    <PagerContent>
        <VekDataGridPager T="Element" />
    </PagerContent>
</VekDataGrid>

@code {
    private VekDataGrid<Element> _grid = null!;
    private IEnumerable<Element> Elements = [];

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable") ?? [];
    }
}
