@namespace Vek.Docs.Examples

<div class="d-flex flex-wrap mb-4">
    <VekButton OnClick="FitAllColumnsAsync">Fit all columns</VekButton>
    <VekButton Class="ml-2" OnClick="FitNameColumnAsync">Fit the name column</VekButton>
</div>

<VekDataGrid @ref="_dataGrid" T="Employee" Items="_employees" HorizontalScrollbar="true">
    <Columns>
        <PropertyColumn @ref="_nameColumn" Property="employee => employee.Name" Title="Employee name" />
        <PropertyColumn Property="employee => employee.Department" />
        <PropertyColumn Property="employee => employee.Location" />
    </Columns>
</VekDataGrid>

@code {
    private readonly IEnumerable<Employee> _employees = new List<Employee>
    {
        new() { Name = "Alex Morgan", Department = "Product design", Location = "Copenhagen" },
        new() { Name = "Jordan Lee", Department = "Customer operations", Location = "San Francisco" },
        new() { Name = "Samira Haddad", Department = "Research and development", Location = "Istanbul" },
    };

    private VekDataGrid<Employee> _dataGrid = default!;
    private PropertyColumn<Employee, string> _nameColumn = default!;

    private Task FitAllColumnsAsync() => _dataGrid.AutoFitColumnWidths();

    private Task FitNameColumnAsync() => _dataGrid.AutoFitColumnWidths(_nameColumn);

    public class Employee
    {
        public string Name { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Location { get; set; } = string.Empty;
    }
}
