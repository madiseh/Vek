@namespace Vek.Docs.Examples

@inject ISnackbar Snackbar

<VekDataGrid T="ServerInfo" Items="_servers"
             ContextMenuEnabled="true"
             SortMode="SortMode.Multiple"
             Filterable="true"
             Groupable="true"
             AllowColumnPinning="true"
             Bordered="true"
             Dense="true">
    <HeaderContextMenuTemplate>
        <VekMenuItem Icon="@Icons.Material.Filled.ArrowUpward" OnClick="@context.SortAscendingAsync">
            Sort Ascending
        </VekMenuItem>
        <VekMenuItem Icon="@Icons.Material.Filled.ArrowDownward" OnClick="@context.SortDescendingAsync">
            Sort Descending
        </VekMenuItem>
        <VekMenuItem Icon="@Icons.Material.Filled.FormatLineSpacing" OnClick="@context.AutoFitAsync">
            AutoFit Column
        </VekMenuItem>
        <VekMenuItem Icon="@Icons.Material.Filled.ViewColumn" OnClick="@context.AutoFitAllAsync">
            AutoFit All Columns
        </VekMenuItem>
        <VekMenuItem Icon="@Icons.Material.Filled.PushPin" OnClick="@context.PinLeftAsync">
            Pin Left
        </VekMenuItem>
        <VekMenuItem Icon="@Icons.Material.Outlined.PushPin" OnClick="@context.UnpinAsync">
            Unpin
        </VekMenuItem>
    </HeaderContextMenuTemplate>
    <CellContextMenuTemplate>
        <VekMenuItem Icon="@Icons.Material.Filled.ContentCopy" OnClick="@context.CopyCellAsync">
            Copy Cell (@context.FormattedValue)
        </VekMenuItem>
        <VekMenuItem Icon="@Icons.Material.Filled.FilterAlt" OnClick="@context.FilterByCellValueAsync">
            Filter by "@context.FormattedValue"
        </VekMenuItem>
        <VekMenuItem Icon="@Icons.Material.Filled.Info" OnClick="@(() => ShowServerDetails(context.Item))">
            Diagnostics (@context.Item?.Host)
        </VekMenuItem>
        <VekMenuItem Icon="@Icons.Material.Filled.RestartAlt" OnClick="@(() => RestartServer(context.Item))">
            Restart @context.Item?.Host
        </VekMenuItem>
    </CellContextMenuTemplate>
    <Columns>
        <PropertyColumn Property="x => x.Host" Title="Host" Sortable="true" Filterable="true" />
        <PropertyColumn Property="x => x.Region" Title="Region" Sortable="true" Filterable="true" Groupable="true" />
        <PropertyColumn Property="x => x.CpuUsage" Title="CPU %" Sortable="true" Format="P0" />
        <PropertyColumn Property="x => x.MemoryUsage" Title="Memory (GB)" Sortable="true" />
        <TemplateColumn T="ServerInfo" Title="Status">
            <CellTemplate>
                <VekChip Color="@(context.Item.Active ? Color.Success : Color.Error)" Size="Size.Small">
                    @(context.Item.Active ? "Online" : "Maintenance")
                </VekChip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
</VekDataGrid>

@code {
#nullable enable
    private readonly List<ServerInfo> _servers =
    [
        new("us-east-web-01", "us-east", 0.42, 16.5, true),
        new("us-east-db-01", "us-east", 0.78, 64.0, true),
        new("eu-west-web-01", "eu-west", 0.35, 16.0, true),
        new("eu-west-worker-01", "eu-west", 0.89, 32.0, false),
        new("ap-south-web-01", "ap-south", 0.51, 16.0, true),
    ];

    private void ShowServerDetails(ServerInfo? server)
    {
        if (server is not null)
        {
            Snackbar.Add($"Diagnostics for {server.Host} ({server.Region}): CPU {server.CpuUsage:P0}, Memory {server.MemoryUsage}GB", Severity.Info);
        }
    }

    private void RestartServer(ServerInfo? server)
    {
        if (server is not null)
        {
            Snackbar.Add($"Restart signal dispatched to {server.Host}", Severity.Warning);
        }
    }

    public record ServerInfo(string Host, string Region, double CpuUsage, double MemoryUsage, bool Active);
}
