@using Vek.Components.DataGrid.Export
@namespace Vek.Docs.Examples

<VekStack Row="true" Spacing="2" Class="mb-4">
    <VekButton OnClick="DownloadCsvAsync">Download CSV</VekButton>
    <VekButton OnClick="DownloadXlsxAsync">Download XLSX</VekButton>
</VekStack>

<VekDataGrid @ref="_grid" Items="@people">
    <Columns>
        <PropertyColumn Property="person => person.Name" />
        <PropertyColumn Property="person => person.Role" />
        <PropertyColumn Property="person => person.StartDate" Format="yyyy-MM-dd" />
    </Columns>
</VekDataGrid>

@code {
    private VekDataGrid<Person> _grid = null!;
    private readonly Person[] people =
    [
        new("Avery Chen", "Engineer", new DateTime(2022, 6, 1)),
        new("Morgan Patel", "Designer", new DateTime(2023, 3, 15))
    ];

    private Task DownloadCsvAsync() => _grid.ExportToCsvAsync("people.csv");

    private Task DownloadXlsxAsync() => _grid.ExportToXlsxAsync("people.xlsx");

    private record Person(string Name, string Role, DateTime StartDate);
}
