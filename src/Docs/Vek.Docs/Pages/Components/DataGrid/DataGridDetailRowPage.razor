@page "/components/datagrid/detail-row"

<DocsPage>
    <DocsPageHeader Title="DataGrid - Detail Rows" Component="@nameof(VekDataGrid<T>)">
        <Description>
            Learn how to build hierarchical master-detail rows and custom expandable templates in the <CodeInline>&lt;VekDataGrid&gt;</CodeInline>.
        </Description>
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Row Detail View">
                <Description>
                    The <CodeInline>&lt;VekDataGrid></CodeInline> allows you to create hierarchical layouts. To do that the <CodeInline>HierarchyColumn</CodeInline> has to be added in the <CodeInline>Columns</CodeInline> definitions.
                    <br><br>
                    You can customize the icon, disable the toggle button, initially expand detail rows, and set <CodeInline>AutoCollapseDetailRows</CodeInline> to keep only one detail row open at a time. Use <CodeInline>ExpandAllDetailsAsync</CodeInline> and <CodeInline>CollapseAllDetailsAsync</CodeInline> to control all visible details, or use <CodeInline>IsDetailRowExpanded</CodeInline> and <CodeInline>SetDetailRowExpandedAsync</CodeInline> for one item. <CodeInline>EnableHeaderToggle</CodeInline> adds a header control for expanding or collapsing all rows.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DataGridDetailRowExample)" ShowCode="false" Block="true" FullWidth="true">
                <DataGridDetailRowExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Row Detail Renderer">
                <Description>
                    The <CodeInline>&lt;VekDataGrid></CodeInline> allows you to customize the detail content and styling with row detail renderers.
                    You can inspect the row's data and render rich nested controls, forms, or secondary grids.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DataGridDetailRowRendererExample)" ShowCode="false" Block="true" FullWidth="true">
                <DataGridDetailRowRendererExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
