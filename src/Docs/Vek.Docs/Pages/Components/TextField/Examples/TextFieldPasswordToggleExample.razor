@namespace Vek.Docs.Examples

<VekStack Spacing="4">
    <VekTextField @bind-Value="_password"
                  Label="Password with Visibility Toggle"
                  InputType="InputType.Password"
                  ShowPasswordToggle="true"
                  Variant="Variant.Outlined"
                  HelperText="Click the eye icon to toggle visibility" />

    <VekTextField @bind-Value="_passwordWithClear"
                  Label="Password with Clear & Toggle"
                  InputType="InputType.Password"
                  ShowPasswordToggle="true"
                  Clearable="true"
                  Variant="Variant.Outlined" />

    <VekTextField @bind-Value="_boundPassword"
                  @bind-PasswordVisible="_isPasswordVisible"
                  Label="Bound Visibility State"
                  InputType="InputType.Password"
                  ShowPasswordToggle="true"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Lock"
                  HelperText="@($"Password is currently {(_isPasswordVisible ? "visible (plain text)" : "masked")}")" />
</VekStack>

@code {
    private string _password = "SuperSecretPassword!";
    private string _passwordWithClear = "AnotherSecret123";
    private string _boundPassword = "VisibleBinding456";
    private bool _isPasswordVisible;
}
