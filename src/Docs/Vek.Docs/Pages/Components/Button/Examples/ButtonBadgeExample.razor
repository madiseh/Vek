@namespace Vek.Docs.Examples

<VekStack Spacing="4">
    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Wrap="Wrap.Wrap">
        <VekButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   BadgeContent="@_unreadCount"
                   BadgeColor="Color.Error"
                   OnClick="MarkAsRead">
            Inbox
        </VekButton>

        <VekButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   BadgeContent="@("NEW")"
                   BadgeColor="Color.Secondary">
            Updates
        </VekButton>

        <VekButton Variant="Variant.Filled"
                   BadgeDot="true"
                   BadgeColor="Color.Success">
            Status
        </VekButton>

        <VekButton Variant="Variant.Filled"
                   Color="Color.Dark"
                   BadgeContent="@_totalCount"
                   BadgeMax="99"
                   BadgeColor="Color.Primary">
            Alerts
        </VekButton>

        <VekButton Variant="Variant.Outlined"
                   BadgeContent="@(3)"
                   BadgePosition="BadgePosition.BottomEnd"
                   BadgeColor="Color.Info">
            Bottom End
        </VekButton>
    </VekStack>

    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <VekButton Variant="Variant.Text"
                   Color="Color.Primary"
                   OnClick="AddNotification">
            Add notification
        </VekButton>
        <VekButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   OnClick="MarkAsRead">
            Clear inbox
        </VekButton>
    </VekStack>
</VekStack>

@code {
    private int _unreadCount = 4;
    private int _totalCount = 120;

    private void AddNotification()
    {
        _unreadCount++;
        _totalCount++;
    }

    private void MarkAsRead()
    {
        _unreadCount = 0;
    }
}
