@namespace Vek.Docs.Examples
<VekButton Href="https://github.com/madiseh/vek"
           Target="_blank"
           Variant="Variant.Filled"
           EndIcon="@Icons.Custom.Brands.GitHub"
           Color="Color.Primary"
           Disabled=@disabled>
    GitHub Link
</VekButton>
<VekButton Href="https://github.com/madiseh/vek"
           Target="_blank"
           Variant="Variant.Text"
           EndIcon="@Icons.Custom.Brands.GitHub"
           Color="Color.Secondary"
           Style="text-transform:none"
           Disabled=@disabled>
    GitHub Link
</VekButton>
<VekButton Href="https://github.com/madiseh/vek"
           Target="_blank"
           Variant="Variant.Outlined"
           EndIcon="@Icons.Custom.Brands.GitHub"
           Color="Color.Tertiary"
           Disabled=@disabled>
    GitHub Link
</VekButton>
<br />
<VekSwitch Color="Color.Primary" @bind-Value=@(disabled) Label="Disable" />

@code{
    bool disabled = false;
}
