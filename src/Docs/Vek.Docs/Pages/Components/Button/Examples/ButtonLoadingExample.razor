@namespace Vek.Docs.Examples

<VekButton Loading="@_processing" LoadingTemplate="@LoadingContent" Variant="Variant.Filled" Color="Color.Primary">
    Save report
</VekButton>
<VekButton Class="ms-2" OnClick="ToggleProcessing">
    @(_processing ? "Finish saving" : "Start saving")
</VekButton>
<VekText Class="ms-2">@(_processing ? "Saving report…" : "Ready to save")</VekText>

@code {
    private bool _processing;

    private RenderFragment LoadingContent => @<span>Saving…</span>;

    private void ToggleProcessing() => _processing = !_processing;
}
