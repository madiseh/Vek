@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekTable Items="@Elements" FixedHeader="@fixed_header" FixedFooter="@fixed_footer" Height="@(fixed_header || fixed_footer ?"400px":"")">
    <HeaderContent>
        <VekTh>Nr</VekTh>
        <VekTh>Sign</VekTh>
        <VekTh>Name</VekTh>
        <VekTh>Position</VekTh>
        <VekTh>Molar mass</VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd DataLabel="Nr">@context.Number</VekTd>
        <VekTd DataLabel="Sign">@context.Sign</VekTd>
        <VekTd DataLabel="Name">@context.Name</VekTd>
        <VekTd DataLabel="Position">@context.Position</VekTd>
        <VekTd DataLabel="Molar mass">@context.Molar</VekTd>
    </RowTemplate>
    <FooterContent>
        <VekTd>Nr</VekTd>
        <VekTd>Sign</VekTd>
        <VekTd>Name</VekTd>
        <VekTd>Position</VekTd>
        <VekTd>Molar mass</VekTd>
    </FooterContent>
    <PagerContent>
        <VekTablePager PageSizeOptions="new int[]{50, 100}" />
    </PagerContent>
</VekTable>

<VekSwitch @bind-Value="fixed_header" Color="Color.Primary">Fixed Header</VekSwitch>
<VekSwitch @bind-Value="fixed_footer" Color="Color.Primary">Fixed Footer</VekSwitch>

@code {
    bool fixed_header = true;
    bool fixed_footer = false;

    private IEnumerable<Element> Elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}
