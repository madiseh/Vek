@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekTable Items="@Elements" Hover="true" SortLabel="Sort By">
    <HeaderContent>
        <VekTh><VekTableSortLabel SortBy="new Func<Element, object>(x=>x.Number)">Nr</VekTableSortLabel></VekTh>
        <VekTh><VekTableSortLabel Enabled="@enabled" SortBy="new Func<Element, object>(x=>x.Sign)">Sign</VekTableSortLabel></VekTh>
        <VekTh><VekTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<Element, object>(x=>x.Name)">Name</VekTableSortLabel></VekTh>
        <VekTh><VekTableSortLabel SortBy="new Func<Element, object>(x=>x.Position)">Position</VekTableSortLabel></VekTh>
        <VekTh><VekTableSortLabel SortBy="new Func<Element, object>(x=>x.Molar)">Mass</VekTableSortLabel></VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd DataLabel="Nr">@context.Number</VekTd>
        <VekTd DataLabel="Sign">@context.Sign</VekTd>
        <VekTd DataLabel="Name">@context.Name</VekTd>
        <VekTd DataLabel="Position">@context.Position</VekTd>
        <VekTd DataLabel="Molar mass">@context.Molar</VekTd>
    </RowTemplate>
    <PagerContent>
        <VekTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
    </PagerContent>
</VekTable>

<VekSwitch @bind-Value="enabled" Color="Color.Info">Enable sorting on the Sign Column</VekSwitch>

@code {
    private bool enabled = true;
    private IEnumerable<Element> Elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}

