@using System.Net.Http.Json
@using Vek.Examples.Data.Models
@namespace Vek.Docs.Examples
@inject HttpClient httpClient

<VekTable Items="@Elements.Take(4)" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info">
    <HeaderContent>
        <VekTh>Nr</VekTh>
        <VekTh>Sign</VekTh>
        <VekTh>Name</VekTh>
        <VekTh>Position</VekTh>
        <VekTh>Molar mass</VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd DataLabel="Nr">@context.Number</VekTd>
        <VekTd DataLabel="Sign">@context.Sign</VekTd>
        <VekTd DataLabel="Name">@context.Name</VekTd>
        <VekTd DataLabel="Position" HideSmall="_hidePosition">@context.Position</VekTd>
        <VekTd DataLabel="Molar mass">@context.Molar</VekTd>
    </RowTemplate>
</VekTable>

<VekSwitch @bind-Value="_hidePosition" Color="Color.Primary">Hide&nbsp;<b>position</b>&nbsp;when Breakpoint=Xs</VekSwitch>
<VekSwitch @bind-Value="_loading" Color="Color.Primary">Show Loading</VekSwitch>

@code { 
    private bool _hidePosition;
    private bool _loading;
    private IEnumerable<Element> Elements = new List<Element>();

    protected override async Task OnInitializedAsync()
    {
        Elements = await httpClient.GetFromJsonAsync<List<Element>>("webapi/periodictable");
    }
}
