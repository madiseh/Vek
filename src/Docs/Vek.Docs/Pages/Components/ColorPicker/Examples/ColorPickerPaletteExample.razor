@namespace Vek.Docs.Examples
@using Vek.Utilities

<VekColorPicker PickerVariant="PickerVariant.Static" ColorPickerView="ColorPickerView.Palette" Palette="_customPalette" />

@code {
    private readonly IEnumerable<VekColor> _customPalette = new List<IEnumerable<VekColor>>
    {
        VekColor.GenerateTintShadePalette("#DC143C", shadeStep: 0),
        VekColor.GenerateTintShadePalette("#1E90FF", tintStep: 0),
        // Reverse for illustrative purposes
        VekColor.GenerateTintShadePalette("#8E24AA").Reverse(),
        VekColor.GenerateAnalogousPalette("#40E0D0"),
        VekColor.GenerateGradientPalette("#1E90FF", "#32CD32"),
        VekColor.GenerateMultiGradientPalette(["#FF4500", "#32CD32", "#8A2BE2"])
    }.SelectMany(palette => palette);
}