@namespace Vek.Docs.Examples

<VekSwitch @bind-Value="Outlined" Label="Outlined Card" Color="Color.Primary" />
<VekSwitch @bind-Value="Modifiers" Label="Modifiers" Color="Color.Secondary" />

<VekTimeline TimelinePosition="TimelinePosition.Start" Modifiers="@Modifiers">
    <VekTimelineItem Size="Size.Medium" Color="Color.Info" Elevation="@(Outlined ? 0 : 25)">
        <VekCard Outlined="@Outlined" Elevation="25">
            <VekCardContent>
                <VekText Typo="Typo.h6">Kopparberg</VekText>
                <VekText Typo="Typo.body2">Kopparberg is a locality and the seat of Ljusnarsberg, Örebro County, Sweden, with 4,200 inhabitants in 2015.</VekText>
                <VekText Typo="Typo.body2">It is famous for Kopparberg Cider, now one of the best selling ciders in the UK and worldwide.</VekText>
            </VekCardContent>
        </VekCard>
    </VekTimelineItem>
</VekTimeline>

@code{
    public bool Modifiers { get; set; } = true;
    public bool Outlined { get; set; }
}