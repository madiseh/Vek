@namespace Vek.Docs.Examples

<style>
    .timeline-red-dot {
        background-color: var(--vek-palette-error);
    }
</style>

<VekItem>
    <VekTimeline Reverse="true">
        <VekTimelineItem>
            <VekText Align="Align.End">Static dot</VekText>
        </VekTimelineItem>
        <VekTimelineItem DotClass="timeline-red-dot">
            <VekText Align="Align.End">Red dot</VekText>
        </VekTimelineItem>
        <VekTimelineItem>
            <VekText Align="Align.End">Static dot</VekText>
        </VekTimelineItem>
    </VekTimeline>
</VekItem>
