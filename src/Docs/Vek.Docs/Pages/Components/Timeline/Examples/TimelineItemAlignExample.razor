@namespace Vek.Docs.Examples

<VekTimeline>
    <VekTimelineItem Color="Color.Info">
        <VekText Typo="Typo.button">Packaging Process Started</VekText>
        <VekText Typo="Typo.body2" Class="vek-text-secondary">Yesterday: 16:33</VekText>
    </VekTimelineItem>
    <VekTimelineItem TimelineAlign="TimelineAlign.End">
        <VekText Typo="Typo.body2">Packaging complete</VekText>
        <VekText Typo="Typo.body2" Class="vek-text-secondary">Yesterday: 17:10</VekText>
    </VekTimelineItem>
    <VekTimelineItem TimelineAlign="TimelineAlign.End">
        <VekText Typo="Typo.body2">Waiting for pickup</VekText>
        <VekText Typo="Typo.body2" Class="vek-text-secondary">Yesterday: 17:15</VekText>
    </VekTimelineItem>
    <VekTimelineItem Color="Color.Error">
        <VekAlert Severity="Severity.Error">Package missed last pickup time.</VekAlert>
    </VekTimelineItem>
    <VekTimelineItem Color="Color.Success">
        <VekText Typo="Typo.button">Package picked up by driver</VekText>
        <VekText Typo="Typo.body2" Class="vek-text-secondary">Today: 17:00</VekText>
    </VekTimelineItem>
    <VekTimelineItem TimelineAlign="TimelineAlign.End">
        <VekText Typo="Typo.button">Package In Transit</VekText>
    </VekTimelineItem>
</VekTimeline>