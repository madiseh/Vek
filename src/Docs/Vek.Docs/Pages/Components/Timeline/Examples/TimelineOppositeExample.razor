@namespace Vek.Docs.Examples

<VekTimeline>
    <VekTimelineItem Color="Color.Info" Size="Size.Small">
        <ItemOpposite>
            <VekText Color="Color.Info" Typo="Typo.h5">1970</VekText>
        </ItemOpposite>
        <ItemContent>
            <VekText Color="Color.Info" Typo="Typo.h6" GutterBottom="true">Atom Towns</VekText>
            <VekText>Construction of the town of Pripyat, one of 9 “atom towns” begins, to be inhabited by future employees of the nuclear power plants.</VekText>
        </ItemContent>
    </VekTimelineItem>
    <VekTimelineItem Color="Color.Success" Size="Size.Small">
        <ItemOpposite>
            <VekText Color="Color.Success" Typo="Typo.h5">1977</VekText>
        </ItemOpposite>
        <ItemContent>
            <VekText Color="Color.Success" Typo="Typo.h6" GutterBottom="true">Operational</VekText>
            <VekText>The first of the Chernobyl Nuclear Power Plants four reactors is ready to operate followed by number 2 in 1978.</VekText>
        </ItemContent>
    </VekTimelineItem>
    <VekTimelineItem Color="Color.Error" Size="Size.Small">
        <ItemOpposite>
            <VekText Color="Color.Error" Typo="Typo.h5">1979</VekText>
        </ItemOpposite>
        <ItemContent>
            <VekText Color="Color.Error" Typo="Typo.h6" GutterBottom="true">Pripyat</VekText>
            <VekText>Pripyat officially proclaimed as a city.<br />The Chernobyl Atomic Power Station reaches its first 10 billion kilowatt-hours of electical output.</VekText>
        </ItemContent>
    </VekTimelineItem>
</VekTimeline>