@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem xs="12" md="8" Class="my-auto">
        <VekTimeline Reverse="true">
            <VekTimelineItem>
                <VekText Align="Align.End">Static dot</VekText>
            </VekTimelineItem>
            <VekTimelineItem Color="@DotColor" Size="@DotSize" Variant="@DotVariant" Elevation="@DotElevation" HideDot="@HideDot">
                <ItemDot>
                    @if(DotConfig == 1)
                    {
                        <VekIcon Size="@DotSize" Icon="@Icons.Custom.Brands.Vek"/>
                    }
                    else if(DotConfig == 2)
                    {
                        <VekAvatar Size="@DotSize">
                            <VekImage Src="images/mony.jpg" />
                        </VekAvatar>
                    }
                </ItemDot>
            </VekTimelineItem>
            <VekTimelineItem>
                <VekText Align="Align.End">Static dot</VekText>
            </VekTimelineItem>
        </VekTimeline>
    </VekItem>
    <VekItem xs="12" md="4">
        <VekPaper Class="pa-4" Elevation="0">
            <VekText Typo="Typo.h6">Dot Options</VekText>
            <VekSelect Label="Color" Dense="true" Margin="Margin.Dense" @bind-Value="DotColor" Class="mt-4">
                <VekSelectItem T="Color" Value="Color.Default">Default</VekSelectItem>
                <VekSelectItem T="Color" Value="Color.Primary">Primary</VekSelectItem>
                <VekSelectItem T="Color" Value="Color.Secondary">Secondary</VekSelectItem>
                <VekSelectItem T="Color" Value="Color.Tertiary">Tertiary</VekSelectItem>
                <VekSelectItem T="Color" Value="Color.Info">Info</VekSelectItem>
                <VekSelectItem T="Color" Value="Color.Success">Success</VekSelectItem>
                <VekSelectItem T="Color" Value="Color.Warning">Warning</VekSelectItem>
                <VekSelectItem T="Color" Value="Color.Error">Error</VekSelectItem>
                <VekSelectItem T="Color" Value="Color.Dark">Dark</VekSelectItem>
            </VekSelect>
            <VekSelect Label="Size" Dense="true" Margin="Margin.Dense" @bind-Value="DotSize" Class="mt-4">
                <VekSelectItem T="Size" Value="Size.Small">Small</VekSelectItem>
                <VekSelectItem T="Size" Value="Size.Medium">Medium</VekSelectItem>
                <VekSelectItem T="Size" Value="Size.Large">Large</VekSelectItem>
            </VekSelect>
            <VekSelect Label="Variant" Dense="true" Margin="Margin.Dense" @bind-Value="DotVariant" Class="mt-4">
                <VekSelectItem T="Variant" Value="Variant.Outlined">Outlined</VekSelectItem>
                <VekSelectItem T="Variant" Value="Variant.Filled">Filled</VekSelectItem>
            </VekSelect>
            <VekSlider @bind-Value="DotElevation" Step="1" Min="0" Max="25" Class="mt-2">Dot Elevation</VekSlider>
            <VekRadioGroup T="int" ValueChanged="DotConfigChanged">
                <VekRadio Value="0" Color="Color.Primary">Default</VekRadio>
                <VekRadio Value="1" Color="Color.Secondary">Icon</VekRadio>
                <VekRadio Value="2" Color="Color.Tertiary">Avatar</VekRadio>
                <VekRadio Value="3" Color="Color.Default">Hide</VekRadio>
            </VekRadioGroup>
        </VekPaper>
    </VekItem>
</VekGrid>


@code{
    public Size DotSize { get; set; } = Size.Medium;
    public Color DotColor { get; set; } = Color.Primary;
    public Variant DotVariant { get; set; } = Variant.Outlined;
    public int DotElevation { get; set; } = 1;
    public bool HideDot { get; set; }
    public int DotConfig;

    void DotConfigChanged(int value)
    {
        switch(value)
        {
            case 3:
                DotConfig = value;
                HideDot = true;
                break;
            default:
                DotConfig = value;
                HideDot = false;
                break;
        }
    }
}