@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" Square="true" Class="mb-2 mt-3">Default Square</VekAlert>
        <VekAlert Severity="Severity.Info" Square="true" Class="my-2">Info Square</VekAlert>
        <VekAlert Severity="Severity.Success" Square="true" Class="my-2">Success Square</VekAlert>
        <VekAlert Severity="Severity.Warning" Square="true" Class="my-2">Warning Square</VekAlert>
        <VekAlert Severity="Severity.Error" Square="true" Class="my-2">Error Square</VekAlert>
    </VekItem>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" Variant="Variant.Outlined" Square="true" Class="my-2">Default Square</VekAlert>
        <VekAlert Severity="Severity.Info" Variant="Variant.Outlined" Square="true" Class="my-2">Info Square</VekAlert>
        <VekAlert Severity="Severity.Success" Variant="Variant.Outlined" Square="true" Class="my-2">Success Square</VekAlert>
        <VekAlert Severity="Severity.Warning" Variant="Variant.Outlined" Square="true" Class="my-2">Warning Square</VekAlert>
        <VekAlert Severity="Severity.Error" Variant="Variant.Outlined" Square="true" Class="my-2">Error Square</VekAlert>
    </VekItem>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" Variant="Variant.Filled" Square="true" Class="mb-2 mt-3">Default Square</VekAlert>
        <VekAlert Severity="Severity.Info" Variant="Variant.Filled" Square="true" Class="my-2">Info Square</VekAlert>
        <VekAlert Severity="Severity.Success" Variant="Variant.Filled" Square="true" Class="my-2">Success Square</VekAlert>
        <VekAlert Severity="Severity.Warning" Variant="Variant.Filled" Square="true" Class="my-2">Warning Square</VekAlert>
        <VekAlert Severity="Severity.Error" Variant="Variant.Filled" Square="true" Class="my-2">Error Square</VekAlert>
    </VekItem>
</VekGrid>