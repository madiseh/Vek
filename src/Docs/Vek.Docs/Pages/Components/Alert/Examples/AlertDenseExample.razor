@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" Dense="true" Class="my-2">Dense Default</VekAlert>
        <VekAlert Severity="Severity.Info" Dense="true" Class="my-2">Dense Info</VekAlert>
        <VekAlert Severity="Severity.Success" Dense="true" Class="my-2">Dense Success</VekAlert>
        <VekAlert Severity="Severity.Warning" Dense="true" Class="my-2">Dense Warning</VekAlert>
        <VekAlert Severity="Severity.Error" Dense="true" Class="my-2">Dense Error</VekAlert>
    </VekItem>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Default</VekAlert>
        <VekAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Info</VekAlert>
        <VekAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Success</VekAlert>
        <VekAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Warning</VekAlert>
        <VekAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="my-2">Dense Error</VekAlert>
    </VekItem>
    <VekItem md="4" xs="12">
        <VekAlert Severity="Severity.Normal" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Default</VekAlert>
        <VekAlert Severity="Severity.Info" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Info</VekAlert>
        <VekAlert Severity="Severity.Success" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Success</VekAlert>
        <VekAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Warning</VekAlert>
        <VekAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="my-2">Dense Error</VekAlert>
    </VekItem>
</VekGrid>