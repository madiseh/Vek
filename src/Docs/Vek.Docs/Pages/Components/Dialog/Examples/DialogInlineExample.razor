@namespace Vek.Docs.Examples

<div class="d-flex">
    <VekButton OnClick="OpenDialog" Variant="Variant.Filled" Color="Color.Primary">
        Edit rating
    </VekButton>
    <VekRating SelectedValue="_rating" Disabled="true" Class="mt-1 ml-3" />
</div>

<VekDialog @bind-Visible="_visible" Options="_dialogOptions">
    <TitleContent>
        <VekText Typo="Typo.h6">
            <VekIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> Edit rating
        </VekText>
    </TitleContent>
    <DialogContent>
        <p>How awesome are inline dialogs?</p>
        <VekRating @bind-SelectedValue="_rating" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Class="px-10">Close</VekButton>
    </DialogActions>
</VekDialog>

@code {
    private bool _visible;
    private int _rating;
    private readonly DialogOptions _dialogOptions = new() { FullWidth = true };

    private void OpenDialog() => _visible = true;

    private void Submit() => _visible = false;
}