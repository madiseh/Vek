@namespace Vek.Docs.Examples

<VekDialog>
    <DialogContent>
        <VekText>Move this dialog by dragging its header, or focus the header and use the arrow keys. Resize from any edge or corner; each handle also supports arrow keys.</VekText>
        <VekText Class="mt-3">The dialog stays within the viewport while you adjust its position and size.</VekText>
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="Close">Done</VekButton>
    </DialogActions>
</VekDialog>

@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; } = null!;

    private void Close() => VekDialog.Close();
}
