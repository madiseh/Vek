@namespace Vek.Docs.Examples

<VekDialog Class="blur dialog-background" TitleClass="blur dialog-background-title" ContentClass="dialog-background-surface py-10" ActionsClass="dialog-background-surface">
    <DialogContent>
        Dialog Content
    </DialogContent>
    <DialogActions>
        <VekButton Color="Color.Error" OnClick="Cancel">Cancel</VekButton>
        <VekButton Color="Color.Primary" OnClick="Submit">OK</VekButton>
    </DialogActions>
</VekDialog>

<style>
    .blur {
        backdrop-filter: blur(10px);
    }

    .dialog-background {
        background-color: transparent;
    }

    .dialog-background-title {
        background: rgba(var(--vek-palette-info-rgb), 0.5);
        color: var(--vek-palette-white);
    }

    .dialog-background-surface {
        background: rgba(var(--vek-palette-surface-rgb), 0.75);
    }
</style>

@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; }

    private void Submit() => VekDialog.Close(DialogResult.Ok(true));

    private void Cancel() => VekDialog.Cancel();
}
