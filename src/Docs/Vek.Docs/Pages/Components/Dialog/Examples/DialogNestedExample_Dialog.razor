@namespace Vek.Docs.Examples

@inject IDialogService DialogService

<VekDialog>
    <DialogContent>
        Dialog Content
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="Cancel">Cancel</VekButton>
        <VekButton Color="Color.Primary" OnClick="OpenSecondDialogAsync">Open Second Dialog</VekButton>
    </DialogActions>
</VekDialog>


@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; }

    private void Cancel() => VekDialog.Cancel();

    private Task OpenSecondDialogAsync()
    {
        return DialogService.ShowAsync<DialogNestedExample_Dialog2>("Second Level Dialog");
    }
}