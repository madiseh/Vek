@namespace Vek.Docs.Examples
@using Vek.Examples.Data.Models

@inject ISnackbar Snackbar

<VekDialog>
    <TitleContent>
        <VekText Typo="Typo.h6">
            <VekIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-3 mb-n1"/>
            Delete server?
        </VekText>
    </TitleContent>
    <DialogContent>
        <VekTextField Value="@Server.Id.ToString()" Label="Server ID" ReadOnly="true"/>
        <VekTextField Value="@Server.Name" Label="Server Name" ReadOnly="true"/>
        <VekTextField Value="@Server.Location" Label="Location" ReadOnly="true"/>
        <VekTextField Value="@Server.IpAddress" Label="IP Address" ReadOnly="true"/>
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="Cancel">Cancel</VekButton>
        <VekButton Color="Color.Error" OnClick="DeleteServer">Delete Server</VekButton>
    </DialogActions>
</VekDialog>

@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; }

    [Parameter]
    public Server Server { get; set; } = new Server();

    private void Cancel() => VekDialog.Cancel();

    private void DeleteServer()
    {
        //In a real world scenario this bool would probably be a service to delete the item from api/database
        Snackbar.Add("Server Deleted", Severity.Success);
        VekDialog.Close(DialogResult.Ok(Server.Id));
    }
}
