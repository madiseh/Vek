@page "/components/dialog"

<DocsPage>
    <DocsPageHeader Title="Dialog" Component="@nameof(VekDialog)" />
    <DocsPageContent>

        <VekAlert Severity="Severity.Info">
            <VekText>The Dialog component relies on <CodeInline Class="docs-code-tertiary">IDialogService</CodeInline> and <CodeInline>VekDialogProvider</CodeInline> for its functionality.</VekText>
            <VekText>See the <VekLink Href="/getting-started/installation">Installation</VekLink> page for setup instructions.</VekText>
        </VekAlert>

        <DocsPageSection>
            <SectionHeader Title="Usage">
                <Description>
                    To use a dialog, define a <CodeInline>VekDialog</CodeInline> in a Razor component (e.g., <CodeInline Class="docs-code-tertiary">TermsOfServiceDialog.razor</CodeInline>).
                    Show it by calling:
                    <p>
                        <CodeInline>DialogService.Show&lt;<CodeInline Class="docs-code-tertiary">TermsOfServiceDialog</CodeInline>&gt;("Terms");</CodeInline>
                    </p>
                    This approach lets you reuse dialogs throughout your app and pass parameters for customization.
                    <VekAlert Class="my-3" Severity="Severity.Info">
                        Tip: For best results, use <CodeInline Tag="true">VekDialog</CodeInline> as the root element of your dialog component.
                    </VekAlert>
                </Description>
            </SectionHeader>
            <SectionContent Codes="@(new[] {new CodeFile("Page.razor", nameof(DialogUsageExample)), new CodeFile("Dialog.razor", nameof(DialogUsageExample_Dialog))})">
                <DialogUsageExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Passing Data">
                <Description>Pass data to a dialog and use it for operations, such as confirming a delete action.</Description>
            </SectionHeader>
            <SectionContent Codes="@(new[] {new CodeFile("Page.razor", nameof(DialogPassingDataExample)), new CodeFile("Dialog.razor", nameof(DialogPassingDataExample_Dialog))})">
                <DialogPassingDataExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Configuration">
                <Description>
                    You can change dialog behavior globally by setting parameters on <CodeInline>&lt;VekDialogProvider/&gt;</CodeInline>, or per dialog by passing a <CodeInline>DialogOptions</CodeInline> instance when opening a dialog.
                </Description>
            </SectionHeader>
            <SectionSubGroups>

                <DocsPageSection>
                    <SectionHeader Title="Global Settings">
                        <Description>Set options on <CodeInline>&lt;VekDialogProvider/&gt;</CodeInline> to affect all dialogs. See the <VekLink Href="/getting-started/installation">installation page</VekLink> for details.</Description>
                    </SectionHeader>
                    <SectionContent Code="@nameof(DialogConfigurationExample)" />
                </DocsPageSection>

                <DocsPageSection>
                    <SectionHeader Title="Per Dialog">
                        <Description>
                            Pass a <CodeInline>DialogOptions</CodeInline> object when opening a dialog to override global settings for that instance.
                        </Description>
                    </SectionHeader>
                    <SectionContent Codes="@(new[] {new CodeFile("Page.razor", nameof(DialogOptionsExample)), new CodeFile("Dialog.razor", nameof(DialogOptionsExample_Dialog))})">
                        <DialogOptionsExample />
                    </SectionContent>
                </DocsPageSection>

                <DocsPageSection>
                    <SectionHeader Title="From dialog">
                        <Description>
                            You can update the dialog's title and options from within the dialog component using <CodeInline>SetTitle</CodeInline> and <CodeInline>SetOptions</CodeInline> on the <CodeInline>VekDialogInstance</CodeInline>.
                        </Description>
                    </SectionHeader>
                    <SectionContent Codes="@(new[] {new CodeFile("Page.razor", nameof(DialogSetOptionsExample)), new CodeFile("Dialog.razor", nameof(DialogSetOptionsExample_Dialog))})">
                        <DialogSetOptionsExample />
                    </SectionContent>
                </DocsPageSection>

            </SectionSubGroups>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Explore Features">
                <Description>Browse specific features and usage patterns in detail:</Description>
            </SectionHeader>
            <div class="docs-explore-grid">
                <DocsExploreCard Title="Movement & Resizing" Category="Dialog" Link="/components/dialog/movement-resizing" Description="Move dialogs by header dragging and resize with viewport-constrained 8-direction handles.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.OpenWith" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Draggable · Resizable · Constrained</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Stacking & Management" Category="Dialog" Link="/components/dialog/stacking" Description="Manage multiple concurrent dialogs, single-shared backdrop, active z-index focus, and close-all operations.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Layers" Color="Color.Info" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Stacked · Z-Index · Close All</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Inline & Embedded" Category="Dialog" Link="/components/dialog/inline" Description="Embed inline dialogs directly inside Razor markups without external component files.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.ViewInAr" Color="Color.Success" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Inline Markup · Direct Scope</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Appearance & Layout" Category="Dialog" Link="/components/dialog/appearance" Description="Configure backdrop blur, scrollable body containers, custom class overrides, and fullscreen layouts.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Warning" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Blur · Scrollable · Fullscreen</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Keyboard & Focus Trap" Category="Dialog" Link="/components/dialog/keyboard-accessibility" Description="W3C Modal pattern: automatic focus trap, default focus element, Escape handling, and arrow moving.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Keyboard" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Focus Trap · Escape · W3C Modal</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Message Box" Category="Dialog" Link="/components/messagebox" Description="Fluent confirmation prompts, yes/no dialogs, and alert boxes with one-line async calls.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.QuestionAnswer" Color="Color.Secondary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Confirm · Prompt · Quick Alert</VekText>
                    </VekStack>
                </DocsExploreCard>
            </div>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
