@using Vek.Resources
@using Vek.Utilities
@inject InternalVekLocalizer Localizer
@namespace Vek.Docs.Examples

<style>
    .vek-input-control.vek-field .vek-input>input.vek-input-root-outlined {
        padding: 0px 14px;
    }
</style>

<VekGrid>
    <VekItem xs="12" md="6" lg="4">
        <VekStack>
            <VekField Label="What am I?" ChildContent="@content"
                      Variant="Variant.Outlined">
            </VekField>
            <VekText Typo="Typo.button">ChildContent</VekText>
            <VekStack Row AlignItems="AlignItems.Center">
                <VekSwitch T="bool" Label="Label" LabelPlacement="Placement.Start" Color="Color.Primary" ValueChanged="@((b) => content = b ? null : rf1)" />
                Placeholder
            </VekStack>
        </VekStack>
    </VekItem>
    <VekItem xs="12" md="6" lg="4">
        <VekField Label="Pick a color" Variant="Variant.Outlined">
            <input type="color" @bind-value="color" /><span class="ml-3">@color</span>
        </VekField>
    </VekItem>
    <VekItem xs="12" md="6" lg="4">
        <VekStack>
            <VekField Label="ShrinkLabel Override" Variant="Variant.Outlined" AdornmentAriaLabel="info icon"
                      AdornmentIcon="@Icons.Material.Filled.Info" AdornmentColor="Color.Info"
                      ShrinkLabel="@_shrinkLabel" Adornment="Adornment.End">
                <VekStack Row Class="vek-input"
                          Spacing="2" AlignItems="AlignItems.Center" tabindex="-1">
                    <input class="@InputClassname" />
                    <VekIconButton Color="@Color.Default"
                                   Icon="@Icons.Material.Filled.Clear"
                                   Size="@Size.Small"
                                   aria-label="@Localizer[LanguageResource.VekInput_Clear]"
                                   tabindex="-1"
                                   @onmousedown:stopPropagation />
                </VekStack>
            </VekField>
            <VekText Typo="Typo.button">ShrinkLabel</VekText>
            <VekStack Row AlignItems="AlignItems.Center">
                <VekSwitch @bind-Value="@_shrinkLabel" Label="Label" LabelPlacement="Placement.Start" Color="Color.Primary" />
                Placeholder
            </VekStack>
        </VekStack>
    </VekItem>
</VekGrid>

@code {
    RenderFragment content = null;
    RenderFragment rf1 = @<VekText Typo="@Typo.h6">I Am Field</VekText>;
    string color = "#6cf014";
    private bool _shrinkLabel = false;

    protected string InputClassname =>
        new CssBuilder("vek-input-slot")
            .AddClass("vek-input-root")
            .AddClass($"vek-input-root-{Variant.Outlined.ToStringFast(true)}")
            .AddClass($"vek-input-root-adorned-{Adornment.End.ToStringFast(true)}")
            .AddClass($"vek-input-root-margin-{Margin.Normal.ToStringFast(true)}")
            .Build();
}
