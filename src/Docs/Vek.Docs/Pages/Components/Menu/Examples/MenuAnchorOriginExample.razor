@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem xs="12" md="3">
        <VekText Typo="Typo.h6">Anchor Origin</VekText>
        <VekRadioGroup T="Origin" @bind-Value="AnchorOrigin" Class="d-flex flex-column my-2">
            <VekRadio Color="Color.Primary" Dense="true" Value="Origin.TopLeft">Top-Left</VekRadio>
            <VekRadio Color="Color.Primary" Dense="true" Value="Origin.TopRight">Top-Right</VekRadio>
            <VekRadio Color="Color.Primary" Dense="true" Value="Origin.BottomLeft">Bottom-Left</VekRadio>
            <VekRadio Color="Color.Primary" Dense="true" Value="Origin.BottomRight">Bottom-Right</VekRadio>
        </VekRadioGroup>
        <VekText Typo="Typo.h6">Transform Origin</VekText>
        <VekRadioGroup T="Origin" @bind-Value="TransformOrigin" Class="d-flex flex-column  my-2">
            <VekRadio Color="Color.Primary" Dense="true" Value="Origin.TopCenter" Disabled="true">Top-Center</VekRadio>
        </VekRadioGroup>
    </VekItem>
    <VekItem xs="12" md="9" Class="d-flex align-center justify-center flex-column">
        <VekMenu Label="Change Anchor Origin" Variant="Variant.Filled" Color="Color.Info" AnchorOrigin="@AnchorOrigin" TransformOrigin="@TransformOrigin">
            <VekMenuItem Label="1" />
            <VekMenuItem Label="2" />
            <VekMenuItem Label="3" />
        </VekMenu>
        <VekText Typo="Typo.overline">Click the button to see effect</VekText>
    </VekItem>
</VekGrid>

@code {
    public Origin AnchorOrigin { get; set; } = Origin.TopLeft;
    public Origin TransformOrigin { get; set; } = Origin.TopCenter;
}
