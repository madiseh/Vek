@namespace Vek.Docs.Examples

<VekCard>
    <VekCardHeader>
        <CardHeaderContent>
            <VekText Typo="Typo.body1">Istra Croatia</VekText>
            <VekText Typo="Typo.body2">Peninsula in Europe</VekText>
        </CardHeaderContent>
    </VekCardHeader>
    <div @onclick="@(OpenContextMenu)" @oncontextmenu="@(OpenContextMenu)" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
        <VekCardMedia Image="images/pilars.jpg" Height="250"/>
    </div>
    <VekCardContent>
        <VekText Typo="Typo.body2">Try left clicking or right clicking the image to open the menu.</VekText>
    </VekCardContent>
</VekCard>

<VekMenu PositionAtCursor @ref="_contextMenu">
    <VekMenuItem Label="Undo" />
    <VekMenuItem Label="Redo" Disabled />
    <VekDivider />
    <VekMenuItem Label="Cut" />
    <VekMenuItem Label="Copy" />
    <VekMenuItem Label="Paste" />
</VekMenu>

@code {
#nullable enable
    private VekMenu _contextMenu = null!;

    private async Task OpenContextMenu(MouseEventArgs args)
    {
        await _contextMenu.OpenMenuAsync(args);
    }
}
