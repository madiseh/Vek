@namespace Vek.Docs.Examples

<VekMenu Label="Left Click" FullWidth="true" ActivationEvent="@MouseEvent.LeftClick" Variant="Variant.Filled" Color="Color.Primary">
    <ChildContent>
        <VekMenuItem Label="Profile" />
        <VekMenuItem Label="Theme" />
        <VekMenuItem Label="Usage" />
        <VekMenuItem Label="Sign Out" />
    </ChildContent>
</VekMenu>

<VekMenu Label="Right Click" ActivationEvent="@MouseEvent.RightClick" Variant="Variant.Filled" Color="Color.Primary">
    <ChildContent>
        <VekMenuItem Label="Profile" />
        <VekMenuItem Label="Theme" />
        <VekMenuItem Label="Usage" />
        <VekMenuItem Label="Sign Out" />
    </ChildContent>
</VekMenu>

<VekMenu Label="Mouse Over" FullWidth="true" ActivationEvent="@MouseEvent.MouseOver" Variant="Variant.Filled" Color="Color.Primary" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
    <ChildContent>
        <VekMenuItem Label="Profile" />
        <VekMenuItem Label="Theme" />
        <VekMenuItem Label="Usage" />
        <VekMenuItem Label="Sign Out" />
    </ChildContent>
</VekMenu>
