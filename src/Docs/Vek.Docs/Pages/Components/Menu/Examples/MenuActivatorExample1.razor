@namespace Vek.Docs.Examples

<VekMenu>
    <ActivatorContent>
        <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@context.ToggleAsync">Button</VekButton>
    </ActivatorContent>
    <ChildContent>
        <VekMenuItem Label="Profile" />
        <VekMenuItem Label="Theme" />
        <VekMenuItem Label="Usage" />
    </ChildContent>
</VekMenu>

<VekMenu>
    <ActivatorContent>
        <VekChip T="string" Icon="@Icons.Material.Filled.Person" Color="Color.Primary" OnClick="@(() => context.ToggleAsync())">Chip</VekChip>
    </ActivatorContent>
    <ChildContent>
        <VekMenuItem Label="Profile" />
        <VekMenuItem Label="Theme" />
        <VekMenuItem Label="Usage" />
    </ChildContent>
</VekMenu>

<VekMenu>
    <ActivatorContent>
        <div @onclick="@context.ToggleAsync" style="cursor: pointer">
            <VekAvatar>
                <VekImage Src="images/toiletvisit.jpg" />
            </VekAvatar>
        </div>
    </ActivatorContent>
    <ChildContent>
        <VekMenuItem Label="Profile" />
        <VekMenuItem Label="Theme" />
        <VekMenuItem Label="Usage" />
    </ChildContent>
</VekMenu>

<VekMenu ActivationEvent="@MouseEvent.RightClick">
    <ActivatorContent>
        <div @oncontextmenu="@context.ToggleAsync" @oncontextmenu:preventDefault style="display: inline-flex">
            <VekChip T="string" Icon="@Icons.Material.Filled.Mouse" Color="Color.Primary">Right Click</VekChip>
        </div>
    </ActivatorContent>
    <ChildContent>
        <VekMenuItem Label="Profile" />
        <VekMenuItem Label="Theme" />
        <VekMenuItem Label="Usage" />
    </ChildContent>
</VekMenu>

<VekMenu ActivationEvent="@MouseEvent.MouseOver" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter">
    <ActivatorContent>
        <VekChip T="string" Icon="@Icons.Material.Filled.Mouse" Color="Color.Primary">Mouse Over</VekChip>
    </ActivatorContent>
    <ChildContent>
        <VekMenuItem Label="Profile" />
        <VekMenuItem Label="Theme" />
        <VekMenuItem Label="Usage" />
    </ChildContent>
</VekMenu>
