@namespace Vek.Docs.Examples

<VekDropContainer T="DropZoneItem" Items="_items" ItemsSelector="@((item, dropzone) => item.Zone == dropzone)" ItemDropped="ItemUpdated" Class="4 flex-grow-1">
    <ChildContent>
        <VekDropContainer T="DropZone" Items="_zones" ItemDisabled="@(item => true)" ItemsSelector="@((item, dropzone) => true)" Class="5">
            <ChildContent>
                <VekDropZone T="DropZone" AllowReorder Class="6 rounded vek-background-gray px-4 py-1 ma-4" />
             </ChildContent>
             <ItemRenderer>
                 <VekPaper Class="pa-4 my-4">
                     <VekText Typo="Typo.h6">@context.Name</VekText>
                     <VekDropZone T="DropZoneItem" Identifier="@context.Name" AllowReorder Class="rounded vek-background-gray px-4 py-1 ma-4" />
                 </VekPaper>
             </ItemRenderer>
         </VekDropContainer>
     </ChildContent>
     <ItemRenderer>
         <VekPaper Class="pa-4 my-4">
             <VekText>@context.Name</VekText>
         </VekPaper>
     </ItemRenderer>
 </VekDropContainer>

 @code {

    private void ItemUpdated(VekItemDropInfo<DropZoneItem> dropItem) => dropItem.Item.Zone = dropItem.DropzoneIdentifier;

    private List<DropZone> _zones = new()
    {
        new() { Name = "Drop Zone 1" },
        new() { Name = "Drop Zone 2" }
    };

    private List<DropZoneItem> _items = new()
    {
        new() { Zone = "Drop Zone 1", Name = "Item 1" },
        new() { Zone = "Drop Zone 1", Name = "Item 2" },
        new() { Zone = "Drop Zone 2", Name = "Item 3" },
    };

    private class DropZone
    {
        public string Name { get; init; }
    }

    private class DropZoneItem
    {
        public string Zone { get; set; }
        public string Name { get; init; }
    }
}