@namespace Vek.Docs.Examples
@using System.Linq

<div class="d-flex flex-column gap-2">
    <VekText Typo="Typo.subtitle1">Open support tickets</VekText>
    @foreach (var ticketNumber in CurrentTicketNumbers)
    {
        <div class="pa-2">Ticket #@ticketNumber</div>
    }
    <VekPagination @bind-Selected="_selectedPage"
                   @bind-PageSize="_pageSize"
                   Count="@PageCount"
                   TotalItems="@TotalItems"
                   ShowPageSizeSelector="true"
                   PageSizeOptions="@PageSizeOptions"
                   ShowDirectPageJump="true"
                   ShowFirstButton="true"
                   ShowLastButton="true" />
</div>

@code {
    private const int TotalItems = 73;
    private static readonly int[] PageSizeOptions = [10, 25, 50];
    private int _pageSize = 10;
    private int _selectedPage = 1;

    private int PageCount => (TotalItems + _pageSize - 1) / _pageSize;

    private IEnumerable<int> CurrentTicketNumbers
    {
        get
        {
            var firstTicketNumber = ((_selectedPage - 1) * _pageSize) + 1;
            var visibleCount = Math.Min(_pageSize, TotalItems - firstTicketNumber + 1);
            return Enumerable.Range(firstTicketNumber, Math.Max(0, visibleCount));
        }
    }
}
