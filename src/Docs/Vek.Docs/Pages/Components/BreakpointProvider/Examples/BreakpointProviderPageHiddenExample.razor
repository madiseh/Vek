@using Vek.Services
@namespace Vek.Docs.Examples

<VekBreakpointProvider>
    @for (int i = 0; i < _amountOfRows; i++)
    {
        <VekHidden Breakpoint="Breakpoint.Xl" Invert="true">
            <VekCard Class="pa-5">
                <VekText>XL</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.Lg" Invert="true">
            <VekCard Class="pa-5">
                <VekText>LG</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.Md" Invert="true">
            <VekCard Class="pa-5">
                <VekText>MD</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.Sm" Invert="true">
            <VekCard Class="pa-5">
                <VekText>SM</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.Xs" Invert="true">
            <VekCard Class="pa-5">
                <VekText>XS</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.LgAndUp" Invert="true">
            <VekCard Class="pa-5">
                <VekText>LG and Up</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.MdAndUp" Invert="true">
            <VekCard Class="pa-5">
                <VekText>MD and Up</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.SmAndUp" Invert="true">
            <VekCard Class="pa-5">
                <VekText>SM and Up</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.LgAndDown" Invert="true">
            <VekCard Class="pa-5">
                <VekText>LG and Down</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.MdAndDown" Invert="true">
            <VekCard Class="pa-5">
                <VekText>MD and Down</VekText>
            </VekCard>
        </VekHidden>
        <VekHidden Breakpoint="Breakpoint.SmAndDown" Invert="true">
            <VekCard Class="pa-5">
                <VekText>SM and Down</VekText>
            </VekCard>
        </VekHidden>
    }
</VekBreakpointProvider>

<VekSlider @bind-Value="_amountOfRows" Min="1" Max="100"></VekSlider>
<VekText>Rows: @_amountOfRows</VekText>

@code {
    private int _amountOfRows = 2;
} 