@namespace Vek.Docs.Examples

<VekPaper Outlined="true" Class="border-dashed pa-4">
    <VekStack Wrap="@_wrap" Spacing="4" Row="@_row" Style="@_size" AlignItems="AlignItems.Start">
        <VekButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 1</VekButton>
        <VekButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 2</VekButton>
        <VekButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 3</VekButton>
        <VekButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 4</VekButton>
        <VekButton Variant="Variant.Filled" Color="Color.Primary" Style="" >Button 5</VekButton>
    </VekStack>
</VekPaper>

<VekSlider @bind-Value="_width" Min="100" Max="800">Width: @_width.ToString()px</VekSlider>
<VekSlider @bind-Value="_height" Min="100" Max="800">Height: @_height.ToString()px</VekSlider>

<VekStack Row AlignItems="AlignItems.Center">
    <VekSwitch @bind-Value="_row" Color="Color.Primary">Row</VekSwitch>
    <VekChipSet T="Wrap" CheckMark @bind-SelectedValue="_wrap">
        <VekChip T="Wrap" Text="No Wrap" Value="@(Wrap.NoWrap)" SelectedColor="Color.Primary" Variant="Variant.Text" Default="true"/>
        <VekChip T="Wrap" Text="Wrap" Value="@(Wrap.Wrap)" SelectedColor="Color.Primary" Variant="Variant.Text" />
        <VekChip T="Wrap" Text="Wrap Reverse" Value="@(Wrap.WrapReverse)" SelectedColor="Color.Primary" Variant="Variant.Text" />
    </VekChipSet>
</VekStack>

@code {
    private Wrap _wrap = Wrap.NoWrap;

    private int _width { get; set; } = 200;
    private int _height { get; set; } = 200;
    private bool _row { get; set; } = true;

    private string _size => $"width: {_width}px; height: {_height}px;";
}