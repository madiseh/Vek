@namespace Vek.Docs.Examples

<VekPaper Outlined="true" Class="border-dashed">
    <VekStack Justify="_justify" AlignItems="_align" Row="_row" Style="height:200px;">
        <VekPaper Class="py-1 px-3 vek-theme-primary">Item 1</VekPaper>
        <VekPaper Class="py-3 px-3 vek-theme-primary">Item 2</VekPaper>
        <VekPaper Class="py-5 px-3 vek-theme-primary">Item 3</VekPaper>
    </VekStack>
</VekPaper>

<VekStack Row="true" Justify="Justify.Center">
    <VekRadioGroup T="bool" @bind-Value="@_row">
        <VekRadio Value="false" Dense="true">Column</VekRadio>
        <VekRadio Value="true" Dense="true">Row</VekRadio>
    </VekRadioGroup>
</VekStack>

<VekStack Row="true">
    <VekChipSet T="string" CheckMark Class="d-flex justify-center">
        <VekChip Text="Justify Start" OnClick="@(() => _justify = Justify.FlexStart)" SelectedColor="Color.Primary" Variant="Variant.Text" Default="true" />
        <VekChip Text="Justify End" OnClick="@(() => _justify = Justify.FlexEnd)" SelectedColor="Color.Primary" Variant="Variant.Text" />
    </VekChipSet>
    <VekChipSet T="string" CheckMark Class="d-flex justify-center">
        <VekChip Text="Align Start" OnClick="@(() => _align = AlignItems.Start)" SelectedColor="Color.Secondary" Variant="Variant.Text" Default="true" />
        <VekChip Text="Align End" OnClick="@(() => _align = AlignItems.End)" SelectedColor="Color.Secondary" Variant="Variant.Text" />
    </VekChipSet>
</VekStack>


@code {
    bool _row = true;
    Justify _justify = Justify.FlexStart;
    AlignItems _align = AlignItems.Start;
}