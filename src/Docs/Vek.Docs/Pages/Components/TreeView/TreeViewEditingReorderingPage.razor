@page "/components/treeview/editing-reordering"

<DocsPage>
    <DocsPageHeader Title="Tree View - Editing & Reordering" Component="@nameof(VekTreeView<T>)">
        <Description>Enable in-place F2 node renaming, drag-and-drop sibling reordering, and reparenting with drop guards.</Description>
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Renaming Nodes">
                <Description>
                    <p>Enable <CodeInline>AllowNodeRenaming</CodeInline> to rename labels in place. Focus a node and press F2, or double-click its label; Enter saves and Escape cancels. Empty names are rejected and <CodeInline>CanRenameFunc</CodeInline> can apply domain-specific validation.</p>
                    <p><CodeInline>OnNodeRenamed</CodeInline> receives the node, old text, and proposed new text. Update your source data in the callback when using an externally controlled tree.</p>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TreeViewRenamingExample)">
                <TreeViewRenamingExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Drag and Drop Reordering">
                <Description>
                    <p>
                        Enable node drag-and-drop reordering with <CodeInline>AllowDragDrop</CodeInline>. When enabled, users can drag nodes to reorder siblings or reparent items into other nodes.
                    </p>
                    <br/>
                    <p>
                        Configure reparenting using <CodeInline>AllowReparenting</CodeInline>, or validate drop operations dynamically using <CodeInline>CanDropFunc</CodeInline>. Handle completed drops with <CodeInline>OnNodeDrop</CodeInline>, which provides details about the source, target, and drop position (<c>Before</c>, <c>Into</c>, or <c>After</c>).
                    </p>
                </Description>
            </SectionHeader>
            <SectionContent Outlined="true" Code="@nameof(TreeViewDragDropExample)">
                <TreeViewDragDropExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
