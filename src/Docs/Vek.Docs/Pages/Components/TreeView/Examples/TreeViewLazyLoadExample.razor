@namespace Vek.Docs.Examples

<VekStack Spacing="3">
    <VekPaper Width="360px" Elevation="1" Class="pa-4">
        <VekStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <VekText Typo="Typo.subtitle1"><b>Remote File Explorer</b></VekText>
            <VekButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="ReloadRootAsync" Disabled="_isLoading">
                Reload Tree
            </VekButton>
        </VekStack>

        <VekTreeView @ref="_treeView"
                     Items="@_items"
                     LoadChildrenAsync="@LoadChildrenAsync"
                     HasChildren="@(node => node.Icon == Icons.Material.Filled.Folder || node.Icon == Icons.Material.Filled.FolderOpen)"
                     Hover="true"
                     Width="100%">
            <ItemTemplate>
                <VekTreeViewItem Value="@context.Value"
                                 Text="@context.Text"
                                 Icon="@context.Icon"
                                 IconExpanded="@Icons.Material.Filled.FolderOpen"
                                 Items="@context.Children"
                                 LoadingIconColor="Color.Primary" />
            </ItemTemplate>
        </VekTreeView>
    </VekPaper>

    @if (_activityLog.Count > 0)
    {
        <VekPaper Width="360px" Outlined="true" Class="pa-3">
            <VekText Typo="Typo.caption"><b>Activity Log:</b></VekText>
            @foreach (var log in _activityLog.TakeLast(3))
            {
                <VekText Typo="Typo.caption" Class="d-block text-secondary">@log</VekText>
            }
        </VekPaper>
    }
</VekStack>

@code {
#nullable enable
    private VekTreeView<string>? _treeView;
    private bool _isLoading;
    private readonly List<string> _activityLog = [];

    private List<TreeItemData<string>> _items =
    [
        new("documents") { Text = "Documents", Icon = Icons.Material.Filled.Folder, HasChildren = true },
        new("pictures") { Text = "Pictures", Icon = Icons.Material.Filled.Folder, HasChildren = true },
        new("readme") { Text = "README.md", Icon = Icons.Material.Filled.InsertDriveFile, HasChildren = false }
    ];

    private async Task<IEnumerable<TreeItemData<string>>> LoadChildrenAsync(TreeItemData<string> parent)
    {
        _isLoading = true;
        _activityLog.Add($"Fetching children for '{parent.Text}'...");
        StateHasChanged();

        // Simulate network API request
        await Task.Delay(700);

        _activityLog.Add($"Loaded children for '{parent.Text}' at {DateTime.Now:HH:mm:ss}");
        _isLoading = false;

        return parent.Value switch
        {
            "documents" =>
            [
                new("work") { Text = "Work Projects", Icon = Icons.Material.Filled.Folder, HasChildren = true },
                new("finance") { Text = "Invoices.xlsx", Icon = Icons.Material.Filled.TableChart, HasChildren = false },
                new("budget") { Text = "AnnualBudget.pdf", Icon = Icons.Material.Filled.PictureAsPdf, HasChildren = false }
            ],
            "pictures" =>
            [
                new("vacation") { Text = "Vacation2026.png", Icon = Icons.Material.Filled.Image, HasChildren = false },
                new("profile") { Text = "Avatar.jpg", Icon = Icons.Material.Filled.Image, HasChildren = false }
            ],
            "work" =>
            [
                new("spec") { Text = "Specification.docx", Icon = Icons.Material.Filled.Description, HasChildren = false },
                new("notes") { Text = "MeetingNotes.txt", Icon = Icons.Material.Filled.Notes, HasChildren = false }
            ],
            _ => []
        };
    }

    private async Task ReloadRootAsync()
    {
        if (_treeView is not null && _items.Count > 0)
        {
            await _treeView.ReloadNodeAsync(_items[0]);
            _activityLog.Add($"Reloaded node '{_items[0].Text}'");
        }
    }
}
