            ]
        },
        new TreeItemData<WorkspaceEntry>(new WorkspaceEntry("Release Checklist", "Elena Vance", "Document", 310, new DateOnly(2026, 10, 22)))
        {
            Text = "Release Checklist",
            Icon = Icons.Material.Filled.Description,
            HasChildren = false
        }
    ];

    private static Color GetKindColor(string kind) => kind switch
    {
        "Division" => Color.Primary,
        "Service" => Color.Info,
        "Component" => Color.Success,
        "Library" => Color.Secondary,
        _ => Color.Default
    };

    private Task ExpandAllAsync() => _treeList?.ExpandAllAsync() ?? Task.CompletedTask;

    private Task CollapseAllAsync() => _treeList?.CollapseAllAsync() ?? Task.CompletedTask;

    private Task ResetWidthsAsync() => _treeList?.ResetColumnWidthsAsync() ?? Task.CompletedTask;

    private void HandleSortChanged(TreeListSortEventArgs<WorkspaceEntry> args)
    {
        _statusMessage = args.SortDirection == SortDirection.None
            ? $"Cleared sort on '{args.Column.Title}'."
            : $"Sorted '{args.Column.Title}' ({args.SortDirection}). Active sort columns: {args.ActiveSorts.Count}.";
    }

    private void HandleColumnResized(TreeListColumnResizeEventArgs<WorkspaceEntry> args)
    {
        _statusMessage = args.NewWidth.HasValue
            ? $"Resized '{args.Column.Title}' from {args.OldWidth:0}px to {args.NewWidth.Value:0}px."
            : $"Reset width on '{args.Column.Title}'.";
    }
}
