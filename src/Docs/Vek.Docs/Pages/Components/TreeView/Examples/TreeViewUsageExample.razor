@namespace Vek.Docs.Examples

<VekPaper Width="300px" Elevation="0">
    <VekTreeView T="string" ReadOnly="@ReadOnly" Hover="@Hover" Dense="@Dense" Disabled="@Disabled"
                 ExpandOnClick="@ExpandOnClick" ExpandOnDoubleClick="@ExpandOnDoubleClick">
        <VekTreeViewItem Text="Applications" Expanded>
            <VekTreeViewItem Text="Terminal" />
        </VekTreeViewItem>
        <VekTreeViewItem Text="Documents" Expanded>
            <VekTreeViewItem Text="Vek" Expanded>
                <VekTreeViewItem Text="API" />
                <VekTreeViewItem Text="Components" />
                <VekTreeViewItem Text="Features" />
            </VekTreeViewItem>
        </VekTreeViewItem>
    </VekTreeView>
</VekPaper>

<VekStack Row Wrap="Wrap.Wrap" Justify="Justify.Center">
    <VekSwitch @bind-Value="ReadOnly" Color="Color.Primary">ReadOnly</VekSwitch>
    <VekSwitch @bind-Value="Hover" Color="Color.Primary">Hover</VekSwitch>
    <VekSwitch @bind-Value="Ripple" Color="Color.Primary">Ripple</VekSwitch>
    <VekSwitch @bind-Value="Dense" Color="Color.Primary">Dense</VekSwitch>
    <VekSwitch @bind-Value="Disabled" Color="Color.Primary">Disabled</VekSwitch>
    <VekSwitch @bind-Value="ExpandOnClick" Color="Color.Primary">ExpandOnClick</VekSwitch>
    <VekSwitch @bind-Value="ExpandOnDoubleClick" Color="Color.Primary">ExpandOnDoubleClick</VekSwitch>
</VekStack>

@code {
    public bool ReadOnly = true;
    public bool Hover = true;
    public bool Ripple;
    public bool Dense;
    public bool Disabled;
    public bool ExpandOnClick = true;
    public bool ExpandOnDoubleClick;
}
