@namespace Vek.Docs.Examples

<VekPaper Width="300px" Elevation="0">
    <VekTreeView @ref="TreeView" Hover AutoExpand="@AutoExpand" @bind-SelectedValue="SelectedValue" SelectionMode="@SelectionMode.ToggleSelection">
        <VekTreeViewItem Value="@("C:")" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
            <VekTreeViewItem Value="@("config")" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
                <VekTreeViewItem Value='"launch.json"' Icon="@Icons.Custom.FileFormats.FileCode" />
                <VekTreeViewItem Value='"tasks.json"' Icon="@Icons.Custom.FileFormats.FileCode" />
            </VekTreeViewItem>
            <VekTreeViewItem Value="@("images")" Icon="@Icons.Custom.Uncategorized.Folder" IconExpanded="@Icons.Custom.Uncategorized.FolderOpen">
                <VekTreeViewItem Value="@("logo.png")" Icon="@Icons.Custom.FileFormats.FileImage" />
            </VekTreeViewItem>
        </VekTreeViewItem>
    </VekTreeView>
</VekPaper>

<VekStack Row Justify="Justify.Center" Style="width: 100%" Wrap="Wrap.Wrap">
    <VekButton Color="Color.Primary" OnClick="@(()=>TreeView.ExpandAllAsync())" Variant="Variant.Filled">Expand all</VekButton>
    <VekButton Color="Color.Dark" OnClick="@(()=>TreeView.CollapseAllAsync())" Variant="Variant.Filled">Collapse all</VekButton>
    <VekChipSet T="string" @bind-SelectedValue="SelectedValue" Color="Color.Primary" Variant="Variant.Text" SelectionMode="@SelectionMode.ToggleSelection">
        <VekChip Text="config"/>
        <VekChip Text="launch.json"/>
        <VekChip Text="tasks.json"/>
        <VekChip Text="images"/>
        <VekChip Text="logo.png"/>
    </VekChipSet>
    <VekSwitch @bind-Value="AutoExpand" Color="Color.Primary">AutoExpand</VekSwitch>
</VekStack>

@code {
    public VekTreeView<string> TreeView;
    public string SelectedValue = null;
    public bool AutoExpand = true;
}
