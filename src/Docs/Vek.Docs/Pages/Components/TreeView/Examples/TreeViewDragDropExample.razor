@namespace Vek.Docs.Examples

<VekStack Spacing="3">
    <VekStack Row Wrap="Wrap.Wrap" Spacing="4" AlignItems="AlignItems.Center">
        <VekSwitch @bind-Value="AllowDragDrop" Color="Color.Primary">Allow Drag &amp; Drop</VekSwitch>
        <VekSwitch @bind-Value="AllowReparenting" Color="Color.Secondary">Allow Reparenting</VekSwitch>
    </VekStack>

    <VekPaper Width="320px" Class="pa-4" Outlined="true">
        <VekTreeView T="string" AllowDragDrop="@AllowDragDrop" AllowReparenting="@AllowReparenting" OnNodeDrop="@HandleNodeDrop">
            <VekTreeViewItem Value="@("Documents")" Text="Documents" Expanded="true">
                <VekTreeViewItem Value="@("Resume.pdf")" Text="Resume.pdf" />
                <VekTreeViewItem Value="@("Budget.xlsx")" Text="Budget.xlsx" />
            </VekTreeViewItem>
            <VekTreeViewItem Value="@("Projects")" Text="Projects" Expanded="true">
                <VekTreeViewItem Value="@("Vek Components")" Text="Vek Components" />
                <VekTreeViewItem Value="@("Design System")" Text="Design System" />
            </VekTreeViewItem>
            <VekTreeViewItem Value="@("Archive")" Text="Archive" />
        </VekTreeView>
    </VekPaper>

    @if (!string.IsNullOrEmpty(LastDropEvent))
    {
        <VekAlert Severity="Severity.Info" Dense="true" Class="mt-2">
            @LastDropEvent
        </VekAlert>
    }
</VekStack>

@code {
    public bool AllowDragDrop = true;
    public bool AllowReparenting = true;
    public string LastDropEvent = string.Empty;

    private void HandleNodeDrop(TreeNodeDropEventArgs<string> args)
    {
        LastDropEvent = $"Moved '{args.SourceValue}' {args.DropPosition.ToString().ToLowerInvariant()} '{args.TargetValue}'";
    }
}
