@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem xs="12" sm="6" md="9" Class="d-flex flex-column align-center justify-center">
        <VekButton Class="mb-4" tabindex="-1" Variant="Variant.Outlined" OnClick="@(async() => await _iconButton1.FocusAsync())">Focus the element</VekButton>
        <VekTooltip ShowOnClick="_click" ShowOnFocus="_focus" ShowOnHover="_hover" Text="Im Vek Tooltip">
            <VekIconButton @ref="_iconButton1" Icon="@Icons.Custom.Brands.Vek" Color="Color.Primary" Size="Size.Large" />
        </VekTooltip>
    </VekItem>

    <VekItem xs="12" sm="6" md="3">
        <VekCheckBox @bind-Value="_focus" Label="Show On Focus" Color="Color.Primary" />
        <VekCheckBox @bind-Value="_hover" Label="Show On Hover" Color="Color.Primary" />
        <VekCheckBox @bind-Value="_click" Label="Click" Color="Color.Primary" />
    </VekItem>
</VekGrid>


@code {

    bool _click = false;
    bool _hover = true;
    bool _focus = true;

    VekIconButton _iconButton1;
}
