@namespace Vek.Docs.Examples

<VekStack Spacing="4">
    <VekText Typo="Typo.h6">Phone Number (Required Digits & Literals Preservation)</VekText>
    <VekMaskedInput @bind-Value="_phoneValue"
                    Label="Phone Number"
                    Mask="(000) 000-0000"
                    PromptChar="@_promptChar"
                    ShowLiterals="@_showLiterals"
                    SaveLiteralRepresentation="@_saveLiterals"
                    Clearable="true"
                    Variant="Variant.Outlined" />
    <VekText Typo="Typo.body2">
        <strong>Bound Value:</strong> <code>@(_phoneValue ?? "(empty)")</code>
    </VekText>

    <VekDivider Class="my-2" />

    <VekText Typo="Typo.h6">Alphanumeric Code (Mixed Letter & Digit Tokens)</VekText>
    <VekMaskedInput @bind-Value="_codeValue"
                    Label="Product / License Code"
                    Mask="LLL-000-AAA"
                    PromptChar="@_promptChar"
                    ShowLiterals="@_showLiterals"
                    SaveLiteralRepresentation="@_saveLiterals"
                    Clearable="true"
                    Variant="Variant.Outlined" />
    <VekText Typo="Typo.body2">
        <strong>Bound Value:</strong> <code>@(_codeValue ?? "(empty)")</code>
    </VekText>

    <VekDivider Class="my-2" />

    <VekText Typo="Typo.subtitle1"><strong>Interactive Controls:</strong></VekText>
    <VekStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
        <VekSelect @bind-Value="_showLiterals" Label="Show Literals Mode" Dense="true" Variant="Variant.Outlined" Style="min-width: 200px;">
            <VekSelectItem Value="ShowLiterals.Always">Always</VekSelectItem>
            <VekSelectItem Value="ShowLiterals.WhileEditing">While Editing</VekSelectItem>
            <VekSelectItem Value="ShowLiterals.Never">Never</VekSelectItem>
        </VekSelect>

        <VekSelect @bind-Value="_promptChar" Label="Prompt Character" Dense="true" Variant="Variant.Outlined" Style="min-width: 160px;">
            <VekSelectItem Value="'_'">Underscore ('_')</VekSelectItem>
            <VekSelectItem Value="'#'">Hash ('#')</VekSelectItem>
            <VekSelectItem Value="'-'">Dash ('-')</VekSelectItem>
            <VekSelectItem Value="' '">Space (' ')</VekSelectItem>
        </VekSelect>

        <VekSwitch @bind-Value="_saveLiterals" Color="Color.Primary" Label="Save Literal Representation" />
    </VekStack>
</VekStack>

@code {
    private string _phoneValue = "5551234567";
    private string _codeValue;
    private char _promptChar = '_';
    private ShowLiterals _showLiterals = ShowLiterals.Always;
    private bool _saveLiterals = true;
}
