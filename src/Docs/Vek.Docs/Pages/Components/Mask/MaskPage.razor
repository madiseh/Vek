@page "/components/mask"
@page "/components/maskedinput"

<DocsPage>
    <DocsPageHeader Title="Masked Input" Component="@nameof(VekMaskedInput)" />
<DocsPageContent>

<DocsPageSection>
    <SectionHeader Title="Pattern Rules, Prompt Characters, and Literals">
        <Description>
            <CodeInline>VekMaskedInput</CodeInline> conforms user input to formatting rules using standard pattern tokens.
            Standard tokens support digits (<CodeInline>0</CodeInline> required, <CodeInline>9</CodeInline> optional, <CodeInline>#</CodeInline> digit or sign),
            letters (<CodeInline>L</CodeInline> required, <CodeInline>?</CodeInline> optional), and alphanumeric characters (<CodeInline>A</CodeInline> required, <CodeInline>a</CodeInline> optional).
            Use <CodeInline>PromptChar</CodeInline> to customize the placeholder symbol for unfilled positions (default: <CodeInline>_</CodeInline>),
            <CodeInline>ShowLiterals</CodeInline> (<CodeInline>Always</CodeInline>, <CodeInline>WhileEditing</CodeInline>, <CodeInline>Never</CodeInline>) to control when delimiters and prompt symbols appear, and
            <CodeInline>SaveLiteralRepresentation</CodeInline> to choose whether bound values retain formatted delimiters or emit clean input data.
        </Description>
    </SectionHeader>
    <SectionContent Code="@nameof(MaskedInputPatternRulesExample)">
        <MaskedInputPatternRulesExample />
    </SectionContent>
</DocsPageSection>

</DocsPageContent>
</DocsPage>
