@namespace Vek.Docs.Examples

<VekCard>
    <VekCardHeader>
        <CardHeaderAvatar>
            <VekAvatar Color="Color.Secondary">I</VekAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <VekText Typo="Typo.body1">Istra Croatia</VekText>
            <VekText Typo="Typo.body2">Peninsula in Europe</VekText>
        </CardHeaderContent>
        <CardHeaderActions>
            <VekIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" />
        </CardHeaderActions>
    </VekCardHeader>
    <VekCardMedia Image="images/pilars.jpg" Height="250" />
    <VekCardContent>
        <VekText Typo="Typo.body2">This photo was taken in a small village in Istra Croatia.</VekText>
    </VekCardContent>
    <VekCardActions>
        <VekIconButton Icon="@Icons.Material.Filled.Favorite" Color="Color.Default" />
        <VekIconButton Icon="@Icons.Material.Filled.Share" Color="Color.Default" />
    </VekCardActions>
</VekCard>