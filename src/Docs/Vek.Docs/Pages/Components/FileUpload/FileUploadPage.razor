@page "/components/fileupload"
@page "/components/fileuploader"

<DocsPage>
    <DocsPageHeader Title="File Upload" Component="@nameof(VekFileUpload<T>)">
        <Description>
            <VekText Typo="@Typo.body1" Class="my-4">
                A <CodeInline>VekFileUpload</CodeInline> handles file selection, validation, and upload workflows with buttons or drag-and-drop surfaces.
            </VekText>
        </Description>
    </DocsPageHeader>
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Basic Usage">
                <Description>
                    Use a <CodeInline>VekFileUpload</CodeInline>, set <CodeInline>T</CodeInline>, and choose the options you need. For drag-and-drop, set <CodeInline>DragAndDrop</CodeInline>
                    to <CodeInline>true</CodeInline>. The drag area fills its parent by default, and you can target <CodeInline>.vek-file-upload-dragarea</CodeInline> for additional styling.
                    When <CodeInline>Disabled</CodeInline> is <CodeInline>true</CodeInline>, the component disables its internal controls automatically.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" ShowCode="false" Code="@nameof(FileUploadBasicExample)">
                <FileUploadBasicExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Multiple Files and Accept Filter">
                <Description>
                    Set <CodeInline>T="IReadOnlyList&lt;IBrowserFile&gt;"</CodeInline> or bind <CodeInline>Files</CodeInline> to an <CodeInline>IReadOnlyList&lt;IBrowserFile&gt;</CodeInline> to allow multiple files.
                    Use <CodeInline>Accept</CodeInline> to limit valid file types. To select more than 10 files at a time, set <CodeInline>MaximumFileCount</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" ShowCode="false" Code="@nameof(FileUploadMultipleAcceptExample)">
                <FileUploadMultipleAcceptExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Append Multiple Files">
                <Description>
                    When <CodeInline>AppendMultipleFiles</CodeInline> is <CodeInline>true</CodeInline>, new selections are appended to the existing list instead of replacing it.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" ShowCode="false" Code="@nameof(FileUploadAppendMultipleExample)">
                <FileUploadAppendMultipleExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Explore Features">
                <Description>Browse specific features and usage patterns in detail:</Description>
            </SectionHeader>
            <div class="vek-bento-grid mt-4">
                <DocsExploreCard Title="Drag & Drop" Category="File Upload" Link="/components/fileupload/drag-and-drop" Description="Full-surface interactive drop zones, custom drop areas, and pointer/drag feedback styling.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.DriveFolderUpload" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Full-surface · Custom · Hover</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Validation & Previews" Category="File Upload" Link="/components/fileupload/validation-previews" Description="Image thumbnails, allowed MIME types, max file size guards, and VekForm integration.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Thumbnails · Form Validation</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Chunked Upload" Category="File Upload" Link="/components/fileupload/chunked-upload" Description="Upload large files in bounded chunks with real-time progress and automatic retry on transient errors.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.CloudSync" Color="Color.Info" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Progress · Chunks · Transient Retry</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Custom Content & Templates" Category="File Upload" Link="/components/fileupload/templates-styling" Description="Custom trigger buttons, chips, selected templates, and fine-grained event callbacks.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.DashboardCustomize" Color="Color.Warning" Size="Size.Large" />
                        <VekText Typo="Typo.body2">CustomContent · SelectedTemplate</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Drop Zone" Category="File Upload" Link="/components/dropzone" Description="Kanban boards and drag-and-drop reordering between distinct item drop zones.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.Dashboard" Color="Color.Secondary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Kanban · Drag Items · Zones</VekText>
                    </VekStack>
                </DocsExploreCard>
            </div>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
