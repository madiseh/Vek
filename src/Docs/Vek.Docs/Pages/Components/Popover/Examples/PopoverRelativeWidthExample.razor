@namespace Vek.Docs.Examples


<div style="width: 250px;">
    <VekButton Variant="Variant.Filled" Color="Color.Primary" FullWidth OnClick="@ToggleOpen">Open</VekButton>
    <VekPopover Open="@_open" Class="pa-4" Fixed="true" RelativeWidth="@_dropdownWidth" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
        <VekText>Content of the popover can be anything.</VekText>
        <VekButton OnClick="@ToggleOpen" Class="ml-auto mr-n3 mb-1" Color="Color.Error">Close</VekButton>
    </VekPopover>
</div>

<div style="width: 250px; margin-left: 150px;">
    <VekSelect T="DropdownWidth" Label="Dropdown Width" @bind-Value="@_dropdownWidth">
        <VekSelectItem Value="@DropdownWidth.Relative">Relative</VekSelectItem>
        <VekSelectItem Value="@DropdownWidth.Adaptive">Adaptive</VekSelectItem>
        <VekSelectItem Value="@DropdownWidth.Ignore">Ignore</VekSelectItem>
    </VekSelect>
</div>

@code{
    private bool _open;

    private DropdownWidth _dropdownWidth = DropdownWidth.Ignore;

    private void ToggleOpen() => _open = !_open;
}
