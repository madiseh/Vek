@page "/components/drawer"

<DocsPage>
    <DocsPageHeader Title="Drawer" Component="@nameof(VekDrawer)" />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Usage">
                <Description>
                    If you use two-way binding <CodeInline>@("@bind-Open=\"...\"")</CodeInline>, you can toggle the Drawer and it will close itself on navigation. If you set its <CodeInline>Open</CodeInline> parameter without two-way binding,
                    you effectively force it to stay open or closed, depending on the provided value.
                    <VekAlert Severity="Severity.Info" Dense="true" Class="mt-3">Always use <CodeInline>@("@bind-Open")</CodeInline> instead of <CodeInline>@("Open")</CodeInline> for auto-closing to work.</VekAlert>
                </Description>
            </SectionHeader>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Temporary Drawer">
                <Description>
                    The Temporary Drawer opens temporarily above all other content until a section is selected, or until the overlay is clicked if <CodeInline>OverlayAutoClose</CodeInline> is set to true.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(DrawerTemporaryExample)" ShowCode="false">
                <DrawerTemporaryExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Persistent Drawer">
                <Description>
                    The Persistent Drawer is positioned alongside the content. When opened, it forces other contents to adjust their width.
                </Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(DrawerPersistentExample)" ShowCode="false" Block="true" FullWidth="true">
                <DrawerPersistentExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Explore Features">
                <Description>Browse specific features and usage patterns in detail:</Description>
            </SectionHeader>
            <div class="docs-explore-grid">
                <DocsExploreCard Title="Responsive & Mini" Category="Drawer" Link="/components/drawer/responsive-mini" Description="Responsive breakpoint auto-toggling and mini icon strips with hover expansion.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.ViewSidebar" Color="Color.Primary" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Responsive · Mini · Hover Expand</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Positioning & Anchoring" Category="Drawer" Link="/components/drawer/positioning-anchoring" Description="Anchor to start/end, absolute left/right placement, and docked AppBar clipping.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.VerticalSplit" Color="Color.Info" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Anchor · ClipMode · RTL/LTR</VekText>
                    </VekStack>
                </DocsExploreCard>
                <DocsExploreCard Title="Sizing & Containers" Category="Drawer" Link="/components/drawer/sizing-containers" Description="Custom dimensions, overlay suppression, and embedding inside isolated VekDrawerContainers.">
                    <VekStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <VekIcon Icon="@Icons.Material.Filled.AspectRatio" Color="Color.Warning" Size="Size.Large" />
                        <VekText Typo="Typo.body2">Inner Container · Width & Height</VekText>
                    </VekStack>
                </DocsExploreCard>
            </div>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
