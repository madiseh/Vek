@namespace Vek.Docs.Examples

<VekPaper Height="200px" Style="overflow:hidden; position:relative;">
    <VekDrawerContainer Class="vek-height-full">
        <VekDrawer @bind-Open="@_open" Fixed="false" Elevation="1" Variant="@DrawerVariant.Mini" OpenMiniOnHover="true" Breakpoint="Breakpoint.None">
            <VekNavMenu>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Store">Store</VekNavLink>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LibraryBooks">Library</VekNavLink>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Group">Community</VekNavLink>
            </VekNavMenu>
        </VekDrawer>
        <div class="d-flex justify-center align-center vek-height-full">
            <VekButton OnClick="@ToggleDrawer" Color="Color.Primary">Toggle</VekButton>
        </div>
    </VekDrawerContainer>
</VekPaper>

@code
{ 
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    } 
}
