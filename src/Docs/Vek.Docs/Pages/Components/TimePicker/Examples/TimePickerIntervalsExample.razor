@namespace Vek.Docs.Examples

<VekStack Spacing="4">
    <VekStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
        <VekTimePicker Label="15-Minute Interval (12h)"
                       @bind-Time="_time1"
                       MinuteInterval="15"
                       TimeEditFormat="TimeEditFormat.TwelveHour" />

        <VekTimePicker Label="30-Minute Interval (24h)"
                       @bind-Time="_time2"
                       MinuteInterval="30"
                       TimeEditFormat="TimeEditFormat.TwentyFourHour" />
    </VekStack>

    <VekStack Row="true" Spacing="4" Wrap="Wrap.Wrap">
        <VekTimePicker Label="With Seconds (12h)"
                       @bind-Time="_timeWithSeconds1"
                       ShowSeconds="true"
                       TimeEditFormat="TimeEditFormat.TwelveHour" />

        <VekTimePicker Label="Seconds with 10s Step (24h)"
                       @bind-Time="_timeWithSeconds2"
                       ShowSeconds="true"
                       SecondInterval="10"
                       TimeEditFormat="TimeEditFormat.TwentyFourHour" />
    </VekStack>
</VekStack>

@code {
    private TimeSpan? _time1 = new TimeSpan(9, 15, 0);
    private TimeSpan? _time2 = new TimeSpan(14, 30, 0);
    private TimeSpan? _timeWithSeconds1 = new TimeSpan(10, 15, 30);
    private TimeSpan? _timeWithSeconds2 = new TimeSpan(22, 45, 10);
}
