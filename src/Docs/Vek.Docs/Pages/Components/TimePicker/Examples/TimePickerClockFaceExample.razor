@namespace Vek.Docs.Examples

<VekStack Spacing="6">
    <VekStack Row="true" Spacing="8" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.Center">
        <VekPaper Class="pa-6" Elevation="3" Style="display: flex; flex-direction: column; align-items: center; border-radius: 16px;">
            <VekText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 600;">24-Hour Analog Clock Dial</VekText>
            <VekClockFace @bind-Time="_time24"
                          @bind-View="_view24"
                          TimeEditFormat="TimeEditFormat.TwentyFourHour"
                          ShowHeader="true"
                          Color="Color.Primary" />
            <VekText Typo="Typo.body2" Class="mt-3" Color="Color.Secondary">
                Selected: @(_time24.HasValue ? _time24.Value.ToString(@"hh\:mm") : "--:--") (24-Hour Dual-Ring)
            </VekText>
        </VekPaper>

        <VekPaper Class="pa-6" Elevation="3" Style="display: flex; flex-direction: column; align-items: center; border-radius: 16px;">
            <VekText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 600;">12-Hour Radial Selector</VekText>
            <VekClockFace @bind-Time="_time12"
                          @bind-View="_view12"
                          TimeEditFormat="TimeEditFormat.TwelveHour"
                          ShowHeader="true"
                          ShowSeconds="true"
                          Color="Color.Secondary" />
            <VekText Typo="Typo.body2" Class="mt-3" Color="Color.Secondary">
                Selected: @(_time12.HasValue ? DateTime.Today.Add(_time12.Value).ToString("hh:mm:ss tt") : "--:--:--") (With Seconds)
            </VekText>
        </VekPaper>
    </VekStack>
</VekStack>

@code {
    private TimeSpan? _time24 = new TimeSpan(14, 35, 0);
    private OpenTo _view24 = OpenTo.Hours;

    private TimeSpan? _time12 = new TimeSpan(10, 15, 45);
    private OpenTo _view12 = OpenTo.Hours;
}
