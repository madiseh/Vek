@page "/components/timepicker"

<DocsPage>
    <DocsPageHeader Title="Time Picker" Component="@nameof(VekTimePicker)" />
    <DocsPageContent>

        <DocsPageSection>
            <SectionHeader Title="Basic Usage">
                <Description>
                    <VekAlert Severity="Severity.Info" Dense="true" Class="mt-3">Note: Always use the two-way binding <CodeInline>@@bind-Time</CodeInline> to bind to a field of type <CodeInline>TimeSpan?</CodeInline></VekAlert>
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TimePickerBasicUsageExample)" ShowCode="true">
                <TimePickerBasicUsageExample />
            </SectionContent>
        </DocsPageSection>
        
        <DocsPageSection>
            <SectionHeader Title="Read Only">
                <Description>If <CodeInline>ReadOnly</CodeInline> is set to true, the TimePicker can be used but the value will remain unchanged regardless of the actions performed or the values entered.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TimePickerReadOnlyExample)" ShowCode="false">
                <TimePickerReadOnlyExample />
            </SectionContent>
        </DocsPageSection>
                
        <DocsPageSection>
            <SectionHeader Title="Action Buttons">
                <Description>You can add buttons by using the <CodeInline>PickerActions</CodeInline> render fragment. If <CodeInline>AutoClose</CodeInline> is set to true and PickerActions are defined, the hour and the minutes can be selected and the drop-down will close without having to click any of the action buttons.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TimePickerActionButtonsExample)" ShowCode="false">
                <TimePickerActionButtonsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Dialog Mode">
                <Description></Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TimePickerDialogExample)" ShowCode="false">
                <TimePickerDialogExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Static Mode">
                <Description></Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Code="@nameof(TimePickerStaticExample)" ShowCode="false">
                <TimePickerStaticExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Open to Minutes">
                <Description>By default, VekTimePicker opens the hours editor and then switches into the minutes editor. By setting <CodeInline>OpenTo="OpenTo.Minutes"</CodeInline>, it will open the minutes editor instead.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TimePickerViewsExample)" ShowCode="false">
                <TimePickerViewsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Edit Mode">
                <Description>By setting the <CodeInline>TimeEditMode</CodeInline>, you can restrict editing of the time value to allow only changing hours or minutes.</Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TimePickerTimeEditModeExample)" ShowCode="false">
                <TimePickerTimeEditModeExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Colors">
                <Description></Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Class="demo-datetime-margin" Code="@nameof(TimePickerColorExample)" ShowCode="false">
                <TimePickerColorExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Elevation">
                <Description>You can change the elevation with the <CodeInline>Elevation</CodeInline> parameter. The default level is 8 for Inline, and 0 for Static or Dialog.</Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Class="demo-datetime-margin" Code="@nameof(TimePickerElevationExample)" ShowCode="false">
                <TimePickerElevationExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Intervals, Seconds, and 12/24-Hour Formats">
                <Description>
                    Configure step intervals with <CodeInline>MinuteInterval</CodeInline> and <CodeInline>SecondInterval</CodeInline>,
                    enable seconds selection using <CodeInline>ShowSeconds="true"</CodeInline>, and choose between 12-hour (with AM/PM) or 24-hour display using <CodeInline>TimeEditFormat</CodeInline>.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TimePickerIntervalsExample)" ShowCode="true">
                <TimePickerIntervalsExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="MinuteSelectionStep">
                <Description>You can change the granularity of selectable times with the <CodeInline>MinuteSelectionStep</CodeInline> parameter.</Description>
            </SectionHeader>
            <SectionContent DarkenBackground="true" Class="demo-datetime-margin" Code="@nameof(TimePickerStepExample)" ShowCode="false">
                <TimePickerStepExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Radial Clock Face">
                <Description>
                    <CodeInline>VekClockFace</CodeInline> provides an analog circular clock dial with touch and mouse dragging hand selector, 24-hour dual-ring mode (inner ring 13–24/00 and outer ring 1–12), automatic transition from hours to minutes selection upon pick, and full keyboard navigation.
                </Description>
            </SectionHeader>
            <SectionContent Code="@nameof(TimePickerClockFaceExample)" ShowCode="true">
                <TimePickerClockFaceExample />
            </SectionContent>
        </DocsPageSection>

        <DocsPageSection>
            <SectionHeader Title="Keyboard Navigation">
                <Description>
                    <VekText>VekTimePicker supports keyboard navigation.</VekText>
                    <br />
                    <VekText><CodeInline>Escape</CodeInline> or <CodeInline>Alt+ArrowUp</CodeInline> keys to close dropdown</VekText>
                    <VekText><CodeInline>Enter</CodeInline> or <CodeInline>NumpadEnter</CodeInline> or <CodeInline>ArrowDown</CodeInline> or <CodeInline>ArrowUp</CodeInline> keys to open dropdown</VekText>
                    <VekText><CodeInline>Space</CodeInline> key to toggle open/close the picker (when it is not editable)</VekText>
                    <VekText><CodeInline>ArrowUp</CodeInline> or <CodeInline>Ctrl+ArrowRight</CodeInline> keys to increase hour by 1</VekText>
                    <VekText><CodeInline>ArrowDown</CodeInline> or <CodeInline>Ctrl+ArrowLeft</CodeInline> keys to decrease hour by 1</VekText>
                    <VekText><CodeInline>ArrowRight</CodeInline> and <CodeInline>ArrowLeft</CodeInline> keys to increase/decrease minute by 1</VekText>
                    <VekText><CodeInline>Shift+ArrowRight</CodeInline> and <CodeInline>Shift+ArrowLeft</CodeInline> keys to increase/decrease minute by 5</VekText>
                    <VekText><CodeInline>Ctrl+Shift+Backspace</CodeInline> keys to reset (validation)</VekText>
                </Description>
            </SectionHeader>
            <SectionContent Class="demo-datetime-margin" Code="@nameof(TimePickerKeyboardNavigationExample)" ShowCode="false">
                <TimePickerKeyboardNavigationExample />
            </SectionContent>
        </DocsPageSection>

    </DocsPageContent>
</DocsPage>
