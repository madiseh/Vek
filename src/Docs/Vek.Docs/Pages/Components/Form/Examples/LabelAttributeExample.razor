@using System.ComponentModel.DataAnnotations
@namespace Vek.Docs.Examples

<VekCard>
    <VekCardContent>
        <VekForm Spacing="2">
            <VekDatePicker For="@(() => model.Date)" />
            <VekDatePicker For="@(() => model.Date)" Label="Parameter Label" />
            <VekSwitch For="@(() => model.Boolean)" Color="Color.Primary" />
            <VekSwitch For="@(() => model.Boolean)" Label="Parameter Label" Color="Color.Primary" />
            <VekTextField For="@(() => model.String)" />
            <VekTextField For="@(() => model.String)" Label="Parameter Label" />
        </VekForm>
    </VekCardContent>
</VekCard>

@code {
    DisplayNameLabelClass model = new();

    public class DisplayNameLabelClass
    {
        [Label("Date LabelAttribute")]
        public DateTime? Date { get; set; }
        [Label("Boolean LabelAttribute")]
        public bool Boolean { get; set; }
        [Label("String LabelAttribute")]
        public string String { get; set; }
    }
}
