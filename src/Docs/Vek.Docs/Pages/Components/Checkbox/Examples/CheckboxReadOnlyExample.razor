@namespace Vek.Docs.Examples

<div>
    <VekCheckBox ReadOnly="@ReadOnly" @bind-Value="Label_Checkbox1" Label="@(ReadOnly ? "ReadOnly Checkbox 1" : "EditMode Checkbox 1")"/>
    <VekCheckBox ReadOnly="@ReadOnly" @bind-Value="Label_Checkbox2" Label="@(ReadOnly ? "ReadOnly Checkbox 2" : "EditMode Checkbox 2")"/>
</div>
<VekSelect  @bind-Value="Label_Checkbox1" Label="Checkbox 1">
    <VekSelectItem Value="@(false)">False</VekSelectItem>
    <VekSelectItem Value="@(true)">True</VekSelectItem>
</VekSelect>
<VekSelect @bind-Value="Label_Checkbox2" Label="Checkbox 2">
    <VekSelectItem Value="@(false)">False</VekSelectItem>
    <VekSelectItem Value="@(true)">True</VekSelectItem>
</VekSelect>

<VekSwitch @bind-Value="ReadOnly" Label="@(ReadOnly ? "ReadOnly Mode" : "Edit Mode")" Color="Color.Primary"/>

@code {
    public bool Label_Checkbox1 { get; set; } = true;
    public bool Label_Checkbox2 { get; set; } = false;
    public bool ReadOnly { get; set; } = true;
}