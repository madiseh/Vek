@using Microsoft.AspNetCore.Components
@using System.Globalization;
@namespace Vek.Docs.Examples

<VekSelect @bind-Value="stringValue" Label="Select fast-food" HelperText="String" Placeholder="Please Select" AdornmentIcon="@Icons.Material.Filled.Fastfood" AdornmentColor="Color.Primary">
    <VekSelectItem Value="@("Pizza")" Disabled="true">Pizza (Disabled)</VekSelectItem>
    <VekSelectItem Value="@("Burger")">Burger</VekSelectItem>
    <VekSelectItem Value="@("Hotdog")">Hot Dog</VekSelectItem>
</VekSelect>

<VekSelect @bind-Value="enumValue" Label="Select drink" HelperText="Enum" OpenIcon="@Icons.Material.Filled.LocalDrink" AdornmentColor="Color.Secondary">
    @foreach (Drink item in Enum.GetValues(typeof(Drink))) {
        <VekSelectItem Value="@item">@item</VekSelectItem>
    }
</VekSelect>

<VekSelect Placeholder="Select culture" @bind-Value="cultureValue" HelperText="CultureInfo" ToStringFunc="@convertFunc" CloseIcon="@Icons.Material.Filled.Flag" AdornmentColor="Color.Tertiary">
    <VekSelectItem Value="@(CultureInfo.GetCultureInfo("en-US"))" />
    <VekSelectItem Value="@(CultureInfo.GetCultureInfo("de-AT"))" />
    <VekSelectItem Value="@(CultureInfo.GetCultureInfo("pt-BR"))" />
    <VekSelectItem Value="@(CultureInfo.GetCultureInfo("zh-CN"))" />
</VekSelect>

<div class="d-flex vek-width-full align-center mt-8">
    <VekText Typo="Typo.subtitle1" Class="mr-2">Selected values: </VekText>
    <VekChip T="string">@(stringValue ?? "Select fast-food")</VekChip>
    <VekChip T="string" Color="Color.Primary">@enumValue</VekChip>
    <VekChip T="string" Color="Color.Secondary">@(cultureValue?.DisplayName ?? "Select culture")</VekChip>
</div>

@code {
    private string stringValue { get; set; }
    private Drink enumValue { get; set; } = Drink.HotWater;
    public enum Drink { Tea, SparklingWater, SoftDrink, Cider, Beer, Wine, Moonshine, Wodka, Cola, GreeTea, FruitJuice, Lemonade, HotWater, SpringWater, IceWater, }
    private CultureInfo cultureValue { get; set; }
    private Func<CultureInfo, string> convertFunc = ci => ci?.DisplayName;
}
