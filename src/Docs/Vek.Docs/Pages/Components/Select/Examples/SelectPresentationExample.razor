@namespace Vek.Docs.Examples

<VekSelect @bind-Value="country" Label="With render fragements" Variant="Variant.Outlined">
    <VekSelectItem Value="@("Austria")">
        <img src="https://upload.wikimedia.org/wikipedia/commons/4/41/Flag_of_Austria.svg" height="14" class="mr-1" /> Austria
    </VekSelectItem>
    <VekSelectItem Value="@("Hungary")">
        <img src="https://upload.wikimedia.org/wikipedia/commons/0/00/Flag_of_Hungary.png" height="14" class="mr-1" /> Hungary
    </VekSelectItem>
    <VekSelectItem Value="@("Sweden")">
        <img src="https://upload.wikimedia.org/wikipedia/commons/4/4b/Flag_of_Sweden_fixed.svg" height="14" class="mr-1" /> Sweden
    </VekSelectItem>
</VekSelect>

<VekSelect @bind-Value="country" Label="Without render fragements" Variant="Variant.Outlined">
    <VekSelectItem Value="@("Austria")" />
    <VekSelectItem Value="@("Hungary")" />
    <VekSelectItem Value="@("Sweden")" />
</VekSelect>

<VekSelect @bind-Value="country" Label="Austria not representable" Variant="Variant.Outlined">
    <VekSelectItem Value="@("Germany")">
        <img src="https://upload.wikimedia.org/wikipedia/en/b/ba/Flag_of_Germany.svg" height="14" class="mr-1" /> Germany
    </VekSelectItem>
    <VekSelectItem Value="@("Hungary")">
        <img src="https://upload.wikimedia.org/wikipedia/commons/0/00/Flag_of_Hungary.png" height="14" class="mr-1" /> Hungary
    </VekSelectItem>
    <VekSelectItem Value="@("Sweden")">
        <img src="https://upload.wikimedia.org/wikipedia/commons/4/4b/Flag_of_Sweden_fixed.svg" height="14" class="mr-1" /> Sweden
    </VekSelectItem>
</VekSelect>

<VekSelect @bind-Value="country" Label="ToStringFunc Precedence" Variant="Variant.Outlined" ToStringFunc="@GetCountryCode">
    <VekSelectItem Value="@("Austria")">
        <img src="https://upload.wikimedia.org/wikipedia/commons/4/41/Flag_of_Austria.svg" height="14" class="mr-1" /> Austria
    </VekSelectItem>
    <VekSelectItem Value="@("Hungary")">
        <img src="https://upload.wikimedia.org/wikipedia/commons/0/00/Flag_of_Hungary.png" height="14" class="mr-1" /> Hungary
    </VekSelectItem>
    <VekSelectItem Value="@("Sweden")">
        <img src="https://upload.wikimedia.org/wikipedia/commons/4/4b/Flag_of_Sweden_fixed.svg" height="14" class="mr-1" /> Sweden
    </VekSelectItem>
</VekSelect>

@code {
    string country="Austria";

    private string GetCountryCode(string name) => name switch
    {
        "Austria" => "AUT",
        "Hungary" => "HUN",
        "Sweden" => "SWE",
        _ => name
    };
}
