@namespace Vek.Docs.Examples
@using System.Linq

<VekSelect MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectionText))" MultiSelection="true" @bind-Value="_value" @bind-SelectedValues="_options" T="string" Label="US States" AdornmentIcon="@Icons.Material.Filled.Search">
    @foreach (var state in _states)
    {
        <VekSelectItem T="string" Value="@state">@state</VekSelectItem>
    }
</VekSelect>

<VekSwitch @bind-Value="_multiselectionTextChoice" Class="vek-width-full" Color="Color.Primary">MultiSelection Text choice</VekSwitch>  

<VekGrid Class="mt-3 px-4">
    <VekItem xs="6">
        <VekText Typo="Typo.subtitle2">Value:</VekText>
        <VekText Typo="Typo.subtitle2">"</VekText>
        <VekText Typo="Typo.body2" Class="pl-4">@_value</VekText>
        <VekText Typo="Typo.subtitle2">"</VekText>
    </VekItem>
    <VekItem xs="6">
        <VekText Typo="Typo.subtitle2">SelectedValues: IReadOnlyCollection&lt;string&gt;</VekText>
        <VekText Typo="Typo.subtitle2">{</VekText>
        <VekText Typo="Typo.body2" Class="pl-4">@(string.Join(", ", _options.Select(x=>$"\"{x}\"")))</VekText>
        <VekText Typo="Typo.subtitle2">}</VekText>
    </VekItem>
</VekGrid>

@code {
    private bool _multiselectionTextChoice;
    private string _value = "Nothing selected";
    private IReadOnlyCollection<string> _options = new List<string>() { "Alaska" };

    private readonly string[] _states =
    [
        "Alabama", "Alaska", "American Samoa", "Arizona",
        "Arkansas", "California", "Colorado", "Connecticut",
        "Delaware", "District of Columbia", "Federated States of Micronesia",
        "Florida", "Georgia", "Guam", "Hawaii", "Idaho",
        "Illinois", "Indiana", "Iowa", "Kansas", "Kentucky",
        "Louisiana", "Maine", "Marshall Islands", "Maryland",
        "Massachusetts", "Michigan", "Minnesota", "Mississippi",
        "Missouri", "Montana", "Nebraska", "Nevada",
        "New Hampshire", "New Jersey", "New Mexico", "New York",
        "North Carolina", "North Dakota", "Northern Mariana Islands", "Ohio",
        "Oklahoma", "Oregon", "Palau", "Pennsylvania", "Puerto Rico",
        "Rhode Island", "South Carolina", "South Dakota", "Tennessee",
        "Texas", "Utah", "Vermont", "Virgin Island", "Virginia",
        "Washington", "West Virginia", "Wisconsin", "Wyoming"
    ];

    private string GetMultiSelectionText(IReadOnlyList<string> selectedValues)
    {
        if (_multiselectionTextChoice)
        {
            return $"Selected state{(selectedValues.Count > 1 ? "s" : "")}: {string.Join(", ", selectedValues.Select(x => x))}";
        }

        return $"{selectedValues.Count} state{(selectedValues.Count > 1 ? "s have":" has")} been selected";
    }
}
