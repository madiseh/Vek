@namespace Vek.Docs.Examples

<VekGrid Spacing="3">
    <VekItem xs="12" md="6">
        <VekSelect T="string"
                   Label="Technologies"
                   HelperText="Selected technologies as removable chip tags"
                   MultiSelection="true"
                   Chips="true"
                   SelectAll="true"
                   SelectAllText="Select all technologies"
                   Clearable="true"
                   MaxDisplayedTags="3"
                   @bind-SelectedValues="_selectedTechs">
            @foreach (var tech in _technologies)
            {
                <VekSelectItem T="string" Value="@tech">@tech</VekSelectItem>
            }
        </VekSelect>
    </VekItem>
    <VekItem xs="12" md="6">
        <VekSelect T="string"
                   Label="Framework Variants"
                   HelperText="Outlined chip style with custom color"
                   MultiSelection="true"
                   Chips="true"
                   ChipVariant="Variant.Outlined"
                   ChipColor="Color.Primary"
                   Clearable="true"
                   @bind-SelectedValues="_selectedFrameworks">
            @foreach (var fw in _frameworks)
            {
                <VekSelectItem T="string" Value="@fw">@fw</VekSelectItem>
            }
        </VekSelect>
    </VekItem>
</VekGrid>

<VekPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
    <VekText Typo="Typo.subtitle2" GutterBottom="true">Current Selection:</VekText>
    <VekText Typo="Typo.body2">
        Technologies (@_selectedTechs.Count): @(string.Join(", ", _selectedTechs))
    </VekText>
    <VekText Typo="Typo.body2">
        Frameworks (@_selectedFrameworks.Count): @(string.Join(", ", _selectedFrameworks))
    </VekText>
</VekPaper>

@code {
    private IReadOnlyCollection<string> _selectedTechs = ["C#", "Blazor", "TypeScript", "WebAssembly"];
    private IReadOnlyCollection<string> _selectedFrameworks = [".NET", "Vek"];

    private readonly string[] _technologies =
    [
        "C#", "Blazor", "TypeScript", "WebAssembly", "Rust", "Python", "Go", "Docker"
    ];

    private readonly string[] _frameworks =
    [
        ".NET", "Vek", "ASP.NET Core", "Entity Framework", "SignalR"
    ];
}
