@namespace Vek.Docs.Examples

<div class="d-flex align-center flex-wrap" style="gap: 2rem;">
    <VekBadge Position="BadgePosition.TopEnd" Content="@_notificationCount" MaxNumber="99" BadgeAriaLabel="Unread notifications" Class="ma-4">
        <VekIcon Icon="@Icons.Material.Filled.Email" Color="Color.Default" Size="Size.Large" />
    </VekBadge>
    <VekBadge Position="BadgePosition.TopStart" Dot="true" Color="@(_isOnline ? Color.Success : Color.Default)" Visible="@_isOnline" BadgeAriaLabel="Online status" Class="ma-4">
        <VekAvatar Size="Size.Large" Color="Color.Primary">AL</VekAvatar>
    </VekBadge>
</div>

<div class="d-flex align-center flex-wrap" style="gap: 0.5rem;">
    <VekButton OnClick="AddNotifications" Color="Color.Primary" Variant="Variant.Filled">Add 25 notifications</VekButton>
    <VekButton OnClick="ToggleOnlineStatus" Color="Color.Secondary" Variant="Variant.Outlined">Toggle online status</VekButton>
</div>

@code {
    private int _notificationCount = 98;
    private bool _isOnline = true;

    private void AddNotifications()
    {
        _notificationCount += 25;
    }

    private void ToggleOnlineStatus()
    {
        _isOnline = !_isOnline;
    }
}
