@inherits BytexDigital.Blazor.Components.CookieConsent.Dialogs.Prompt.CookieConsentPromptComponentBase

<div class="vek-cc-container">
    <VekPaper Class="vek-cc-content" Elevation="16">
        <div class="vek-cc-body">
            <VekText Typo="Typo.h6">
                We use cookies
            </VekText>

            <VekText Typo="Typo.body2">
                We use cookies to analyze site traffic and enhance your experience.
                By clicking Accept, you consent to the use of additional cookies.
                <VekLink Href="@Options.Value.PolicyUrl" Target="_blank">Learn more</VekLink>
            </VekText>
        </div>

        <div class="vek-cc-actions">
            <VekButton Variant="Variant.Filled" DropShadow="false" FullWidth Color="Color.Primary" OnClick="async () => await AcceptAsync(true)">
                Accept
            </VekButton>

            <VekButton Variant="Variant.Filled" DropShadow="false" FullWidth Color="Color.Default" OnClick="async () => await AcceptAsync(false)">
                Close
            </VekButton>
        </div>
    </VekPaper>
</div>
