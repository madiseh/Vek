@page "/customization/z-index"
<DocsPage>
    <DocsPageHeader Title="z-index">
        <Description>The z-index CSS property specifies a stack order of your elements to help you arrange the content.</Description>
    </DocsPageHeader>
    <DocsPageContent>
        <DocsPageSection>
            <SectionHeader Title="Vek z-index's">
                <Description>This is the z-order that is utilized by Vek by default. Either design your application around it or change it in your theme.</Description>
            </SectionHeader>
            <ul class="docs-list mx-2">
                <li><VekText HtmlTag="span">Drawer</VekText></li>
                <li><VekText HtmlTag="span">Popover</VekText></li>
                <li><VekText HtmlTag="span">AppBar</VekText></li>
                <li><VekText HtmlTag="span">Dialog</VekText></li>
                <li><VekText HtmlTag="span">Snackbar</VekText></li>
                <li><VekText HtmlTag="span">Tooltip</VekText></li>
            </ul>
            <VekText Class="mt-4 mb-16">These values can be changed in the <CodeInline>VekTheme</CodeInline> class, where <VekLink Href="/customization/default-theme" Color="Color.Secondary">the defaults</VekLink> are displayed under z-index.</VekText>
        </DocsPageSection>
        <DocsPageSection>
            <VekDivider Class="my-16" Style="opacity:0;" />
            @*You are cool like a swimming pool!*@
        </DocsPageSection>
    </DocsPageContent>
</DocsPage>