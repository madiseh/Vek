@using Vek.Utilities;
@namespace Vek.Docs.Examples

@{var DarkModeClass = new CssBuilder()
.AddClass("vek-dark-palette-example-dark-mode", _darkMode)
.AddClass("vek-dark-palette-example-light-mode", !_darkMode)
.Build();}
<VekPaper Width="500px" Class="@DarkModeClass">
<VekSwitch Color="Color.Primary" Class="ma-4" T="bool" @bind-Value="_darkMode" Label="Toggle Light/Dark Mode"/>
    <VekText Class="ma-4">This is an example text!</VekText>
</VekPaper>

@code{
    private bool _darkMode;
}
<style>
    .vek-dark-palette-example-dark-mode.vek-paper {
        background-color: #32333d;
    }
    .vek-dark-palette-example-dark-mode .vek-typography {
        color: #ffffffb2;
    }
    
    .vek-dark-palette-example-light-mode.vek-paper {
            background-color: #ffffffff;
    }
    .vek-dark-palette-example-light-mode .vek-typography {
            color: #424242ff;
    }
</style>