@namespace Vek.Docs.Examples

<VekGrid Class="justify-space-between" Style="max-width: 400px;">
    <VekItem xs="12">
        <VekTextField Mask="@mask" Label="Flight number" 
                      @bind-Value="text"  Variant="@Variant.Outlined" Clearable />
    </VekItem>
    <VekItem xs="12">
        Flight number: <b>@text</b>
    </VekItem>
</VekGrid>

@code {
    public string text { get; set; }

    IMask mask = new BlockMask(delimiters:" ", new Block('a', 1,3), new Block('0', 1,4));
}