@namespace Vek.Docs.Examples


<VekGrid Class="justify-space-between" Style="max-width: 800px;">
    <VekItem xs="12" sm="6">
        <VekTextField Mask="@guidMask" Label="Identifier" HelperText="@guidMask.Mask"
                      @bind-Value="identifier" Variant="@Variant.Text" Clearable />
    </VekItem>
    <VekItem xs="12" sm="6">
        Identifier: <b>@identifier</b>
    </VekItem>
</VekGrid>

@code {
    public string identifier;
    public IMask guidMask = RegexMask.Guid();
}
