@namespace Vek.Docs.Examples

<VekGrid>
    <VekItem xs="12" md="8" Class="d-flex justify-center align-center" Style="height:500px;">
        <VekPaper Style="@($"background-color:{ColorValue};")" Elevation="@Elevation" Outlined="@Outlined" Height="@($"{PaperHeight}px")" Width="@($"{PaperWidth}px")" />
    </VekItem>
    <VekItem xs="12" md="4">
        <VekPaper Class="pa-4 mt-6 mt-lg-16" Elevation="0">
            <VekText Typo="Typo.h6">Options</VekText>
            <VekText><b>Elevation:</b> @Elevation</VekText>
            <VekSlider @bind-Value="Elevation" Max="25" Min="0" Color="Color.Primary" />
            <VekText><b>Outlined:</b> @Outlined</VekText>
            <VekSwitch @bind-Value="Outlined" Color="Color.Primary" />
            <VekText><b>Color:</b> @ColorValue</VekText>
            <VekColorPicker Class="mb-2" @bind-Text="ColorValue" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <VekText><b>Width:</b> @($"{PaperWidth}px")</VekText>
            <VekSlider @bind-Value="PaperWidth" Max="400" Min="0" Color="Color.Primary" />
            <VekText><b>Height:</b> @($"{PaperHeight}px")</VekText>
            <VekSlider @bind-Value="PaperHeight" Max="400" Min="0" Color="Color.Primary" />
        </VekPaper>
    </VekItem>
</VekGrid>

@code {
    public int PaperHeight { get; set; } = 300;
    public int PaperWidth { get; set; } = 300;
    public int Elevation { get; set; } = 5;
    public bool Outlined { get; set; } = false;
    public string ColorValue { get; set; } = "#f9f9f9";
}