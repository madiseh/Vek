@namespace Vek.Docs.Examples

<VekRTLProvider RightToLeft="true">
    <VekGrid>
        <VekItem xs="12" sm="4">
            <VekText Align="Align.Left">Text</VekText>
            <VekTextField Label="الاسم الأول" Variant="Variant.Outlined" @bind-Value="_name" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"></VekTextField>
        </VekItem>
        <VekItem xs="12" sm="4">
            <VekText Align="Align.Left">Telephone</VekText>
            <VekTextField InputType="InputType.Telephone" Label="رقم الهاتف" Variant="Variant.Outlined" @bind-Value="_telephone" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Smartphone"></VekTextField>
        </VekItem>
        <VekItem xs="12" sm="4">
            <VekText Align="Align.Left">Email</VekText>
            <VekTextField InputType="InputType.Email" Label="البريد الإلكتروني" Variant="Variant.Outlined" @bind-Value="_email" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email"></VekTextField>
        </VekItem>
    </VekGrid>
</VekRTLProvider>

@code {
    private string _name { get; set; } = "John Smith";
    private string _email { get; set; } = "mail@example.com";
    private long? _telephone { get; set; } = 1618033988;
}