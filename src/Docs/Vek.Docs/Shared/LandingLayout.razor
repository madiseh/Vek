@inherits LayoutComponentBase
@layout MainLayout

<VekLayout Class="vek-landingpage">
    <VekAppBar Class="landing-appbar" Elevation="0">
        <Appbar DrawerToggleCallback="ToggleDrawer" DisplaySearchBar="false" />
    </VekAppBar>
    <VekDrawer @bind-Open="@_drawerOpen" Elevation="25" Variant="@DrawerVariant.Temporary" aria-label="Navigation Drawer">
        <VekToolBar Dense="true" Gutters="false" Class="px-1 docs-gray-bg">
            <VekIconButton Icon="@Icons.Material.Rounded.Close" Color="Color.Inherit" OnClick="@ToggleDrawer" aria-label="Toggle drawer" />
            <VekSpacer/>
            <AppbarButtons/>
        </VekToolBar>
        <VekNavMenu Color="Color.Primary" Margin="Margin.Dense" Rounded="true" Class="pa-2">
            <VekNavLink Href="/getting-started/installation">Get Started</VekNavLink>
            <VekNavLink Href="/docs/overview">Components</VekNavLink>
            <VekNavGroup Title="Showcases" Expanded="true" ExpandIcon="@Icons.Material.Filled.ExpandMore">
                <VekNavLink Href="/examples/expense-tracker">Expense</VekNavLink>
            </VekNavGroup>
            <VekNavLink Href="/api">API Index</VekNavLink>
            <VekNavLink Href="/features/break-points">Features</VekNavLink>
            <VekNavLink Href="/vek/introduction">About Vek</VekNavLink>
            <VekNavLink Href="https://github.com/madiseh/vek" Target="_blank">GitHub</VekNavLink>
        </VekNavMenu>
    </VekDrawer>
    <VekMainContent Class="pa-0">
        @Body
        <LandingFooter/>
    </VekMainContent>
</VekLayout>
