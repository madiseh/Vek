@using System.Linq
@using System.Text.RegularExpressions
@using Vek.Docs.Extensions

<VekNavGroup Title="Getting Started" Expanded="@(_section == "getting-started")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    <VekNavLink Href="/getting-started/installation">Installation</VekNavLink>
    <VekNavLink Href="/getting-started/layouts">Layouts</VekNavLink>
    <VekNavLink Href="/getting-started/usage">Usage</VekNavLink>
    <VekNavLink Href="/getting-started/wireframes">Wireframes</VekNavLink>
</VekNavGroup>

<VekNavLink Href="docs/overview" Class="docs-single-link">Components Overview</VekNavLink>

<VekNavGroup Title="Components" Expanded="@(_section == "components")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    @foreach (var item in MenuService.Components)
    {
        if (item.IsNavGroup)
        {
            <VekNavGroup Title="@item.Name" Icon="@item.Icon" IconColor="Color.Primary" Expanded="true" ExpandIcon="@Icons.Material.Filled.ExpandMore">
                @foreach (var subItem in item.GroupComponents)
                {
                    var href = $"components/{subItem.Link}";
                    <VekNavLink Href="@href" Match="NavLinkMatch.All">@subItem.Name</VekNavLink>
                }
            </VekNavGroup>
        }
        else
        {
            var href = $"components/{item.Link}";
            <VekNavLink Href="@href">@item.Name</VekNavLink>
        }
    }
</VekNavGroup>

<VekNavGroup Title="Component API" Expanded="@(_section == "api")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    <VekNavLink Href="/api" Match="NavLinkMatch.All">API Index</VekNavLink>
    @foreach (var item in MenuService.Api.OrderBy(x => x.Name))
    {
        <VekNavLink Href="@ApiLink.GetApiLinkFor(item.Type)">@item.Name</VekNavLink>
    }
</VekNavGroup>

<VekNavGroup Title="Features" Expanded="@(_section == "features")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    @foreach (var link in MenuService.Features)
    {
        <VekNavLink Href="@link.Href">@link.Title</VekNavLink>
    }
</VekNavGroup>

<VekNavGroup Title="Customization" Expanded="@(_section == "customization")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    @foreach (var link in MenuService.Customization)
    {
        <VekNavLink Href="@link.Href">@link.Title</VekNavLink>
    }
</VekNavGroup>

<VekNavGroup Title="CSS Utilities" Expanded="@(_section == "utilities")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    @foreach (var title in MenuService.Utilities.GroupBy(x => x.Group).Select(x => x.Key))
    {
        <div class="docs-css-utility-header">
            @title
        </div>

        @foreach (var link in MenuService.Utilities.Where(x => x.Group == title))
        {
            <VekNavLink Href="@link.Href" Match="NavLinkMatch.All">@link.Title</VekNavLink>
        }
    }
</VekNavGroup>

<VekNavGroup Title="Learn More" Expanded="@(_section == "about")" ExpandIcon="@Icons.Material.Filled.ExpandMore">
    <VekNavLink Href="/vek/introduction">What is Vek?</VekNavLink>
    <VekNavLink Href="/vek/community/getting-help">Getting Help</VekNavLink>
    <VekNavLink Href="/vek/community/reporting-bugs">Reporting Bugs</VekNavLink>
    <VekNavLink Href="/vek/community/contribution">Contribution</VekNavLink>
    <VekNavLink Href="/vek/project/roadmap">Roadmap</VekNavLink>
    <VekNavLink Href="/vek/project/sponsor">Support Vek</VekNavLink>
    <VekNavLink Href="/vek/project/team">Team & Contributors</VekNavLink>
    <VekNavLink Href="/vek/project/how-it-started">How it Started</VekNavLink>
</VekNavGroup>
