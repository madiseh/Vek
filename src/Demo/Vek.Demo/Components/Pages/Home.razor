@page "/"
@inject IDemoProductProvider ProductProvider

<PageTitle>Vek Components Demo</PageTitle>

<h1>Vek Components Demo</h1>

<p>This app is the showcase host for reusable Blazor components in <code>Vek.Components</code>.</p>

<h2>Simulated sample data</h2>
<p>The sample products are loaded through the demo data port from the JSON adapter.</p>

@if (_products is null)
{
    <p>Loading sample products…</p>
}
else
{
    <VekDataGrid TItem="DemoProduct" Items="_products" PageSize="10" Class="product-grid">
        <PropertyColumn Property="product => product.Name" Title="Name" />
        <PropertyColumn Property="product => product.Category" Title="Category" />
        <PropertyColumn Property="product => product.Price" Title="Price" />
    </VekDataGrid>
}

@code {
    private IReadOnlyList<DemoProduct>? _products;

    protected override async Task OnInitializedAsync()
    {
        _products = await ProductProvider.GetProductsAsync();
    }
}
