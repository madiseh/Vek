@page "/"

<PageTitle>Vek Components | Blazor component library</PageTitle>

<main class="landing-page">
    <section class="landing-hero" aria-labelledby="landing-title">
        <p class="landing-eyebrow">VEK COMPONENTS</p>
        <h1 id="landing-title">
            Build polished Blazor apps.<br />
            <span>Start with Vek.</span>
        </h1>
        <p class="landing-description">
            Reusable, thoughtfully crafted components for .NET developers.
        </p>
        <div class="landing-actions">
            <a class="landing-button landing-button-primary get-started-link"
               href="/docs/getting-started">
                Get started
            </a>
            <a class="landing-button landing-button-secondary github-link"
               href="https://github.com/madiseh/Vek"
               target="_blank"
               rel="noopener noreferrer">
                Star on GitHub
            </a>
        </div>
    </section>
</main>
