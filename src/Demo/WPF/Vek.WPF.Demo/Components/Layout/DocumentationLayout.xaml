<UserControl x:Class="Vek.WPF.Demo.Components.Layout.DocumentationLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0" Padding="12,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="VEK / DOCUMENTATION" FontWeight="SemiBold" Margin="16,0,0,16" />
                    <Button Content="Home" Click="NavigateHome" HorizontalAlignment="Left" Padding="16,8" Margin="4,0,0,20"
                            AutomationProperties.Name="Return to Home" />
                </StackPanel>
                <TreeView x:Name="DocumentationNavigation" SelectedItemChanged="NavigationSelectionChanged"
                          AutomationProperties.Name="Documentation navigation"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource MutedBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          KeyboardNavigation.TabNavigation="Continue" />
            </DockPanel>
        </Border>
        <ContentControl x:Name="SelectedPageHost" Grid.Column="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        AutomationProperties.Name="Documentation content">
        </ContentControl>
    </Grid>
</UserControl>
