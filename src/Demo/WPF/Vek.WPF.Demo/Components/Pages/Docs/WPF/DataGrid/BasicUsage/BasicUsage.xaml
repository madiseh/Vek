<UserControl x:Class="Vek.WPF.Demo.Components.Pages.Docs.WPF.DataGrid.BasicUsage.BasicUsage" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Vek.WPF.DataGrid.Components;assembly=Vek.WPF.DataGrid"
             xmlns:codeview="clr-namespace:Vek.WPF.Demo.Components.CodeView">
    <Grid AutomationProperties.AutomationId="docs-page-layout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="ArticleScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="40,40,32,64">
            <StackPanel x:Name="Article" MaxWidth="900" HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="docs-article">
                <TextBlock Text="VekDataGrid: Basic Usage" FontSize="36" FontWeight="Bold"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="article-title" />
                <TextBlock Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"
                           AutomationProperties.AutomationId="article-intro">
                    Display every supplied item in a sortable table, and opt into pagination with <Run FontFamily="Consolas">PageSize</Run>.
                </TextBlock>

                <StackPanel x:Name="LiveExample" Margin="0,36,0,0" Focusable="True"
                            AutomationProperties.AutomationId="section:live-example"
                            AutomationProperties.Name="Live example">
                    <TextBlock Text="Live example" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Click a column heading to sort the five sample products."
                               Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0" />
                    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,18,0,0">
                        <Grid>
                            <components:VekDataGrid x:Name="ProductGrid"
                                ItemsSource="{Binding DataContext.BasicUsage.Products, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                CanUserDeleteRows="False" CanUserSortColumns="True" CanUserReorderColumns="False"
                                HeadersVisibility="Column" RowHeaderWidth="0" AlternationCount="2"
                                GridLinesVisibility="Horizontal" MinHeight="210" MaxHeight="340"
                                Background="{DynamicResource SidebarBrush}" Foreground="{DynamicResource TextBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                AlternatingRowBackground="{DynamicResource HoverBrush}"
                                AutomationProperties.Name="Sample products data grid">
                                <components:VekDataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </components:VekDataGrid.RowStyle>
                                <components:VekDataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </components:VekDataGrid.CellStyle>
                                <components:VekDataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Setter Property="Padding" Value="8,10" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </components:VekDataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="*" />
                                    <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C2}" SortMemberPath="Price" Width="*" />
                                    <DataGridTextColumn Header="Product ID" Binding="{Binding Id}" SortMemberPath="Id" Width="*" />
                                </DataGrid.Columns>
                            </components:VekDataGrid>
                            <TextBlock Text="Loading sample products..."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                        <Setter Property="FontSize" Value="17" />
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=ProductGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding DataContext.BasicUsage.LoadErrorMessage, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Foreground="Tomato" TextWrapping="Wrap" Margin="0,12,0,0"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>

                <StackPanel x:Name="Code" Margin="0,36,0,0" Focusable="True"
                            AutomationProperties.AutomationId="section:code" AutomationProperties.Name="Code">
                    <TextBlock Text="Code" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0">
                        Keep the component markup in <Run FontFamily="Consolas">Sample.xaml</Run> and its data loading logic in <Run FontFamily="Consolas">Sample.xaml.cs</Run>.
                    </TextBlock>
                    <codeview:CodeSampleView Samples="{Binding CodeSamples, ElementName=Root}"
                                             Height="300" Margin="0,16,0,0" />
                </StackPanel>

                <StackPanel x:Name="SortingAndPagination" Margin="0,36,0,0" Focusable="True"
                            AutomationProperties.AutomationId="section:sorting-and-pagination"
                            AutomationProperties.Name="Sorting and pagination">
                    <TextBlock Text="Sorting and pagination" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0">
                        Each property column can be sorted by selecting its heading. When <Run FontFamily="Consolas">PageSize</Run> is omitted, all supplied items are displayed. Set it to opt into pagination.
                    </TextBlock>
                    <TextBlock Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0">
                        Column filters are opt-in: <Run FontFamily="Consolas">Filterable</Run> defaults to false. Set it to true on columns that need filtering and choose a filter layout on the grid. See Filtering for the available options.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Margin="0,48,16,32" Padding="20,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel AutomationProperties.AutomationId="docs-toc">
                    <TextBlock Text="On this page" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Button Content="Live example" Tag="{Binding ElementName=LiveExample}" Click="NavigateToSection" AutomationProperties.AutomationId="toc:live-example" Style="{DynamicResource TocLinkStyle}" />
                    <Button Content="Code" Tag="{Binding ElementName=Code}" Click="NavigateToSection" AutomationProperties.AutomationId="toc:code" Style="{DynamicResource TocLinkStyle}" />
                    <Button Content="Sorting and pagination" Tag="{Binding ElementName=SortingAndPagination}" Click="NavigateToSection" AutomationProperties.AutomationId="toc:sorting-and-pagination" Style="{DynamicResource TocLinkStyle}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
