<UserControl x:Class="Vek.WPF.Demo.Components.Pages.Docs.WPF.DataGrid.ServerData.ServerData" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <Grid AutomationProperties.AutomationId="docs-page-layout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <ScrollViewer x:Name="ArticleScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,40,32,64">
            <StackPanel MaxWidth="900" AutomationProperties.AutomationId="docs-article">
                <TextBlock Text="VekDataGrid: Server Data" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.AutomationId="article-title"/>
                <TextBlock Text="Load only the requested page and let the data source apply the grid's current sort and filter state." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0" AutomationProperties.AutomationId="article-intro"/>
                <StackPanel x:Name="Section_live_example" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:live-example" AutomationProperties.Name="Live example">
                    <TextBlock Text="Live example" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="Sorting, filtering, and paging send a new cancellable request to the sample provider." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                    <TextBlock Text="Loading products…" Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                    <TextBlock Text="Could not load products: @error.Message" Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                    <TextBlock Text="No products match this request." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="16" Margin="0,18,0,0"><TextBlock Text="Native WPF example is in development." Style="{DynamicResource DescriptionStyle}"/></Border>
                </StackPanel>
                <StackPanel x:Name="Section_code" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:code" AutomationProperties.Name="Code">
                    <TextBlock Text="Code" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="16" Margin="0,18,0,0"><TextBlock Text="Native WPF code sample is in development." Style="{DynamicResource DescriptionStyle}"/></Border>
                </StackPanel>
                <StackPanel x:Name="Section_server_contract" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:server-contract" AutomationProperties.Name="Server request contract">
                    <TextBlock Text="Server request contract" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="The source receives the requested page, page size, sort definitions, filters, and a cancellation token. Return the page rows together with the total number of matching rows. A new request cancels the previous one; failures can be presented with ErrorContent , and RefreshServerDataAsync reloads the current request." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,48,16,32" Padding="20,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel AutomationProperties.AutomationId="docs-toc">
                <TextBlock Text="On this page" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Button Content="Live example" Tag="{Binding ElementName=Section_live_example}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:live-example"/>
                <Button Content="Code" Tag="{Binding ElementName=Section_code}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:code"/>
                <Button Content="Server request contract" Tag="{Binding ElementName=Section_server_contract}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:server-contract"/>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>
