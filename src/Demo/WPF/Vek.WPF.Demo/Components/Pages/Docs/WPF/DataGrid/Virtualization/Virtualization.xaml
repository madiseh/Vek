<UserControl x:Class="Vek.WPF.Demo.Components.Pages.Docs.WPF.DataGrid.Virtualization.Virtualization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <Grid AutomationProperties.AutomationId="docs-page-layout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <ScrollViewer x:Name="ArticleScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,40,32,64">
            <StackPanel MaxWidth="900" AutomationProperties.AutomationId="docs-article">
                <TextBlock Text="VekDataGrid: Virtualization" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.AutomationId="article-title"/>
                <TextBlock Text="Render a small viewport-sized window from a large local collection or request ranges from a remote data source." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0" AutomationProperties.AutomationId="article-intro"/>
                <StackPanel x:Name="Section_client_virtualization" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:client-virtualization" AutomationProperties.Name="Client data">
                    <TextBlock Text="Client data" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="The grid has 500 product records. Sorting and filtering apply before the virtualizer renders the visible window." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="16" Margin="0,18,0,0"><TextBlock Text="Native WPF example is in development." Style="{DynamicResource DescriptionStyle}"/></Border>
                </StackPanel>
                <StackPanel x:Name="Section_server_virtualization" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:server-virtualization" AutomationProperties.Name="Server data">
                    <TextBlock Text="Server data" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="The source receives a start index and requested row count with the current sort/filter state. It can cancel work when the visible range changes." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="16" Margin="0,18,0,0"><TextBlock Text="Native WPF example is in development." Style="{DynamicResource DescriptionStyle}"/></Border>
                </StackPanel>
                <StackPanel x:Name="Section_code" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:code" AutomationProperties.Name="Code">
                    <TextBlock Text="Code" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="16" Margin="0,18,0,0"><TextBlock Text="Native WPF code sample is in development." Style="{DynamicResource DescriptionStyle}"/></Border>
                </StackPanel>
                <StackPanel x:Name="Section_virtualization_options" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:virtualization-options" AutomationProperties.Name="Sizing and supported features">
                    <TextBlock Text="Sizing and supported features" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="VirtualItemSize should match the rendered row height. VirtualOverscanCount adds rows around the viewport, and VirtualMaxItemCount bounds each render. Virtualization uses the document scroll container and hides the pager." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                    <TextBlock Text="Grouping and hierarchical row details are rejected because they introduce variable-height rows. For server ranges, return the matching total and no more rows than the requested count; the grid also trims responses that extend beyond the reported end." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,48,16,32" Padding="20,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel AutomationProperties.AutomationId="docs-toc">
                <TextBlock Text="On this page" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Button Content="Client data" Tag="{Binding ElementName=Section_client_virtualization}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:client-virtualization"/>
                <Button Content="Server data" Tag="{Binding ElementName=Section_server_virtualization}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:server-virtualization"/>
                <Button Content="Code" Tag="{Binding ElementName=Section_code}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:code"/>
                <Button Content="Sizing" Tag="{Binding ElementName=Section_virtualization_options}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:virtualization-options"/>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>
