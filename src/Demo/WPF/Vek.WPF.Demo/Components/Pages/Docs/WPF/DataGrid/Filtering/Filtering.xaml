<UserControl x:Class="Vek.WPF.Demo.Components.Pages.Docs.WPF.DataGrid.Filtering.Filtering"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Vek.WPF.DataGrid.Components;assembly=Vek.WPF.DataGrid"
             xmlns:codeview="clr-namespace:Vek.WPF.Demo.Components.CodeView"
             x:Name="Root">
    <Grid AutomationProperties.AutomationId="docs-page-layout">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="ArticleScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="40,40,32,64">
            <StackPanel MaxWidth="900" AutomationProperties.AutomationId="docs-article">
                <TextBlock Text="VekDataGrid: Filtering" FontSize="36" FontWeight="Bold"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="article-title" />
                <TextBlock Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0"
                           AutomationProperties.AutomationId="article-intro">
                    Combine quick predicates with per-column filters, choose a filter surface, and control string matching.
                </TextBlock>

                <StackPanel x:Name="Section_live_example" Margin="0,36,0,0" Focusable="True"
                            AutomationProperties.AutomationId="section:live-example"
                            AutomationProperties.Name="Live example">
                    <TextBlock Text="Live example" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Enter a value under a column heading to filter the sample products. Clear it to restore all rows."
                               Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0" />
                    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,18,0,0">
                        <components:VekDataGrid x:Name="FilterGrid"
                            ItemsSource="{Binding DataContext.BasicUsage.Products, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            ShowFilterRow="True" AutoGenerateColumns="False" IsReadOnly="True"
                            CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True"
                            HeadersVisibility="Column" RowHeaderWidth="0" MinHeight="210" MaxHeight="340"
                            Background="{DynamicResource SidebarBrush}" Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                            AutomationProperties.Name="Filterable sample products data grid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="*" />
                            </DataGrid.Columns>
                        </components:VekDataGrid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="Section_code" Margin="0,36,0,0" Focusable="True"
                            AutomationProperties.AutomationId="section:code" AutomationProperties.Name="Code">
                    <TextBlock Text="Code" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Set ShowFilterRow to display a filter editor for each bound column."
                               Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0" />
                    <codeview:CodeSampleView Samples="{Binding CodeSamples, ElementName=Root}"
                                             Margin="0,18,0,0" />
                </StackPanel>

                <StackPanel x:Name="Section_filter_modes" Margin="0,36,0,0" Focusable="True"
                            AutomationProperties.AutomationId="section:filter-modes"
                            AutomationProperties.Name="Filter modes and operators">
                    <TextBlock Text="Filter modes and operators" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="The WPF adapter places a text editor in each filterable column heading. The editor uses that column's configured filter operator and clears its filter when empty."
                               Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0" />
                </StackPanel>

                <StackPanel x:Name="Section_filter_options" Margin="0,36,0,0" Focusable="True"
                            AutomationProperties.AutomationId="section:filter-options"
                            AutomationProperties.Name="Filter properties">
                    <TextBlock Text="Filter properties" FontSize="25" FontWeight="SemiBold" />
                    <TextBlock Text="Filtering is opt-in on shared column definitions. Set FilterCaseSensitive to configure text matching."
                               Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                Margin="0,48,16,32" Padding="20,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel AutomationProperties.AutomationId="docs-toc">
                    <TextBlock Text="On this page" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Button Content="Live example" Tag="{Binding ElementName=Section_live_example}"
                            Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}"
                            AutomationProperties.AutomationId="toc:live-example" />
                    <Button Content="Code" Tag="{Binding ElementName=Section_code}" Click="NavigateToSection"
                            Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:code" />
                    <Button Content="Filter modes" Tag="{Binding ElementName=Section_filter_modes}"
                            Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}"
                            AutomationProperties.AutomationId="toc:filter-modes" />
                    <Button Content="Filter properties" Tag="{Binding ElementName=Section_filter_options}"
                            Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}"
                            AutomationProperties.AutomationId="toc:filter-options" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
