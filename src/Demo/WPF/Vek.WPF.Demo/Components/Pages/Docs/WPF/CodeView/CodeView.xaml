<UserControl x:Class="Vek.WPF.Demo.Components.Pages.Docs.WPF.CodeView.CodeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Root">
    <Grid AutomationProperties.AutomationId="docs-page-layout">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <ScrollViewer x:Name="ArticleScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,40,32,64">
            <StackPanel MaxWidth="900" AutomationProperties.AutomationId="docs-article">
                <TextBlock Text="VekCodeView: Basic Usage" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" AutomationProperties.AutomationId="article-title"/>
                <TextBlock Text="Display read-only code with syntax highlighting and a copy action." Style="{DynamicResource DescriptionStyle}" Margin="0,16,0,0" AutomationProperties.AutomationId="article-intro"/>
                <StackPanel x:Name="Section_html_heading" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:html-heading" AutomationProperties.Name="HTML">
                    <TextBlock Text="HTML" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBox Text="&lt;article class=&quot;card&quot;&gt;&#10;    &lt;h2&gt;Welcome&lt;/h2&gt;&#10;    &lt;p&gt;Browse the latest updates.&lt;/p&gt;&#10;&lt;/article&gt;" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Height="220" Margin="0,16,0,0" AutomationProperties.Name="HTML code sample"/>
                </StackPanel>
                <StackPanel x:Name="Section_java_heading" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:java-heading" AutomationProperties.Name="Java">
                    <TextBlock Text="Java" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBox Text="public class Greeting {&#10;    public static void main(String[] args) {&#10;        System.out.println(&quot;Hello, Vek!&quot;);&#10;    }&#10;}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Height="220" Margin="0,16,0,0" AutomationProperties.Name="Java code sample"/>
                </StackPanel>
                <StackPanel x:Name="Section_csharp_heading" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:csharp-heading" AutomationProperties.Name="C#">
                    <TextBlock Text="C#" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBox Text="public static class Greeting&#10;{&#10;    public static string Create(string name) =&gt; $&quot;Hello, {name}!&quot;;&#10;}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Height="220" Margin="0,16,0,0" AutomationProperties.Name="C# code sample"/>
                </StackPanel>
                <StackPanel x:Name="Section_sql_heading" Margin="0,36,0,0" Focusable="True" AutomationProperties.AutomationId="section:sql-heading" AutomationProperties.Name="SQL">
                    <TextBlock Text="SQL" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBox Text="SELECT name, created_at&#10;FROM users&#10;WHERE is_active = 1&#10;ORDER BY created_at DESC;" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" Height="220" Margin="0,16,0,0" AutomationProperties.Name="SQL code sample"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,48,16,32" Padding="20,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel AutomationProperties.AutomationId="docs-toc">
                <TextBlock Text="On this page" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Button Content="HTML" Tag="{Binding ElementName=Section_html_heading}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:html-heading"/>
                <Button Content="Java" Tag="{Binding ElementName=Section_java_heading}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:java-heading"/>
                <Button Content="C#" Tag="{Binding ElementName=Section_csharp_heading}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:csharp-heading"/>
                <Button Content="SQL" Tag="{Binding ElementName=Section_sql_heading}" Click="NavigateToSection" Style="{DynamicResource TocLinkStyle}" AutomationProperties.AutomationId="toc:sql-heading"/>
            </StackPanel></ScrollViewer>
        </Border>
    </Grid>
</UserControl>
