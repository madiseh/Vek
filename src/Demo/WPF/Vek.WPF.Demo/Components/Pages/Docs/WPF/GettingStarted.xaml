<UserControl x:Class="Vek.WPF.Demo.Components.Pages.Docs.WPF.GettingStarted"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40,40,32,64">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left" AutomationProperties.AutomationId="docs-article">
            <TextBlock Text="Getting Started" FontSize="36" FontWeight="Bold" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="article-title" />
            <TextBlock Text="This guide is being prepared." Style="{DynamicResource DescriptionStyle}"
                       Margin="0,16,0,0" AutomationProperties.AutomationId="article-intro" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
