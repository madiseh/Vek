<UserControl x:Class="Vek.WPF.Demo.Views.DocumentationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:navigation="clr-namespace:Vek.WPF.Demo.Navigation">
    <UserControl.Resources>
        <CollectionViewSource x:Key="NavigationPages" Source="{Binding Pages}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Section" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0" Padding="12,24">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="VEK / DOCUMENTATION" FontWeight="SemiBold" Margin="16,0,0,20" />
                <ListBox ItemsSource="{Binding Source={StaticResource NavigationPages}}"
                         SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         AutomationProperties.Name="Documentation navigation"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyboardNavigation.TabNavigation="Once">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}"
                                               FontSize="13" FontWeight="SemiBold" Margin="20,20,0,8" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl Content="{Binding SelectedPage}" Margin="48,48,48,64"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top"
                            AutomationProperties.Name="Documentation content">
                <ContentControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type navigation:DemoPageDefinition}">
                        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Section}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16" />
                            <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource DescriptionStyle}" Margin="0,24,0,0" />
                            <Border Background="{DynamicResource SelectedBrush}" Padding="16" Margin="0,32,0,0" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ImplementationStatus}" Value="{x:Static navigation:DemoPageImplementationStatus.InDevelopment}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="In development — native examples for this topic are being prepared."
                                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</UserControl>
