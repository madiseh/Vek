<UserControl x:Class="Vek.WPF.Demo.Views.DocumentationPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Vek.WPF.DataGrid.Components;assembly=Vek.WPF.DataGrid"
             x:Name="Root" Loaded="OnLoaded">
    <UserControl.Resources>
        <DataTemplate x:Key="NativeGridTemplate">
            <StackPanel>
                <components:VekDataGrid ItemsSource="{Binding BasicUsage.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        AutoGenerateColumns="False" IsReadOnly="True"
                                        CanUserAddRows="False" CanUserDeleteRows="False"
                                        CanUserSortColumns="True" CanUserReorderColumns="False"
                                        HeadersVisibility="Column" RowHeaderWidth="0" AlternationCount="2"
                                        GridLinesVisibility="Horizontal" MinHeight="210" MaxHeight="340"
                                        Background="{DynamicResource SidebarBrush}"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                        AlternatingRowBackground="{DynamicResource HoverBrush}"
                                        AutomationProperties.Name="Sample products data grid">
                    <components:VekDataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </components:VekDataGrid.RowStyle>
                    <components:VekDataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,6" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </components:VekDataGrid.CellStyle>
                    <components:VekDataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Padding" Value="8,10" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusStyle}" />
                        </Style>
                    </components:VekDataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="*" />
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C2}" SortMemberPath="Price" Width="*" />
                        <DataGridTextColumn Header="Product ID" Binding="{Binding Id}" SortMemberPath="Id" Width="*" />
                    </DataGrid.Columns>
                </components:VekDataGrid>
                <TextBlock Text="{Binding BasicUsage.LoadErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="Tomato" TextWrapping="Wrap" Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Assertive">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BasicUsage.LoadErrorMessage, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="ArticleScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="40,40,32,64">
            <StackPanel x:Name="Article" MaxWidth="900" HorizontalAlignment="Stretch" />
        </ScrollViewer>
        <Border Grid.Column="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Margin="0,48,16,32" Padding="20,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TableOfContents" AutomationProperties.Name="On this page" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
