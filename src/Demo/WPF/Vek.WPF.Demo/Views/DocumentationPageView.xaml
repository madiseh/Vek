<UserControl x:Class="Vek.WPF.Demo.Views.DocumentationPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:Vek.WPF.DataGrid.Components;assembly=Vek.WPF.DataGrid"
             xmlns:navigation="clr-namespace:Vek.WPF.Demo.Navigation"
             xmlns:views="clr-namespace:Vek.WPF.Demo.Views"
             x:Name="Root"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Section}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,16" />
            <TextBlock Text="{Binding Title}" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Description}" Style="{DynamicResource DescriptionStyle}" Margin="0,24,0,0" />

            <Border Background="{DynamicResource SelectedBrush}" Padding="16" Margin="0,32,0,0" CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ImplementationStatus}" Value="{x:Static navigation:DemoPageImplementationStatus.InDevelopment}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="In development — native WPF behavior for this topic is being prepared."
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            </Border>

            <StackPanel Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Id}" Value="vekdatagrid/basic-usage">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Live example" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="Click a column heading to sort the five sample products."
                           Style="{DynamicResource DescriptionStyle}" FontSize="15" Margin="0,0,0,18" />
                <components:VekDataGrid ItemsSource="{Binding BasicUsage.Products, ElementName=Root}"
                                        AutoGenerateColumns="False" IsReadOnly="True"
                                        CanUserAddRows="False" CanUserDeleteRows="False"
                                        CanUserSortColumns="True" CanUserReorderColumns="False"
                                        HeadersVisibility="Column" RowHeaderWidth="0" AlternationCount="2"
                                        GridLinesVisibility="Horizontal" MinHeight="210" MaxHeight="340"
                                        Background="{DynamicResource SidebarBrush}"
                                        Foreground="{DynamicResource TextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                        AlternatingRowBackground="{DynamicResource HoverBrush}"
                                        AutomationProperties.Name="Sample products data grid">
                    <components:VekDataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </components:VekDataGrid.RowStyle>
                    <components:VekDataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="8,6" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </components:VekDataGrid.CellStyle>
                    <components:VekDataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Padding" Value="8,10" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusStyle}" />
                        </Style>
                    </components:VekDataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="2*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="*" />
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C2}" SortMemberPath="Price" Width="*" />
                        <DataGridTextColumn Header="Product ID" Binding="{Binding Id}" SortMemberPath="Id" Width="*" />
                    </DataGrid.Columns>
                </components:VekDataGrid>
                <TextBlock x:Name="LoadErrorText" Visibility="Collapsed" Foreground="Tomato"
                           TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" />

                <TextBlock Text="Code" FontSize="25" FontWeight="SemiBold" Margin="0,34,0,14" />
                <TextBlock Text="Keep the native grid markup in Sample.xaml and its data loading logic in BasicUsageViewModel.cs."
                           Style="{DynamicResource DescriptionStyle}" FontSize="15" Margin="0,0,0,16" />
                <views:CodeSampleView Samples="{Binding BasicUsageCodeSamples, ElementName=Root}" Height="280" />

                <TextBlock Text="Sorting and pagination" FontSize="25" FontWeight="SemiBold" Margin="0,34,0,8" />
                <TextBlock Text="Column headings sort the sample products. WPF DataGrid does not provide paging here; that topic remains in development."
                           Style="{DynamicResource DescriptionStyle}" FontSize="15" />
            </StackPanel>

            <StackPanel Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Id}" Value="vekcodeview/basic-usage">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Read-only code samples" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
                <views:CodeSampleView Samples="{Binding CodeViewBasicSamples, ElementName=Root}" Height="360" />
            </StackPanel>

            <StackPanel Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Id}" Value="vekcodeview/multi-sample">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Choose a sample" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14" />
                <views:CodeSampleView Samples="{Binding CodeViewMultiSamples, ElementName=Root}" Height="360" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
