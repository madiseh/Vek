<UserControl x:Class="Vek.WPF.Demo.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,96" MaxWidth="760" HorizontalAlignment="Center">
            <TextBlock Text="VEK / WPF COMPONENTS" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,24" />
            <TextBlock Text="Native components.&#10;Built for WPF." FontSize="48" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Explore native WPF component examples and documentation."
                       Style="{DynamicResource DescriptionStyle}" TextAlignment="Center" Margin="0,24,0,32" />
            <Button Content="_Get Started" Command="{Binding GetStartedCommand}"
                    AutomationProperties.Name="Get Started" HorizontalAlignment="Center"
                    Padding="28,14" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
