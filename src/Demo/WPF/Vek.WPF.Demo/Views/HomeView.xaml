<UserControl x:Class="Vek.WPF.Demo.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.28" GradientOrigin="0.5,0.28" RadiusX="0.55" RadiusY="0.65">
                <GradientStop Color="#2E5D4BDC" Offset="0" />
                <GradientStop Color="#00171824" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>
        <Path Data="M 0,0.68 L 1,0.18 L 1,1 L 0,1 Z" Stretch="Fill" Height="200"
              VerticalAlignment="Bottom" IsHitTestVisible="False" Focusable="False">
            <Path.Fill>
                <LinearGradientBrush StartPoint="0,0.4" EndPoint="1,0.6">
                    <GradientStop Color="#5845DC" Offset="0.05" />
                    <GradientStop Color="#7850DF" Offset="0.52" />
                    <GradientStop Color="#B345A8" Offset="1" />
                </LinearGradientBrush>
            </Path.Fill>
        </Path>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,96,48,200" MaxWidth="880" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="VEK / WPF COMPONENTS" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,24" />
            <TextBlock Text="Native components." FontSize="64" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Built for WPF." FontSize="64" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0.4" EndPoint="1,0.6">
                        <GradientStop Color="#7561FF" Offset="0.05" />
                        <GradientStop Color="#E35BA8" Offset="0.94" />
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>
            <TextBlock Text="Explore native WPF component examples and documentation."
                       Style="{DynamicResource DescriptionStyle}" TextAlignment="Center" Margin="0,24,0,32" />
            <WrapPanel HorizontalAlignment="Center">
            <Button Content="_Get Started" Command="{Binding GetStartedCommand}"
                    AutomationProperties.Name="Get Started" HorizontalAlignment="Center"
                    Padding="28,14" Margin="8" FontWeight="SemiBold" Foreground="White">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0.4" EndPoint="1,0.6">
                        <GradientStop Color="#6553EE" Offset="0" />
                        <GradientStop Color="#825DE9" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            <Border BorderBrush="#8A889B" BorderThickness="1" CornerRadius="6" Margin="8"
                    Background="#9E171824" Padding="28,14">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                    <Hyperlink NavigateUri="https://github.com/madiseh/Vek" RequestNavigate="OpenRepository"
                               Foreground="{DynamicResource TextBrush}" TextDecorations="{x:Null}"
                               AutomationProperties.Name="Star on GitHub">Star on GitHub</Hyperlink>
                </TextBlock>
            </Border>
            </WrapPanel>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
