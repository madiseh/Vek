<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- Single source of truth for the current release; package publishing requires a matching vX.Y.Z tag. -->
    <VersionPrefix>1.3.4</VersionPrefix>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <PropertyGroup>
    <PrimaryTargetFramework>net10.0</PrimaryTargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NetEscapades.EnumGenerators.Generators uses DescriptionAttribute to generate the enum values -->
    <EnumGenerator_EnumMetadataSource>DescriptionAttribute</EnumGenerator_EnumMetadataSource>
  </PropertyGroup>


  <PropertyGroup>
    <BunVersion>1.4.4</BunVersion>
    <BunToolRestore>dotnet tool restore --tool-manifest &quot;$(MSBuildThisFileDirectory).config/dotnet-tools.json&quot;</BunToolRestore>
    <BunWrapper>dotnet tool run bun -- wrapper --version $(BunVersion) --path &quot;$(MSBuildThisFileDirectory)tools&quot; --silent --</BunWrapper>
    <BunInstall>$(BunWrapper) install --frozen-lockfile</BunInstall>
  </PropertyGroup>

  <!--
    Shared inputs for every Bun-built asset: the dependency graph and the toolchain version.
    Projects that build web assets add these to their own WebAssetInputs, plus their local build.mjs or build.mts.
    Without them the incremental Inputs/Outputs check only watches .js and .scss sources, so changing a dependency or the Bun version leaves the previously built assets in place and the build silently ships stale output.
    This file is listed because it defines BunVersion, which selects the Bun binary that emits the bundle.
  -->
  <ItemGroup>
    <BunToolchainInputs Include="$(MSBuildThisFileDirectory)src/package.json" />
    <BunToolchainInputs Include="$(MSBuildThisFileDirectory)src/bun.lock" />
    <BunToolchainInputs Include="$(MSBuildThisFileFullPath)" />
  </ItemGroup>
</Project>
