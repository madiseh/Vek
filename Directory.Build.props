<Project>
  <PropertyGroup>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$(MSBuildThisFileDirectory)</SolutionDir>
  </PropertyGroup>

  <!-- ============================================= -->
  <!-- Common Settings                               -->
  <!-- ============================================= -->
  <PropertyGroup>
    <PackageOutputPath>$(SolutionDir)\VekNugetPackage</PackageOutputPath>
    <TargetFramework>net10.0</TargetFramework>
    <WinTargetFramework>net10.0-windows</WinTargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'x86' and '$(Platform)' != 'x64'">AnyCPU</PlatformTarget>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <!-- mismatch configuration -->
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>Error</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
  </PropertyGroup>

  <!-- ============================================= -->
  <!-- EditorConfig & Roslyn Analyzers               -->
  <!-- Set EnableAnalyzers to true whenever needed   -->
  <!-- ============================================= -->
  <PropertyGroup>
    <EnableAnalyzers Condition="'$(EnableAnalyzers)' == ''">false</EnableAnalyzers>
    <EnableNETAnalyzers>$(EnableAnalyzers)</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>$(EnableAnalyzers)</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>$(EnableAnalyzers)</RunAnalyzersDuringBuild>
  </PropertyGroup>
</Project>
