<VekPopoverProvider />

<VekDateRangePicker id="picker" @ref="_picker" Label="With action buttons" @bind-DateRange="DateRange" AutoClose="@AutoClose">
    <PickerActions>
        <VekButton Class="mr-auto align-self-start" OnClick="@(() => _picker.ClearAsync())">Clear</VekButton>
        <VekButton OnClick="@(() => _picker.CloseAsync(false))">Cancel</VekButton>
        <VekButton Color="Color.Primary" OnClick="@(() => _picker.CloseAsync())">OK</VekButton>
    </PickerActions>
</VekDateRangePicker>

@code {
    private VekDateRangePicker _picker = null!;

    [Parameter]
    public DateRange? DateRange { get; set; }

    [Parameter]
    public bool AutoClose { get; set; }
}