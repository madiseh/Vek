<VekPopoverProvider/>
<VekStack>
    <VekDateRangePicker Class="hsx-daterange"
                        @bind-DateRange="_dateRange"
                        Clearable="true"
                        PlaceholderStart="PlaceholderFrom"
                        PlaceholderEnd="PlaceholderTo"
                        ShowToolbar="false"
                        Variant="Variant.Outlined"
    />
    <VekDateRangePicker Class="hsx-daterange"
                        @bind-DateRange="_dateRange"
                        Clearable="true"
                        PlaceholderStart="PlaceholderFrom"
                        PlaceholderEnd="PlaceholderTo"
                        ShowToolbar="false"
                        Variant="Variant.Outlined"
                        DateFormat="dd-MMM-yyyy"
    />
    <VekSwitch @bind-Value="_autoClose" Color="Color.Secondary">AutoClose</VekSwitch>
</VekStack>

@code {
    private DateRange? _dateRange;
    private bool _autoClose;
}