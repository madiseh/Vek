<VekTreeView T="string" SelectionMode="SelectionMode.MultiSelection" AutoSelectParent="false" SelectedValues="@SelectedValues">
    <VekTreeViewItem Class="root" Value='"root"'>
        <VekTreeViewItem Class="selected-leaf" Value='"selected-leaf"' />
        <VekTreeViewItem Class="unselected-leaf" Value='"unselected-leaf"' />
        <VekTreeViewItem Class="fully-selected" Value='"fully-selected"'>
            <VekTreeViewItem Class="fully-selected-child" Value='"fully-selected-child"' />
            <VekTreeViewItem Class="fully-selected-grandchild" Value='"fully-selected-grandchild"' />
        </VekTreeViewItem>
        <VekTreeViewItem Class="fully-unselected" Value='"fully-unselected"'>
            <VekTreeViewItem Class="fully-unselected-child" Value='"fully-unselected-child"' />
            <VekTreeViewItem Class="fully-unselected-grandchild" Value='"fully-unselected-grandchild"' />
        </VekTreeViewItem>
        <VekTreeViewItem Class="selected-parent" Value='"selected-parent"'>
            <VekTreeViewItem Class="selected-parent-child" Value='"selected-parent-child"'>
                <VekTreeViewItem Class="selected-parent-grandchild" Value='"selected-parent-grandchild"' />
            </VekTreeViewItem>
            <VekTreeViewItem Class="selected-parent-unselected-grandchild" Value='"selected-parent-unselected-grandchild"' />
        </VekTreeViewItem>
        <VekTreeViewItem Class="unselected-parent" Value='"unselected-parent"'>
            <VekTreeViewItem Class="unselected-parent-child" Value='"unselected-parent-child"'>
                <VekTreeViewItem Class="unselected-parent-grandchild" Value='"unselected-parent-grandchild"' />
            </VekTreeViewItem>
        </VekTreeViewItem>
        <VekTreeViewItem Class="wide" Value='"wide"'>
            <VekTreeViewItem Class="wide-selected" Value='"wide-selected"' />
            <VekTreeViewItem Class="wide-unselected" Value='"wide-unselected"' />
            <VekTreeViewItem Class="wide-selected-2" Value='"wide-selected-2"' />
        </VekTreeViewItem>
        <VekTreeViewItem Class="deep" Value='"deep"'>
            <VekTreeViewItem Class="deep-1" Value='"deep-1"'>
                <VekTreeViewItem Class="deep-2" Value='"deep-2"'>
                    <VekTreeViewItem Class="deep-3" Value='"deep-3"' />
                </VekTreeViewItem>
            </VekTreeViewItem>
        </VekTreeViewItem>
    </VekTreeViewItem>
    </VekTreeView>

@code {
    [Parameter]
    public IReadOnlyCollection<string> SelectedValues { get; set; } = [];
}
