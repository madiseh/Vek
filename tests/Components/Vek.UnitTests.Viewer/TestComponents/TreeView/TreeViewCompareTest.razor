<VekTreeView T="string" SelectionMode="SelectionMode.ToggleSelection" @bind-SelectedValue="SelectedValue" Comparer="Comparer">
    <VekTreeViewItem Value='"Ax"' @bind-Selected="_item1Selected">
        <VekTreeViewItem Value='"Bx"' />
    </VekTreeViewItem>
    <VekTreeViewItem Value='"Cx"' @bind-Selected="_item2Selected">
        <VekTreeViewItem Value='"Dx"' />
    </VekTreeViewItem>
</VekTreeView>

<p class="selected-value">
    @SelectedValue
</p>
<p class="item1-activated">
    @_item1Selected
</p>
<p class="item2-activated">
    @_item2Selected
</p>
@code{
    private bool _item1Selected;
    private bool _item2Selected;

    [Parameter]
    public string? SelectedValue { get; set; }

    [Parameter]
    public IEqualityComparer<string> Comparer { get; set; } = new DelegateEqualityComparer<string>(
        (x, y) =>
        {
            if (x == null && y == null) return true;
            if (x == null || y == null) return false;
            return x.Equals(y);
        },
        obj => obj?.GetHashCode() ?? 0);
}