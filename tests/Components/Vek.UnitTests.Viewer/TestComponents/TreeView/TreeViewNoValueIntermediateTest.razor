<VekTreeView T="string" SelectionMode="SelectionMode.MultiSelection" AutoSelectParent="true" @bind-SelectedValues="SelectedValues">
    <VekTreeViewItem Class="parent" Value='"parent"' Expanded="true">
        <VekTreeViewItem Class="parent-child" Value='"parent-child"' />
        <VekTreeViewItem Class="parent-group" Expanded="true">
            <BodyContent>Nested group</BodyContent>
            <ChildContent>
                <VekTreeViewItem Class="parent-group-child-1" Value='"parent-group-child-1"' />
                <VekTreeViewItem Class="parent-group-child-2" Value='"parent-group-child-2"' />
            </ChildContent>
        </VekTreeViewItem>
    </VekTreeViewItem>
</VekTreeView>

<p class="selected-values">@string.Join(", ", SelectedValues.Order())</p>

@code {
    [Parameter]
    public IReadOnlyCollection<string> SelectedValues { get; set; } = [];
}
