
<VekStack>
    <VekText>Select an item</VekText>
    <VekToggleGroup T="string" SelectionMode="SelectionMode.SingleSelection" Value="_value1" ValueChanged="OnValueChanged" Color="Color.Primary" CheckMark FixedContent>
        <VekToggleItem Value="@("Yes")" Text="Yes" />
        <VekToggleItem Value="@("No")" Text="No" />
        <VekToggleItem Value="@("Don't know")" Text="Don't know (Click me twice)" />
    </VekToggleGroup>
    <VekText>
        Selected value : @(_value1 ?? "None")
    </VekText>
</VekStack>


@code {

    private string? _value1;

    private async Task OnValueChanged(string value)
    {
        if (value == "Don't know")
        {

            // I expect "Yes" to become the selected toggle button
            _value1 = "Yes";
        }
        else
        {
            _value1 = value;
        }

        await Task.CompletedTask;
    }
}