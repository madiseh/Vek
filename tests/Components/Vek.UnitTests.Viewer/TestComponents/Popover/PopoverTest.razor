<VekPopoverProvider />

<div class="popoverparent">
    <p>Some Text</p>
    <VekPopover Open="_open">
        <VekText>Popover content</VekText>
    </VekPopover>
</div>

@code {
    private bool _open;

    public Task Open()
    {
        _open = true;
        return InvokeAsync(StateHasChanged);
    }

    public Task Close()
    {
        _open = false;
        return InvokeAsync(StateHasChanged);
    }
}