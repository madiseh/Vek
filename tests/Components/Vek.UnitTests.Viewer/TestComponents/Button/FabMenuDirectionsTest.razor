@using Vek

<VekGrid>
    <VekItem xs="12">
        <VekText Typo="Typo.h6">Fixed Anchors (Scroll down to see them fixed to viewport or select one)</VekText>
        <VekSelect T="Origin" Label="Anchor" @bind-Value="_anchor" FitContent>
            @foreach (Origin origin in Enum.GetValues(typeof(Origin)))
            {
                <VekSelectItem Value="@origin">@origin</VekSelectItem>
            }
        </VekSelect>
        <VekFabMenu Fixed="true" Anchor="_anchor" Direction="@GetDirection(_anchor)" Color="Color.Error" StartIcon="@Icons.Material.Filled.Settings">
            <VekFabMenuItem Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
            <VekFabMenuItem Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Delete" />
        </VekFabMenu>
    </VekItem>

    <VekItem xs="12">
        <VekText Typo="Typo.h6">Directions</VekText>
    </VekItem>
    @foreach (Direction direction in Enum.GetValues(typeof(Direction)))
    {
        <VekItem xs="4" Class="d-flex flex-column align-center justify-center pa-16" Style="height: 300px;">
            <VekText Typo="Typo.subtitle1">@direction</VekText>
            <VekFabMenu Direction="@direction" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
                <VekFabMenuItem Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
                <VekFabMenuItem Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Delete" />
                <VekFabMenuItem Color="Color.Info" StartIcon="@Icons.Material.Filled.Share" />
            </VekFabMenu>
        </VekItem>
    }
    
    <VekItem xs="12" Class="mt-16">
        <VekText Typo="Typo.h6">Extended FAB Menu</VekText>
    </VekItem>
    <VekItem xs="12" Class="d-flex justify-space-around pa-16">
        <VekFabMenu Direction="Direction.Top" Label="Extended Top" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            <VekFabMenuItem Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
            <VekFabMenuItem Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Delete" />
        </VekFabMenu>
        
        <VekFabMenu Direction="Direction.Right" Label="Extended Right" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">
            <VekFabMenuItem Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
            <VekFabMenuItem Color="Color.Tertiary" StartIcon="@Icons.Material.Filled.Delete" />
        </VekFabMenu>
    </VekItem>

</VekGrid>

@code {
    private Origin _anchor = Origin.BottomRight;

    private Direction GetDirection(Origin origin)
    {
        return origin switch
        {
            Origin.TopLeft or Origin.TopRight or Origin.TopCenter => Direction.Bottom,
            Origin.BottomLeft or Origin.BottomRight or Origin.BottomCenter => Direction.Top,
            Origin.CenterLeft => Direction.Right,
            Origin.CenterRight => Direction.Left,
            Origin.CenterCenter => Direction.End,
            _ => Direction.Top
        };
    }
}
