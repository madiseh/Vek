<div class="overflow-y-auto" style="height: 560px;">
    <VekText Typo="Typo.h6">Inside Container</VekText>
    @for (int i = 1; i < 100; i++)
    {
        <div>
            <VekTooltip Text="@("Person " + i)" Placement="Placement.Right">
                <VekIconButton Icon="@Icons.Material.Filled.Person" />
            </VekTooltip>
        </div>
    }
</div>
<VekText Typo="Typo.h6">Scrollable Body</VekText>
@for (int i = 1; i < 100; i++)
{
    <div>
        <VekTooltip Text="@("Person " + i)" Placement="Placement.Right">
            <VekIconButton Icon="@Icons.Material.Filled.Person" />
        </VekTooltip>
    </div>
}

@code {
    public static string __description__ = "Scrolling Tooltips";
}
