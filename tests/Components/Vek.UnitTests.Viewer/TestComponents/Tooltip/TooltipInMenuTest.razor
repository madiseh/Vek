<VekText Typo="Typo.h6">VekTooltip is @Text</VekText>
<VekMenu Label="Menu">
    <VekTooltip Text="Some text">
        <VekMenuItem AutoClose="true">
            Some button with flashing tooltip
        </VekMenuItem>
    </VekTooltip>
</VekMenu>

<VekTooltip Text="Some text">
    <VekButton>
        Some button with normal tooltip
    </VekButton>
</VekTooltip>

@code {
    public static string __description__ = "Shows tooltips in a menu";

    private const string Text = "Testing";
}
