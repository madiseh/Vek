<VekPopoverProvider />

<VekTooltip Text="@TooltipTextContent" Touch="@EnableTouch" Placement="Placement.Start">
    <VekButton id="sample-button">My Button</VekButton>
</VekTooltip>

@code {
    [Parameter]
    public string? TooltipTextContent { get; set; }

    [Parameter]
    public bool EnableTouch { get; set; }
}

