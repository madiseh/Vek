<VekText>SelectedItems { @string.Join(", ", _selectedItems) }</VekText>
<VekTable Items="_items" @bind-SelectedItems="_selectedItems" MultiSelection="true">
    <HeaderContent>
        <VekTh>Nr</VekTh>
        <VekTh></VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd>@context</VekTd>
        <VekTd>
            <VekButton OnClick="(() => DeleteItem(context))">Delete</VekButton>
        </VekTd>
    </RowTemplate>
</VekTable>

@code {
    public static string __description__ = "SelectedItems should update when rows are removed and the header should remain checked.";

    private HashSet<int> _selectedItems = [];
    private readonly List<int> _items = [0, 1, 2, 3, 4];

    private void DeleteItem(int i)
    {
        _items.Remove(i);
        StateHasChanged();
    }
}
