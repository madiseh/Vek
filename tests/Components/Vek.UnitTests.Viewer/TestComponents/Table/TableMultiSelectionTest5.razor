<VekText>SelectedItems { @string.Join(", ", _selectedItems) }</VekText>
<VekTable Items="_items" @bind-SelectedItems="_selectedItems" MultiSelection="true" RowsPerPage="2">
    <HeaderContent>
        <VekTh>#</VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd>@context</VekTd>
    </RowTemplate>
    <PagerContent>
        <VekTablePager PageSizeOptions="_pageSizeOptions"/>
    </PagerContent>
</VekTable>

@code {
    public static string __description__ = "Multiselection should work with paging.";

    private readonly int[] _pageSizeOptions = [2];
    private readonly int[] _items = [0, 1, 2, 3];
    private HashSet<int> _selectedItems = [0, 1, 2, 3];
}
