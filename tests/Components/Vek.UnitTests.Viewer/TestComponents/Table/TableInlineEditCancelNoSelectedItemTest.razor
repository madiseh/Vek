<VekTable Items="_items" CanCancelEdit="true">
    <HeaderContent>
        <VekTh>Id</VekTh>
        <VekTh>Value</VekTh>
    </HeaderContent>
    <RowTemplate>
        <VekTd>@context.Id</VekTd>
        <VekTd>@context.Value</VekTd>
    </RowTemplate>
    <RowEditingTemplate>
        <VekTd>
            <VekTextField @bind-Value="@context.Id"></VekTextField>
        </VekTd>
        <VekTd>
            <VekTextField @bind-Value="@context.Value"></VekTextField>
        </VekTd>
    </RowEditingTemplate>
</VekTable>

@code {
    private readonly List<Element> _items =
    [
        new() { Value = "A", Id = "Id1" },
        new() { Value = "B", Id = "Id2" },
        new() { Value = "C", Id = "Id3" }
    ];

    public class Element
    {
        public required string Id { get; set; }

        public required string Value { get; set; }
    }
}