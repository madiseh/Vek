<ErrorBoundary>
    <ChildContent>
        <VekDataGrid Items="@_model" T="Model">
            <Columns>
        <PropertyColumn Property="@(dto => dto.Name)" Title="Name"></PropertyColumn>
        <PropertyColumn Property="@(dto => dto.Teacher!.Name)" Title="Teacher"></PropertyColumn>
    </Columns>
</VekDataGrid>
    </ChildContent>
    <ErrorContent>
        <VekAlert Severity="Severity.Error">Oh my! We caught an error and handled it!</VekAlert>
    </ErrorContent>
</ErrorBoundary>

@code {
    private readonly List<Model> _model =
    [
        new Model
        {
            Name = "Class A",
            Teacher = null
        }
    ];

    public record Model 
    {
        public string? Name {get; set;}

        public Teacher? Teacher {get; set;}
    }

    public record Teacher 
    {
        public string? Name {get; set;}
    }
}
