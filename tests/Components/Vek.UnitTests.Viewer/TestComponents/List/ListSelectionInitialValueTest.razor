<VekList T="string" Color="Color" @bind-SelectedValue="_selectedValue">
    <VekListSubheader>
        Your drink:
        <VekChip Color="Color.Secondary">
            @(_selectedValue ?? "You are dry")
        </VekChip>
    </VekListSubheader>
    <VekListItem Text="Sparkling Water" />
    <VekListItem Text="Teas">
        <NestedList>
            <VekListItem Text="Earl Grey" />
            <VekListItem Text="Matcha" />
            <VekListItem Text="Pu'er" />
        </NestedList>
    </VekListItem>
    <VekListItem Text="Coffees">
        <NestedList>
            <VekListItem Text="Irish Coffee" />
            <VekListItem Text="Double Espresso" />
            <VekListItem Text="Cafe Latte" />
        </NestedList>
    </VekListItem>
</VekList>

@code {
    public static string __description__ = "Sparkling Water should be selected initially.";

    private string? _selectedValue = "Sparkling Water";

    [Parameter]
    public Color Color { get; set; } = Color.Primary;

    public void SetSelectedValue(string? value)
    {
        _selectedValue = value;
        StateHasChanged();
    }
}