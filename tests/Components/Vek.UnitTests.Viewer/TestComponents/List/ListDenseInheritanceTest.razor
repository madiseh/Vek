<VekList T="string" Dense="Dense">
    <VekListSubheader>
        Drinks
    </VekListSubheader>
    <VekListItem Text="Sparkling Water" />
    <VekListItem Text="Teas" Expanded="true">
        <NestedList>
            <VekListItem Text="Earl Grey" />
            <VekListItem Text="Matcha" />
            <VekListItem Text="Pu'er" />
        </NestedList>
    </VekListItem>
    <VekListItem Text="Coffees" Dense="InnerListDense">
        <NestedList>
            <VekListItem Text="Irish Coffee" />
            <VekListItem Text="Double Espresso" />
            <VekListItem Text="Cafe Latte" />
        </NestedList>
    </VekListItem>
</VekList>

@code {
    public static string __description__ = "The child lists are dense when the parent list is dense.";

    [Parameter] 
    public bool Dense { get; set; }

    [Parameter] 
    public bool? InnerListDense { get; set; }
}