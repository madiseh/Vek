<VekTabs TabButtonsClass="vek-tabs-button-class" TabPanelsClass="vek-tabs-panel-class" @bind-ActivePanelIndex="@SelectedTab" @ref="Tabs">
    <VekTabPanel Class="vek-tab-panel-button-class-1" PanelClass="vek-tab-panel-panel-class-1">
        <ChildContent>
            <VekText>Tab content one</VekText>
        </ChildContent>
        <TabContent>
            Item One
        </TabContent>
    </VekTabPanel>
    <VekTabPanel Class="vek-tab-panel-button-class-2" PanelClass="vek-tab-panel-panel-class-2">
        <ChildContent>
            <VekText>Tab content two</VekText>
        </ChildContent>
        <TabContent>
            Item Two
        </TabContent>
    </VekTabPanel>
</VekTabs>

@code {
    public static int SelectedTab { get; set; } = 1;

    public VekTabs Tabs { get; set; } = null!;
}
