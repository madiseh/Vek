<VekRadioGroup T="Position" Value="@_selectedPosition" ValueChanged="@OnPositionChanged">
    <VekRadio T="Position" Value="@Position.Top">Horizontal</VekRadio>
    <VekRadio T="Position" Value="@Position.Left">Vertical</VekRadio>
</VekRadioGroup>

<VekTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6"
         EnableDragAndDrop="true" OnItemDropped="@ItemDroppedFired" OnTabReordered="@TabReordered" Position="@_selectedPosition">
    <VekTabPanel Text="Tab One">
        <VekText>Content One</VekText>
    </VekTabPanel>
    <VekTabPanel Text="Tab Two">
        <VekText>Content Two</VekText>
    </VekTabPanel>
    <VekTabPanel Text="Tab Three">
        <VekText>Content Three</VekText>
    </VekTabPanel>
    <VekTabPanel Text="Tab Disabled" Disabled="true">
        <VekText>Content Disabled</VekText>
    </VekTabPanel>
</VekTabs>

@code {
    public static string __description__ = "Viewer for VekTabs. Drag and drop tabs to reorder them.";
    private Position _selectedPosition;

    [Parameter]
    public Position Position { get; set; } = Position.Top;

    [Parameter]
    public EventCallback<VekItemDropInfo<VekTabPanel>> ItemDroppedFired { get; set; }

    [Parameter]
    public EventCallback<TabReorderedEventArgs> TabReordered { get; set; }

    protected override void OnInitialized()
    {
        _selectedPosition = Position;
    }

    private Task OnPositionChanged(Position position)
    {
        _selectedPosition = position;
        return Task.CompletedTask;
    }
}
