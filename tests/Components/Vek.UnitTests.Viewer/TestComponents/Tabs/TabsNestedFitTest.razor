<div style="max-width: 520px; border: 1px solid var(--vek-palette-lines-default);">
    <VekTabs Position="Position.Left" Elevation="1">
        <VekTabPanel Text="Outer 1">
            <VekTabs>
                @foreach (var tab in _tabs)
                {
                    <VekTabPanel @key="tab" Text="@tab">
                        <VekText>@tab content</VekText>
                    </VekTabPanel>
                }
            </VekTabs>
        </VekTabPanel>
        <VekTabPanel Text="Outer 2">
            <VekText>Second outer tab</VekText>
        </VekTabPanel>
    </VekTabs>
</div>

@code {
    public static string __description__ = "nested tabs should fit inside a left-positioned parent tab";

    private readonly List<string> _tabs =
    [
        "Accounts",
        "Billing",
        "Documents",
        "Notifications",
        "Permissions",
        "Audit history",
        "Integrations",
        "Advanced settings"
    ];
}
