<VekSelect Variant="Variant.Outlined" Label="Tabs Position" Dense="true" Margin="Margin.Dense" T="@Position" @bind-Value="Position">
    <VekSelectItem T="Position" Value="@Position.Top">Top</VekSelectItem>
    <VekSelectItem T="Position" Value="@Position.Start">Start</VekSelectItem>
    <VekSelectItem T="Position" Value="@Position.Left">Left</VekSelectItem>
    <VekSelectItem T="Position" Value="@Position.Right">Right</VekSelectItem>
    <VekSelectItem T="Position" Value="@Position.End">End</VekSelectItem>
    <VekSelectItem T="Position" Value="@Position.Bottom">Bottom</VekSelectItem>
</VekSelect>
<br />
<VekTabs @bind-ActivePanelIndex="@SelectedTab" SliderAnimation="@SliderAnimation" Position="@Position">
    <VekTabPanel Text="Tab One">
        <VekText>Content One</VekText>
    </VekTabPanel>
    <VekTabPanel Text="Tab Two">
        <VekText>Content Two</VekText>
    </VekTabPanel>
    <VekTabPanel Text="Tab Three">
        <VekText>Content Three</VekText>
    </VekTabPanel>
    <VekTabPanel Text="Tab Disabled" Disabled="true">
        <VekText>Content Disabled</VekText>
    </VekTabPanel>
</VekTabs>

SliderAnimation (@SliderAnimation):
<VekToggleIconButton @bind-Toggled="@SliderAnimation"
        Icon="@Icons.Material.Filled.Animation" 
        ToggledIcon="@Icons.Material.Filled.Animation" 
        Color="Color.Error" 
        ToggledColor="Color.Success"/>

@code {
    [Parameter]
    public int SelectedTab { get; set; } = 2;

    public bool SliderAnimation { get; set; } = true;

    public Position Position { get; set; } = Position.Left;
}