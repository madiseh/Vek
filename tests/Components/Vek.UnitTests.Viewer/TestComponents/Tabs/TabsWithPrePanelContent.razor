<VekPopoverProvider />

<VekTabs @bind-ActivePanelIndex="SelectedIndex" Class="">
    <ChildContent>
        <VekTabPanel Text="Tab One">
            <VekText class="my-text">Some Content</VekText>
        </VekTabPanel>
        <VekTabPanel Text="Tab Two">
            <VekText class="my-text">Another content</VekText>
        </VekTabPanel>
    </ChildContent>
    <PrePanelContent>
        <VekText Class="pre-panel-content-custom">Selected: @context?.Text</VekText>
    </PrePanelContent>
</VekTabs>

@code {
    [Parameter]
    public int SelectedIndex { get; set; }
}
