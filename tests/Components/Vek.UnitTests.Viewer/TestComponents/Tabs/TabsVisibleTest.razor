<VekTabs>
    <VekTabPanel Text="Item One" />
    <VekTabPanel Text="Item Two" Visible="@Visible" />
    <VekTabPanel Text="Item Three" />
</VekTabs>

<VekText>Hide first item</VekText>

<VekTabs>
    <VekTabPanel Text="Item One" Visible="false" />
