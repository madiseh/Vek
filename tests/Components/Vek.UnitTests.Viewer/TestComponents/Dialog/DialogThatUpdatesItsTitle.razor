<VekDialog>
    <TitleContent>
     Title: @_textTest
    </TitleContent>
    <DialogContent>
      Body: @_textTest
    </DialogContent>
    <DialogActions>
        <VekButton OnClick="Cancel">Cancel</VekButton>
        <VekButton Color="Color.Primary" OnClick="Submit">OK</VekButton>
    </DialogActions>
</VekDialog>


@code {
    private string? _textTest;

    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; } = null!;

    private void Submit()
    {
        _textTest = "Test123";
        VekDialog.StateHasChanged();
    }

    private static void Cancel()
    {
    }
}
