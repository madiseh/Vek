<VekButton OnClick="OpenDialogAsync" Class="open-dialog-button">
    Open Dialog
</VekButton>

<VekDialog @ref="_dialog">
    <DialogContent>
        <p>The dialog's content is displayed.</p>
    </DialogContent>
</VekDialog>

@code {
    private VekDialog _dialog = null!;

    private async Task OpenDialogAsync()
    {
        await _dialog.ShowAsync();
    }
}
