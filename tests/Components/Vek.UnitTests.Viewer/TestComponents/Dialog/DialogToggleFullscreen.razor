<VekDialog>
    <DialogContent>
        <div class="d-flex flex-column py-1">
            <VekButton OnClick="ToggleFullscreenAsync">Toggle FullScreen</VekButton>
        </div>
    </DialogContent>
    <DialogActions>
        <VekButton Color="Color.Primary" OnClick="Close">OK</VekButton>
    </DialogActions>
</VekDialog>
@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; } = null!;

    private void Close() => VekDialog.Close(DialogResult.Ok(true));

    private Task ToggleFullscreenAsync()
    {
        var options = VekDialog.Options with
        {
            FullScreen = !(VekDialog.Options.FullScreen ?? false)
        };

        return VekDialog.SetOptionsAsync(options);
    }
}