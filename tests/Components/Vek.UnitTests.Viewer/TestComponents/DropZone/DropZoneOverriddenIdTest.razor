<VekDropContainer T="SimpleDropItem"
                  Items="_items" ItemsSelector="@((item,dropzone) => item.ZoneIdentifier == dropzone)"
                  Class="d-flex">
    <ChildContent>
        <VekDropZone T="SimpleDropItem" Identifier="Column 1" Class="first-drop-zone" id="custom-zone">
            <VekText Typo="Typo.h6" Class="mb-4">Drop Zone 1</VekText>
        </VekDropZone>
        <VekDropZone T="SimpleDropItem" Identifier="Column 2" Class="second-drop-zone">
            <VekText Typo="Typo.h6" Class="mb-4">Drop Zone 2</VekText>
        </VekDropZone>
    </ChildContent>
    <ItemRenderer>
        <VekText>@context.Name</VekText>
    </ItemRenderer>
</VekDropContainer>

@code {
    private readonly IEnumerable<SimpleDropItem> _items =
    [
        new("First Item", "Column 1"),
        new("Second Item", "Column 2")
    ];

    public class SimpleDropItem(string name, string zoneIdentifier)
    {
        public string Name { get; set; } = name;
        public string ZoneIdentifier { get; set; } = zoneIdentifier;
    }
}
