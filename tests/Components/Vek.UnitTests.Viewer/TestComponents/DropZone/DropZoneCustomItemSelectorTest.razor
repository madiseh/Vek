<VekDropContainer T="SimpleDropItem" Items="_items" ItemsSelector="@((item,dropzone) => item.ZoneIdentifier == dropzone)" Class="d-flex">
    <ChildContent>
        <VekDropZone T="SimpleDropItem" Identifier="Column 1" Class="first-drop-zone">
            <ChildContent>
                <VekText Typo="Typo.h6" Class="mb-4">Drop Zone 1</VekText>
            </ChildContent>
            <ItemRenderer>
                <VekText>@context.Name by Drop Zone 1</VekText>
            </ItemRenderer>
        </VekDropZone>
        <VekDropZone T="SimpleDropItem" Identifier="Column 2" Class="second-drop-zone">
            <VekText Typo="Typo.h6" Class="mb-4">Drop Zone 2</VekText>
        </VekDropZone>
    </ChildContent>
    <ItemRenderer>
        <VekText>@context.Name</VekText>
    </ItemRenderer>
</VekDropContainer>

@code {
    private readonly IEnumerable<SimpleDropItem> _items =
    [
        new("First Item", "Column 1"),
        new("Second Item", "Column 2"),
        new("Third Item", "Column 2")
    ];

    public record SimpleDropItem(string Name, string ZoneIdentifier);
}
