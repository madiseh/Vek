<VekDialog>
    <TitleContent>
        <VekText Typo="Typo.h6">
            <VekIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" />
            Dialog Title
        </VekText>
    </TitleContent>
    <DialogContent>
        <VekExpansionPanels MultiExpansion="true">
            <VekExpansionPanel Text="Panel One">
                <VekTextField T="string" Variant="Variant.Outlined" Label="Editable Field" Disabled="false" Class="mt-3" HelperText="This field is enabled" />
                <VekTextField T="string" Variant="Variant.Outlined" Label="Disabled Field" Disabled="true" Class="mt-3" HelperText="This field is disabled" />
                <VekTextField T="string" Variant="Variant.Outlined" Label="Disabled Field with Character Counter" Disabled="true" Class="mt-3" HelperText="Max 100 characters" MaxLength="100" Counter="100" />
                <VekTextField T="string" Variant="Variant.Outlined" Label="Disabled Field with Auto-Grow" Disabled="true" Class="mt-3" HelperText="Expands with content" MaxLength="100" Counter="100" AutoGrow="true" />
                <VekTextField T="string" Variant="Variant.Outlined" Label="Minimal Disabled Auto-Grow" Disabled="true" Class="mt-3" AutoGrow="true" />
            </VekExpansionPanel>
        </VekExpansionPanels>
    </DialogContent>
    <DialogActions>
        <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Cancel">Close</VekButton>
    </DialogActions>
</VekDialog>

@code {
    [CascadingParameter]
    private IVekDialogInstance VekDialog { get; set; } = default!;

    private void Submit() => VekDialog.Close(DialogResult.Ok(true));
    private void Cancel() => VekDialog.Cancel();
}
