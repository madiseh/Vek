        <VekTextField T="string" Variant="Variant.Outlined" Label="Shrink Dense" ShrinkLabel="true" Margin="Margin.Dense"></VekTextField>
        <VekTextField T="string" Variant="Variant.Outlined" Margin="Margin.Dense" Label="Dense"></VekTextField>
        <VekTextField T="string" Variant="Variant.Outlined" Label="Shrink Normal" ShrinkLabel="true"></VekTextField>
        <VekTextField T="string" Variant="Variant.Outlined" Label="Normal"></VekTextField>
    </VekStack>
</VekRTLProvider>

