<VekDialog>
    <DialogContent>
        <VekMenu Label="Open Menu 1">
            <VekMenuItem>Item 1</VekMenuItem>
            <VekMenuItem>Item 2</VekMenuItem>
            <VekMenuItem>Item 3</VekMenuItem>
        </VekMenu>
        <VekSelect @bind-Value="@_firstText" T="string" Label="First select">
            <VekSelectItem Value='"First select 1"'>First select 1</VekSelectItem>
            <VekSelectItem Value='"First select 2"'>First select 2</VekSelectItem>
        </VekSelect>
        <VekSelect @bind-Value="@_secondText" T="string" Label="Second select">
            <VekSelectItem Value='"Second select 1"'>Second select 1</VekSelectItem>
            <VekSelectItem Value='"Second select 2"'>Second select 2</VekSelectItem>
        </VekSelect>
        <VekSelect @bind-Value="@_thirdText" T="string" Label="Third select">
            <VekSelectItem Value='"Third select 1"'>Third select 1</VekSelectItem>
            <VekSelectItem Value='"Third select 2"'>Third select 2</VekSelectItem>
        </VekSelect>
        <VekMenu Label="Open Menu 2">
            <VekMenuItem>Item 1</VekMenuItem>
            <VekMenuItem>Item 2</VekMenuItem>
            <VekMenuItem>Item 3</VekMenuItem>
        </VekMenu>
    </DialogContent>
</VekDialog>

@code {
    private string _firstText = string.Empty;
    private string _secondText = string.Empty;
    private string _thirdText = string.Empty;
}