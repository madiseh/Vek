<VekFileUpload T="IBrowserFile"
               MaxFileSize="@MaxFileSize"
               AllowedExtensions="@AllowedExtensions"
               AllowedMimeTypes="@AllowedMimeTypes"
               @bind-Files="File">
    <SelectedTemplate>
        <div>
            Select Template
        </div>
    </SelectedTemplate>
</VekFileUpload>

@code {
    public static string __description__ = "Tests binding a single uploaded file with an optional max size limit.";

    public IBrowserFile? File { get; private set; }

    [Parameter]
    public long? MaxFileSize { get; set; }

    [Parameter]
    public IReadOnlyList<string>? AllowedExtensions { get; set; }

    [Parameter]
    public IReadOnlyList<string>? AllowedMimeTypes { get; set; }

}
