<style>
    .vek-button-root:disabled {
        pointer-events: auto;
    }
</style>

<VekStack Spacing="4">
    <VekPaper Outlined="true" Class="pa-4">
        <VekText>Blank FileUpload Drag False</VekText>
        <VekFileUpload T="IReadOnlyList<IBrowserFile>"
                       AppendMultipleFiles="true" />
    </VekPaper>

    <VekPaper Outlined="true" Class="pa-4">
        <VekText>Blank FileUpload with empty SelectedTemplate</VekText>
        <VekFileUpload T="IReadOnlyList<IBrowserFile>" AppendMultipleFiles="true">
            <SelectedTemplate />
        </VekFileUpload>
    </VekPaper>

    <VekPaper Outlined="true" Class="pa-4">
        <VekText>Blank FileUpload Drag True</VekText>
        <VekFileUpload T="IReadOnlyList<IBrowserFile>"
                       Style="height: 300px;width: 300px;"
                       AppendMultipleFiles="true"
                       DragAndDrop="true" />
    </VekPaper>

    <VekPaper Outlined="true" Class="pa-4">
        <VekText>File Upload with Activator Content</VekText>
        <VekFileUpload T="IReadOnlyList<IBrowserFile>"
                       AppendMultipleFiles="true"
                       DragAndDrop="true"
                       tabindex="-1"
                       @bind-Dragging="@_dragging"
                       @bind-Dragging:after="@ClearDragClass">
            <CustomContent>
                <VekPaper Height="300px"
                          Outlined="true"
                          @onclick="@context.OpenFilePickerAsync"
                          @ondragenter="@SetDragClass"
                          Class="@_dragClass">
                    <VekText Typo="Typo.h6">
                        Drag and drop files here or click
                    </VekText>
                    @foreach (var file in context.GetFilenames())
                    {
                        <VekChip T="string"
                                 Color="Color.Dark"
                                 Text="@file"
                                 tabindex="-1" />
                    }
                    <VekToolBar Gutters="@false"
                                Class="relative d-flex justify-end gap-4 z-11">
                        <VekButton Color="Color.Primary"
                                   OnClick="@context.OpenFilePickerAsync"
                                   Variant="Variant.Filled">
                            Open file picker
                        </VekButton>
                        <VekButton Color="Color.Error"
                                   Disabled="@(!context.GetFilenames().Any())"
                                   OnClick="@context.ClearAsync"
                                   Variant="Variant.Filled">
                            Clear
                        </VekButton>
                    </VekToolBar>
                </VekPaper>
            </CustomContent>
            <SelectedTemplate />
        </VekFileUpload>
    </VekPaper>
</VekStack>

@code {
#nullable enable
    public static string __description__ = "A test for using components inside CustomContent that don't activate.";
    private const string DefaultDragClass = "relative rounded-lg border-2 border-dashed pa-4 mt-4 vek-width-full vek-height-full";
    private string _dragClass = DefaultDragClass;
    private bool _dragging = false;

    private void SetDragClass()
    {
        _dragClass = $"{DefaultDragClass} vek-border-primary";
        _dragging = true;
    }

    private void ClearDragClass()
    {
        if (!_dragging)
        {
            _dragClass = DefaultDragClass;
        }
    }
}
