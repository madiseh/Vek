<div style="max-width: 400px;">
    <VekForm @ref="_form1" @bind-IsValid="@_valid" @bind-IsTouched="@_touched" ValidationDelay="0" >
        <VekTextField id="textFieldLabelTest" T="string" Label="First Name"/>
        <VekTextField T="string" Required="true" Label="Last Name" />
    </VekForm>
    <div class="d-flex mt-5">
        <VekButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => _form1.ValidateAsync())">Validate</VekButton>
        <VekButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@(() => _form1.ResetAsync())" Class="mx-2">Reset</VekButton>
        <VekButton Variant="Variant.Filled" OnClick="@(() => _form1.ResetValidationAsync())">Reset Validation</VekButton>
    </div>
    <div class="d-flex mt-3">
        <VekSwitch @bind-Value="@_valid" Label="IsValid " Color="Color.Info" />
        <VekSwitch @bind-Value="@_touched" Label="IsTouched" Color="Color.Info" />
    </div>
</div>

@code {
    public static string __description__ = "Form should update the bound variables valid and touched whenever they change.";

    private bool _touched;
    private bool _valid = true;
    private VekForm _form1 = null!;
}
