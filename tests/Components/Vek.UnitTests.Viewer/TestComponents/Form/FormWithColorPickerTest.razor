@using Vek.Utilities

<VekPopoverProvider />

<VekForm ValidationDelay="0">
    <VekColorPicker Required="true" @bind-Value="ColorValue">
    </VekColorPicker>
</VekForm>

@code {
    public static string __description__ = "Form should validate color picker's value.";

    [Parameter]
    public VekColor ColorValue { get; set; } = new("#000000");
}
