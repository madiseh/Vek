<VekPaper Height="500px" Style="overflow:hidden; position:relative;">
    <VekDrawerContainer Class="vek-width-full">
        <VekDrawer @bind-Open="@_open" Variant="@DrawerVariant.Persistent" Anchor="@Anchor" Height="@DrawerHeight">
            <VekDrawerHeader>
                <VekText Typo="Typo.h6">My App</VekText>
            </VekDrawerHeader>
            <VekNavMenu>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Error">Dashboard</VekNavLink>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.LocalLibrary" IconColor="Color.Error">Library</VekNavLink>
                <VekNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.People" IconColor="Color.Error">Community</VekNavLink>
            </VekNavMenu>
        </VekDrawer>
        <div class="d-flex justify-center align-center vek-width-full vek-height-full" id="toggle-button-container">
            <VekButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="@ToggleDrawer" id="toggle-drawer-button">Toggle Drawer</VekButton>
        </div>
    </VekDrawerContainer>
</VekPaper>

@code {
    private bool _open = false;
    [Parameter]
    public VekDrawer Drawer { get; set; } = null!;

    [Parameter]
    public Anchor Anchor { get; set; } = Anchor.Top;

    [Parameter]
    public string DrawerHeight { get; set; } = "300px";

    private void ToggleDrawer() => _open = !_open;
}
