<VekLayout>
    <VekAppBar Elevation="1">
        <VekIconButton id="toggle-drawer-button" Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
    </VekAppBar>
    <VekDrawer @ref="@Drawer" @bind-Open="@_open" Variant="@DrawerVariant.Temporary" Elevation="1">
    </VekDrawer>
    <VekMainContent Class="pt-16 px-16">
        <VekContainer Class="mt-6">
        </VekContainer>
    </VekMainContent>
</VekLayout>

@code{
    private bool _open;

    public VekDrawer Drawer { get; private set; } = null!;
    
    [Parameter]
    public bool InitialOpenState { get; set; }

    protected override void OnInitialized()
    {
        _open = InitialOpenState;
        base.OnInitialized();
    }

    private void ToggleDrawer() => _open = !_open;
}