<VekPopoverProvider />

<VekPaper Class="flex-1 d-flex pa-1" Width="500px" Height="500px" Outlined="true" Square="true">
    <VekMenu PositionAtCursor="true" Dense="true" class="vek-height-full vek-width-full" ActivationEvent="@MouseEvent.RightClick">
        <ActivatorContent>
            <VekPaper Class="d-flex align-center justify-center  vek-info" Height="100%" Width="100%">
                <VekText Typo="Typo.h6">Right Click Me</VekText>
            </VekPaper>

        </ActivatorContent>
        <ChildContent>
            <VekMenuItem Label="Dense Stuff" />
            <VekMenuItem Label="Stuff is Dense" />
            <VekMenuItem Label="Soo Dense" />
        </ChildContent>
    </VekMenu>
</VekPaper>

@code {
    public static string __description__ = "Covers setting PositionAtCursor for VekMenu regardless of container.";
}
