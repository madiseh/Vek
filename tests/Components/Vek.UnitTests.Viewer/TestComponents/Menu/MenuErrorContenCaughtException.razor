<ErrorBoundary>
    <ChildContent>
        <VekPopoverProvider></VekPopoverProvider>
        <VekMenu Label="Open Menu">
            <ChildContent>
                <VekMenuItem @onclick="@HandleClickAsync">Throw error</VekMenuItem>
            </ChildContent>
        </VekMenu>
        <br/>
    </ChildContent>
    <ErrorContent>
        <VekAlert Severity="Severity.Error">Oh my! We caught an error and handled it!</VekAlert>
    </ErrorContent>
</ErrorBoundary>

@code {
    public async Task HandleClickAsync()
    {
        await Task.Delay(100);
        throw new Exception("Something went wrong...");
    }
}
