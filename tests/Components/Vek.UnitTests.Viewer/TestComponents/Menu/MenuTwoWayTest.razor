<VekPopoverProvider />

<VekMenu @bind-Open="@Open" Label="Full Menu Width" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" PopoverClass="menu-popover-class">
    <VekMenuItem Class="test-class">1</VekMenuItem>
    <VekMenuItem Href="https://www.test.com">2</VekMenuItem>
    <VekMenuItem Href="https://www.test.com" Target="_blank">3</VekMenuItem>
    <VekMenuItem AutoClose="false">4 (AutoClose is false)</VekMenuItem>
</VekMenu>

<VekSwitch id="switch" Color="Color.Primary" @bind-Value="Open" Label="Open Menu Switch" />
@code {
    public bool Open { get; private set; }
}