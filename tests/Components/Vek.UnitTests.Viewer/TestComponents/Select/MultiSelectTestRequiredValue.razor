<VekPopoverProvider />

<VekSelect @ref="@_stringSelect" T="string?" @bind-Value="@_value" @bind-SelectedValues="@_values" Label="String Binding" MultiSelection="true" Required="true" Clearable="true">
    <VekSelectItem Value="@("1")">1</VekSelectItem>
    <VekSelectItem Value="@("2")">2</VekSelectItem>
    <VekSelectItem Value="@("3")">3</VekSelectItem>
</VekSelect>

<VekStack Row Class="py-8">
    <VekButton id="clear-string" Variant="Variant.Filled" OnClick="@(() => _stringSelect.ClearAsync())">Clear</VekButton>
    <VekButton id="reset-string" Variant="Variant.Filled" OnClick="@(() => _stringSelect.ResetAsync())">Reset</VekButton>
</VekStack>

<VekText>Value: @_value</VekText>
<VekText>Selected values: @(_values is null ? null : string.Join(", ", _values.Select(x => x)))</VekText>

<VekSelect @ref="_objectSelect" T="TestClass" @bind-Value="@_selectedRole" @bind-SelectedValues="_selectedRoles" Label="Object Binding" MultiSelection="true" Required="true" Clearable="true">
    @foreach(var role in _roles)
    {
        <VekSelectItem T="TestClass" Value=@role/>
    }
</VekSelect>

<VekStack Row Class="py-8">
    <VekButton id="clear-object" Variant="Variant.Filled" OnClick="@(() => _objectSelect.ClearAsync())">Clear</VekButton>
    <VekButton id="reset-object" Variant="Variant.Filled" OnClick="@(() => _objectSelect.ResetAsync())">Reset</VekButton>
</VekStack>

<VekText>Value: @_selectedRole?.Name</VekText>
<VekText>Selected values: @(string.Join(", ", _selectedRoles.Select(x => x.Name)))</VekText>

@code {
    public static string __description__ = "Multi-Select Required Should Recognize Values";

    private VekSelect<string?> _stringSelect = null!;
    private VekSelect<TestClass> _objectSelect = null!;

    private string? _value;
    private IReadOnlyCollection<string?>? _values;

    private TestClass? _selectedRole;
    private IReadOnlyCollection<TestClass> _selectedRoles = [];
    private readonly List<TestClass> _roles =
    [
        new() { Name = "Admin", NameTranslated = "Administrator" },
        new() { Name = "Customer", NameTranslated = "Kunde" }
    ];

    public class TestClass
    {
        public required string Name { get; set; }

        public required string NameTranslated { get; set; }

        public override string ToString() => Name;
    }
}
