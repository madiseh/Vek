<VekPopoverProvider />

<VekSelect Label="Select Item"
           MultiSelection="true"
           T="string"
           Delimiter="^"
           SelectAll="true"
           @bind-SelectedValues="@_selectedItems">
    @foreach (var item in _allItems)
    {
        <VekSelectItem T="string" Value="@item">@item</VekSelectItem>
    }
</VekSelect>

@code {
    public static string __description__ = "Test for the Select All option";

    private readonly List<string> _allItems = [];
    private IReadOnlyCollection<string> _selectedItems = [];

    protected override void OnInitialized()
    {
        _allItems.Add("FirstA");
        _allItems.Add("SecondA");
        _allItems.Add("ThirdA");

        base.OnInitialized();
    }
}
