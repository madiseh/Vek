@namespace Vek.UnitTests.TestComponents.Select

@* Guards the #13086 fix: forwarding consumer attributes to the presenter must not
   duplicate the id (owned by the hidden input) nor add tabindex to a disabled presenter. *@
<VekSelect T="string" Value="@("car")" id="select-with-id" Label="With id">
    <VekSelectItem Value="@("car")"><span>Car</span></VekSelectItem>
    <VekSelectItem Value="@("van")"><span>Van</span></VekSelectItem>
</VekSelect>

<VekSelect T="string" Value="@("car")" Disabled="true" tabindex="0" data-scenario="disabled" Label="Disabled">
    <VekSelectItem Value="@("car")"><span>Car</span></VekSelectItem>
    <VekSelectItem Value="@("van")"><span>Van</span></VekSelectItem>
</VekSelect>
