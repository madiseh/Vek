<VekGrid>
    <VekItem sm="12" md="6">
        <VekRadioGroup @bind-Value="_selectedOption1" ReadOnly="_readOnly">
            <VekRadio Value="@("Radio 1")">Radio 1</VekRadio>
            <VekRadio Value="@("Radio 2")">Radio 2</VekRadio>
            <VekRadio Value="@("Radio 3")">Radio 3</VekRadio>
            <VekRadio Value="@("Radio 4")">Radio 4</VekRadio>
        </VekRadioGroup>
        <VekSwitch @bind-Value="_readOnly" Color="Color.Primary" Label="ReadOnly" />
        <VekText>Selected Option 1: @_selectedOption1</VekText>
    </VekItem>
    <VekItem sm="12" md="6">
        <VekRadioGroup @bind-Value="_selectedOption2" Disabled="_disabled">
            <VekRadio Value="@("Radio 1")">Radio 1</VekRadio>
            <VekRadio Value="@("Radio 2")">Radio 2</VekRadio>
            <VekRadio Value="@("Radio 3")">Radio 3</VekRadio>
            <VekRadio Value="@("Radio 4")">Radio 4</VekRadio>
        </VekRadioGroup>
        <VekSwitch @bind-Value="_disabled" Color="Color.Primary" Label="Disabled" />
        <VekText>Selected Option 2: @_selectedOption2</VekText>
    </VekItem>
</VekGrid>

@code {
    private string? _selectedOption1;
    private string? _selectedOption2;
    private bool _disabled;
    private bool _readOnly;
}