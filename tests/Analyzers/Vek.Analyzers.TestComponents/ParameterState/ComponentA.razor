@using Vek.State

<div>Counter: @Counter</div>

@code {
    [Parameter, ParameterState]
    public int Counter { get; set; }

    // Constructor assignment - allowed (no VEK0011)
    public ComponentA()
    {
        Counter = 0;
    }

    // SetParametersAsync assignment - allowed (no VEK0011)
    public override Task SetParametersAsync(ParameterView parameters)
    {
        Counter = 5;
        return base.SetParametersAsync(parameters);
    }

    // Reading the property inside a method - should trigger VEK0010
    public int GetCounter()
    {
        return Counter; // VEK0010
    }

    // Writing inside a method - should trigger VEK0011
    public void SetCounter(int value)
    {
        Counter = value; // VEK0011
    }

    // Reading the property in various ways - should trigger VEK0010
    public void ReadExamples()
    {
        var x = Counter; // VEK0010
        DoSomething(Counter); // VEK0010
    }

    // Writing with compound assignment - should trigger VEK0011
    public void CompoundAssign()
    {
        Counter += 1; // VEK0011
    }

    // Increment - should trigger VEK0011
    public void IncrementCounter()
    {
        Counter++; // VEK0011
    }

    // Decrement - should trigger VEK0011
    public void DecrementCounter()
    {
        Counter--; // VEK0011
    }

    private void DoSomething(int value) { }
}
