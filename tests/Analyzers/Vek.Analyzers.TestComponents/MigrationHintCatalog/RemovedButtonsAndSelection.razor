@*each removed parameter appears once, on the component a consumer writes*@

@*buttons: Link, DisableRipple, and DisableElevation come from VekBaseButton*@
<VekButton Link="/button" DisableRipple="true" DisableElevation="true">Button</VekButton>
<VekIconButton Icon="@Icons.Material.Filled.Add" Link="/icon-button" DisableRipple="@_flag" DisableElevation="@(!_flag)" />
<VekFab Icon="@Icons.Material.Filled.Add" Link="/fab" DisableRipple="false" DisableElevation="@(_flag && _other)" />
<VekToggleIconButton Icon="@Icons.Material.Filled.AlarmOff" ToggledIcon="@Icons.Material.Filled.AlarmOn" DisableRipple="true" DisableElevation="true" />
<VekButtonGroup DisableElevation="true" VerticalAlign="true">
    <VekButton>One</VekButton>
</VekButtonGroup>

@*selection controls*@
<VekCheckBox T="bool" Checked="@_flag" CheckedChanged="@((bool value) => _flag = value)" DisableRipple="true" LabelPosition="LabelPosition.Start" />
<VekSwitch T="bool" Checked="@_flag" CheckedChanged="@((bool value) => _flag = value)" DisableRipple="@_flag" LabelPosition="LabelPosition.End" />
<VekRadioGroup T="string" SelectedOption="@_text" SelectedOptionChanged="@((string value) => _text = value)">
    <VekRadio T="string" Option="@("a")" DisableRipple="true" Placement="Placement.End">A</VekRadio>
</VekRadioGroup>
<VekToggleGroup T="string" DisableRipple="true" Outline="false" />
<VekRating DisableRipple="true" />
<VekRatingItem DisableRipple="false" />

@code
{
    public static string __description__ = "Removed button and selection-control parameters that VEK0002 explains";

    private bool _flag = true;

    private bool _other = true;

    private string _text = "a";
}
