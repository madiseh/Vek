@using Microsoft.AspNetCore.Components.Web
@*each removed parameter appears once, on the component a consumer writes*@

@*inputs: DisableUnderLine and OnKeyPress come from VekBaseInput*@
<VekTextField T="string" DisableUnderLine="true" OnKeyPress="@((KeyboardEventArgs args) => _text = args.Key)" AutoGrow="true" />
<VekNumericField T="int" DisableUnderLine="true" OnKeyPress="@((KeyboardEventArgs args) => _text = args.Key)" />
<VekSelect T="string" DisableUnderLine="true" OnOpen="@(() => _flag = true)" OnClose="@(() => _flag = false)" />
<VekAutocomplete T="string" DisableUnderLine="true" IsOpenChanged="@((bool open) => _flag = open)" SelectOnClick="true" SearchFuncWithCancel="@((string value, CancellationToken token) => SearchAsync(value, token))" />
<VekField DisableUnderLine="true" />
<VekInput T="string" AutoGrow="@_flag" />

@*pickers: DisableToolbar, DisableUnderLine, InputIcon, InputVariant, and ClassActions come from VekPicker*@
<VekDatePicker DisableToolbar="true" DisableUnderLine="true" InputIcon="@Icons.Material.Filled.Event" InputVariant="Variant.Outlined" />
<VekDateRangePicker DisableToolbar="true" />
<VekTimePicker DisableToolbar="false" ClassActions="actions" />
<VekColorPicker DisableToolbar="true" DisableSliders="true" DisablePreview="true" DisableModeSwitch="true" DisableInputs="true" DisableDragEffect="true" DisableColorField="true" DisableAlpha="true" />
<VekPickerToolbar DisableToolbar="true" />

@*navigation, tabs, and progress*@
<VekNavMenu>
    <VekNavGroup Title="Group" DisableRipple="true">
        <VekNavLink Href="/link" DisableRipple="true">Link</VekNavLink>
    </VekNavGroup>
</VekNavMenu>
<VekTabs DisableRipple="true" DisableSliderAnimation="true" TabPanelClass="buttons" PanelClass="panels">
    <VekTabPanel Text="One" PanelClass="one-panel" />
</VekTabs>
<VekDynamicTabs PanelClass="panels" />
<VekTimeline DisableModifiers="true" />
<VekProgressCircular Value="50" Minimum="0" Maximum="100" />
<VekProgressLinear Value="50" Minimum="0" Maximum="100" />
<VekCarousel TData="string" ShowDelimiters="true" DelimitersColor="Color.Primary" DelimitersClass="bullets" DelimiterTemplate="@_bulletTemplate" />
<VekPagination Count="3" DisableElevation="true" />

@*tables and data grids*@
<VekTablePager DisableRowsPerPage="true" />
<VekDataGridPager T="string" DisableRowsPerPage="true" />
<VekDataGrid T="Row" Items="_rows" CancelledEditingItem="@((Row row) => _text = row.Name)">
    <Columns>
        <PropertyColumn Property="x => x.Name" IsEditable="true" />
        <TemplateColumn IsEditable="false" />
    </Columns>
</VekDataGrid>
<VekTable T="string" Items="_items">
    <HeaderContent>
        <VekTHeadRow IsCheckable="true" IsExpandable="true" />
    </HeaderContent>
    <RowTemplate>
        <VekTr IsCheckable="true" IsChecked="@_flag" IsCheckedChanged="@((bool isChecked) => _flag = isChecked)" IsExpandable="true" IsEditable="true" />
    </RowTemplate>
    <FooterContent>
        <VekTFootRow IsCheckable="true" IsExpandable="true" />
    </FooterContent>
</VekTable>
<VekTableGroupRow T="string" IsCheckable="true" />

@*trees, drag and drop, and charts*@
<VekTreeView T="string" CanHover="true" ActivatedValueChanged="@((string value) => _text = value)">
    <VekTreeViewItem T="string" Value="@("item")" ExpandedIcon="@Icons.Material.Filled.ChevronRight" ExpandedIconColor="Color.Primary" />
</VekTreeView>
<VekDropContainer T="string" Items="_items" ItemsSelector="@((item, zone) => true)" ItemIsDisabled="@((string item) => item.Length == 0)">
    <ChildContent>
        <VekDropZone T="string" Identifier="zone" ItemIsDisabled="@((string item) => false)" />
    </ChildContent>
</VekDropContainer>
<VekChart T="double" XAxisLabels="@_labels" InputLabels="@_labels" />

@code
{
    public static string __description__ = "Removed input, picker, navigation, and data parameters that VEK0002 explains";

    private bool _flag = true;

    private string _text = "a";

    private readonly string[] _items = ["a", "b"];

    private readonly string[] _labels = ["Jan", "Feb"];

    private readonly Row[] _rows = [new("a")];

    private readonly RenderFragment<bool> _bulletTemplate = selected => builder => builder.AddContent(0, selected);

    private Task<IEnumerable<string>> SearchAsync(string value, CancellationToken token) => Task.FromResult<IEnumerable<string>>(_items);

    public sealed record Row(string Name);
}
