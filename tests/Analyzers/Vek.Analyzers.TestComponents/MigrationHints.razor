@*removed in v7: Link moved to Href*@
<VekButton Link="/removed-in-v7">Link</VekButton>

@*removed in v7: DisableRipple moved to Ripple with the value inverted*@
<VekButton DisableRipple="true">Literal true</VekButton>
<VekButton DisableRipple="false">Literal false</VekButton>
<VekButton DisableRipple="@_noRipple">Simple expression</VekButton>
<VekButton DisableRipple="@(_noRipple && !_grow)">Complex expression</VekButton>

@*multiline attributes with nested content*@
<VekButton Variant="Variant.Filled"
           Link="/multiline"
           Color="Color.Primary">
    <VekText>Nested content</VekText>
</VekButton>

@*removed in v9: AutoGrow moved to Sizing; @bind-Value forces a TypeInference helper*@
<VekTextField @bind-Value="_text" AutoGrow="true" Label="Literal true" />
<VekTextField @bind-Value="_text" AutoGrow="false" Label="Literal false" />
<VekTextField T="string" AutoGrow="@_grow" Label="Simple expression" />
<VekTextField T="string" AutoGrow="@(_grow || _noRipple)" Label="Complex expression" />

@*the replacements themselves compile and stay silent*@
<VekButton Href="/replacement" Ripple="false">Href and Ripple</VekButton>
<VekButton Ripple="@(!_noRipple)">Inverted expression</VekButton>
<VekTextField @bind-Value="_text" Sizing="InputSizing.Auto" Lines="3" MaxLines="8" Label="Auto" />
<VekTextField T="string" Sizing="@(_grow ? InputSizing.Auto : InputSizing.Fixed)" Label="Conditional" />

@*derived component without its own Link still points at VekButton's replacement*@
<DerivedVekButton Link="/derived" />

@*derived component that declares Link is a real parameter, so nothing is reported*@
<ReintroducedLinkButton Link="/reintroduced" />

@*a component that merely shares VekButton's short name gets no hint*@
<Vek.Analyzers.TestComponents.Shadow.VekButton Link="/shadow" />

@*other components that dropped Link get the same Href guidance*@
<VekChip T="string" Link="/chip" />
<VekIconButton Link="/icon-button" />

@*similar names are ordinary typos, not migrations*@
<VekButton Linked="/typo">Similar</VekButton>
<VekButton DisableRippleEffect="true">Similar</VekButton>
<VekTextField T="string" AutoGrowth="true" Label="Similar" />

@*a dynamic attribute dictionary is invisible to the analyzer*@
<VekButton @attributes="_splattedAttributes">Splat</VekButton>

@*markup inside comments and strings is never analyzed*@
@*<VekButton Link="/razor-comment" />*@
<!-- <VekButton DisableRipple="true" /> -->
<VekText>@MarkupSample</VekText>

@code
{
    public static string __description__ = "Removed parameters that VEK0002 explains with a migration hint";

    private const string MarkupSample = "<VekButton Link=\"/string-literal\" />";

    private readonly Dictionary<string, object> _splattedAttributes = new() { ["Link"] = "/splatted" };

    private string _text = "y";

    private bool _noRipple = true;

    private bool _grow = true;
}
