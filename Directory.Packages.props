<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Roslyn version shipped with Vek.Analyzers and Vek.Analyzers.CodeFixes. -->
    <VekRoslynShippedVersion>4.7.0</VekRoslynShippedVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Blazor-Analytics" Version="4.0.0" />
    <PackageVersion Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageVersion Include="bunit" Version="2.13.3" />
    <PackageVersion Include="BytexDigital.Blazor.Components.CookieConsent" Version="1.2.1" />
    <PackageVersion Include="ColorCode.HTML" Version="2.0.15" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="JunitXml.TestLogger" Version="8.1.0" />
    <PackageVersion Include="LoxSmoke.DocXml" Version="3.9.0" />
    <PackageVersion Include="Markdig" Version="1.5.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.1" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net10.0' )" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="10.0.14" Condition="('$(MSBuildProjectName)' == 'Vek.Benchmarks' Or '$(MSBuildProjectName)' == 'Vek.Docs' Or '$(MSBuildProjectName)' == 'Vek.Docs.Landing' Or '$(MSBuildProjectName)' == 'Vek.Docs.Showcases')" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="11.0.0" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net11.0' )" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="8.0.12" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net8.0' )" />
    <PackageVersion Include="Microsoft.AspNetCore.Components" Version="9.0.1" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net9.0' )" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.1" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net10.0' )" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" Condition="('$(MSBuildProjectName)' == 'Vek.Docs' Or '$(MSBuildProjectName)' == 'Vek.Docs.Landing' Or '$(MSBuildProjectName)' == 'Vek.Docs.Showcases')" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net11.0' )" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="8.0.12" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net8.0' )" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="9.0.1" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net9.0' )" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.14" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" Condition="('$(MSBuildProjectName)' == 'Vek.Analyzers')" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" Condition="('$(MSBuildProjectName)' == 'Vek.UnitTests.Analyzers')" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(VekRoslynShippedVersion)" Condition="('$(MSBuildProjectName)' == 'Vek.Analyzers')" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" Condition="('$(MSBuildProjectName)' == 'Vek.Analyzers.TestComponents')" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" Version="1.1.4" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(VekRoslynShippedVersion)" Condition="('$(MSBuildProjectName)' == 'Vek.Analyzers.CodeFixes')" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" Condition="('$(MSBuildProjectName)' == 'Vek.UnitTests.Analyzers')" />
    <PackageVersion Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="3.11.0-beta1.26226.5" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.1" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net10.0' )" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="11.0.0" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net11.0' )" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="8.0.12" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net8.0' )" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="9.0.1" Condition="('$(MSBuildProjectName)' == 'Vek') And ( '$(TargetFramework)' == 'net9.0' )" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.2" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NetArchTest.eNhancedEdition" Version="1.4.5" />
    <PackageVersion Include="NetEscapades.EnumGenerators.Generators" Version="1.0.0-beta21" />
    <PackageVersion Include="nunit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="RichardSzalay.MockHttp" Version="7.1.0" />
  </ItemGroup>
</Project>
